msgstr "Exporteren als .xknx…"

msgid "Pin"
msgstr "Vastzetten"

msgid "Unpin"
msgstr "Losmaken"

msgid "Check"
msgstr "Controleren"

msgid "Delete…"
msgstr "Verwijderen…"

msgid "Show what differs between the project now and this backup"
msgstr "Toont wat er verschilt tussen het huidige project en deze back-up"

msgid "A pinned backup is never deleted automatically"
msgstr "Een vastgezette back-up wordt nooit automatisch verwijderd"

msgid "Check that the backup can be restored"
msgstr "Controleert of de back-up kan worden hersteld"

msgid "Created"
msgstr "Gemaakt"

msgid "Kind"
msgstr "Soort"

msgid "Comment"
msgstr "Opmerking"

