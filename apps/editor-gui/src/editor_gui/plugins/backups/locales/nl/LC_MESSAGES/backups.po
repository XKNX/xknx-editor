msgstr "Opmerking: {comment}"

msgid "Settings…"
msgstr "Instellingen…"

msgid "Open a project to see its backups."
msgstr "Open een project om de back-ups ervan te zien."

msgid "This project has no backups yet."
msgstr "Dit project heeft nog geen back-ups."

msgid "Folder: {path}"
msgstr "Map: {path}"

msgid "Open Folder"
msgstr "Map openen"

msgid "Compare"
msgstr "Vergelijken"

