msgid "Open a project to use the Mass Linker."
msgstr "Hapni një projekt për të përdorur Lidhjet masive."

msgid "Pairs are matched by list order (1st with 1st, …). Surplus items on the longer side are ignored. Reorder a list via its right-click menu."
msgstr "Çiftet formohen sipas radhës në listë (i 1-ri me të 1-rin, …). Elementet e tepërta në anën më të gjatë shpërfillen. Renditjen e një liste e ndryshoni nga menyja e klikimit të djathtë."

msgid "Link group objects to existing group addresses."
msgstr "Lidh objektet e grupit me adresa grupi ekzistuese."

msgid "Add objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Shtoni objekte me \"{add_device}\" ose \"{add_objects}\"."

msgid "Pick a group address per row, or fill all with \"{match}\" or \"{sequential}\"."
msgstr "Zgjidhni një adresë grupi për çdo rresht, ose plotësojini të gjitha me \"{match}\" ose \"{sequential}\"."

msgid "\"{link_all}\" links every row that has one."
msgstr "\"{link_all}\" lidh çdo rresht që ka një të tillë."

msgid "Link objects to each other through a new group address each: the source sends, the target receives."
msgstr "Lidh objektet me njëri-tjetrin, secilin përmes një adrese grupi të re: burimi dërgon, objektivi merr."

msgid "Add the source objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Shtoni objektet burimore me \"{add_device}\" ose \"{add_objects}\"."

msgid "Pick a target object per row. Address and name are suggested and can be changed."
msgstr "Zgjidhni një objekt objektiv për çdo rresht. Adresa dhe emri sugjerohen dhe mund të ndryshohen."

msgid "\"{link_all}\" creates the group addresses and links them."
msgstr "\"{link_all}\" krijon adresat e grupeve dhe i lidh ato."

msgid "Link All"
msgstr "Lidh të gjitha"

