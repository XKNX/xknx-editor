msgstr "Vain yleiskäyttöistä yhdistintä voidaan käyttää, kun runkolinjan media on TP."

msgid "The coupler does not support segment coupling, so the sub-segment must be of the same KNX medium type as the main segment."
msgstr "Yhdistin ei tue segmenttikytkentää, joten alisegmentin on oltava samaa KNX-mediatyyppiä kuin pääsegmentti."

msgid "The operation could not be executed, because this device couples medium '{above}' (above) to medium '{below}' (below), but the segment above is '{segment}'."
msgstr "Toimintoa ei voitu suorittaa, koska tämä laite kytkee median '{above}' (yllä) mediaan '{below}' (alla), mutta yllä oleva segmentti on '{segment}'."

msgid "The operation could not be executed, because medium type of coupler device matches only sub segment, but maximum amount of segments reached."
msgstr "Toimintoa ei voitu suorittaa, koska liitäntälaitteen mediatyyppi\\n vastaa vain alisegmenttiä, mutta segmenttien enimmäismäärä saavutettiin."

msgid "The operation could not be executed, because this device couples medium '{above}' (above) to medium '{below}' (below), but the medium type of the lower segment is '{segment}'."
msgstr "Toimenpidettä ei voitu suorittaa, koska tämä laite yhdistää median '{above}' (yllä) mediaan '{below}' (alla), mutta alemman segmentin mediatyyppi on '{segment}'."

