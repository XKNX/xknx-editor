msgid "Open a project to use the Mass Linker."
msgstr "Toplu Bağlayıcıyı kullanmak için bir proje açın."

msgid "Pairs are matched by list order (1st with 1st, …). Surplus items on the longer side are ignored. Reorder a list via its right-click menu."
msgstr "Çiftler liste sırasına göre eşleştirilir (1. ile 1., …). Uzun taraftaki fazla öğeler yok sayılır. Bir listenin sırasını sağ tıklama menüsünden değiştirin."

msgid "Link group objects to existing group addresses."
msgstr "Grup nesnelerini mevcut grup adreslerine bağlayın."

msgid "Add objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Nesneleri \"{add_device}\" veya \"{add_objects}\" ile ekleyin."

msgid "Pick a group address per row, or fill all with \"{match}\" or \"{sequential}\"."
msgstr "Her satır için bir grup adresi seçin veya tümünü \"{match}\" ya da \"{sequential}\" ile doldurun."

msgid "\"{link_all}\" links every row that has one."
msgstr "\"{link_all}\", grup adresi olan her satırı bağlar."

msgid "Link objects to each other through a new group address each: the source sends, the target receives."
msgstr "Nesneleri her biri için yeni bir grup adresi üzerinden birbirine bağlayın: kaynak gönderir, hedef alır."

msgid "Add the source objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Kaynak nesneleri \"{add_device}\" veya \"{add_objects}\" ile ekleyin."

msgid "Pick a target object per row. Address and name are suggested and can be changed."
msgstr "Her satır için bir hedef nesne seçin. Adres ve ad önerilir ve değiştirilebilir."

msgid "\"{link_all}\" creates the group addresses and links them."
msgstr "\"{link_all}\", grup adreslerini oluşturur ve bağlar."

