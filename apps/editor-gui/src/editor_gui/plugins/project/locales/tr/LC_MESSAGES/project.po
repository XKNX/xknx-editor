msgid "This device already uses its own key from this project. Its certificate is only needed again after a factory reset."
msgstr "Bu cihaz zaten bu projedeki kendi anahtarını kullanıyor. Sertifikası yalnızca fabrika ayarlarına sıfırlamadan sonra yeniden gerekir."

msgid "This device still uses its factory key: its first secure download needs its certificate."
msgstr "Bu cihaz hâlâ fabrika anahtarını kullanıyor: ilk güvenli yüklemesi için sertifikası gerekir."

msgid "Stored Certificate: {serial}"
msgstr "Kayıtlı Sertifika: {serial}"

msgid "Enter the FDSK from its label or certificate (36 characters):"
msgstr "Etiketindeki veya sertifikasındaki FDSK'yi girin (36 karakter):"

msgid "To replace it, enter the new FDSK (36 characters):"
msgstr "Değiştirmek için yeni FDSK'yi girin (36 karakter):"

msgid "Remove the stored certificate? After a factory reset, the device can then only be reached again with the code from its label."
msgstr "Kayıtlı sertifika kaldırılsın mı? Fabrika ayarlarına sıfırlamadan sonra cihaza yalnızca etiketindeki kodla yeniden erişilebilir."

msgid "Device Certificate…"
msgstr "Cihaz Sertifikası…"

