msgstr "segment"

msgid "The medium of a segment can only change while it holds no device."
msgstr "Medium segmentu można zmienić tylko wtedy, gdy nie zawiera ono żadnego urządzenia."

msgid "The medium type of the segment '{segment}' cannot be changed to IoT, because its parent line '{line}' is not of medium type IP."
msgstr "Typ medium segmentu \"{segment}\" nie może zostać zmieniony na IoT, ponieważ jego linia nadrzędna \"{line}\" nie ma typu medium IP."

msgid "The maximum number of segments has been reached."
msgstr "Osiągnięto maksymalną liczbę segmentów."

msgid "The main segment cannot be deleted."
msgstr "Główny segment nie może zostać usunięty."

msgid "Device '{device}' is incompatible with line's medium type."
msgstr "Urządzenie '{device}' jest niezgodne z typem medium linii."

msgid "Device '{device}' is incompatible with segment's medium type."
msgstr "Urządzenie '{device}' jest niekompatybilne z medium segmentu."

msgid "Add Segment"
msgstr "Dodaj segment"

msgid "Rename segment to {name}"
msgstr "Zmień nazwę segmentu na {name}"

