msgstr "Urządzenia: {count}"

msgid "The main segment cannot be moved."
msgstr "Nie można przenieść segmentu głównego."

msgid "The maximum number of lines has been reached."
msgstr "Osiągnięto maksymalną liczbę linii."

msgid "The line is already assigned to an area."
msgstr "Linia jest już przypisana do obszaru."

msgid "The main line cannot be moved."
msgstr "Nie można przenieść linii głównej."

