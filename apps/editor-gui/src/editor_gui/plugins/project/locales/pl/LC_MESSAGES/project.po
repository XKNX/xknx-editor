msgstr "WLAN (< 1 s)"

msgid "WAN (< 2s)"
msgstr "WAN (< 2 s)"

msgid "Mobile (< 4s)"
msgstr "Sieć komórkowa (< 4 s)"

msgid "Satellite (< 8s)"
msgstr "Satelitarne (< 8 s)"

msgid "The network latency must be a number of milliseconds from 1 to 65535."
msgstr "Opóźnienie sieci musi być liczbą milisekund od 1 do 65535."

msgid "Multicast Address"
msgstr "Adres multicastowy"

msgid "Enter a multicast address from 224.0.0.0 to 239.255.255.255."
msgstr "Wprowadź adres multicastowy od 224.0.0.0 do 239.255.255.255."

msgid "Bus Connection"
msgstr "Połączenie z magistralą"

msgid "Set IP routing of the backbone"
msgstr "Ustaw routing IP szkieletu"

msgid "As long as a coupler exists at a sub line or sub segment, a change of the medium type is not possible."
msgstr "Dopóki istnieje sprzęgło w lini podrzędnej lub w podsegmencie, zmiana typu medium nie jest możliwa."

msgid "A main line of a project cannot have medium type RF."
msgstr "Linia główna projektu nie może mieć medium typu RF."

msgid "The operation could not be executed, because as medium type of the backbone only IP and TP are allowed."
msgstr "Operacja nie mogła zostać wykonana, ponieważ jako medium obszarowe tylko IP i TP są dozwolone."

msgid "A sub-segment of KNX medium type IP or PL is not allowed."
msgstr "Podsegment medium KNX IP lub PL jest niedozwolony."

msgid "The medium type of the main line '{line}' can no longer be changed to PL, because it already contains lines or segments that are not allowed in PL main lines."
msgstr "Typ medium linii głównej \"{line}\" nie może już zostać zmieniony na PL, ponieważ zawiera on już linie lub segmenty, które nie są dozwolone w liniach głównych PL."

msgid "The medium type of the main line '{line}' cannot be changed to IoT, because the backbone line '{backbone}' is not of medium type IP."
msgstr "Typ medium linii głównej \"{line}\" nie może zostać zmieniony na IoT, ponieważ linia szkieletowa \"{backbone}\" nie ma typu medium IP."

msgid "The medium type of the main line '{line}' can no longer be changed to IoT, because it already contains lines or segments that are not allowed in IoT main lines."
msgstr "Typ medium linii głównej \"{line}\" nie może już zostać zmieniony na IoT, ponieważ zawiera ona już linie lub segmenty, które nie są dozwolone w liniach głównych IoT."

msgid "The medium type of the line '{line}' cannot be changed, because it already contains lines or segments that require an IoT or IP main line."
msgstr "Typ medium linii głównej \"{line}\" nie może zostać zmieniony, ponieważ zawiera już linie lub segmenty, które wymagają linii głównej IoT lub IP."

msgid "A sub-segment is not allowed below a main segment of KNX medium type RF."
msgstr "Podsegment nie jest dozwolony poniżej głównego segmentu medium RF KNX."

msgid "A sub-segment is not allowed below a main segment of KNX medium type PL."
msgstr "Podsegment jest niedozwolony poniżej głównego segmentu medium KNX typu PL."

msgid "A sub-segment of KNX medium type IoT is not allowed below a main segment of the same type."
msgstr "Podsegment medium KNX typu IoT nie jest dozwolony poniżej głównego segmentu tego samego typu."

msgid "The operation could not be executed, because a RF main line '{line}' requires all other lines in the area to be RF lines as well."
msgstr "Operacja nie może być wykonana, ponieważ główna linia RF {line} wymaga, aby wszystkie inne linie w obszarze były również liniami RF."

msgid "The operation could not be executed, because a PL main line '{line}' requires all other lines in the area to be PL lines as well."
msgstr "Operacja nie może być wykonana, ponieważ główna linia PL {line} wymaga, aby wszystkie inne linie w obszarze były również liniami PL."

msgid "The operation could not be executed, because a IoT main line '{line}' requires all other lines in the area to be IoT lines as well."
msgstr "Operacja nie mogła zostać wykonana, ponieważ główna linia IoT \"{line}\" wymaga, aby wszystkie inne linie w obszarze również były liniami IoT."

msgid "The medium type of the line '{line}' cannot be changed to IoT, because its main line '{main}' is not of medium type IP."
msgstr "Typ medium linii \"{line}\" nie może zostać zmieniony na IoT, ponieważ jej linia główna \"{main}\" nie ma typu medium IP."

msgid "The medium type of the line '{line}' can no longer be changed to IoT, because it already contains segments that are not allowed in IoT lines."
msgstr "Typ medium linii \"{line}\" nie może już zostać zmieniony na IoT, ponieważ zawiera już segmenty, które nie są dozwolone w liniach IoT."

msgid "The operation could not be executed, because the line is the IP backbone line and the project contains KNXnet/IP routers. KNXnet/IP routers require an IP backbone line."
msgstr "Operacja nie mogła zostać wykonana, ponieważ linia obszarowa jest linią typu IP i projekt zawiera KNXnet / routery IP. KNXnet / IP routery wymagają linii obszarowej ostawionej jako IP."

msgid "The operation could not be executed, because the line is the IP main line and the project contains KNXnet/IP routers. KNXnet/IP routers require an IP main line."
msgstr "Operacja nie może być wykonana, ponieważ jest to główna linia IP oraz projekt zawiera KNXnet/routery IP. KNXnet/IP routery wymagają ustawienia linii głównej jako linii IP."

msgid "The operation could not be executed, because the line is the IP backbone line and the project contains IoT or IP lines."
msgstr "Operacja nie mogła zostać wykonana, ponieważ linia jest linią szkieletową IP, a projekt zawiera linie IoT lub IP."

msgid "The operation could not be executed, because the medium type of the line can only be set to IP if an IP main line exists."
msgstr "Operacja nie może być wykonana, ponieważ rodzaj medium linii może być ustawiona tylko na IP jeśli istnieje linia główna IP."

msgid "The operation could not be executed, because the medium type of the line can only be set to IP if an IP backbone line exists."
msgstr "Operacja nie może być wykonana, ponieważ rodzaj medium linii może być ustawiony tylko na IP, jeśli linia obszarowa IP istnieje."

msgid "The operation could not be executed, because below a TP main segment only segments of KNX medium type TP, RF or PL can exist."
msgstr "Operacja nie mogła zostać wykonana, ponieważ poniżej głównego segmentu mogą istnieć tylko segmenty KNX medium TP, RF lub PL."

msgid "Below a main segment of KNX medium type IP only segments of medium type TP or RF can exist."
msgstr "Poniżej głównego segmentu medium KNX IP mogą istnieć tylko segmenty medium TP lub RF."

msgid "A sub-segment of KNX medium type PL is not allowed below a main segment."
msgstr "Podsegment medium KNX PL nie jest dozwolony poniżej segmentu głównego."

msgid "Set bus connection of the backbone"
msgstr "Ustaw połączenie z magistralą szkieletu"

msgid "Set domain address"
msgstr "Ustaw adres domeny"

msgid "Generate New"
msgstr "Wygeneruj nowy"

msgid "The given domain address is invalid."
msgstr "Podany adres domeny jest nieprawidłowy."

msgid "Domain address is not valid! Valid values are 1 to 255."
msgstr "Adres domeny nie jest prawidłowy! Poprawny adres jest w zakresie od 1 do 255."

msgid "DomainAddress of mediumType 'RF' is lower than the minimum value of 0001:00000000."
msgstr "Adres domeny medium 'RF' jest niższy od minimalnej wartości 0001: 00000000."

msgid "DomainAddress of medium type '{medium}' exceeds the maximum valid value of {maximum}"
msgstr "Adres domeny dla typu medium '{medium} \"przekracza maksymalną dopuszczalną wartość {maximum}"

msgid "DomainAddress of RF sublines must be equal to DomainAdress of main line."
msgstr "Adres domeny linii RF musi być równy adresowi domeny linii głównej."

msgid "Domain Address of IoT sublines must be equal to Domain Address of main line."
msgstr "Adres domeny podlinii IoT musi być taki sam jak Adres domeny głównej linii."

msgid "Each line in a project must have a unique domain address."
msgstr "Każda linia w projekcie musi mieć unikalny adres domeny."

