msgstr "Wymuszone włączenie"

msgid "Forced off"
msgstr "Wymuszone wyłączenie"

msgid "Overridden by '{name}': {mode}"
msgstr "Nadpisane przez '{name}': {mode}"

msgid "Central"
msgstr "Centralna"

msgid "Not every device linked to a group address of this group is commissioned securely, so it cannot be secured."
msgstr "Nie wszystkie urządzenia połączone z adresem grupowym tej grupy są uruchamiane w trybie bezpiecznym, więc nie można jej zabezpieczyć."

msgid "Set group security"
msgstr "Ustaw zabezpieczenie grupy"

msgid "Mark group address as central"
msgstr "Oznacz adres grupowy jako centralny"

msgid "Remove central mark from group address"
msgstr "Usuń oznaczenie centralne z adresu grupowego"

