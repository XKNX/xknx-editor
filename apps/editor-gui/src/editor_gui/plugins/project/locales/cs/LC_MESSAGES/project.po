msgid "This device already uses its own key from this project. Its certificate is only needed again after a factory reset."
msgstr "Toto zařízení už používá vlastní klíč z tohoto projektu. Jeho certifikát bude znovu potřeba až po obnovení továrního nastavení."

msgid "This device still uses its factory key: its first secure download needs its certificate."
msgstr "Toto zařízení stále používá svůj tovární klíč: jeho první zabezpečené nahrání vyžaduje jeho certifikát."

msgid "Stored Certificate: {serial}"
msgstr "Uložený certifikát: {serial}"

msgid "Enter the FDSK from its label or certificate (36 characters):"
msgstr "Zadejte FDSK z jeho štítku nebo certifikátu (36 znaků):"

msgid "To replace it, enter the new FDSK (36 characters):"
msgstr "Pro nahrazení zadejte nový FDSK (36 znaků):"

msgid "Remove the stored certificate? After a factory reset, the device can then only be reached again with the code from its label."
msgstr "Odstranit uložený certifikát? Po obnovení továrního nastavení pak bude zařízení dosažitelné jen s kódem z jeho štítku."

msgid "Device Certificate…"
msgstr "Certifikát zařízení…"

msgid "The device certificate (FDSK) is missing."
msgstr "Chybí certifikát zařízení (FDSK)."

