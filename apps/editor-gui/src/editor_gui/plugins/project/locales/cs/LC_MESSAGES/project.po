msgid "Open a project to use the Mass Linker."
msgstr "Pro použití hromadného propojení otevřete projekt."

msgid "Pairs are matched by list order (1st with 1st, …). Surplus items on the longer side are ignored. Reorder a list via its right-click menu."
msgstr "Páry se tvoří podle pořadí v seznamu (1. s 1., …). Přebývající položky delšího seznamu se ignorují. Pořadí v seznamu změníte v jeho kontextové nabídce."

msgid "Link group objects to existing group addresses."
msgstr "Propojit skupinové objekty s existujícími skupinovými adresami."

msgid "Add objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Přidejte objekty pomocí \"{add_device}\" nebo \"{add_objects}\"."

msgid "Pick a group address per row, or fill all with \"{match}\" or \"{sequential}\"."
msgstr "Vyberte skupinovou adresu pro každý řádek, nebo vyplňte všechny pomocí \"{match}\" nebo \"{sequential}\"."

msgid "\"{link_all}\" links every row that has one."
msgstr "\"{link_all}\" propojí každý řádek, který ji má."

msgid "Link objects to each other through a new group address each: the source sends, the target receives."
msgstr "Propojit objekty navzájem, každý pár přes novou skupinovou adresu: zdroj vysílá, cíl přijímá."

msgid "Add the source objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Přidejte zdrojové objekty pomocí \"{add_device}\" nebo \"{add_objects}\"."

msgid "Pick a target object per row. Address and name are suggested and can be changed."
msgstr "Vyberte cílový objekt pro každý řádek. Adresa a název se navrhnou a lze je změnit."

msgid "\"{link_all}\" creates the group addresses and links them."
msgstr "\"{link_all}\" vytvoří skupinové adresy a propojí je."

