msgstr "Toto není platný FDSK; zkontrolujte ho prosím."

msgid "This certificate belongs to the device with serial number {serial}."
msgstr "Tento certifikát patří zařízení se sériovým číslem {serial}."

msgid "Set a project password first: it protects the device keys."
msgstr "Nejprve nastavte heslo projektu: chrání klíče zařízení."

msgid "The other project is protected with a password. Enter it to compare:"
msgstr "Druhý projekt je chráněn heslem. Pro porovnání ho zadejte:"

