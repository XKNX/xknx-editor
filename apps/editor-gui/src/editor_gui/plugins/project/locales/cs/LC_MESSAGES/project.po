msgstr "Doba odezvy sítě musí být počet milisekund od 1 do 65535."

msgid "Multicast Address"
msgstr "Adresa multicast"

msgid "Enter a multicast address from 224.0.0.0 to 239.255.255.255."
msgstr "Zadejte adresu multicast od 224.0.0.0 do 239.255.255.255."

msgid "Bus Connection"
msgstr "Spojení se sběrnicí"

msgid "Set IP routing of the backbone"
msgstr "Nastavit IP směrování páteře"

msgid "As long as a coupler exists at a sub line or sub segment, a change of the medium type is not possible."
msgstr "Dokud v podlince nebo v podsegmentu existuje spojka, není změna typu média možná."

msgid "A main line of a project cannot have medium type RF."
msgstr "Hlavní linie v projektu nemůže obsahovat médium typu RF."

msgid "The operation could not be executed, because as medium type of the backbone only IP and TP are allowed."
msgstr "Operaci nebylo možno provést, protože jako typ média páteře jsou povoleny jen IP a TP."

msgid "A sub-segment of KNX medium type IP or PL is not allowed."
msgstr "Podsegment KNX typu IP nebo PL není povolen."

msgid "The medium type of the main line '{line}' can no longer be changed to PL, because it already contains lines or segments that are not allowed in PL main lines."
msgstr "Typ média hlavní linie „{line}“ již nelze změnit na PL, protože již obsahuje linie nebo segmenty, které nejsou povoleny v hlavních liniích PL."

msgid "The medium type of the main line '{line}' cannot be changed to IoT, because the backbone line '{backbone}' is not of medium type IP."
msgstr "Typ média hlavní linie „{line}“ nelze změnit na IoT, protože páteřní linie „{backbone}“ není médium typu IP."

msgid "The medium type of the main line '{line}' can no longer be changed to IoT, because it already contains lines or segments that are not allowed in IoT main lines."
msgstr "Typ média hlavní linie „{line}“ již nelze změnit na IoT, protože již obsahuje linie nebo segmenty, které nejsou povoleny v hlavních liniích IoT."

msgid "The medium type of the line '{line}' cannot be changed, because it already contains lines or segments that require an IoT or IP main line."
msgstr "Typ média hlavní linie „{line}“ již nelze změnit, protože již obsahuje linie nebo segmenty, které vyžadují hlavní linii IoT nebo IP."

msgid "A sub-segment is not allowed below a main segment of KNX medium type RF."
msgstr "Podsegment není dovolen pod hlavním segmentem média KNX typu RF."

msgid "A sub-segment is not allowed below a main segment of KNX medium type PL."
msgstr "Podsegment není povolen pod hlavním segmentem média KNX typu PL."

msgid "A sub-segment of KNX medium type IoT is not allowed below a main segment of the same type."
msgstr "Dílčí segment média KNX typu IoT není povolen pod hlavním segmentem stejného typu."

msgid "The operation could not be executed, because a RF main line '{line}' requires all other lines in the area to be RF lines as well."
msgstr "Operaci nelze spustit, protože hlavní linie RF „{line}“vyžaduje, aby i všechny ostatní linie v oblasti byly liniemi RF."

msgid "The operation could not be executed, because a PL main line '{line}' requires all other lines in the area to be PL lines as well."
msgstr "Operaci nelze uskutečnit, protože PL hlavní linie '{line}' vyžaduje, aby všechny ostatní linie v oblasti byly rovněž PL liniemi."

msgid "The operation could not be executed, because a IoT main line '{line}' requires all other lines in the area to be IoT lines as well."
msgstr "Operaci nelze spustit, protože hlavní linie IoT „{line}“ vyžaduje, aby i všechny ostatní linie v oblasti byly liniemi IoT."

msgid "The medium type of the line '{line}' cannot be changed to IoT, because its main line '{main}' is not of medium type IP."
msgstr "Typ média linie „{line}“ nelze změnit na IoT, protože hlavní linie „{main}“ není médium typu IP."

msgid "The medium type of the line '{line}' can no longer be changed to IoT, because it already contains segments that are not allowed in IoT lines."
msgstr "Typ média linie „{line}“ již nelze změnit na IoT, protože již obsahuje segmenty, které nejsou povoleny v liniích IoT."

msgid "The operation could not be executed, because the line is the IP backbone line and the project contains KNXnet/IP routers. KNXnet/IP routers require an IP backbone line."
msgstr "Operaci není možné uskutečnit, protože linie je IP páteřní linií a projekt obsahuje  KNXnet/IP routery. KNXnet/IP routery vyžadují IP páteřní linii."

msgid "The operation could not be executed, because the line is the IP main line and the project contains KNXnet/IP routers. KNXnet/IP routers require an IP main line."
msgstr "Operaci není možné uskutečnit, protože linie je IP hlavní linií a  projekt obsahuje KNXnet/IP routery. KNXnet/IP routery vyžadují IP hlavní linii."

msgid "The operation could not be executed, because the line is the IP backbone line and the project contains IoT or IP lines."
msgstr "Operaci nelze uskutečnit, protože páteřní linie je IP a projekt obsahuje IoT nebo IP linie."

msgid "The operation could not be executed, because the medium type of the line can only be set to IP if an IP main line exists."
msgstr "Operace nemůže být vykonána, protože typ média linie může být nastaven pouze na IP, když existuje IP hlavní linie."

msgid "The operation could not be executed, because the medium type of the line can only be set to IP if an IP backbone line exists."
msgstr "Operaci nelze uskutečnit, protože typ média na linii lze nastavit pouze na IP jestliže existuje IP páteřní linie."

msgid "The operation could not be executed, because below a TP main segment only segments of KNX medium type TP, RF or PL can exist."
msgstr "Operaci nebylo možno provést, protože pod hlavním segmentem TP mohou existovat jen segmenty média KNx typu TP, RF nebo PL."

msgid "Below a main segment of KNX medium type IP only segments of medium type TP or RF can exist."
msgstr "Pod hlavním segmentem média KNX typu IP mohou existovat jen segmenty média typu TP nebo RF."

msgid "A sub-segment of KNX medium type PL is not allowed below a main segment."
msgstr "Podsegment média KNX typu PL není pod hlavním segmentem dovolen."

msgid "Set bus connection of the backbone"
msgstr "Nastavit spojení se sběrnicí páteře"

msgid "Set domain address"
msgstr "Nastavit adresu domény"

msgid "Generate New"
msgstr "Vytvořit nový"

msgid "The given domain address is invalid."
msgstr "Daná adresa domény je neplatná."

msgid "Domain address is not valid! Valid values are 1 to 255."
msgstr "Adresa domény není platná! Platnými hodnotami jsou 1 až 255."

msgid "DomainAddress of mediumType 'RF' is lower than the minimum value of 0001:00000000."
msgstr "Adresa domény typu média 'RF' je kratší, než minimální hodnota 0001:00000000."

msgid "DomainAddress of medium type '{medium}' exceeds the maximum valid value of {maximum}"
msgstr "Adresa domény mediálního typu '{medium}' překračuje maximální platnou hodnotu {maximum}"

msgid "DomainAddress of RF sublines must be equal to DomainAdress of main line."
msgstr "Adresa domény RF podřízené linie musí být shodná a adresou domény hlavní linie."

msgid "Domain Address of IoT sublines must be equal to Domain Address of main line."
msgstr "DomainAddress dílčích linií IoT musí odpovídat DomainAddress hlavní linie."

msgid "Each line in a project must have a unique domain address."
msgstr "Každá linie v projektu musí mít jedinečnou doménovou adresu."

