msgid "Replace Device"
msgstr "Замінити пристрій"

msgid "Swap a device for another model (a template device already in the project), keeping its group-address links. Group objects are matched by number and size; unmatched ones are reported. Parameters are not carried over."
msgstr "Замінити пристрій іншою моделлю (пристроєм-шаблоном, який уже є в проєкті), зберігши зв'язки з груповими адресами. Групові об'єкти зіставляються за номером і розміром; незіставлені буде показано. Параметри не переносяться."

msgid "Device to Replace"
msgstr "Пристрій для заміни"

msgid "Replace with (Template)"
msgstr "Замінити на (шаблон)"

msgid "Group Object Mapping (by Number)"
msgstr "Зіставлення групових об'єктів (за номером)"

msgid "{count} object(s) will be re-mapped"
msgstr "Об'єктів буде перезіставлено: {count}"

