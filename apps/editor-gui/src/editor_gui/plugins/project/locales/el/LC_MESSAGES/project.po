msgstr "{count} αντικείμενο(-α) θα αντιστοιχιστούν εκ νέου"

msgid "Replaced; re-mapped {count} group object(s)"
msgstr "Αντικαταστάθηκε· αντιστοιχίστηκαν εκ νέου {count} αντικείμενο(-α) επικοινωνίας"

