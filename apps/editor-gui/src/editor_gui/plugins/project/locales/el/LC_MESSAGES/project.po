msgid "Project Diff"
msgstr "Σύγκριση Έργων"

msgid "Compare the open project with another project file (.knxproj or .xknx): which devices and group addresses were added, removed or changed. The other project is read-only; nothing is modified."
msgstr "Σύγκριση του ανοιχτού έργου με άλλο αρχείο έργου (.knxproj ή .xknx): ποιες συσκευές και διευθύνσεις ομάδων προστέθηκαν, αφαιρέθηκαν ή άλλαξαν. Το άλλο έργο είναι μόνο για ανάγνωση· δεν τροποποιείται τίποτα."

msgid "Choose Project to Compare…"
msgstr "Επιλογή Έργου για Σύγκριση…"

msgid "Choose Project to Compare"
msgstr "Επιλογή Έργου για Σύγκριση"

msgid "KNX project (*.knxproj *.xknx)"
msgstr "Έργο KNX (*.knxproj *.xknx)"

msgid "compared with {name}"
msgstr "σε σύγκριση με {name}"

