msgstr "Il est uniquement possible d’utiliser un coupleur mondial lorsque le média de la ligne réseau est TP."

msgid "The coupler does not support segment coupling, so the sub-segment must be of the same KNX medium type as the main segment."
msgstr "Le coupler ne supporte pas le couplage de segments, donc le sous-segment doit être du même type de média KNX que le segment principal."

msgid "The operation could not be executed, because this device couples medium '{above}' (above) to medium '{below}' (below), but the segment above is '{segment}'."
msgstr "L'opération n'a pas pu être exécutée, car cet appareil couple le média '{above}' (ci-dessus) au média '{below}' (ci-dessous), mais le segment ci-dessus est '{segment}'."

msgid "The operation could not be executed, because medium type of coupler device matches only sub segment, but maximum amount of segments reached."
msgstr "L'opération n'a pas pu être exécutée, car le type de média ne correspond qu'à un sous-segment, mais la quantité maximale de segments atteints."

msgid "The operation could not be executed, because this device couples medium '{above}' (above) to medium '{below}' (below), but the medium type of the lower segment is '{segment}'."
msgstr "L'opération n'a pas pu être exécutée, car ce participant couple le média '{above}' (ci-dessus) au média '{below}' (ci-dessous), mais le segment ci-dessous est '{segment}'."

