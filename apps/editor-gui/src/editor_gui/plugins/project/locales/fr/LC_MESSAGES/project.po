msgstr "Adresse de domaine non valide. Les valeurs valables sont 1 à 255."

msgid "DomainAddress of mediumType 'RF' is lower than the minimum value of 0001:00000000."
msgstr "L'adresse de domaine de Type 'RF' est inférieure que la valeur minimale de 0001:00000000."

