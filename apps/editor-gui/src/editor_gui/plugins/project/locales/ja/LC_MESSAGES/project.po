msgstr "拡張コピー"

msgid "Replace Device"
msgstr "デバイスを置換する"

msgid "Swap a device for another model (a template device already in the project), keeping its group-address links. Group objects are matched by number and size; unmatched ones are reported. Parameters are not carried over."
msgstr "デバイスを別のモデル（プロジェクト内にあるテンプレート・デバイス）に置き換え、グループ・アドレスのリンクを保持します。グループ・オブジェクトは番号とサイズで照合され、一致しないものは報告されます。パラメータは引き継がれません。"

msgid "Device to Replace"
msgstr "置換するデバイス"

msgid "Replace with (Template)"
msgstr "置換先（テンプレート）"

msgid "Group Object Mapping (by Number)"
msgstr "グループ・オブジェクトの対応付け（番号順）"

msgid "{count} object(s) will be re-mapped"
msgstr "{count} 個のオブジェクトが再対応付けされます"

msgid "Replaced; re-mapped {count} group object(s)"
msgstr "置換しました。{count} 個のグループ・オブジェクトを再対応付けしました"

msgid "Shift Addresses"
msgstr "アドレスをシフト"

msgid "Labels"
msgstr "ラベル"

