msgid "Open a project to use the Mass Linker."
msgstr "Åpne et prosjekt for å bruke massekoblingen."

msgid "Pairs are matched by list order (1st with 1st, …). Surplus items on the longer side are ignored. Reorder a list via its right-click menu."
msgstr "Par dannes etter rekkefølgen i listene (1. med 1., …). Overtallige elementer på den lengste siden ignoreres. Endre rekkefølgen i en liste via høyreklikkmenyen."

msgid "Link group objects to existing group addresses."
msgstr "Koble gruppeobjekter til eksisterende gruppeadresser."

msgid "Add objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Legg til objekter med «{add_device}» eller «{add_objects}»."

msgid "Pick a group address per row, or fill all with \"{match}\" or \"{sequential}\"."
msgstr "Velg en gruppeadresse per rad, eller fyll ut alle med «{match}» eller «{sequential}»."

msgid "\"{link_all}\" links every row that has one."
msgstr "«{link_all}» kobler hver rad som har en."

msgid "Link objects to each other through a new group address each: the source sends, the target receives."
msgstr "Koble objekter til hverandre via en ny gruppeadresse hver: kilden sender, målet mottar."

msgid "Add the source objects with \"{add_device}\" or \"{add_objects}\"."
msgstr "Legg til kildeobjektene med «{add_device}» eller «{add_objects}»."

msgid "Pick a target object per row. Address and name are suggested and can be changed."
msgstr "Velg et målobjekt per rad. Adresse og navn foreslås og kan endres."

msgid "\"{link_all}\" creates the group addresses and links them."
msgstr "«{link_all}» oppretter gruppeadressene og kobler dem."

