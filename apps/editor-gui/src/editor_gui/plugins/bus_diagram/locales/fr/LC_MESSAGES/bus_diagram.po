msgstr "+ {count} de plus"

msgid "{count} more devices outside the selection. Click to show them."
msgstr "{count} participants supplémentaires hors de la sélection. Cliquez pour les afficher."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\n{senders} émetteur(s), {receivers} récepteur(s)"

