msgstr "Précédent"

msgid "Fit"
msgstr "Ajuster"

msgid "Sending"
msgstr "Émetteurs"

msgid "Group Addresses"
msgstr "Adresses de Groupe"

msgid "Receiving"
msgstr "Récepteurs"

msgid "Areas"
msgstr "Zones"

msgid "Lines"
