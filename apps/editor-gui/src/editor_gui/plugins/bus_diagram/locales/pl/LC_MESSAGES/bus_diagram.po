msgid "Bus Diagram"
msgstr "Schemat magistrali"

msgid "No project open"
msgstr "Brak otwartego projektu"

msgid "Unassigned"
msgstr "Nieprzypisane"

msgid "Drag to move, {key}+scroll to zoom. Click a device to open it."
msgstr "Przeciągnij, aby przesunąć, {key}+kółko, aby powiększyć. Kliknięcie urządzenia otwiera je."

msgid "Physical"
msgstr "Fizyczna"

msgid "Building"
msgstr "Budynek"

msgid "Links"
msgstr "Powiązania"

msgid "Which devices talk to which over their group addresses: sending devices on the left, receiving devices on the right."
msgstr "Które urządzenia komunikują się ze sobą przez adresy grupowe: urządzenia nadające po lewej, odbierające po prawej."

msgid "Click to follow a device, channel or group address, double-click to open a device, click the arrow of a device to list its group objects. Drag to move, {key}+scroll to zoom."
msgstr "Kliknięcie śledzi urządzenie, kanał lub adres grupowy, dwukrotne kliknięcie otwiera urządzenie, kliknięcie strzałki urządzenia wyświetla jego obiekty grupy. Przeciągnij, aby przesunąć, {key}+kółko, aby powiększyć."

msgid "Tap to follow a device, channel or group address, double-tap to open a device, tap the arrow of a device to list its group objects. Zoom with two fingers."
msgstr "Dotknięcie śledzi urządzenie, kanał lub adres grupowy, dwukrotne dotknięcie otwiera urządzenie, dotknięcie strzałki urządzenia wyświetla jego obiekty grupy. Powiększanie dwoma palcami."

msgid "Channels"
msgstr "Kanały"

msgid "Channel: {channel} ({device})"
msgstr "Kanał: {channel} ({device})"

msgid "List the group objects"
msgstr "Pokaż obiekty grupy"

msgid "Hide the group objects"
msgstr "Ukryj obiekty grupy"

msgid "Group object {number}: {name}"
msgstr "Obiekt grupy {number}: {name}"

msgid "Channel: {channel}"
msgstr "Kanał: {channel}"

msgid "No linked devices to show."
msgstr "Brak połączonych urządzeń do wyświetlenia."

msgid "Show"
msgstr "Pokaż"

msgid "Whole Project"
msgstr "Cały projekt"

msgid "Rooms"
msgstr "Pokoje"

msgid "Main Groups"
msgstr "Grupy główne"

msgid "Device: {device}"
msgstr "Urządzenie: {device}"

msgid "Group Address: {address}"
msgstr "Adres grupowy: {address}"

msgid "Back"
msgstr "Powrót"

msgid "Fit"
msgstr "Dopasuj"

msgid "Sending"
msgstr "Nadające"

msgid "Group Addresses"
msgstr "Adresy grupowe"

msgid "Receiving"
msgstr "Odbierające"

msgid "Areas"
msgstr "Obszary"

msgid "Lines"
msgstr "Linie"

msgid "Devices"
msgstr "Urządzenia"

msgid "Buildings"
msgstr "Budynki"

msgid "+ {count} more"
msgstr "+ {count} więcej"

msgid "{count} more devices outside the selection. Click to show them."
msgstr "Urządzenia poza wyborem: {count}. Kliknij, aby je wyświetlić."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\nnadające: {senders}, odbierające: {receivers}"

msgid "Area {area}"
msgstr "Obszar {area}"

msgid "L {line}"
msgstr "L {line}"

msgid "Zoom with two fingers. Tap a device to open it."
msgstr "Powiększanie dwoma palcami. Dotknięcie urządzenia otwiera je."

msgid "(unnamed)"
msgstr "(bez nazwy)"

msgid "Address: {address}"
msgstr "Adres: {address}"

msgid "Application: {application}"
msgstr "Aplikacja: {application}"
