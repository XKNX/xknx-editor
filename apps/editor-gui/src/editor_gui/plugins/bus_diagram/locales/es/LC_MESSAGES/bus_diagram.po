msgid "Bus Diagram"
msgstr "Diagrama de bus"

msgid "No project open"
msgstr "Ningún proyecto abierto"

msgid "Unassigned"
msgstr "sin asignar"

msgid "Drag to move, {key}+scroll to zoom. Click a device to open it."
msgstr "Arrastre para mover, {key}+rueda para hacer zoom. Haga clic en un dispositivo para abrirlo."

