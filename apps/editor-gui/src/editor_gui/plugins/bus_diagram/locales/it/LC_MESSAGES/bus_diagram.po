msgstr "Trasmittenti"

msgid "Group Addresses"
msgstr "Indirizzi di Gruppo"

msgid "Receiving"
msgstr "Riceventi"

msgid "Areas"
msgstr "Aree"

msgid "Lines"
msgstr "Linee"

