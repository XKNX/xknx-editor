msgstr "Altri {count} dispositivi fuori dalla selezione. Fare clic per mostrarli."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\n{senders} trasmittenti, {receivers} riceventi"

msgid "Area {area}"
msgstr "Area {area}"

msgid "L {line}"
msgstr "L {line}"

msgid "Zoom with two fingers. Tap a device to open it."
msgstr "Zoom con due dita. Toccare un dispositivo per aprirlo."

