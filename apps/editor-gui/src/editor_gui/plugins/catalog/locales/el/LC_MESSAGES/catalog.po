msgstr "Εξήχθη το {name}"

msgid "Could not export {name}: {error}"
msgstr "Δεν ήταν δυνατή η εξαγωγή του {name}: {error}"

msgid "No stored archive for {name}"
msgstr "Δεν υπάρχει αποθηκευμένη αρχειοθήκη για το {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Αυτή η συσκευή υποστηρίζει KNX Data Secure. Ορίστε κωδικό έργου για ασφαλή θέση σε λειτουργία· χωρίς κωδικό προστίθεται και τίθεται σε λειτουργία χωρίς κρυπτογράφηση."

msgid "Search…"
msgstr "Αναζήτηση…"
