msgstr "Αναζήτηση προϊόντων, αριθμού παραγγελίας…"

msgid "Product Index ({date}): {mfrs} manufacturers, {products} products"
msgstr "Ευρετήριο Προϊόντων ({date}): {mfrs} κατασκευαστές, {products} προϊόντα"

msgid "No Product Index yet - fetch the online catalog to build it"
msgstr "Δεν υπάρχει ακόμη Ευρετήριο Προϊόντων - κάντε λήψη του online καταλόγου για να δημιουργηθεί"

msgid "Building Product Index… {done}/{total} manufacturers"
msgstr "Δημιουργία Ευρετηρίου Προϊόντων… {done}/{total} κατασκευαστές"

msgid "Cancel"
msgstr "Άκυρο"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "Κάντε λήψη του online καταλόγου για αναζήτηση σε όλους τους κατασκευαστές."

msgid "Showing {shown} of {total} matches - refine the search"
msgstr "Εμφάνιση {shown} από {total} αποτελεσμάτων - περιορίστε την αναζήτηση"

msgid "Product Details"
msgstr "Λεπτομέρειες Προϊόντος"

msgid "Name"
msgstr "Όνομα"

msgid "Order Number"
msgstr "Αριθμός Παραγγελίας"

msgid "Manufacturer"
msgstr "Κατασκευαστής"

msgid "Application"
msgstr "Εφαρμογή"

msgid "Program Version"
msgstr "Έκδοση Προγράμματος"

msgid "Application ID"
msgstr "ID Εφαρμογής"

msgid "DIN Rail Mounting"
msgstr "Εγκατάσταση σε ράγα DIN"

msgid "Bus Current"
msgstr "Ρεύμα Bus"

msgid "Yes"
msgstr "Ναι"

msgid "No"
msgstr "Όχι"

msgid "Product Ref"
msgstr "Αναφορά Προϊόντος"

msgid "Add Device"
msgstr "Προσθήκη Συσκευής"

msgid "Room"
msgstr "Δωμάτιο"

msgid "(no room)"
msgstr "(χωρίς δωμάτιο)"

msgid "Open or create a project first to add a device."
msgstr "Ανοίξτε ή δημιουργήστε πρώτα ένα έργο για να προσθέσετε συσκευή."

msgid "This product has no usable application program."
msgstr "Αυτό το προϊόν δεν έχει χρησιμοποιήσιμο πρόγραμμα εφαρμογής."

msgid "Added device: {name}"
msgstr "Προστέθηκε συσκευή: {name}"

msgid "Local"
msgstr "Τοπικός"

msgid "Online"
msgstr "Online"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Δεν έχουν εισαχθεί ακόμη προϊόντα — εισαγάγετε ένα .knxprod ή χρησιμοποιήστε την καρτέλα Online."

msgid "Fetch {count} Missing Application(s) Online"
msgstr "Λήψη Online {count} Εφαρμογής(-ών) που Λείπουν"

msgid "Fetching missing applications…"
msgstr "Λήψη εφαρμογών που λείπουν…"

msgid "Delete"
msgstr "Διαγραφή"

msgid "Delete from Local Catalog"
msgstr "Διαγραφή από τον Τοπικό Κατάλογο"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Θέλετε σίγουρα να διαγράψετε την επιλεγμένη συσκευή; Η ενέργεια δεν αναιρείται."

msgid "{count} device(s) in the open project use this product. They can't be loaded until the product is imported again."
msgstr "{count} συσκευή(-ές) στο ανοιχτό έργο χρησιμοποιούν αυτό το προϊόν. Δεν θα μπορούν να φορτωθούν μέχρι να εισαχθεί ξανά το προϊόν."

msgid "Deleting {name}…"
msgstr "Διαγραφή {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Διαγράφηκε από τον τοπικό κατάλογο: {name}"

msgid "Export .knxprod…"
msgstr "Εξαγωγή .knxprod…"

msgid "Export .knxprod"
msgstr "Εξαγωγή .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Προϊόν KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "Εξήχθη το {name}"

msgid "Could not export {name}: {error}"
msgstr "Δεν ήταν δυνατή η εξαγωγή του {name}: {error}"

msgid "No stored archive for {name}"
msgstr "Δεν υπάρχει αποθηκευμένη αρχειοθήκη για το {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Αυτή η συσκευή υποστηρίζει KNX Data Secure. Ορίστε κωδικό έργου για ασφαλή θέση σε λειτουργία· χωρίς κωδικό προστίθεται και τίθεται σε λειτουργία χωρίς κρυπτογράφηση."

msgid "Search…"
msgstr "Αναζήτηση…"

msgid "Market:"
msgstr "Αγορά:"

msgid "All Markets"
msgstr "Όλες οι Αγορές"

msgid "Only Products in {language}"
msgstr "Μόνο Προϊόντα στα {language}"

msgid "{shown} of {total} shown"
msgstr "Εμφανίζονται {shown} από {total}"

msgid "(estimated)"
msgstr "(εκτιμώμενο)"

msgid "Line"
msgstr "Γραμμή"

msgid "Automatic"
msgstr "Αυτόματα"

msgid "Add to"
msgstr "Προσθήκη σε"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Αυτόματα: η συσκευή μπαίνει στην Τρέχουσα Γραμμή του επιλεγμένου χώρου, αλλιώς στην πρώτη γραμμή TP."

msgid "Download to Local Catalog"
msgstr "Λήψη στον Τοπικό Κατάλογο"

msgid "Filename"
msgstr "Όνομα αρχείου"

msgid "Mask Version"
msgstr "Έκδοση μάσκας"

msgid "Size"
msgstr "Μέγεθος"

msgid "Updated"
msgstr "Ενημερώθηκε"

msgid "Alternative"
msgstr "Εναλλακτικός"

msgid "Server URL"
msgstr "URL διακομιστή"

msgid "Username"
msgstr "Όνομα χρήστη"

msgid "Email"
msgstr "Email"

msgid "Save"
msgstr "Αποθήκευση"

msgid "Register"
msgstr "Εγγραφή"

msgid "Continue Registration"
msgstr "Συνέχεια εγγραφής"

msgid "Verification Code"
msgstr "Κωδικός επαλήθευσης"

msgid "Verify Email"
msgstr "Επαλήθευση email"

msgid "Resend Code"
msgstr "Επαναποστολή κωδικού"

msgid "Open Website"
msgstr "Άνοιγμα ιστοτόπου"

msgid "Imported {count} product versions. Find them in the Local tab."
msgstr "Εισήχθησαν {count} εκδόσεις προϊόντων. Θα τις βρείτε στην καρτέλα Τοπικά."

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Τα στοιχεία σύνδεσης αποθηκεύονται σε αυτόν τον υπολογιστή. Αφήστε κενό τον κωδικό πρόσβασης για να διατηρηθεί για τον ίδιο διακομιστή και χρήστη."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Η εγγραφή στέλνει κωδικό μέσω email. Κωδικός πρόσβασης: τουλάχιστον 10 χαρακτήρες, κεφαλαίο, πεζό, ψηφίο και ειδικός χαρακτήρας· έως 72 byte UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Εισαγάγετε τον εξαψήφιο κωδικό από το email για να ολοκληρώσετε την εγγραφή."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "Το email επαληθεύτηκε. Οι λήψεις θα είναι διαθέσιμες μετά την έγκριση του διαχειριστή."

msgid "Version"
msgstr "Έκδοση"

msgid "Register…"
msgstr "Εγγραφή…"
msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Η σύνδεση απορρίφθηκε: το όνομα χρήστη ή ο κωδικός είναι λάθος, ή ο λογαριασμός δεν έχει εγκριθεί ακόμη."

msgid "Enter your username and password, or register, before downloading."
msgstr "Εισαγάγετε το όνομα χρήστη και τον κωδικό σας ή κάντε εγγραφή πριν από τη λήψη."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Το ημερήσιο όριο λήψεων συμπληρώθηκε. Δοκιμάστε ξανά αύριο."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Ο διακομιστής καταλόγου είναι απασχολημένος. Δοκιμάστε ξανά σε λίγο."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Εισαγάγετε μια διεύθυνση email και ένα όνομα χρήστη από 3 έως 32 γράμματα, ψηφία, τελείες, κάτω παύλες ή παύλες."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Ο κωδικός χρειάζεται τουλάχιστον 10 χαρακτήρες με κεφαλαία και πεζά γράμματα, ένα ψηφίο και έναν ειδικό χαρακτήρα."

msgid "Enter the six-digit code from the email."
msgstr "Εισαγάγετε τον εξαψήφιο κωδικό από το email."
