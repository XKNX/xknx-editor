msgstr "Tällä tuotteella ei ole käyttökelpoista sovellusohjelmaa."

msgid "Added device: {name}"
msgstr "Laite lisätty: {name}"

msgid "Add to project?"
msgstr "Lisätäänkö projektiin?"

msgid "“{name}” was added to the local catalog. Add it to the project now?"
msgstr "”{name}” lisättiin paikalliseen luetteloon. Lisätäänkö se nyt projektiin?"

msgid "Add to Project"
msgstr "Lisää projektiin"

msgid "Not Now"
msgstr "Ei nyt"

msgid "Local"
msgstr "Paikallinen"

msgid "Online"
msgstr "Verkossa"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Tuotteita ei ole vielä tuotu — tuo .knxprod-tiedosto tai käytä Verkossa-välilehteä."

msgid "Fetch {count} Missing Application(s) Online"
msgstr "Hae puuttuvat sovellukset verkosta ({count})"

msgid "Fetching missing applications…"
msgstr "Haetaan puuttuvia sovelluksia…"

msgid "Delete"
msgstr "Poista"

msgid "Delete from Local Catalog"
msgstr "Poista paikallisesta luettelosta"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Haluatko varmasti poistaa valitun laitteen? Tätä ei voi kumota."

msgid "{count} device(s) in the open project use this product. They can't be loaded until the product is imported again."
msgstr "Avoimessa projektissa tätä tuotetta käyttäviä laitteita: {count}. Niitä ei voi ladata ennen kuin tuote tuodaan uudelleen."

msgid "Deleting {name}…"
msgstr "Poistetaan: {name}…"

