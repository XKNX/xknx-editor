msgid "Catalog"
msgstr "Luettelo"

msgid "Failed to load archive"
msgstr "Arkiston lataaminen epäonnistui"

msgid "Loaded: {path}"
msgstr "Ladattu: {path}"

msgid "Fetch Online Catalog"
msgstr "Hae verkkoluettelo"

msgid "Loading manufacturer list…"
msgstr "Ladataan valmistajaluetteloa…"

msgid "Online catalog not reachable"
msgstr "Verkkoluetteloon ei saada yhteyttä"

msgid "Loading products…"
msgstr "Ladataan tuotteita…"

