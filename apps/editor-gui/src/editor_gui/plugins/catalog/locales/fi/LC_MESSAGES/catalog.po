msgstr "Kohteen {name} vienti epäonnistui: {error}"

msgid "No stored archive for {name}"
msgstr "Ei tallennettua arkistoa: {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Tämä laite tukee KNX Data Secure -suojausta. Aseta projektille salasana, jotta laite voidaan ottaa käyttöön suojatusti; ilman salasanaa se lisätään ja otetaan käyttöön salaamattomana."

msgid "Search…"
msgstr "Etsi…"

msgid "Market:"
msgstr "Markkina:"

msgid "All Markets"
msgstr "Kaikki markkinat"

msgid "Only Products in {language}"
msgstr "Vain tuotteet, kieli: {language}"

msgid "{shown} of {total} shown"
msgstr "{shown}/{total} näytetään"

msgid "(estimated)"
msgstr "(arvioitu)"
