msgstr "Ei ladattavia tuotteita"

msgid "Downloading {name}…"
msgstr "Ladataan: {name}…"

msgid "(plugin required)"
msgstr "(laajennus tarvitaan)"

msgid "(in local catalog)"
msgstr "(paikallisessa luettelossa)"

msgid "Search products, order number…"
msgstr "Etsi tuotteita, tilausnumeroa…"

msgid "No Product Index yet - fetch the online catalog to build it"
msgstr "Tuotehakemistoa ei vielä ole – hae verkkoluettelo sen luomiseksi"

msgid "Building Product Index… {done}/{total} manufacturers"
msgstr "Luodaan tuotehakemistoa… {done}/{total} valmistajaa"

msgid "Cancel"
msgstr "Peruuta"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "Hae verkkoluettelo, jotta voit etsiä kaikkien valmistajien tuotteista."

