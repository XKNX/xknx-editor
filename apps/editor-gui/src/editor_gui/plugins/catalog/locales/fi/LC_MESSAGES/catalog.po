msgstr "Lisää Laite"

msgid "Room"
msgstr "Huone"

msgid "(no room)"
msgstr "(ei huonetta)"

msgid "Open or create a project first to add a device."
msgstr "Avaa tai luo ensin projekti, jotta voit lisätä laitteen."

msgid "This product has no usable application program."
msgstr "Tällä tuotteella ei ole käyttökelpoista sovellusohjelmaa."

msgid "Added device: {name}"
msgstr "Laite lisätty: {name}"

msgid "Local"
msgstr "Paikallinen"

msgid "Online"
msgstr "Verkossa"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Tuotteita ei ole vielä tuotu — tuo .knxprod-tiedosto tai käytä Verkossa-välilehteä."

msgid "Fetching missing applications…"
msgstr "Haetaan puuttuvia sovelluksia…"

msgid "Delete"
msgstr "Poista"

msgid "Delete from Local Catalog"
msgstr "Poista paikallisesta luettelosta"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Haluatko varmasti poistaa valitun laitteen? Tätä ei voi kumota."

msgid "Deleting {name}…"
msgstr "Poistetaan: {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Poistettu paikallisesta luettelosta: {name}"

msgid "Export .knxprod…"
msgstr "Vie .knxprod-tiedostona…"

msgid "Export .knxprod"
msgstr "Vie .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "KNX-tuote (*.knxprod)"

msgid "Exported {name}"
msgstr "Viety: {name}"

msgid "Could not export {name}: {error}"
msgstr "Kohteen {name} vienti epäonnistui: {error}"

msgid "No stored archive for {name}"
msgstr "Ei tallennettua arkistoa: {name}"

msgid "The product data of {name} comes from a project without a catalog (Catalog.xml), so it cannot be exported as a .knxprod"
msgstr "Tuotteen {name} tuotetiedot ovat peräisin projektista, jossa ei ole luetteloa (Catalog.xml), joten niitä ei voi viedä .knxprod-tiedostona"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Tämä laite tukee KNX Data Secure -suojausta. Aseta projektille salasana, jotta laite voidaan ottaa käyttöön suojatusti; ilman salasanaa se lisätään ja otetaan käyttöön salaamattomana."

msgid "Search…"
msgstr "Etsi…"

msgid "Market:"
msgstr "Markkina:"

msgid "All Markets"
msgstr "Kaikki markkinat"

msgid "Only Products in {language}"
msgstr "Vain tuotteet, kieli: {language}"

msgid "{shown} of {total} shown"
msgstr "{shown}/{total} näytetään"

msgid "(estimated)"
msgstr "(arvioitu)"

msgid "Line"
msgstr "Linja"

msgid "Automatic"
msgstr "Automaattinen"

msgid "Add to"
msgstr "Lisää"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Automaattinen: laite menee valitun huoneen nykyiselle linjalle, muuten ensimmäiselle TP-linjalle."

msgid "Download to Local Catalog"
msgstr "Lataa paikalliseen luetteloon"

msgid "Filename"
msgstr "Tiedostonimi"

msgid "Mask Version"
msgstr "Maskiversio"

msgid "Size"
msgstr "Koko"

msgid "Updated"
msgstr "Päivitetty"

msgid "Alternative"
msgstr "Vaihtoehtoinen"

msgid "Server URL"
msgstr "Palvelimen URL"

msgid "Username"
msgstr "Käyttäjätunnus"

msgid "Email"
msgstr "Sähköposti"

msgid "Save"
msgstr "Tallenna"

msgid "Register"
msgstr "Rekisteröidy"

msgid "Continue Registration"
msgstr "Jatka rekisteröintiä"

msgid "Verification Code"
msgstr "Vahvistuskoodi"

msgid "Verify Email"
msgstr "Vahvista sähköposti"

msgid "Resend Code"
msgstr "Lähetä koodi uudelleen"

msgid "Open Website"
msgstr "Avaa verkkosivusto"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Kirjautumistiedot tallennetaan tälle tietokoneelle. Jätä salasana tyhjäksi säilyttääksesi sen samalle palvelimelle ja käyttäjälle."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Rekisteröinti lähettää koodin sähköpostitse. Salasana: vähintään 10 merkkiä, iso ja pieni kirjain, numero ja erikoismerkki; enintään 72 UTF-8-tavua."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Viimeistele rekisteröinti antamalla sähköpostin kuusinumeroinen koodi."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "Sähköposti vahvistettu. Lataukset ovat käytettävissä ylläpitäjän hyväksynnän jälkeen."

msgid "Version"
msgstr "Versio"

msgid "Register…"
msgstr "Rekisteröidy…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Kirjautuminen hylättiin: käyttäjätunnus tai salasana on väärä, tai tiliä ei ole vielä hyväksytty."

msgid "Enter your username and password, or register, before downloading."
msgstr "Anna käyttäjätunnuksesi ja salasanasi tai rekisteröidy ennen lataamista."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Päivittäinen latausraja on täynnä. Yritä huomenna uudelleen."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Luettelopalvelin on varattu. Yritä hetken päästä uudelleen."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Anna sähköpostiosoite ja 3–32 merkin käyttäjätunnus, jossa on kirjaimia, numeroita, pisteitä, alaviivoja tai yhdysmerkkejä."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Salasanassa on oltava vähintään 10 merkkiä, isoja ja pieniä kirjaimia, numero ja erikoismerkki."

msgid "Enter the six-digit code from the email."
msgstr "Anna sähköpostin kuusinumeroinen koodi."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Tuotiin {count} tuoteversio. Se löytyy Paikallinen-välilehdeltä."
msgstr[1] "Tuotiin {count} tuoteversiota. Ne löytyvät Paikallinen-välilehdeltä."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "Löytyi {count} sovellus"
msgstr[1] "Löytyi {count} sovellusta"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} ryhmäobjekti)"
msgstr[1] "({count} ryhmäobjektia)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} osuma"
msgstr[1] "{count} osumaa"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Tuotehakemisto ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} valmistaja"
msgstr[1] "{count} valmistajaa"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} tuote"
msgstr[1] "{count} tuotetta"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Näytetään {shown}/{total} osuma – tarkenna hakua"
msgstr[1] "Näytetään {shown}/{total} osumaa – tarkenna hakua"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Hae {count} puuttuva sovellus verkosta"
msgstr[1] "Hae {count} puuttuvaa sovellusta verkosta"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "Avoimessa projektissa {count} laite käyttää tätä tuotetta. Sitä ei voi ladata ennen kuin tuote tuodaan uudelleen."
msgstr[1] "Avoimessa projektissa {count} laitetta käyttää tätä tuotetta. Niitä ei voi ladata ennen kuin tuote tuodaan uudelleen."
