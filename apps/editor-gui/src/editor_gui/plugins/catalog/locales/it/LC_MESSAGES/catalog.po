msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Visualizzati {shown} di {total} risultato - affinare la ricerca"
msgstr[1] "Visualizzati {shown} di {total} risultati - affinare la ricerca"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Recupera online {count} applicazione mancante"
msgstr[1] "Recupera online {count} applicazioni mancanti"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} dispositivo del progetto aperto usa questo prodotto. Non potrà essere caricato finché il prodotto non verrà importato di nuovo."
msgstr[1] "{count} dispositivi del progetto aperto usano questo prodotto. Non potranno essere caricati finché il prodotto non verrà importato di nuovo."
