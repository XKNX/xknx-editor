msgstr "Apri sito web"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Le credenziali sono salvate su questo computer. Lascia vuota la password per mantenerla per lo stesso server e utente."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "La registrazione invia un codice via e-mail. Password: almeno 10 caratteri, maiuscola, minuscola, cifra e carattere speciale; massimo 72 byte UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Inserisci il codice di sei cifre ricevuto via e-mail per completare la registrazione."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail verificata. I download saranno disponibili dopo l’approvazione dell’amministratore."

msgid "Version"
msgstr "Versione"

msgid "Register…"
msgstr "Registrati…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Accesso rifiutato: il nome utente o la password sono errati, oppure l'account non è ancora approvato."

msgid "Enter your username and password, or register, before downloading."
msgstr "Inserisca nome utente e password, oppure si registri, prima di scaricare."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Il limite giornaliero di download è stato raggiunto. Riprovi domani."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Il server del catalogo è occupato. Riprovi tra un momento."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Inserisca un indirizzo e-mail e un nome utente di 3-32 lettere, cifre, punti, trattini bassi o trattini."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "La password richiede almeno 10 caratteri con lettere maiuscole e minuscole, una cifra e un carattere speciale."

msgid "Enter the six-digit code from the email."
msgstr "Inserisca il codice di sei cifre ricevuto via e-mail."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Importata {count} versione di prodotto. È nella scheda Locale."
msgstr[1] "Importate {count} versioni di prodotto. Sono nella scheda Locale."

