msgstr "Hat"

msgid "Automatic"
msgstr "Otomatik"

msgid "Add to"
msgstr "Şuraya Ekle"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Otomatik: cihaz seçilen odanın geçerli linyesine, yoksa ilk TP linyesine eklenir."

msgid "Download to Local Catalog"
msgstr "Yerel Kataloğa İndir"

msgid "Filename"
msgstr "Dosya adı"

msgid "Mask Version"
msgstr "Maske sürümü"

msgid "Size"
msgstr "Boyut"

msgid "Updated"
msgstr "Güncellendi"

msgid "Alternative"
msgstr "Alternatif"

msgid "Server URL"
msgstr "Sunucu URL’si"

msgid "Username"
msgstr "Kullanıcı adı"

msgid "Email"
msgstr "E-posta"

msgid "Save"
msgstr "Kaydet"

msgid "Register"
msgstr "Kayıt ol"

msgid "Continue Registration"
msgstr "Kayda devam et"

msgid "Verification Code"
msgstr "Doğrulama kodu"

msgid "Verify Email"
msgstr "E-postayı doğrula"

msgid "Resend Code"
msgstr "Kodu yeniden gönder"

msgid "Open Website"
msgstr "Web sitesini aç"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Giriş bilgileri bu bilgisayarda saklanır. Aynı sunucu ve kullanıcı için parolayı korumak üzere boş bırakın."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Kayıt işlemi e-postayla kod gönderir. Parola: en az 10 karakter, büyük harf, küçük harf, rakam ve özel karakter; en fazla 72 UTF-8 baytı."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Kaydı tamamlamak için e-postanızdaki altı haneli kodu girin."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-posta doğrulandı. İndirmeler yönetici onayından sonra kullanılabilir."

msgid "Version"
msgstr "Sürüm"

msgid "Register…"
msgstr "Kayıt ol…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Oturum açma reddedildi: kullanıcı adı veya parola yanlış ya da hesap henüz onaylanmadı."

msgid "Enter your username and password, or register, before downloading."
msgstr "İndirmeden önce kullanıcı adınızı ve parolanızı girin veya kaydolun."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Günlük indirme sınırına ulaşıldı. Yarın yeniden deneyin."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Katalog sunucusu meşgul. Biraz sonra yeniden deneyin."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Bir e-posta adresi ve harf, rakam, nokta, alt çizgi veya kısa çizgiden oluşan 3 ila 32 karakterlik bir kullanıcı adı girin."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Parola, büyük ve küçük harf, bir rakam ve bir özel karakter içeren en az 10 karakterden oluşmalıdır."

msgid "Enter the six-digit code from the email."
msgstr "E-postadaki altı haneli kodu girin."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "{count} ürün sürümü içe aktarıldı. Yerel sekmesinde bulabilirsiniz."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "{count} uygulama bulundu"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} grup nesnesi)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} eşleşme"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Ürün Dizini ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} üretici"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} ürün"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "{total} eşleşmeden {shown} tanesi gösteriliyor - aramayı daraltın"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Eksik {count} Uygulamayı Çevrimiçi Getir"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "Açık projedeki {count} cihaz bu ürünü kullanıyor. Ürün yeniden içe aktarılana kadar bu cihazlar yüklenemez."
