msgstr "Eksik uygulamalar getiriliyor…"

msgid "Delete"
msgstr "Sil"

msgid "Delete from Local Catalog"
msgstr "Yerel Katalogdan Sil"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Seçili cihazı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."

msgid "Deleting {name}…"
msgstr "Siliniyor: {name}…"

