msgstr "Dışa aktarıldı: {name}"

msgid "Could not export {name}: {error}"
msgstr "{name} dışa aktarılamadı: {error}"

msgid "No stored archive for {name}"
msgstr "Kayıtlı arşiv yok: {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Bu cihaz KNX Data Secure destekler. Cihazı güvenli şekilde devreye almak için bir proje parolası belirleyin; parola olmadan cihaz eklenir ve şifrelenmeden devreye alınır."

