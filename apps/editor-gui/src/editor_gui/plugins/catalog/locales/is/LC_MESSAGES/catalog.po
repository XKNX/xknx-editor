msgstr "Halda áfram skráningu"

msgid "Verification Code"
msgstr "Staðfestingarkóði"

msgid "Verify Email"
msgstr "Staðfesta netfang"

msgid "Resend Code"
msgstr "Senda kóða aftur"

msgid "Open Website"
msgstr "Opna vefsvæði"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Innskráningarupplýsingar eru vistaðar á þessari tölvu. Skildu lykilorðið eftir autt til að halda því fyrir sama þjón og notanda."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Við skráningu er kóði sendur í tölvupósti. Lykilorð: minnst 10 stafir, hástafur, lágstafur, tölustafur og sértákn; mest 72 UTF-8-bæti."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Sláðu inn sex stafa tölukóðann úr tölvupóstinum til að ljúka skráningu."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "Netfang staðfest. Niðurhal verður tiltækt eftir samþykki kerfisstjóra."

msgid "Version"
msgstr "Útgáfa"

msgid "Register…"
msgstr "Nýskráning…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Innskráningu var hafnað: notandanafn eða lykilorð er rangt, eða aðgangurinn hefur ekki enn verið samþykktur."

msgid "Enter your username and password, or register, before downloading."
msgstr "Sláðu inn notandanafn og lykilorð, eða skráðu þig, áður en þú sækir."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Daglegu niðurhalshámarki er náð. Reyndu aftur á morgun."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Vörulistaþjónninn er upptekinn. Reyndu aftur eftir smástund."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Sláðu inn netfang og notandanafn með 3 til 32 bókstöfum, tölustöfum, punktum, undirstrikum eða bandstrikum."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Lykilorðið þarf að minnsta kosti 10 stafi með há- og lágstöfum, tölustaf og sérstaf."

msgid "Enter the six-digit code from the email."
msgstr "Sláðu inn sex stafa kóðann úr tölvupóstinum."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "{count} vöruútgáfa flutt inn. Hún er á flipanum Staðbundið."
msgstr[1] "{count} vöruútgáfur fluttar inn. Þær eru á flipanum Staðbundið."

