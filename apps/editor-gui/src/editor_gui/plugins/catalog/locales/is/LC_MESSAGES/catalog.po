msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Sýnir {shown} af {total} niðurstöðu - þrengdu leitina"
msgstr[1] "Sýnir {shown} af {total} niðurstöðum - þrengdu leitina"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Sækja {count} verkforrit sem vantar á netinu"
msgstr[1] "Sækja {count} verkforrit sem vantar á netinu"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} tæki í opna verkefninu notar þessa vöru. Ekki er hægt að hlaða því fyrr en varan hefur verið flutt inn aftur."
msgstr[1] "{count} tæki í opna verkefninu nota þessa vöru. Ekki er hægt að hlaða þeim fyrr en varan hefur verið flutt inn aftur."
