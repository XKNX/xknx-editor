msgstr "已加载：{path}"

msgid "Found {count} application(s)"
msgstr "找到 {count} 个应用"

msgid "({count} group objects)"
msgstr "（{count} 个组对象）"

msgid "Fetch Online Catalog"
msgstr "获取在线产品目录"

msgid "Loading manufacturer list…"
msgstr "正在加载厂家列表…"

msgid "Online catalog not reachable"
msgstr "无法访问在线产品目录"

msgid "{count} matches"
msgstr "{count} 个匹配项"

msgid "Loading products…"
msgstr "正在加载产品…"

msgid "No downloadable products"
msgstr "没有可下载的产品"

msgid "Downloading {name}…"
msgstr "正在下载 {name}…"

msgid "(plugin required)"
msgstr "（需要插件）"

msgid "(in local catalog)"
msgstr "（在本地产品目录中）"

msgid "Search products, order number…"
msgstr "搜索产品、订货号…"

