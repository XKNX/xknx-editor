msgstr "产品索引（{date}）：{mfrs} 个厂家，{products} 个产品"

msgid "No Product Index yet - fetch the online catalog to build it"
msgstr "尚无产品索引——获取在线产品目录以建立索引"

msgid "Building Product Index… {done}/{total} manufacturers"
msgstr "正在建立产品索引… {done}/{total} 个厂家"

msgid "Cancel"
msgstr "取消"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "获取在线产品目录，以便在所有厂家中搜索。"

msgid "Showing {shown} of {total} matches - refine the search"
msgstr "显示 {total} 个匹配项中的 {shown} 个——请细化搜索"

