msgstr "程序版本"

msgid "Application ID"
msgstr "应用 ID"

msgid "DIN Rail Mounting"
msgstr "DIN 导轨安装"

msgid "Bus Current"
msgstr "总线电流"

msgid "Yes"
msgstr "是"

msgid "No"
msgstr "否"

msgid "Product Ref"
msgstr "产品引用"

msgid "Add Device"
msgstr "添加设备"

msgid "Room"
msgstr "房间"

msgid "(no room)"
msgstr "（无房间）"

msgid "Open or create a project first to add a device."
msgstr "请先打开或创建项目，然后再添加设备。"

msgid "This product has no usable application program."
msgstr "此产品没有可用的应用程序。"

msgid "Added device: {name}"
msgstr "已添加设备：{name}"

msgid "Local"
msgstr "本地"

msgid "Online"
msgstr "在线"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "尚未导入任何产品——请导入 .knxprod 或使用“在线”选项卡。"

msgid "Fetch {count} Missing Application(s) Online"
msgstr "在线获取 {count} 个缺失的应用"

msgid "Fetching missing applications…"
msgstr "正在获取缺失的应用…"

msgid "Delete"
msgstr "删除"

msgid "Delete from Local Catalog"
msgstr "从本地产品目录删除"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "确定要删除所选设备吗？此操作无法撤消。"

msgid "{count} device(s) in the open project use this product. They can't be loaded until the product is imported again."
msgstr "打开的项目中有 {count} 个设备使用此产品。在重新导入该产品之前，这些设备无法加载。"

msgid "Deleting {name}…"
msgstr "正在删除 {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "已从本地产品目录删除：{name}"

msgid "Export .knxprod…"
msgstr "导出 .knxprod…"

msgid "Export .knxprod"
msgstr "导出 .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "KNX 产品 (*.knxprod)"

msgid "Exported {name}"
msgstr "已导出 {name}"

msgid "Could not export {name}: {error}"
msgstr "无法导出 {name}：{error}"

msgid "No stored archive for {name}"
msgstr "没有 {name} 的已存储归档"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "此设备支持 KNX Data Secure。请设置项目密码以进行安全调试；如不设置，设备将以非加密方式添加和调试。"

msgid "Search…"
msgstr "搜索…"

msgid "Market:"
msgstr "市场："

msgid "All Markets"
msgstr "所有市场"

msgid "Only Products in {language}"
msgstr "仅限{language}产品"

msgid "{shown} of {total} shown"
msgstr "显示 {total} 个中的 {shown} 个"

msgid "(estimated)"
msgstr "（估计的）"

msgid "Line"
msgstr "线路"

msgid "Automatic"
msgstr "自动"

msgid "Add to"
msgstr "添加到"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "自动：设备放在所选房间的当前支线上，没有时放在第一条 TP 线路上。"

msgid "Download to Local Catalog"
msgstr "下载到本地目录"

msgid "Filename"
msgstr "文件名"

msgid "Mask Version"
msgstr "掩码版本"

msgid "Size"
msgstr "大小"

msgid "Updated"
msgstr "更新时间"

msgid "Alternative"
msgstr "备用目录"

msgid "Server URL"
msgstr "服务器 URL"

msgid "Username"
msgstr "用户名"

msgid "Email"
msgstr "电子邮件"

msgid "Save"
msgstr "保存"

msgid "Register"
msgstr "注册"

msgid "Continue Registration"
msgstr "继续注册"

msgid "Verification Code"
msgstr "验证码"

msgid "Verify Email"
msgstr "验证邮箱"

msgid "Resend Code"
msgstr "重新发送验证码"

msgid "Open Website"
msgstr "打开网站"

msgid "Imported {count} product versions. Find them in the Local tab."
msgstr "已导入 {count} 个产品版本。请在“本地”选项卡中查看。"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "登录信息保存在此计算机上。如服务器和用户不变，可将密码留空以保留原密码。"

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "注册时会通过电子邮件发送验证码。密码至少包含 10 个字符，须有大写字母、小写字母、数字及特殊字符；最多 72 个 UTF-8 字节。"

msgid "Enter the six-digit code from your email to complete registration."
msgstr "输入邮件中的六位数字验证码以完成注册。"

msgid "Email verified. Downloads become available after administrator approval."
msgstr "邮箱已验证。管理员批准后即可下载。"

msgid "Version"
msgstr "版本"

msgid "Register…"
msgstr "注册…"
msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "登录被拒绝：用户名或密码错误，或者账户尚未获批。"

msgid "Enter your username and password, or register, before downloading."
msgstr "下载前请输入用户名和密码，或先注册。"

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "已达到每日下载上限。请明天再试。"

msgid "The catalog server is busy. Try again in a moment."
msgstr "目录服务器繁忙。请稍后再试。"

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "请输入电子邮件地址和由 3 到 32 个字母、数字、点、下划线或连字符组成的用户名。"

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "密码至少需要 10 个字符，包含大小写字母、一个数字和一个特殊字符。"

msgid "Enter the six-digit code from the email."
msgstr "请输入电子邮件中的六位数代码。"
