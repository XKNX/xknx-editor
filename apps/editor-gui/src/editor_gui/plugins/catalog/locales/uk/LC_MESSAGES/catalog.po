msgid "Catalog"
msgstr "Каталог"

msgid "Failed to load archive"
msgstr "Не вдалося завантажити архів"

msgid "Loaded: {path}"
msgstr "Завантажено: {path}"

msgid "Fetch Online Catalog"
msgstr "Отримати онлайн-каталог"

msgid "Loading manufacturer list…"
msgstr "Завантаження списку виробників…"

msgid "Online catalog not reachable"
msgstr "Онлайн-каталог недоступний"

msgid "Loading products…"
msgstr "Завантаження продуктів…"

msgid "No downloadable products"
msgstr "Немає продуктів для завантаження"

msgid "Downloading {name}…"
msgstr "Завантаження {name}…"

msgid "(plugin required)"
msgstr "(потрібен плагін)"

msgid "(in local catalog)"
msgstr "(у локальному каталозі)"

msgid "Search products, order number…"
msgstr "Пошук продуктів, номера для замовлення…"

msgid "No Product Index yet - fetch the online catalog to build it"
msgstr "Індексу продуктів ще немає - отримайте онлайн-каталог, щоб створити його"

msgid "Building Product Index… {done}/{total} manufacturers"
msgstr "Створення індексу продуктів… {done}/{total} виробників"

msgid "Cancel"
msgstr "Скасувати"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "Отримайте онлайн-каталог, щоб шукати серед усіх виробників."

msgid "Product Details"
msgstr "Відомості про продукт"

msgid "Name"
msgstr "Ім'я"

msgid "Order Number"
msgstr "Номер для замовлення"

msgid "Manufacturer"
msgstr "Виробник"

msgid "Application"
msgstr "Додаток"

msgid "Program Version"
msgstr "Версія програми"

msgid "Application ID"
msgstr "ID прикладної програми"

msgid "DIN Rail Mounting"
msgstr "Монтаж на DIN-рейку"

msgid "Bus Current"
msgstr "Струм шини"

msgid "Yes"
msgstr "Так"

msgid "No"
msgstr "Ні"

msgid "Product Ref"
msgstr "Посилання на продукт"

msgid "Add Device"
msgstr "Додати пристрій"

msgid "Room"
msgstr "Кімната"

msgid "(no room)"
msgstr "(без кімнати)"

msgid "Open or create a project first to add a device."
msgstr "Щоб додати пристрій, спочатку відкрийте або створіть проєкт."

msgid "This product has no usable application program."
msgstr "Цей продукт не має придатної прикладної програми."

msgid "Added device: {name}"
msgstr "Додано пристрій: {name}"

msgid "Local"
msgstr "Локальний"

msgid "Online"
msgstr "Онлайн"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Продуктів ще не імпортовано — імпортуйте .knxprod або скористайтеся вкладкою «Онлайн»."

msgid "Fetching missing applications…"
msgstr "Отримання відсутніх прикладних програм…"

msgid "Delete"
msgstr "Видалити"

msgid "Delete from Local Catalog"
msgstr "Видалити з локального каталогу"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Видалити вибраний пристрій? Цю дію неможливо скасувати."

msgid "Deleting {name}…"
msgstr "Видалення {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Видалено з локального каталогу: {name}"

msgid "Export .knxprod…"
msgstr "Експортувати .knxprod…"

msgid "Export .knxprod"
msgstr "Експортувати .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Продукт KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "Експортовано {name}"

msgid "Could not export {name}: {error}"
msgstr "Не вдалося експортувати {name}: {error}"

msgid "No stored archive for {name}"
msgstr "Немає збереженого архіву для {name}"

msgid "The product data of {name} comes from a project without a catalog (Catalog.xml), so it cannot be exported as a .knxprod"
msgstr "Дані продукту {name} походять із проєкту без каталогу (Catalog.xml), тому їх не можна експортувати як .knxprod"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Цей пристрій підтримує KNX Data Secure. Задайте пароль проєкту, щоб виконати захищене налагодження; без пароля його буде додано й налагоджено без шифрування."

msgid "Search…"
msgstr "Пошук…"

msgid "Market:"
msgstr "Ринок:"

msgid "All Markets"
msgstr "Усі ринки"

msgid "Only Products in {language}"
msgstr "Лише продукти мовою: {language}"

msgid "{shown} of {total} shown"
msgstr "Показано {shown} з {total}"

msgid "(estimated)"
msgstr "(за оцінками)"

msgid "Line"
msgstr "Лінія"

msgid "Automatic"
msgstr "Автоматично"

msgid "Add to"
msgstr "Додати до"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Автоматично: пристрій потрапляє на поточну лінію вибраного приміщення, інакше на першу лінію TP."

msgid "Download to Local Catalog"
msgstr "Завантажити до локального каталогу"

msgid "Filename"
msgstr "Ім’я файлу"

msgid "Mask Version"
msgstr "Версія маски"

msgid "Size"
msgstr "Розмір"

msgid "Updated"
msgstr "Оновлено"

msgid "Alternative"
msgstr "Альтернативний"

msgid "Server URL"
msgstr "URL сервера"

msgid "Username"
msgstr "Ім’я користувача"

msgid "Email"
msgstr "Електронна пошта"

msgid "Save"
msgstr "Зберегти"

msgid "Register"
msgstr "Реєстрація"

msgid "Continue Registration"
msgstr "Продовжити реєстрацію"

msgid "Verification Code"
msgstr "Код підтвердження"

msgid "Verify Email"
msgstr "Підтвердити пошту"

msgid "Resend Code"
msgstr "Надіслати код повторно"

msgid "Open Website"
msgstr "Відкрити сайт"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Дані входу зберігаються на цьому комп’ютері. Залиште пароль порожнім, щоб зберегти його для того самого сервера й користувача."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Під час реєстрації код надсилається поштою. Пароль: щонайменше 10 символів, велика й мала літери, цифра та спеціальний символ; не більше 72 байтів UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Введіть шестизначний код із листа, щоб завершити реєстрацію."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "Пошту підтверджено. Завантаження стануть доступні після схвалення адміністратора."

msgid "Version"
msgstr "Версія"

msgid "Register…"
msgstr "Реєстрація…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Вхід відхилено: неправильне ім'я користувача або пароль, або обліковий запис ще не схвалено."

msgid "Enter your username and password, or register, before downloading."
msgstr "Перед завантаженням введіть ім'я користувача та пароль або зареєструйтеся."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Досягнуто денного ліміту завантажень. Спробуйте знову завтра."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Сервер каталогу зайнятий. Спробуйте знову за хвилину."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Введіть адресу електронної пошти та ім'я користувача з 3–32 літер, цифр, крапок, підкреслень або дефісів."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Пароль має містити щонайменше 10 символів, великі й малі літери, цифру та спеціальний символ."

msgid "Enter the six-digit code from the email."
msgstr "Введіть шестизначний код із листа."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Імпортовано {count} версію продукту. Вона на вкладці «Локальні»."
msgstr[1] "Імпортовано {count} версії продуктів. Вони на вкладці «Локальні»."
msgstr[2] "Імпортовано {count} версій продуктів. Вони на вкладці «Локальні»."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "Знайдено {count} прикладну програму"
msgstr[1] "Знайдено {count} прикладні програми"
msgstr[2] "Знайдено {count} прикладних програм"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} груповий об'єкт)"
msgstr[1] "({count} групові об'єкти)"
msgstr[2] "({count} групових об'єктів)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} збіг"
msgstr[1] "{count} збіги"
msgstr[2] "{count} збігів"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Індекс продуктів ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} виробник"
msgstr[1] "{count} виробники"
msgstr[2] "{count} виробників"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} продукт"
msgstr[1] "{count} продукти"
msgstr[2] "{count} продуктів"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Показано {shown} з {total} збігу - уточніть пошук"
msgstr[1] "Показано {shown} з {total} збігів - уточніть пошук"
msgstr[2] "Показано {shown} з {total} збігів - уточніть пошук"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Отримати онлайн {count} відсутню прикладну програму"
msgstr[1] "Отримати онлайн {count} відсутні прикладні програми"
msgstr[2] "Отримати онлайн {count} відсутніх прикладних програм"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} пристрій у відкритому проєкті використовує цей продукт. Його неможливо завантажити, доки продукт не буде імпортовано знову."
msgstr[1] "{count} пристрої у відкритому проєкті використовують цей продукт. Їх неможливо завантажити, доки продукт не буде імпортовано знову."
msgstr[2] "{count} пристроїв у відкритому проєкті використовують цей продукт. Їх неможливо завантажити, доки продукт не буде імпортовано знову."
