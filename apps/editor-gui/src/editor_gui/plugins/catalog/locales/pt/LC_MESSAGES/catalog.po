msgstr "Guardar"

msgid "Register"
msgstr "Registar"

msgid "Continue Registration"
msgstr "Continuar registo"

msgid "Verification Code"
msgstr "Código de verificação"

msgid "Verify Email"
msgstr "Verificar e-mail"

msgid "Resend Code"
msgstr "Reenviar código"

msgid "Open Website"
msgstr "Abrir site"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "As credenciais são guardadas neste computador. Deixe a palavra-passe vazia para a manter para o mesmo servidor e utilizador."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "O registo envia um código por e-mail. Palavra-passe: pelo menos 10 caracteres, maiúscula, minúscula, algarismo e carácter especial; máximo de 72 bytes UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Introduza o código de seis dígitos do e-mail para concluir o registo."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail verificado. As transferências ficam disponíveis após aprovação do administrador."

msgid "Version"
msgstr "Versão"

msgid "Register…"
msgstr "Registar…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "O início de sessão foi recusado: o nome de utilizador ou a palavra-passe está errado, ou a conta ainda não foi aprovada."

msgid "Enter your username and password, or register, before downloading."
msgstr "Introduza o seu nome de utilizador e palavra-passe, ou registe-se, antes de transferir."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "O limite diário de transferências foi atingido. Tente novamente amanhã."

msgid "The catalog server is busy. Try again in a moment."
msgstr "O servidor do catálogo está ocupado. Tente novamente dentro de momentos."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Introduza um endereço de e-mail e um nome de utilizador com 3 a 32 letras, dígitos, pontos, sublinhados ou hífenes."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "A palavra-passe precisa de pelo menos 10 caracteres com maiúsculas e minúsculas, um dígito e um caráter especial."

msgid "Enter the six-digit code from the email."
msgstr "Introduza o código de seis dígitos do e-mail."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Importada {count} versão de produto. Está no separador Local."
msgstr[1] "Importadas {count} versões de produto. Estão no separador Local."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "{count} aplicação encontrada"
msgstr[1] "{count} aplicações encontradas"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} objeto de grupo)"
msgstr[1] "({count} objetos de grupo)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} resultado"
msgstr[1] "{count} resultados"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Índice de Produtos ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} fabricante"
msgstr[1] "{count} fabricantes"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} produto"
msgstr[1] "{count} produtos"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "A mostrar {shown} de {total} resultado - refine a pesquisa"
msgstr[1] "A mostrar {shown} de {total} resultados - refine a pesquisa"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Obter {count} Aplicação em Falta Online"
msgstr[1] "Obter {count} Aplicações em Falta Online"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} dispositivo no projeto aberto utiliza este produto. Só poderá ser carregado depois de o produto ser importado novamente."
msgstr[1] "{count} dispositivos no projeto aberto utilizam este produto. Só poderão ser carregados depois de o produto ser importado novamente."
