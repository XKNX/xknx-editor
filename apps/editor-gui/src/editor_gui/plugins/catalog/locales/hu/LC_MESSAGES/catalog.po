msgstr "Online"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Még nincs importált termék – importáljon egy .knxprod fájlt, vagy használja az Online lapot."

msgid "Program Version"
msgstr "Programverzió"

msgid "Search products, order number…"
msgstr "Termékek, rendelési szám keresése…"

msgid "No Product Index yet - fetch the online catalog to build it"
msgstr "Még nincs termékindex – a létrehozásához kérje le az online katalógust"

msgid "Building Product Index… {done}/{total} manufacturers"
msgstr "Termékindex létrehozása… {done}/{total} gyártó"

msgid "Cancel"
msgstr "Mégse"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "Kérje le az online katalógust, hogy minden gyártó termékei között kereshessen."

msgid "(in local catalog)"
msgstr "(a helyi katalógusban)"

msgid "Open or create a project first to add a device."
msgstr "Készülék hozzáadásához előbb nyisson meg vagy hozzon létre egy projektet."

msgid "This product has no usable application program."
msgstr "Ennek a terméknek nincs használható alkalmazási programja."

msgid "Added device: {name}"
msgstr "Készülék hozzáadva: {name}"

msgid "Delete"
msgstr "Törlés"

msgid "Delete from Local Catalog"
msgstr "Törlés a helyi katalógusból"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Biztosan törli a kijelölt készüléket? Ez nem vonható vissza."

msgid "Deleting {name}…"
msgstr "Törlés: {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Törölve a helyi katalógusból: {name}"

msgid "Application ID"
msgstr "Alkalmazásazonosító"

msgid "DIN Rail Mounting"
msgstr "Kalapsínre szerelhető"

msgid "Bus Current"
msgstr "Buszáram"

msgid "Yes"
msgstr "Igen"

msgid "No"
msgstr "Nem"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Ez a készülék támogatja a KNX Data Secure-t. Állítson be projektjelszót a biztonságos üzembe helyezéshez; jelszó nélkül a készülék titkosítás nélkül kerül hozzáadásra és üzembe helyezésre."

msgid "Search…"
msgstr "Keresés…"

msgid "Export .knxprod…"
msgstr "Exportálás .knxprod fájlként…"

msgid "Export .knxprod"
msgstr "Exportálás .knxprod fájlként"

msgid "KNX product (*.knxprod)"
msgstr "KNX-termék (*.knxprod)"

msgid "Exported {name}"
msgstr "Exportálva: {name}"

msgid "Could not export {name}: {error}"
msgstr "Nem sikerült exportálni: {name}. Hiba: {error}"

msgid "No stored archive for {name}"
msgstr "Nincs tárolt archívum: {name}"

msgid "Market:"
msgstr "Piac:"

msgid "All Markets"
msgstr "Minden piac"

msgid "Only Products in {language}"
msgstr "Csak a következő nyelvű termékek: {language}"

msgid "{shown} of {total} shown"
msgstr "{shown}/{total} látható"

msgid "(estimated)"
msgstr "(becsült)"

msgid "Line"
msgstr "Vonal"

msgid "Automatic"
msgstr "Automatikus"

msgid "Add to"
msgstr "Hozzáadás ide"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Automatikus: a készülék a kiválasztott helyiség aktuális vonalára kerül, ha nincs ilyen, akkor az első TP-vonalra."

msgid "Download to Local Catalog"
msgstr "Letöltés a helyi katalógusba"

msgid "Filename"
msgstr "Fájlnév"

msgid "Mask Version"
msgstr "Maszkverzió"

msgid "Size"
msgstr "Méret"

msgid "Updated"
msgstr "Frissítve"

msgid "Alternative"
msgstr "Alternatív"

msgid "Server URL"
msgstr "Kiszolgáló URL-je"

msgid "Username"
msgstr "Felhasználónév"

msgid "Email"
msgstr "E-mail"

msgid "Save"
msgstr "Mentés"

msgid "Register"
msgstr "Regisztráció"

msgid "Continue Registration"
msgstr "Regisztráció folytatása"

msgid "Verification Code"
msgstr "Ellenőrző kód"

msgid "Verify Email"
msgstr "E-mail megerősítése"

msgid "Resend Code"
msgstr "Kód újraküldése"

msgid "Open Website"
msgstr "Webhely megnyitása"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "A bejelentkezési adatok ezen a számítógépen tárolódnak. Hagyja üresen a jelszót, hogy megmaradjon ugyanahhoz a kiszolgálóhoz és felhasználóhoz."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "A regisztráció kódot küld e-mailben. Jelszó: legalább 10 karakter, nagybetű, kisbetű, számjegy és különleges karakter; legfeljebb 72 UTF-8-bájt."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "A regisztráció befejezéséhez adja meg az e-mailben kapott hatjegyű kódot."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail megerősítve. A letöltések a rendszergazda jóváhagyása után érhetők el."

msgid "Version"
msgstr "Verzió"

msgid "Register…"
msgstr "Regisztráció…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "A bejelentkezés elutasítva: a felhasználónév vagy a jelszó hibás, vagy a fiók még nincs jóváhagyva."

msgid "Enter your username and password, or register, before downloading."
msgstr "Letöltés előtt adja meg a felhasználónevét és a jelszavát, vagy regisztráljon."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Elérte a napi letöltési korlátot. Próbálja újra holnap."

msgid "The catalog server is busy. Try again in a moment."
msgstr "A katalógusszerver foglalt. Próbálja újra egy kis idő múlva."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Adjon meg egy e-mail-címet és egy 3–32 karakteres felhasználónevet betűkből, számjegyekből, pontokból, aláhúzásokból vagy kötőjelekből."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "A jelszónak legalább 10 karakterből kell állnia, kis- és nagybetűvel, számjeggyel és különleges karakterrel."

msgid "Enter the six-digit code from the email."
msgstr "Adja meg az e-mailben kapott hatjegyű kódot."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "{count} termékverzió importálva. A Helyi lapon találhatók."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "{count} alkalmazás található"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} kommunikációs objektum)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} találat"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Termékindex ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} gyártó"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} termék"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "{shown}/{total} találat látható – pontosítsa a keresést"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "{count} hiányzó alkalmazás lekérése online"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "A megnyitott projektben {count} készülék használja ezt a terméket. Ezek csak a termék újbóli importálása után tölthetők be."
