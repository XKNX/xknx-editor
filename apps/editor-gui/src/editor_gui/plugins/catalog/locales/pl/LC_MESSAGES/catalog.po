msgstr "Dodano urządzenie: {name}"

msgid "Local"
msgstr "Lokalny"

msgid "Online"
msgstr "Online"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Nie zaimportowano jeszcze żadnych produktów — należy zaimportować plik .knxprod lub użyć karty Online."

msgid "Fetch {count} Missing Application(s) Online"
msgstr "Pobierz brakujące aplikacje online ({count})"

