msgstr "Nazwa użytkownika"

msgid "Email"
msgstr "E-mail"

msgid "Save"
msgstr "Zapisz"

msgid "Register"
msgstr "Zarejestruj"

msgid "Continue Registration"
msgstr "Kontynuuj rejestrację"

msgid "Verification Code"
msgstr "Kod weryfikacyjny"

msgid "Verify Email"
msgstr "Zweryfikuj e-mail"

msgid "Resend Code"
msgstr "Wyślij kod ponownie"

msgid "Open Website"
msgstr "Otwórz witrynę"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Dane logowania są zapisywane na tym komputerze. Pozostaw hasło puste, aby zachować je dla tego samego serwera i użytkownika."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Rejestracja wysyła kod e-mailem. Hasło: co najmniej 10 znaków, wielka i mała litera, cyfra i znak specjalny; maksymalnie 72 bajty UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Wpisz sześciocyfrowy kod z e-maila, aby dokończyć rejestrację."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail zweryfikowany. Pobieranie będzie dostępne po zatwierdzeniu przez administratora."

msgid "Version"
msgstr "Wersja"

msgid "Register…"
msgstr "Zarejestruj…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Logowanie odrzucone: nazwa użytkownika lub hasło są błędne albo konto nie zostało jeszcze zatwierdzone."

msgid "Enter your username and password, or register, before downloading."
msgstr "Przed pobieraniem wprowadź nazwę użytkownika i hasło albo zarejestruj się."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Osiągnięto dzienny limit pobrań. Spróbuj ponownie jutro."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Serwer katalogu jest zajęty. Spróbuj ponownie za chwilę."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Wprowadź adres e-mail i nazwę użytkownika z 3 do 32 liter, cyfr, kropek, podkreśleń lub łączników."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Hasło musi mieć co najmniej 10 znaków, wielkie i małe litery, cyfrę oraz znak specjalny."

msgid "Enter the six-digit code from the email."
msgstr "Wprowadź sześciocyfrowy kod z wiadomości e-mail."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Zaimportowano {count} wersję produktu. Znajdziesz ją na karcie Lokalne."
msgstr[1] "Zaimportowano {count} wersje produktów. Znajdziesz je na karcie Lokalne."
msgstr[2] "Zaimportowano {count} wersji produktów. Znajdziesz je na karcie Lokalne."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "Znaleziono {count} aplikację"
msgstr[1] "Znaleziono {count} aplikacje"
msgstr[2] "Znaleziono {count} aplikacji"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} obiekt grupy)"
msgstr[1] "({count} obiekty grupy)"
msgstr[2] "({count} obiektów grupy)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} trafienie"
msgstr[1] "{count} trafienia"
msgstr[2] "{count} trafień"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Indeks produktów ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} producent"
msgstr[1] "{count} producenci"
msgstr[2] "{count} producentów"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} produkt"
msgstr[1] "{count} produkty"
msgstr[2] "{count} produktów"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Wyświetlono {shown} z {total} trafienia - należy zawęzić wyszukiwanie"
msgstr[1] "Wyświetlono {shown} z {total} trafień - należy zawęzić wyszukiwanie"
msgstr[2] "Wyświetlono {shown} z {total} trafień - należy zawęzić wyszukiwanie"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Pobierz online {count} brakującą aplikację"
msgstr[1] "Pobierz online {count} brakujące aplikacje"
msgstr[2] "Pobierz online {count} brakujących aplikacji"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} urządzenie w otwartym projekcie używa tego produktu. Nie można go załadować, dopóki produkt nie zostanie ponownie zaimportowany."
msgstr[1] "{count} urządzenia w otwartym projekcie używają tego produktu. Nie można ich załadować, dopóki produkt nie zostanie ponownie zaimportowany."
msgstr[2] "{count} urządzeń w otwartym projekcie używa tego produktu. Nie można ich załadować, dopóki produkt nie zostanie ponownie zaimportowany."
