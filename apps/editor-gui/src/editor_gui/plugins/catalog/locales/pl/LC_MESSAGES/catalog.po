msgstr "Znalezione aplikacje: {count}"

msgid "({count} group objects)"
msgstr "(obiekty grupy: {count})"

msgid "Fetch Online Catalog"
msgstr "Pobierz katalog online"

msgid "Loading manufacturer list…"
msgstr "Ładowanie listy producentów…"

