msgstr "Pobieranie brakujących aplikacji…"

msgid "Delete"
msgstr "Usuń"

msgid "Delete from Local Catalog"
msgstr "Usuń z katalogu lokalnego"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Czy na pewno usunąć wybrane urządzenie? Tej operacji nie można cofnąć."

msgid "Deleting {name}…"
msgstr "Usuwanie {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Usunięto z katalogu lokalnego: {name}"

msgid "Export .knxprod…"
msgstr "Eksportuj .knxprod…"

msgid "Export .knxprod"
msgstr "Eksport .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Produkt KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "Wyeksportowano {name}"

msgid "Could not export {name}: {error}"
msgstr "Nie można wyeksportować {name}: {error}"

msgid "No stored archive for {name}"
msgstr "Brak zapisanego archiwum dla {name}"

msgid "The product data of {name} comes from a project without a catalog (Catalog.xml), so it cannot be exported as a .knxprod"
msgstr "Dane produktu {name} pochodzą z projektu bez katalogu (Catalog.xml), dlatego nie można ich wyeksportować jako .knxprod"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "To urządzenie obsługuje KNX Data Secure. Aby uruchomić je w trybie bezpiecznym, należy ustawić hasło projektu; bez hasła zostanie dodane i uruchomione bez szyfrowania."

msgid "Search…"
msgstr "Szukaj…"

