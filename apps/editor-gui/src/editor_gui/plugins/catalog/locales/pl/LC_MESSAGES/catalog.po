msgstr "Wyświetlono {shown} z {total}"

msgid "(estimated)"
msgstr "(szacowane)"

msgid "Line"
msgstr "Linia"

msgid "Automatic"
msgstr "Automatycznie"

msgid "Add to"
msgstr "Dodaj do"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Automatycznie: urządzenie trafia na linię aktywną wybranego pomieszczenia, a bez niej na pierwszą linię TP."

msgid "Download to Local Catalog"
msgstr "Pobierz do katalogu lokalnego"

msgid "Filename"
msgstr "Nazwa pliku"

msgid "Mask Version"
msgstr "Wersja maski"

