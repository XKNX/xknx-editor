msgid "Open or create a project first to add a device."
msgstr "Aby dodać urządzenie, należy najpierw otworzyć lub utworzyć projekt."

msgid "This product has no usable application program."
msgstr "Ten produkt nie ma programu aplikacyjnego, którego można użyć."

