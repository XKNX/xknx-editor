msgstr "Aby dodać urządzenie, należy najpierw otworzyć lub utworzyć projekt."

msgid "This product has no usable application program."
msgstr "Ten produkt nie ma programu aplikacyjnego, którego można użyć."

msgid "Added device: {name}"
msgstr "Dodano urządzenie: {name}"

msgid "Add to project?"
msgstr "Dodać do projektu?"

msgid "“{name}” was added to the local catalog. Add it to the project now?"
msgstr "„{name}” dodano do katalogu lokalnego. Dodać go teraz do projektu?"

msgid "Add to Project"
msgstr "Dodaj do projektu"

msgid "Not Now"
msgstr "Nie teraz"

msgid "Local"
msgstr "Lokalny"

msgid "Online"
msgstr "Online"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Nie zaimportowano jeszcze żadnych produktów — należy zaimportować plik .knxprod lub użyć karty Online."

msgid "Fetch {count} Missing Application(s) Online"
msgstr "Pobierz brakujące aplikacje online ({count})"

msgid "Fetching missing applications…"
msgstr "Pobieranie brakujących aplikacji…"

msgid "Delete"
msgstr "Usuń"

msgid "Delete from Local Catalog"
msgstr "Usuń z katalogu lokalnego"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Czy na pewno usunąć wybrane urządzenie? Tej operacji nie można cofnąć."

msgid "{count} device(s) in the open project use this product. They can't be loaded until the product is imported again."
msgstr "Urządzenia w otwartym projekcie, które używają tego produktu: {count}. Nie można ich załadować, dopóki produkt nie zostanie ponownie zaimportowany."

msgid "Deleting {name}…"
msgstr "Usuwanie {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Usunięto z katalogu lokalnego: {name}"

msgid "Export .knxprod…"
msgstr "Eksportuj .knxprod…"

msgid "Export .knxprod"
msgstr "Eksport .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Produkt KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "Wyeksportowano {name}"

msgid "Could not export {name}: {error}"
msgstr "Nie można wyeksportować {name}: {error}"

msgid "No stored archive for {name}"
msgstr "Brak zapisanego archiwum dla {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "To urządzenie obsługuje KNX Data Secure. Aby uruchomić je w trybie bezpiecznym, należy ustawić hasło projektu; bez hasła zostanie dodane i uruchomione bez szyfrowania."

msgid "Search…"
msgstr "Szukaj…"

msgid "Market:"
msgstr "Rynek:"

msgid "All Markets"
msgstr "Wszystkie rynki"

msgid "Only Products in {language}"
msgstr "Tylko produkty w języku: {language}"

msgid "{shown} of {total} products shown"
msgstr "Wyświetlono {shown} z {total} produktów"
