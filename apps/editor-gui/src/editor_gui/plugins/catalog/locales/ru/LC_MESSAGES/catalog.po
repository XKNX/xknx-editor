msgstr "(без комнаты)"

msgid "Open or create a project first to add a device."
msgstr "Чтобы добавить устройство, сначала откройте или создайте проект."

msgid "This product has no usable application program."
msgstr "У этого продукта нет пригодной прикладной программы."

msgid "Added device: {name}"
msgstr "Устройство добавлено: {name}"

msgid "Local"
msgstr "Локальный"

msgid "Online"
msgstr "Онлайн"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Продукты ещё не импортированы — импортируйте файл .knxprod или используйте вкладку «Онлайн»."

msgid "Fetch {count} Missing Application(s) Online"
msgstr "Получить онлайн недостающие прикладные программы ({count})"

msgid "Fetching missing applications…"
msgstr "Получение недостающих прикладных программ…"

msgid "Delete"
msgstr "Удалить"

msgid "Delete from Local Catalog"
msgstr "Удалить из локального каталога"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Удалить выбранное устройство? Это действие нельзя отменить."

msgid "{count} device(s) in the open project use this product. They can't be loaded until the product is imported again."
msgstr "Устройств в открытом проекте, использующих этот продукт: {count}. Их нельзя будет загрузить, пока продукт не будет импортирован снова."

msgid "Deleting {name}…"
msgstr "Удаление {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Удалено из локального каталога: {name}"

msgid "Export .knxprod…"
msgstr "Экспорт .knxprod…"

msgid "Export .knxprod"
msgstr "Экспорт .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Продукт KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "Экспортировано: {name}"

msgid "Could not export {name}: {error}"
msgstr "Не удалось экспортировать {name}: {error}"

msgid "No stored archive for {name}"
msgstr "Нет сохранённого архива для {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Это устройство поддерживает KNX Data Secure. Задайте пароль проекта, чтобы ввести его в эксплуатацию с защитой; без пароля оно будет добавлено и введено в эксплуатацию без шифрования."

msgid "Search…"
msgstr "Поиск…"

msgid "Market:"
msgstr "Рынок:"

