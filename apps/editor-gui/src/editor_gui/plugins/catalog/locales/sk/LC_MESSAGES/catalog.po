msgstr "Registrovať"

msgid "Continue Registration"
msgstr "Pokračovať v registrácii"

msgid "Verification Code"
msgstr "Overovací kód"

msgid "Verify Email"
msgstr "Overiť e-mail"

msgid "Resend Code"
msgstr "Znova odoslať kód"

msgid "Open Website"
msgstr "Otvoriť web"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Prihlasovacie údaje sa ukladajú v tomto počítači. Nechajte heslo prázdne, ak ho chcete zachovať pre rovnaký server a používateľa."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Registrácia odošle kód e-mailom. Heslo: aspoň 10 znakov, veľké a malé písmeno, číslica a špeciálny znak; najviac 72 bajtov UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Dokončite registráciu zadaním šesťmiestneho kódu z e-mailu."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail overený. Sťahovanie bude dostupné po schválení správcom."

msgid "Version"
msgstr "Verzia"

msgid "Register…"
msgstr "Registrovať…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Prihlásenie bolo odmietnuté: používateľské meno alebo heslo je nesprávne, alebo účet ešte nie je schválený."

msgid "Enter your username and password, or register, before downloading."
msgstr "Pred sťahovaním zadajte používateľské meno a heslo, alebo sa zaregistrujte."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Denný limit sťahovania je vyčerpaný. Skúste to znova zajtra."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Server katalógu je zaneprázdnený. Skúste to o chvíľu znova."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Zadajte e-mailovú adresu a používateľské meno s 3 až 32 písmenami, číslicami, bodkami, podčiarkovníkmi alebo spojovníkmi."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Heslo musí mať aspoň 10 znakov, veľké aj malé písmená, číslicu a špeciálny znak."

msgid "Enter the six-digit code from the email."
msgstr "Zadajte šesťmiestny kód z e-mailu."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Importovaná {count} verzia produktu. Nájdete ju na karte Lokálne."
msgstr[1] "Importované {count} verzie produktov. Nájdete ich na karte Lokálne."
msgstr[2] "Importovaných {count} verzií produktov. Nájdete ich na karte Lokálne."

