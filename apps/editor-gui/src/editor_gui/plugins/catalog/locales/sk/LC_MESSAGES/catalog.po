msgstr[1] "Zobrazené {shown} z {total} zhôd – spresnite hľadanie"
msgstr[2] "Zobrazené {shown} z {total} zhôd – spresnite hľadanie"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Načítať online {count} chýbajúcu aplikáciu"
msgstr[1] "Načítať online {count} chýbajúce aplikácie"
msgstr[2] "Načítať online {count} chýbajúcich aplikácií"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} zariadenie v otvorenom projekte používa tento produkt. Nedá sa načítať, kým sa produkt znova neimportuje."
msgstr[1] "{count} zariadenia v otvorenom projekte používajú tento produkt. Nedajú sa načítať, kým sa produkt znova neimportuje."
msgstr[2] "{count} zariadení v otvorenom projekte používa tento produkt. Nedajú sa načítať, kým sa produkt znova neimportuje."
