msgstr "Brugernavn"

msgid "Email"
msgstr "E-mail"

msgid "Save"
msgstr "Gem"

msgid "Register"
msgstr "Registrer"

msgid "Continue Registration"
msgstr "Fortsæt registrering"

msgid "Verification Code"
msgstr "Bekræftelseskode"

msgid "Verify Email"
msgstr "Bekræft e-mail"

msgid "Resend Code"
msgstr "Send kode igen"

msgid "Open Website"
msgstr "Åbn websted"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Loginoplysninger gemmes på denne computer. Lad adgangskoden være tom for at beholde den til samme server og bruger."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Registrering sender en kode via e-mail. Adgangskode: mindst 10 tegn, stort og lille bogstav, ciffer og specialtegn; højst 72 UTF-8-byte."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Indtast den sekscifrede kode fra din e-mail for at afslutte registreringen."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail bekræftet. Download bliver tilgængelig efter administratorens godkendelse."

msgid "Version"
msgstr "Version"

msgid "Register…"
msgstr "Registrer…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Login blev afvist: brugernavn eller adgangskode er forkert, eller kontoen er endnu ikke godkendt."

msgid "Enter your username and password, or register, before downloading."
msgstr "Indtast dit brugernavn og din adgangskode, eller registrer dig, før du downloader."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Den daglige downloadgrænse er nået. Prøv igen i morgen."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Katalogserveren er optaget. Prøv igen om lidt."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Indtast en e-mailadresse og et brugernavn på 3 til 32 bogstaver, cifre, punktummer, understregninger eller bindestreger."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Adgangskoden skal have mindst 10 tegn med store og små bogstaver, et ciffer og et specialtegn."

msgid "Enter the six-digit code from the email."
msgstr "Indtast den sekscifrede kode fra e-mailen."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "{count} produktversion importeret. Find den på fanen Lokal."
msgstr[1] "{count} produktversioner importeret. Find dem på fanen Lokal."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "{count} applikation fundet"
msgstr[1] "{count} applikationer fundet"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} gruppeobjekt)"
msgstr[1] "({count} gruppeobjekter)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} resultat"
msgstr[1] "{count} resultater"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Produktindeks ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} producent"
msgstr[1] "{count} producenter"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} produkt"
msgstr[1] "{count} produkter"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Viser {shown} af {total} resultat - præciser søgningen"
msgstr[1] "Viser {shown} af {total} resultater - præciser søgningen"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Hent {count} manglende applikation online"
msgstr[1] "Hent {count} manglende applikationer online"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} enhed i det åbne projekt bruger dette produkt. Den kan først indlæses igen, når produktet er importeret igen."
msgstr[1] "{count} enheder i det åbne projekt bruger dette produkt. De kan først indlæses igen, når produktet er importeret igen."
