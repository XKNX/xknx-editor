msgstr "Der er endnu ikke importeret produkter — importer en .knxprod, eller brug fanen Online."

msgid "Fetching missing applications…"
msgstr "Henter manglende applikationer…"

msgid "Delete"
msgstr "Slet"

msgid "Delete from Local Catalog"
msgstr "Slet fra lokalt katalog"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Er du sikker på, at du vil slette den valgte enhed? Dette kan ikke fortrydes."

msgid "Deleting {name}…"
msgstr "Sletter {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Slettet fra det lokale katalog: {name}"

msgid "Export .knxprod…"
msgstr "Eksporter .knxprod…"

msgid "Export .knxprod"
msgstr "Eksporter .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "KNX-produkt (*.knxprod)"

