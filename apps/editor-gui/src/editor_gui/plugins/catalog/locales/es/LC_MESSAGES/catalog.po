msgid_plural "{count} manufacturers"
msgstr[0] "{count} fabricante"
msgstr[1] "{count} fabricantes"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} producto"
msgstr[1] "{count} productos"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Mostrando {shown} de {total} coincidencia - refine la búsqueda"
msgstr[1] "Mostrando {shown} de {total} coincidencias - refine la búsqueda"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Obtener Online {count} Aplicación Faltante"
msgstr[1] "Obtener Online {count} Aplicaciones Faltantes"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} dispositivo del proyecto abierto usa este producto. No podrá cargarse hasta que el producto se vuelva a importar."
msgstr[1] "{count} dispositivos del proyecto abierto usan este producto. No podrán cargarse hasta que el producto se vuelva a importar."
