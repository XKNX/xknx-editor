msgstr "Continuar registro"

msgid "Verification Code"
msgstr "Código de verificación"

msgid "Verify Email"
msgstr "Verificar correo"

msgid "Resend Code"
msgstr "Reenviar código"

msgid "Open Website"
msgstr "Abrir sitio web"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Las credenciales se guardan en este equipo. Deja la contraseña vacía para conservarla para el mismo servidor y usuario."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "El registro envía un código por correo. Contraseña: al menos 10 caracteres, mayúscula, minúscula, dígito y carácter especial; máximo 72 bytes UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Introduce el código de seis dígitos del correo para completar el registro."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "Correo verificado. Las descargas estarán disponibles tras la aprobación del administrador."

msgid "Version"
msgstr "Versión"

msgid "Register…"
msgstr "Registrarse…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Se rechazó el inicio de sesión: el nombre de usuario o la contraseña son incorrectos, o la cuenta aún no está aprobada."

msgid "Enter your username and password, or register, before downloading."
msgstr "Introduzca su nombre de usuario y contraseña, o regístrese, antes de descargar."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Se ha alcanzado el límite diario de descargas. Inténtelo de nuevo mañana."

msgid "The catalog server is busy. Try again in a moment."
msgstr "El servidor del catálogo está ocupado. Inténtelo de nuevo en un momento."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Introduzca una dirección de correo y un nombre de usuario de 3 a 32 letras, dígitos, puntos, guiones bajos o guiones."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "La contraseña necesita al menos 10 caracteres con mayúsculas y minúsculas, un dígito y un carácter especial."

msgid "Enter the six-digit code from the email."
msgstr "Introduzca el código de seis dígitos del correo electrónico."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Se importó {count} versión de producto. Está en la pestaña Local."
msgstr[1] "Se importaron {count} versiones de producto. Están en la pestaña Local."

