msgstr "Po ndërtohet indeksi i produkteve… {done}/{total} prodhues"

msgid "Cancel"
msgstr "Anulo"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "Merrni katalogun online për të kërkuar te të gjithë prodhuesit."

msgid "Showing {shown} of {total} matches - refine the search"
msgstr "Po shfaqen {shown} nga {total} rezultate - ngushtoni kërkimin"

