msgstr "(pa dhomë)"

msgid "Open or create a project first to add a device."
msgstr "Për të shtuar një pajisje, fillimisht hapni ose krijoni një projekt."

msgid "This product has no usable application program."
msgstr "Ky produkt nuk ka program aplikativ të përdorshëm."

msgid "Added device: {name}"
msgstr "U shtua pajisja: {name}"

msgid "Local"
msgstr "Lokal"

msgid "Online"
msgstr "Online"

msgid "No products imported yet — import a .knxprod or use the Online tab."
msgstr "Ende pa produkte — importoni një .knxprod ose përdorni skedën Online."

msgid "Fetch {count} Missing Application(s) Online"
msgstr "Merr online programet aplikative që mungojnë ({count})"

msgid "Fetching missing applications…"
msgstr "Po merren programet aplikative që mungojnë…"

msgid "Delete"
msgstr "Fshi"

msgid "Delete from Local Catalog"
msgstr "Fshi nga katalogu lokal"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Të fshihet pajisja e zgjedhur? Ky veprim nuk mund të zhbëhet."

msgid "{count} device(s) in the open project use this product. They can't be loaded until the product is imported again."
msgstr "{count} pajisje në projektin e hapur e përdorin këtë produkt. Ato nuk mund të ngarkohen derisa produkti të importohet sërish."

msgid "Deleting {name}…"
msgstr "Po fshihet {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "U fshi nga katalogu lokal: {name}"

msgid "Export .knxprod…"
msgstr "Eksporto .knxprod…"

msgid "Export .knxprod"
msgstr "Eksporto .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Produkt KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "U eksportua {name}"

msgid "Could not export {name}: {error}"
msgstr "{name} nuk u eksportua: {error}"

msgid "No stored archive for {name}"
msgstr "Nuk ka arkiv të ruajtur për {name}"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Kjo pajisje mbështet KNX Data Secure. Vendosni një fjalëkalim projekti për ta vënë në punë në mënyrë të sigurt; pa të, ajo shtohet dhe vihet në punë pa enkriptim."

msgid "Search…"
msgstr "Kërko…"

msgid "Market:"
msgstr "Tregu:"

msgid "All Markets"
msgstr "Të gjitha tregjet"

msgid "Only Products in {language}"
msgstr "Vetëm produkte në {language}"

msgid "{shown} of {total} shown"
msgstr "{shown} nga {total} të shfaqura"

msgid "(estimated)"
msgstr "(përafërsisht)"

msgid "Line"
msgstr "Linja"

msgid "Automatic"
msgstr "Automatike"

msgid "Add to"
msgstr "Shto në"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Automatike: pajisja vendoset në linjën aktuale të dhomës së zgjedhur; nëse dhoma nuk ka të tillë, në linjën e parë TP."

msgid "Download to Local Catalog"
msgstr "Shkarko në katalogun lokal"

msgid "Filename"
msgstr "Emri i skedarit"

msgid "Mask Version"
msgstr "Versioni i maskës"

msgid "Size"
msgstr "Madhësia"

msgid "Updated"
msgstr "Përditësuar më"

msgid "Alternative"
msgstr "Alternativ"

msgid "Server URL"
msgstr "URL-ja e serverit"

msgid "Username"
msgstr "Emri i përdoruesit"

msgid "Email"
msgstr "Email"

msgid "Save"
msgstr "Ruaj"

msgid "Register"
msgstr "Regjistrohu"

msgid "Continue Registration"
msgstr "Vazhdo regjistrimin"

msgid "Verification Code"
msgstr "Kodi i verifikimit"

msgid "Verify Email"
msgstr "Verifiko emailin"

msgid "Resend Code"
msgstr "Ridërgo kodin"

msgid "Open Website"
msgstr "Hap faqen e internetit"

msgid "Imported {count} product versions. Find them in the Local tab."
msgstr "U importuan {count} versione produktesh. I gjeni në skedën “Lokal”."

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Të dhënat e hyrjes ruhen në këtë kompjuter. Nëse e lini bosh fushën e fjalëkalimit, fjalëkalimi i ruajtur më parë mbahet vetëm kur serveri dhe përdoruesi mbeten të njëjtë."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Gjatë regjistrimit ju dërgohet një kod me email. Fjalëkalimi duhet të ketë të paktën 10 karaktere, një shkronjë të madhe, një shkronjë të vogël, një shifër dhe një karakter të veçantë; nuk duhet të kalojë 72 bajte në kodimin UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Vendosni kodin gjashtëshifror që morët me email për të përfunduar regjistrimin."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "Emaili u verifikua. Shkarkimet bëhen të disponueshme pas miratimit nga administratori."

msgid "Version"
msgstr "Versioni"

msgid "Register…"
msgstr "Regjistrohu…"
msgid "Alternative Catalog"
msgstr "Katalogu alternativ"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Hyrja u refuzua: emri i përdoruesit ose fjalëkalimi është i gabuar, ose llogaria nuk është miratuar ende."

msgid "Enter your username and password, or register, before downloading."
msgstr "Futni emrin e përdoruesit dhe fjalëkalimin, ose regjistrohuni, para se të shkarkoni."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "U arrit kufiri ditor i shkarkimeve. Provoni sërish nesër."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Serveri i katalogut është i zënë. Provoni sërish pas pak."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Futni një adresë email-i dhe një emër përdoruesi me 3 deri në 32 shkronja, shifra, pika, nënvizime ose viza."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Fjalëkalimi duhet të ketë të paktën 10 karaktere me shkronja të mëdha dhe të vogla, një shifër dhe një karakter të veçantë."

msgid "Enter the six-digit code from the email."
msgstr "Futni kodin gjashtëshifror nga email-i."
