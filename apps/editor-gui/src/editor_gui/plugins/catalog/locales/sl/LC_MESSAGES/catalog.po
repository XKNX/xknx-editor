msgstr "Kazala izdelkov še ni – za izdelavo pridobite spletni katalog"

msgid "Building Product Index… {done}/{total} manufacturers"
msgstr "Gradnja kazala izdelkov… proizvajalci: {done}/{total}"

msgid "Cancel"
msgstr "Prekliči"

msgid "Fetch the online catalog to search across all manufacturers."
msgstr "Pridobite spletni katalog, da boste lahko iskali med vsemi proizvajalci."

msgid "(in local catalog)"
msgstr "(v lokalnem katalogu)"

msgid "Open or create a project first to add a device."
msgstr "Če želite dodati napravo, najprej odprite ali ustvarite projekt."

msgid "This product has no usable application program."
msgstr "Ta izdelek nima uporabnega aplikacijskega programa."

