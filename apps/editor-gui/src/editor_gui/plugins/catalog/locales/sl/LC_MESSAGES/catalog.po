msgstr "Prikazano: {shown} od {total}"

msgid "(estimated)"
msgstr "(ocenjeno)"

msgid "Line"
msgstr "Linija"

msgid "Automatic"
msgstr "Samodejno"

msgid "Add to"
msgstr "Dodaj v"

msgid "Automatic: the device goes on the Current Line of the room chosen, without one on the first TP line."
msgstr "Samodejno: naprava se doda na trenutno linijo izbranega prostora, če te ni, pa na prvo linijo TP."

msgid "Download to Local Catalog"
msgstr "Prenesi v lokalni katalog"

msgid "Filename"
msgstr "Ime datoteke"

msgid "Mask Version"
msgstr "Različica maske"

