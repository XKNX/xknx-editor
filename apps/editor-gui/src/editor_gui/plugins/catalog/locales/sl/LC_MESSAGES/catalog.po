msgstr "Naprava dodana: {name}"

msgid "Delete"
msgstr "Izbriši"

msgid "Delete from Local Catalog"
msgstr "Brisanje iz lokalnega kataloga"

msgid "Are you sure you want to delete the selected device? This cannot be undone."
msgstr "Ali ste prepričani, da želite izbrisati izbrano napravo? Tega ni mogoče razveljaviti."

msgid "Deleting {name}…"
msgstr "Brisanje {name}…"

msgid "Deleted from the local catalog: {name}"
msgstr "Izbrisano iz lokalnega kataloga: {name}"

msgid "Application ID"
msgstr "ID aplikacije"

msgid "DIN Rail Mounting"
msgstr "Montaža na DIN-letev"

msgid "Bus Current"
msgstr "Tok vodila"

msgid "Yes"
msgstr "Da"

msgid "No"
msgstr "Ne"

msgid "This device supports KNX Data Secure. Set a project password to commission it securely; without one it is added and commissioned in the clear."
msgstr "Ta naprava podpira KNX Data Secure. Nastavite geslo projekta, da jo boste lahko varno zagnali; brez gesla je dodana in zagnana nešifrirano."

msgid "Search…"
msgstr "Iskanje…"

msgid "Export .knxprod…"
msgstr "Izvozi .knxprod…"

msgid "Export .knxprod"
msgstr "Izvoz .knxprod"

msgid "KNX product (*.knxprod)"
msgstr "Izdelek KNX (*.knxprod)"

msgid "Exported {name}"
msgstr "Izvoženo: {name}"

msgid "Could not export {name}: {error}"
msgstr "{name} ni bilo mogoče izvoziti: {error}"

msgid "No stored archive for {name}"
msgstr "Ni shranjenega arhiva za {name}"

msgid "The product data of {name} comes from a project without a catalog (Catalog.xml), so it cannot be exported as a .knxprod"
msgstr "Podatki o izdelku {name} izvirajo iz projekta brez kataloga (Catalog.xml), zato jih ni mogoče izvoziti kot .knxprod"

