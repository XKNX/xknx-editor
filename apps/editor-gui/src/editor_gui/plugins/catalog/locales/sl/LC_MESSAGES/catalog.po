msgstr "Uvoženih izdelkov še ni – uvozite datoteko .knxprod ali uporabite zavihek Na spletu."

msgid "Program Version"
msgstr "Različica programa"

msgid "Search products, order number…"
msgstr "Iskanje izdelkov, naročilne številke…"

