msgstr "URL strežnika"

msgid "Username"
msgstr "Uporabniško ime"

msgid "Email"
msgstr "E-pošta"

msgid "Save"
msgstr "Shrani"

msgid "Register"
msgstr "Registracija"

msgid "Continue Registration"
msgstr "Nadaljuj registracijo"

msgid "Verification Code"
msgstr "Potrditvena koda"

msgid "Verify Email"
msgstr "Potrdi e-pošto"

msgid "Resend Code"
msgstr "Znova pošlji kodo"

msgid "Open Website"
msgstr "Odpri spletno mesto"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Prijavni podatki so shranjeni v tem računalniku. Pustite geslo prazno, da ga ohranite za isti strežnik in uporabnika."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Registracija pošlje kodo po e-pošti. Geslo: vsaj 10 znakov, velika in mala črka, številka in poseben znak; največ 72 bajtov UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Za dokončanje registracije vnesite šestmestno kodo iz e-pošte."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-pošta potrjena. Prenosi bodo na voljo po odobritvi skrbnika."

msgid "Version"
msgstr "Različica"

msgid "Register…"
msgstr "Registracija…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Prijava je bila zavrnjena: uporabniško ime ali geslo je napačno ali račun še ni odobren."

msgid "Enter your username and password, or register, before downloading."
msgstr "Pred prenosom vnesite uporabniško ime in geslo ali se registrirajte."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Dosežena je dnevna omejitev prenosov. Poskusite znova jutri."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Strežnik kataloga je zaseden. Poskusite znova čez trenutek."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Vnesite e-poštni naslov in uporabniško ime s 3 do 32 črkami, števkami, pikami, podčrtaji ali vezaji."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Geslo potrebuje vsaj 10 znakov z velikimi in malimi črkami, števko in posebnim znakom."

msgid "Enter the six-digit code from the email."
msgstr "Vnesite šestmestno kodo iz e-pošte."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "Uvožena {count} različica izdelka. Najdete jo na zavihku Lokalno."
msgstr[1] "Uvoženi {count} različici izdelkov. Najdete ju na zavihku Lokalno."
msgstr[2] "Uvožene {count} različice izdelkov. Najdete jih na zavihku Lokalno."
msgstr[3] "Uvoženih {count} različic izdelkov. Najdete jih na zavihku Lokalno."

