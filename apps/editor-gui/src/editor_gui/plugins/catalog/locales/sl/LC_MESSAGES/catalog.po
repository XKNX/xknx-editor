msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "Prikazani zadetki: {shown} od {total} – zožite iskanje"
msgstr[1] "Prikazani zadetki: {shown} od {total} – zožite iskanje"
msgstr[2] "Prikazani zadetki: {shown} od {total} – zožite iskanje"
msgstr[3] "Prikazani zadetki: {shown} od {total} – zožite iskanje"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Pridobi {count} manjkajočo aplikacijo s spleta"
msgstr[1] "Pridobi {count} manjkajoči aplikaciji s spleta"
msgstr[2] "Pridobi {count} manjkajoče aplikacije s spleta"
msgstr[3] "Pridobi {count} manjkajočih aplikacij s spleta"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} naprava v odprtem projektu uporablja ta izdelek. Dokler izdelka znova ne uvozite, je ni mogoče naložiti."
msgstr[1] "{count} napravi v odprtem projektu uporabljata ta izdelek. Dokler izdelka znova ne uvozite, ju ni mogoče naložiti."
msgstr[2] "{count} naprave v odprtem projektu uporabljajo ta izdelek. Dokler izdelka znova ne uvozite, jih ni mogoče naložiti."
msgstr[3] "{count} naprav v odprtem projektu uporablja ta izdelek. Dokler izdelka znova ne uvozite, jih ni mogoče naložiti."
