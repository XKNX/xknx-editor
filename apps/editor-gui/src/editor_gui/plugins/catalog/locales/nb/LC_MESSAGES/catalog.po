msgstr "Fortsett registrering"

msgid "Verification Code"
msgstr "Bekreftelseskode"

msgid "Verify Email"
msgstr "Bekreft e-post"

msgid "Resend Code"
msgstr "Send kode på nytt"

msgid "Open Website"
msgstr "Åpne nettsted"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Innloggingsopplysningene lagres på denne datamaskinen. La passordet stå tomt for å beholde det for samme server og bruker."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Registreringen sender en kode via e-post. Passord: minst 10 tegn, stor og liten bokstav, siffer og spesialtegn; høyst 72 UTF-8-byte."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Skriv inn den sekssifrede koden fra e-posten for å fullføre registreringen."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-post bekreftet. Nedlastinger blir tilgjengelige etter administratorens godkjenning."

msgid "Version"
msgstr "Versjon"

msgid "Register…"
msgstr "Registrer…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Innloggingen ble avvist: brukernavnet eller passordet er feil, eller kontoen er ikke godkjent ennå."

msgid "Enter your username and password, or register, before downloading."
msgstr "Skriv inn brukernavn og passord, eller registrer deg, før du laster ned."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Den daglige nedlastingsgrensen er nådd. Prøv igjen i morgen."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Katalogserveren er opptatt. Prøv igjen om litt."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Skriv inn en e-postadresse og et brukernavn på 3 til 32 bokstaver, sifre, punktum, understreker eller bindestreker."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Passordet må ha minst 10 tegn med store og små bokstaver, et siffer og et spesialtegn."

msgid "Enter the six-digit code from the email."
msgstr "Skriv inn den sekssifrede koden fra e-posten."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "{count} produktversjon importert. Du finner den på fanen Lokal."
msgstr[1] "{count} produktversjoner importert. Du finner dem på fanen Lokal."

