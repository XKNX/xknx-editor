msgstr[0] "Viser {shown} av {total} treff – avgrens søket"
msgstr[1] "Viser {shown} av {total} treff – avgrens søket"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "Hent {count} manglende applikasjon online"
msgstr[1] "Hent {count} manglende applikasjoner online"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} enhet i det åpne prosjektet bruker dette produktet. Den kan ikke lastes før produktet er importert på nytt."
msgstr[1] "{count} enheter i det åpne prosjektet bruker dette produktet. De kan ikke lastes før produktet er importert på nytt."
