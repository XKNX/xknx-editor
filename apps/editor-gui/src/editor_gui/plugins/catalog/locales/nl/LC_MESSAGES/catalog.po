msgstr "Website openen"

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "De inloggegevens worden op deze computer opgeslagen. Laat het wachtwoord leeg om het voor dezelfde server en gebruiker te behouden."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Bij registratie ontvang je een code per e-mail. Wachtwoord: minstens 10 tekens, hoofdletter, kleine letter, cijfer en speciaal teken; maximaal 72 UTF-8-bytes."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Voer de zescijferige code uit je e-mail in om de registratie te voltooien."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail bevestigd. Downloads zijn beschikbaar na goedkeuring door de beheerder."

msgid "Version"
msgstr "Versie"

msgid "Register…"
msgstr "Registreren…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Aanmelden geweigerd: de gebruikersnaam of het wachtwoord is onjuist, of het account is nog niet goedgekeurd."

msgid "Enter your username and password, or register, before downloading."
msgstr "Voer uw gebruikersnaam en wachtwoord in, of registreer u, voordat u downloadt."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "De dagelijkse downloadlimiet is bereikt. Probeer het morgen opnieuw."

msgid "The catalog server is busy. Try again in a moment."
msgstr "De catalogusserver is bezet. Probeer het zo meteen opnieuw."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Voer een e-mailadres en een gebruikersnaam van 3 tot 32 letters, cijfers, punten, underscores of koppeltekens in."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Het wachtwoord heeft minstens 10 tekens nodig met hoofdletters en kleine letters, een cijfer en een speciaal teken."

msgid "Enter the six-digit code from the email."
msgstr "Voer de zescijferige code uit de e-mail in."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "{count} productversie geïmporteerd. Je vindt die op het tabblad Lokaal."
msgstr[1] "{count} productversies geïmporteerd. Je vindt ze op het tabblad Lokaal."

msgid "Found {count} application"
msgid_plural "Found {count} applications"
msgstr[0] "{count} applicatie gevonden"
msgstr[1] "{count} applicaties gevonden"

msgid "({count} group object)"
msgid_plural "({count} group objects)"
msgstr[0] "({count} groepsobject)"
msgstr[1] "({count} groepsobjecten)"

msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} resultaat"
msgstr[1] "{count} resultaten"

msgid "Product Index ({date}): {manufacturers}, {products}"
msgstr "Productindex ({date}): {manufacturers}, {products}"

msgid "{count} manufacturer"
msgid_plural "{count} manufacturers"
msgstr[0] "{count} fabrikant"
msgstr[1] "{count} fabrikanten"

msgid "{count} product"
msgid_plural "{count} products"
msgstr[0] "{count} product"
msgstr[1] "{count} producten"

msgid "Showing {shown} of {total} match - refine the search"
msgid_plural "Showing {shown} of {total} matches - refine the search"
msgstr[0] "{shown} van {total} resultaat - verfijn de zoekopdracht"
msgstr[1] "{shown} van {total} resultaten - verfijn de zoekopdracht"

msgid "Fetch {count} Missing Application Online"
msgid_plural "Fetch {count} Missing Applications Online"
msgstr[0] "{count} ontbrekende applicatie online ophalen"
msgstr[1] "{count} ontbrekende applicaties online ophalen"

msgid "{count} device in the open project uses this product. It can't be loaded until the product is imported again."
msgid_plural "{count} devices in the open project use this product. They can't be loaded until the product is imported again."
msgstr[0] "{count} apparaat in het geopende project gebruikt dit product. Het kan pas weer worden geladen als het product opnieuw is geïmporteerd."
msgstr[1] "{count} apparaten in het geopende project gebruiken dit product. Ze kunnen pas weer worden geladen als het product opnieuw is geïmporteerd."
