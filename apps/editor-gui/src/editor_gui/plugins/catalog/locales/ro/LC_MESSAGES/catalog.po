msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Datele de autentificare sunt salvate pe acest calculator. Lasă parola goală pentru a o păstra pentru același server și utilizator."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "Înregistrarea trimite un cod prin e-mail. Parola: minimum 10 caractere, majusculă, minusculă, cifră și caracter special; maximum 72 de octeți UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Introdu codul de șase cifre din e-mail pentru a finaliza înregistrarea."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail verificat. Descărcările devin disponibile după aprobarea administratorului."

msgid "Version"
msgstr "Versiune"

msgid "Register…"
msgstr "Înregistrare…"

msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "Autentificarea a fost refuzată: numele de utilizator sau parola sunt greșite, ori contul nu este încă aprobat."

msgid "Enter your username and password, or register, before downloading."
msgstr "Introduceți numele de utilizator și parola sau înregistrați-vă înainte de descărcare."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "Limita zilnică de descărcări a fost atinsă. Încercați din nou mâine."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Serverul catalogului este ocupat. Încercați din nou peste puțin timp."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Introduceți o adresă de e-mail și un nume de utilizator de 3–32 litere, cifre, puncte, liniuțe de subliniere sau cratime."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Parola are nevoie de cel puțin 10 caractere cu litere mari și mici, o cifră și un caracter special."

msgid "Enter the six-digit code from the email."
msgstr "Introduceți codul din șase cifre din e-mail."

msgid "Imported {count} product version. Find it in the Local tab."
msgid_plural "Imported {count} product versions. Find them in the Local tab."
msgstr[0] "S-a importat {count} versiune de produs. O găsești în fila Local."
msgstr[1] "S-au importat {count} versiuni de produs. Le găsești în fila Local."
msgstr[2] "S-au importat {count} de versiuni de produs. Le găsești în fila Local."

