msgstr "S’inscrire"

msgid "Continue Registration"
msgstr "Continuer l’inscription"

msgid "Verification Code"
msgstr "Code de vérification"

msgid "Verify Email"
msgstr "Vérifier l’e-mail"

msgid "Resend Code"
msgstr "Renvoyer le code"

msgid "Open Website"
msgstr "Ouvrir le site web"

msgid "Imported {count} product versions. Find them in the Local tab."
msgstr "{count} versions de produit importées. Retrouvez-les dans l’onglet Local."

msgid "Login is saved on this computer. Leave the password empty to keep it for the same server and user."
msgstr "Les identifiants sont enregistrés sur cet ordinateur. Laissez le mot de passe vide pour le conserver pour le même serveur et utilisateur."

msgid "Registration sends an email code. Password: at least 10 characters, uppercase, lowercase, digit and special character; at most 72 UTF-8 bytes."
msgstr "L’inscription envoie un code par e-mail. Mot de passe : au moins 10 caractères, majuscule, minuscule, chiffre et caractère spécial ; au plus 72 octets UTF-8."

msgid "Enter the six-digit code from your email to complete registration."
msgstr "Saisissez le code à six chiffres reçu par e-mail pour terminer l’inscription."

msgid "Email verified. Downloads become available after administrator approval."
msgstr "E-mail vérifié. Les téléchargements seront disponibles après approbation de l’administrateur."

msgid "Version"
msgstr "Version"

msgid "Register…"
msgstr "S’inscrire…"
msgid "Alternative Catalog"
msgstr "Alternative Catalog"

msgid "The login was refused: the username or password is wrong, or the account is not approved yet."
msgstr "La connexion a été refusée : le nom d'utilisateur ou le mot de passe est incorrect, ou le compte n'est pas encore approuvé."

msgid "Enter your username and password, or register, before downloading."
msgstr "Saisissez votre nom d'utilisateur et votre mot de passe, ou inscrivez-vous, avant de télécharger."

msgid "The daily download limit is reached. Try again tomorrow."
msgstr "La limite quotidienne de téléchargements est atteinte. Réessayez demain."

msgid "The catalog server is busy. Try again in a moment."
msgstr "Le serveur du catalogue est occupé. Réessayez dans un instant."

msgid "Enter an email address and a username of 3 to 32 letters, digits, dots, underscores or hyphens."
msgstr "Saisissez une adresse e-mail et un nom d'utilisateur de 3 à 32 lettres, chiffres, points, traits de soulignement ou traits d'union."

msgid "The password needs at least 10 characters with upper and lower case letters, a digit and a special character."
msgstr "Le mot de passe doit comporter au moins 10 caractères avec des majuscules et des minuscules, un chiffre et un caractère spécial."

msgid "Enter the six-digit code from the email."
msgstr "Saisissez le code à six chiffres reçu par e-mail."
