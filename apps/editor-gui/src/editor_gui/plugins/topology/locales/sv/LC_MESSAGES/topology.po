msgid "Topology"
msgstr "Topologi"

msgid "No project open"
msgstr "Inget projekt öppet"

msgid "Unassigned"
msgstr "Ej tilldelade"

msgid "Drag to move, Ctrl/Cmd+scroll to zoom. Click a device to open it."
msgstr "Dra för att flytta, Ctrl/Cmd+scrolla för att zooma. Klicka på en apparat för att öppna den."

msgid "Physical"
msgstr "Fysisk"

msgid "Building"
msgstr "Byggnad"

msgid "Links"
msgstr "Kopplingar"

msgid "Which devices talk to which over their group addresses: sending devices on the left, receiving devices on the right."
msgstr "Vilka apparater som kommunicerar med vilka via sina gruppadresser: sändande apparater till vänster, mottagande apparater till höger."

msgid "Click to follow a device or group address, double-click to open a device. Drag to move, Ctrl/Cmd+scroll to zoom."
msgstr "Klicka för att följa en apparat eller gruppadress, dubbelklicka för att öppna en apparat. Dra för att flytta, Ctrl/Cmd+scrolla för att zooma."

msgid "Tap to follow a device or group address, double-tap to open a device. Zoom with two fingers."
msgstr "Tryck för att följa en apparat eller gruppadress, dubbeltryck för att öppna en apparat. Zooma med två fingrar."

msgid "No linked devices to show."
msgstr "Inga förbundna apparater att visa."

msgid "Show"
msgstr "Visa"

msgid "Whole Project"
msgstr "Hela projektet"

msgid "Rooms"
msgstr "Rum"

msgid "Main Groups"
msgstr "Huvudgrupper"

msgid "Device: {device}"
msgstr "Apparat: {device}"

msgid "Group Address: {address}"
msgstr "Gruppadress: {address}"

msgid "Back"
msgstr "Tillbaka"

msgid "Fit"
msgstr "Anpassa"

msgid "Sending"
msgstr "Sändande"

msgid "Group Addresses"
msgstr "Gruppadresser"

msgid "Receiving"
msgstr "Mottagande"

msgid "Areas"
msgstr "Områden"

msgid "Lines"
msgstr "Linjer"

msgid "Devices"
msgstr "Apparater"

msgid "Buildings"
msgstr "Byggnader"

msgid "+ {count} more"
msgstr "+ {count} till"

msgid "{count} more devices outside the selection. Click to show them."
msgstr "{count} apparater till utanför urvalet. Klicka för att visa dem."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\n{senders} sändande, {receivers} mottagande"

msgid "Area {area}"
msgstr "Område {area}"

msgid "L {line}"
msgstr "L {line}"

msgid "Zoom with two fingers. Tap a device to open it."
msgstr "Zooma med två fingrar. Tryck på en apparat för att öppna den."

msgid "(unnamed)"
msgstr "(namnlös)"

msgid "Address: {address}"
msgstr "Adress: {address}"

msgid "Application: {application}"
msgstr "Applikation: {application}"
