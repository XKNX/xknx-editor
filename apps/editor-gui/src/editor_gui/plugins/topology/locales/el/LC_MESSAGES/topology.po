msgid "Topology"
msgstr "Τοπολογία"

msgid "No project open"
msgstr "Δεν υπάρχει ανοιχτό έργο"

msgid "Unassigned"
msgstr "Χωρίς αντιστοίχιση"

msgid "Drag to move, {key}+scroll to zoom. Click a device to open it."
msgstr "Σύρετε για μετακίνηση, {key}+κύλιση για μεγέθυνση. Κάντε κλικ σε μια συσκευή για να την ανοίξετε."

msgid "Physical"
msgstr "Φυσική"

msgid "Building"
msgstr "Κτίριο"

msgid "Links"
msgstr "Συνδέσεις"

msgid "Which devices talk to which over their group addresses: sending devices on the left, receiving devices on the right."
msgstr "Ποιες συσκευές επικοινωνούν με ποιες μέσω των διευθύνσεων ομάδων τους: συσκευές αποστολής αριστερά, συσκευές λήψης δεξιά."

msgid "Click to follow a device or group address, double-click to open a device. Drag to move, {key}+scroll to zoom."
msgstr "Κάντε κλικ για να ακολουθήσετε μια συσκευή ή διεύθυνση ομάδας, διπλό κλικ για να ανοίξετε μια συσκευή. Σύρετε για μετακίνηση, {key}+κύλιση για μεγέθυνση."

msgid "Tap to follow a device or group address, double-tap to open a device. Zoom with two fingers."
msgstr "Πατήστε για να ακολουθήσετε μια συσκευή ή διεύθυνση ομάδας, διπλό πάτημα για να ανοίξετε μια συσκευή. Μεγέθυνση με δύο δάχτυλα."

msgid "No linked devices to show."
msgstr "Δεν υπάρχουν συνδεδεμένες συσκευές για εμφάνιση."

msgid "Show"
msgstr "Προβολή"

msgid "Whole Project"
msgstr "Ολόκληρο το Έργο"

msgid "Rooms"
msgstr "Δωμάτια"

msgid "Main Groups"
msgstr "Κύριες Ομάδες"

msgid "Device: {device}"
msgstr "Συσκευή: {device}"

msgid "Group Address: {address}"
msgstr "Διεύθυνση Ομάδας: {address}"

msgid "Back"
msgstr "Πίσω"

msgid "Fit"
msgstr "Προσαρμογή"

msgid "Sending"
msgstr "Αποστολείς"

msgid "Group Addresses"
msgstr "Διευθύνσεις Ομάδων"

msgid "Receiving"
msgstr "Δέκτες"

msgid "Areas"
msgstr "Περιοχές"

msgid "Lines"
msgstr "Γραμμές"

msgid "Devices"
msgstr "Συσκευές"

msgid "Buildings"
msgstr "Κτίρια"

msgid "+ {count} more"
msgstr "+ {count} ακόμη"

msgid "{count} more devices outside the selection. Click to show them."
msgstr "{count} ακόμη συσκευές εκτός της επιλογής. Κάντε κλικ για να εμφανιστούν."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\n{senders} αποστέλλουν, {receivers} λαμβάνουν"

msgid "Area {area}"
msgstr "Περιοχή {area}"

msgid "L {line}"
msgstr "Γ {line}"

msgid "Zoom with two fingers. Tap a device to open it."
msgstr "Μεγέθυνση με δύο δάχτυλα. Πατήστε μια συσκευή για να την ανοίξετε."

msgid "(unnamed)"
msgstr "(χωρίς όνομα)"

msgid "Address: {address}"
msgstr "Διεύθυνση: {address}"

msgid "Application: {application}"
msgstr "Εφαρμογή: {application}"
