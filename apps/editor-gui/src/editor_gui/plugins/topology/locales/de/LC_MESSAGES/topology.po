msgstr "Zurück"

msgid "Fit"
msgstr "Einpassen"

msgid "Sending"
msgstr "Sendend"

msgid "Group Addresses"
msgstr "Gruppenadressen"

msgid "Receiving"
msgstr "Empfangend"

