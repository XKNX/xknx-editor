msgid "Topology"
msgstr "Topologi"

msgid "No project open"
msgstr "Intet projekt åbent"

msgid "Unassigned"
msgstr "Ikke tildelt"

msgid "Drag to move, Ctrl/Cmd+scroll to zoom. Click a device to open it."
msgstr "Træk for at flytte, Ctrl/Cmd+rul for at zoome. Klik på en enhed for at åbne den."

msgid "Physical"
msgstr "Fysisk"

msgid "Building"
msgstr "Bygning"

msgid "Links"
msgstr "Sammenkædninger"

msgid "Which devices talk to which over their group addresses: sending devices on the left, receiving devices on the right."
msgstr "Hvilke enheder der taler med hvilke via deres gruppeadresser: sendende enheder til venstre, modtagende enheder til højre."

msgid "Click to follow a device or group address, double-click to open a device. Drag to move, Ctrl/Cmd+scroll to zoom."
msgstr "Klik for at følge en enhed eller gruppeadresse, dobbeltklik for at åbne en enhed. Træk for at flytte, Ctrl/Cmd+rul for at zoome."

msgid "Tap to follow a device or group address, double-tap to open a device. Zoom with two fingers."
msgstr "Tryk for at følge en enhed eller gruppeadresse, dobbelttryk for at åbne en enhed. Zoom med to fingre."

msgid "No linked devices to show."
msgstr "Ingen sammenkædede enheder at vise."

msgid "Show"
msgstr "Vis"

msgid "Whole Project"
msgstr "Hele projektet"

msgid "Rooms"
msgstr "Rum"

msgid "Main Groups"
msgstr "Hovedgrupper"

msgid "Device: {device}"
msgstr "Enhed: {device}"

msgid "Group Address: {address}"
msgstr "Gruppeadresse: {address}"

msgid "Back"
msgstr "Tilbage"

msgid "Fit"
msgstr "Tilpas"

msgid "Sending"
msgstr "Sendende"

msgid "Group Addresses"
msgstr "Gruppeadresser"

msgid "Receiving"
msgstr "Modtagende"

msgid "Areas"
msgstr "Områder"

msgid "Lines"
msgstr "Linjer"

msgid "Devices"
msgstr "Enheder"

msgid "Buildings"
msgstr "Bygninger"

msgid "+ {count} more"
msgstr "+ {count} mere"

msgid "{count} more devices outside the selection. Click to show them."
msgstr "{count} enheder mere uden for markeringen. Klik for at vise dem."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\n{senders} sender, {receivers} modtager"

msgid "Area {area}"
msgstr "Område {area}"

msgid "L {line}"
msgstr "L {line}"

msgid "Zoom with two fingers. Tap a device to open it."
msgstr "Zoom med to fingre. Tryk på en enhed for at åbne den."

msgid "(unnamed)"
msgstr "(unavngivet)"

msgid "Address: {address}"
msgstr "Adresse: {address}"

msgid "Application: {application}"
msgstr "Applikation: {application}"
