msgid "Topology"
msgstr "Topologi"

msgid "No project open"
msgstr "Ingen prosjekt åpent"

msgid "Unassigned"
msgstr "Ikke tilordnet"

msgid "Drag to move, Ctrl/Cmd+scroll to zoom. Click a device to open it."
msgstr "Dra for å flytte, Ctrl/Cmd+rulling for å zoome. Klikk på en enhet for å åpne den."

msgid "Physical"
msgstr "Fysisk"

msgid "Building"
msgstr "Bygning"

msgid "Links"
msgstr "Koblinger"

msgid "Which devices talk to which over their group addresses: sending devices on the left, receiving devices on the right."
msgstr "Hvilke enheter som kommuniserer med hvilke via gruppeadressene sine: sendende enheter til venstre, mottakende enheter til høyre."

msgid "Click to follow a device or group address, double-click to open a device. Drag to move, Ctrl/Cmd+scroll to zoom."
msgstr "Klikk for å følge en enhet eller gruppeadresse, dobbeltklikk for å åpne en enhet. Dra for å flytte, Ctrl/Cmd+rulling for å zoome."

msgid "Tap to follow a device or group address, double-tap to open a device. Zoom with two fingers."
msgstr "Trykk for å følge en enhet eller gruppeadresse, dobbelttrykk for å åpne en enhet. Zoom med to fingre."

msgid "No linked devices to show."
msgstr "Ingen koblede enheter å vise."

msgid "Show"
msgstr "Vis"

msgid "Whole Project"
msgstr "Hele prosjektet"

msgid "Rooms"
msgstr "Rom"

msgid "Main Groups"
msgstr "Hovedgrupper"

msgid "Device: {device}"
msgstr "Enhet: {device}"

msgid "Group Address: {address}"
msgstr "Gruppeadresse: {address}"

msgid "Back"
msgstr "Tilbake"

msgid "Fit"
msgstr "Tilpass"

msgid "Sending"
msgstr "Sendende"

msgid "Group Addresses"
msgstr "Gruppeadresser"

msgid "Receiving"
msgstr "Mottakende"

msgid "Areas"
msgstr "Områder"

msgid "Lines"
msgstr "Linjer"

msgid "Devices"
msgstr "Enheter"

msgid "Buildings"
msgstr "Bygninger"

msgid "+ {count} more"
msgstr "+ {count} til"

msgid "{count} more devices outside the selection. Click to show them."
msgstr "{count} flere enheter utenfor utvalget. Klikk for å vise dem."

msgid "{address}\n{senders} sending, {receivers} receiving"
msgstr "{address}\n{senders} sendende, {receivers} mottakende"

msgid "Area {area}"
msgstr "Område {area}"

msgid "L {line}"
msgstr "L {line}"

msgid "Zoom with two fingers. Tap a device to open it."
msgstr "Zoom med to fingre. Trykk på en enhet for å åpne den."

msgid "(unnamed)"
msgstr "(uten navn)"

msgid "Address: {address}"
msgstr "Adresse: {address}"

msgid "Application: {application}"
msgstr "Applikasjon: {application}"
