msgid ""
msgstr ""
"Project-Id-Version: xknx-editor signing 1.0\n"
"Language: sv\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Signing"
msgstr "Signering"

msgid "Signing Key…"
msgstr "Signeringsnyckel…"

msgid "A signing key is set (exports are signed)."
msgstr "En signeringsnyckel är angiven (exporter signeras)."

msgid "Placeholder key in use — signatures are not ETS-valid."
msgstr "Platshållarnyckel används — signaturerna är inte ETS-giltiga."

msgid "Modulus (hex)"
msgstr "Modulus (hex)"

msgid "Private Exponent (hex)"
msgstr "Privat exponent (hex)"

msgid "Public Exponent (hex)"
msgstr "Publik exponent (hex)"

msgid "Extract from Knx.Ets.XmlSigning.dll…"
msgstr "Extrahera från Knx.Ets.XmlSigning.dll…"

msgid "Save"
msgstr "Spara"

msgid "Reset to Placeholder"
msgstr "Återställ till platshållare"

msgid "All DLLs"
msgstr "Alla DLL-filer"

msgid "All Files"
msgstr "Alla filer"

msgid "Select \"Knx.Ets.XmlSigning.dll\" from your ETS installation (e.g. C:\\Program Files (x86)\\ETS6)."
msgstr "Välj \"Knx.Ets.XmlSigning.dll\" från din ETS-installation (t.ex. C:\\Program Files (x86)\\ETS6)."

msgid "Extracting key from the assembly…"
msgstr "Extraherar nyckel från assemblyn…"

msgid "Signing key saved."
msgstr "Signeringsnyckeln sparad."

msgid "Reverted to the placeholder key."
msgstr "Återställd till platshållarnyckeln."

msgid "No .NET runtime found. Install the .NET SDK (macOS: `brew install dotnet-sdk`; Fedora: `sudo dnf install dotnet-sdk-8.0`) to extract the key, or paste it manually below."
msgstr "Ingen .NET-körmiljö hittades. Installera .NET SDK (macOS: `brew install dotnet-sdk`; Fedora: `sudo dnf install dotnet-sdk-8.0`) för att extrahera nyckeln, eller klistra in den manuellt nedan."

msgid "The key is read from your own licensed ETS assembly and stored per-user, never in the project."
msgstr "Nyckeln läses från din egen licensierade ETS-assembly och sparas per användare, aldrig i projektet."

msgid "Based on OpenKNXproducer (github.com/OpenKNX/OpenKNXproducer)."
msgstr "Baserad på OpenKNXproducer (github.com/OpenKNX/OpenKNXproducer)."
