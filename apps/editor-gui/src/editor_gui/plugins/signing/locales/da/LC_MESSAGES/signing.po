#
msgid ""
msgstr ""
"Project-Id-Version: xknx-editor signing 1.0\n"
"Language: da\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Signing"
msgstr "Signering"

msgid "Signing Key…"
msgstr "Signeringsnøgle…"

msgid "A signing key is set (exports are signed)."
msgstr "Der er angivet en signeringsnøgle (eksporter signeres)."

msgid "Placeholder key in use — signatures are not ETS-valid."
msgstr "Pladsholdernøgle i brug — signaturerne er ikke ETS-gyldige."

msgid "Modulus (hex)"
msgstr "Modulus (hex)"

msgid "Private Exponent (hex)"
msgstr "Privat eksponent (hex)"

msgid "Public Exponent (hex)"
msgstr "Offentlig eksponent (hex)"

msgid "Extract from Knx.Ets.XmlSigning.dll…"
msgstr "Udtræk fra Knx.Ets.XmlSigning.dll…"

msgid "Save"
msgstr "Gem"

msgid "Reset to Placeholder"
msgstr "Nulstil til pladsholder"

msgid "All DLLs"
msgstr "Alle DLL'er"

msgid "All Files"
msgstr "Alle filer"

msgid "Select \"Knx.Ets.XmlSigning.dll\" from your ETS installation (e.g. C:\\Program Files (x86)\\ETS6)."
msgstr "Vælg \"Knx.Ets.XmlSigning.dll\" i din ETS-installation (f.eks. C:\\Program Files (x86)\\ETS6)."

msgid "Extracting key from the assembly…"
msgstr "Udtrækker nøgle fra assembly…"

msgid "Signing key saved."
msgstr "Signeringsnøgle gemt."

msgid "Reverted to the placeholder key."
msgstr "Vendt tilbage til pladsholdernøglen."

msgid "No .NET runtime found. Install the .NET SDK (macOS: `brew install dotnet-sdk`; Fedora: `sudo dnf install dotnet-sdk-8.0`) to extract the key, or paste it manually below."
msgstr "Ingen .NET-runtime fundet. Installer .NET SDK (macOS: `brew install dotnet-sdk`; Fedora: `sudo dnf install dotnet-sdk-8.0`) for at udtrække nøglen, eller indsæt den manuelt nedenfor."

msgid "The key is read from your own licensed ETS assembly and stored per-user, never in the project."
msgstr "Nøglen læses fra din egen licenserede ETS-assembly og gemmes pr. bruger, aldrig i projektet."

msgid "Based on OpenKNXproducer (github.com/OpenKNX/OpenKNXproducer)."
msgstr "Baseret på OpenKNXproducer (github.com/OpenKNX/OpenKNXproducer)."
