msgstr "Staða"

msgid "Set an address range and scan the bus."
msgstr "Settu vistfangasvið og leitaðu á tengibrautinni."

msgid "Scanning the bus…"
msgstr "Leitar á tengibrautinni…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Leitar á %(address)s  (%(done)d/%(total)d, fundust: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Sækir vörur sem vantar úr vörulista á netinu: %(what)s"

msgid "Reading devices…"
msgstr "Les tæki…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Les %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "töflur hópsamskipta"

msgid "parameter memory"
msgstr "færibreytuminni"

msgid "Recovered"
msgstr "Endurheimt"

msgid "Not connected to a KNX bus."
msgstr "Ekki tengt við KNX-tengibraut."

msgid "Open or create a project to add recovered devices."
msgstr "Opnaðu eða búðu til verkefni til að bæta við endurheimtum tækjum."

msgid "Product found"
msgstr "Vara fannst"

msgid "Check the product and version, then select it"
msgstr "Athugaðu vöru og útgáfu og veldu hana svo"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Ekki í vörulista: fluttu vöruna inn í Vörulista"

msgid "Not programmed"
msgstr "Ekki forritað"

msgid "Error"
msgstr "Villa"

msgid "Already in the project, skipped"
msgstr "Þegar í verkefninu, sleppt"

msgid "Recovered (incomplete)"
msgstr "Endurheimt (ófullgert)"

msgid "Search Effort"
msgstr "Leitarumfang"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Hversu mörg gildi eru prófuð fyrir stillingar sem tækið geymir ekki afrit af. Meira umfang finnur stillingar í tækjum með margar rásir en tekur lengri tíma. Ótakmarkað heldur áfram þar til ekkert gildi passar betur; Stöðva lýkur leitinni."

msgid "Fast"
msgstr "Hratt"

msgid "Medium"
msgstr "Miðlungs"

msgid "Maximum"
msgstr "Hámark"

msgid "Search Again"
msgstr "Leita Aftur"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Leitar aftur að stillingum valinna ófullgerðra tækja í því sem var lesið úr þeim, með völdu leitarumfangi. Þarf ekki bus. Tæki sem þegar hefur verið bætt við verkefnið er skipt út (eitt afturköllunarskref)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Leitar aftur í %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "meira leitarumfang gæti hjálpað"

msgid "Unlimited"
msgstr "Ótakmarkað"

msgid "Result"
msgstr "Niðurstaða"

msgid "Not read yet"
msgstr "Ekki lesið enn"

msgid "Verified"
msgstr "Staðfest"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d hópvistfang er án sendanda eða með fleiri en einn sendanda."
msgstr[1] "%(count)d hópvistföng eru án sendanda eða með fleiri en einn sendanda."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d tæki endurheimt"
msgstr[1] "%(count)d tæki endurheimt"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d hópvistfang"
msgstr[1] "%(count)d hópvistföng"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d tenging"
msgstr[1] "%(count)d tengingar"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d færibreyta"
msgstr[1] "%(count)d færibreytur"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "Ekki er hægt að endurheimta %(count)d færibreytu"
msgstr[1] "Ekki er hægt að endurheimta %(count)d færibreytur"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d færibreyta ekki fundin enn"
msgstr[1] "%(count)d færibreytur ekki fundnar enn"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d tæki bætt við opna verkefnið (%(target)s)."
msgstr[1] "%(count)d tækjum bætt við opna verkefnið (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Nýtt verkefni %(target)s búið til með %(count)d tæki."
msgstr[1] "Nýtt verkefni %(target)s búið til með %(count)d tækjum."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Ekki tókst að bæta við %(count)d tæki; ástæðan er í dálkinum „Niðurstaða“."
msgstr[1] "Ekki tókst að bæta við %(count)d tækjum; ástæðan er í dálkinum „Niðurstaða“."

msgid "Differs from the device: %(what)s"
msgstr "Víkur frá tækinu: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d bæti"
msgstr[1] "%(count)d bæti"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d samskiptahlutur"
msgstr[1] "%(count)d samskiptahlutir"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Staðfesting: %(count)d bæti víkur frá"
msgstr[1] "Staðfesting: %(count)d bæti víkja frá"
