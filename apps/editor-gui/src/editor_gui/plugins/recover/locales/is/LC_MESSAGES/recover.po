msgstr "Leitar á tengibrautinni…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Leitar á %(address)s  (%(done)d/%(total)d, fundust: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Sækir vörur sem vantar úr vörulista á netinu: %(what)s"

msgid "Reading devices…"
msgstr "Les tæki…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Les %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "töflur hópsamskipta"

msgid "parameter memory"
msgstr "færibreytuminni"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Endurheimt tæki: %(devices)d; hópvistföng: %(group_addresses)d, tengingar: %(links)d, færibreytur sem ekki var hægt að endurheimta: %(unknown)d."

msgid "Recovered"
msgstr "Endurheimt"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Tækjum bætt við opna verkefnið (%(target)s): %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Nýtt verkefni %(target)s búið til; tæki: %(count)d."

msgid "Not connected to a KNX bus."
msgstr "Ekki tengt við KNX-tengibraut."

msgid "Open or create a project to add recovered devices."
msgstr "Opnaðu eða búðu til verkefni til að bæta við endurheimtum tækjum."

msgid "matched"
msgstr "samsvarar"

msgid "confirm product/version, then tick"
msgstr "staðfestu vöru/útgáfu og hakaðu svo við"

msgid "not in catalog - import via Catalog"
msgstr "ekki í vörulista - fluttu inn í gegnum Vörulista"

msgid "unprogrammed"
msgstr "óforritað"

msgid "recovered"
msgstr "endurheimt"

msgid "error"
msgstr "villa"

msgid "%d parameters could not be recovered"
msgstr "Færibreytur sem ekki var hægt að endurheimta: %d"

msgid "already in project - skipped"
msgstr "þegar í verkefni - sleppt"

msgid "%(count)d device(s) could not be added; the reason is in the Recovered column."
msgstr "Ekki tókst að bæta við tækjum: %(count)d; ástæðan er í dálkinum „Endurheimt“."

msgid "recovered (incomplete)"
msgstr "endurheimt (ófullgert)"

msgid "Search Effort"
msgstr "Leitarumfang"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Hversu mörg gildi eru prófuð fyrir stillingar sem tækið geymir ekki afrit af. Meira umfang finnur stillingar í tækjum með margar rásir en tekur lengri tíma. Ótakmarkað heldur áfram þar til ekkert gildi passar betur; Stöðva lýkur leitinni."

msgid "Fast"
msgstr "Hratt"

msgid "Medium"
msgstr "Miðlungs"

msgid "Maximum"
msgstr "Hámark"

msgid "Search Again"
msgstr "Leita Aftur"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Leitar aftur að stillingum valinna ófullgerðra tækja í því sem var lesið úr þeim, með völdu leitarumfangi. Þarf ekki bus. Tæki sem þegar hefur verið bætt við verkefnið er skipt út (eitt afturköllunarskref)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Leitar aftur í %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d bæti og %(objects)d samskiptahlutir víkja frá tækinu"

msgid "more search effort may help"
msgstr "meira leitarumfang gæti hjálpað"

msgid "Unlimited"
msgstr "Ótakmarkað"
