msgid "Recover Project from Bus"
msgstr "Rikupero projektin nga busi"

msgid "From Address"
msgstr "Nga adresa"

msgid "To Address"
msgstr "Deri te adresa"

msgid "Scan"
msgstr "Kërko"

msgid "Stop"
msgstr "Ndalo"

msgid "Add to Open Project as Read"
msgstr "Shto në projektin e hapur sapo të lexohen"

msgid "Recover Selected"
msgstr "Rikupero të zgjedhurat"

msgid "Create New Project"
msgstr "Krijo projekt të ri"

msgid "Add to Open Project"
msgstr "Shto në projektin e hapur"

msgid "Verify (Read-Only)"
msgstr "Verifiko (vetëm lexim)"

msgid "Export Snapshot"
msgstr "Eksporto pamjen e çastit"

msgid "Verifying (re-reading and comparing)…"
msgstr "Po verifikohet (rilexim dhe krahasim)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d adresë(a) grupi nuk kanë dërgues ose kanë disa dërgues."

msgid "Address"
msgstr "Adresa"

msgid "Mask"
msgstr "Maska"

msgid "Product/Application"
msgstr "Produkti/Programi aplikativ"

msgid "Status"
msgstr "Gjendja"

msgid "Set an address range and scan the bus."
msgstr "Përcaktoni një diapazon adresash dhe kërkoni në bus."

msgid "Scanning the bus…"
msgstr "Po kërkohet në bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Po kërkohet %(address)s  (%(done)d/%(total)d, %(found)d të gjetura)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Po ngarkohen produktet që mungojnë nga katalogu online: %(what)s"

msgid "Reading devices…"
msgstr "Po lexohen pajisjet…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Po lexohet %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabelat e komunikimit në grup"

msgid "parameter memory"
msgstr "memoria e parametrave"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "U rikuperuan %(devices)d pajisje: %(group_addresses)d adresa grupi, %(links)d lidhje, %(unknown)d parametër(a) të parikuperueshëm."

msgid "Recovered"
msgstr "Rikuperuar"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "U shtuan %(count)d pajisje në projektin e hapur (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "U krijua projekti i ri %(target)s me %(count)d pajisje."

msgid "Not connected to a KNX bus."
msgstr "Nuk ka lidhje me një bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Hapni ose krijoni një projekt për të shtuar pajisjet e rikuperuara."

msgid "Product found"
msgstr "Produkti u gjet"

msgid "Check the product and version, then select it"
msgstr "Kontrolloni produktin dhe versionin, pastaj zgjidheni"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Nuk është në katalog: importojeni produktin e tij në Katalog"

msgid "Not programmed"
msgstr "I paprogramuar"


msgid "Already in the project, skipped"
msgstr "Tashmë në projekt, u anashkalua"

msgid "Error"
msgstr "Gabim"

msgid "%d parameters could not be recovered"
msgstr "%d parametra nuk u rikuperuan"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "%(count)d pajisje nuk mund të shtoheshin; arsyeja është në kolonën “Rezultati”."

msgid "Recovered (incomplete)"
msgstr "Rikuperuar (jo i plotë)"

msgid "Search Effort"
msgstr "Përpjekja e Kërkimit"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Sa vlera provohen për cilësimet për të cilat pajisja nuk ruan kopje. Më shumë përpjekje gjen cilësime në pajisje me shumë kanale, por zgjat më shumë. Pa kufi vazhdon derisa asnjë vlerë të mos përshtatet më mirë; Ndalo e përfundon kërkimin."

msgid "Fast"
msgstr "Shpejt"

msgid "Medium"
msgstr "Mesatare"

msgid "Maximum"
msgstr "Maksimale"

msgid "Search Again"
msgstr "Kërko Përsëri"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Kërkon përsëri cilësimet e pajisjeve të paplota të zgjedhura në atë që u lexua prej tyre, me përpjekjen e zgjedhur të kërkimit. Nuk kërkon bus. Një pajisje e shtuar tashmë në projekt zëvendësohet (një hap zhbërjeje)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Po kërkohet përsëri %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d bajt dhe %(objects)d objekte të grupit ndryshojnë nga pajisja"

msgid "more search effort may help"
msgstr "më shumë përpjekje kërkimi mund të ndihmojë"

msgid "Unlimited"
msgstr "Pa kufi"

msgid "Result"
msgstr "Rezultati"

msgid "Not read yet"
msgstr "Ende i palexuar"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d adresa grupi, %(links)d lidhje, %(parameters)d parametra"

msgid "%(count)d unknown"
msgstr "%(count)d të panjohura"

msgid "Verified"
msgstr "U verifikua"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Verifikimi: ndryshojnë %(bytes)d bajt"
