msgstr "Van de bus herstellen…"

msgid "Recovered"
msgstr "Hersteld"

msgid "Scan"
msgstr "Zoeken"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "%(address)s doorzoeken  (%(done)d/%(total)d, %(found)d gevonden)"

