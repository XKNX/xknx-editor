msgstr[1] "%(count)d parameters nog niet gevonden"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d apparaat aan het geopende project toegevoegd (%(target)s)."
msgstr[1] "%(count)d apparaten aan het geopende project toegevoegd (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Nieuw project %(target)s gemaakt met %(count)d apparaat."
msgstr[1] "Nieuw project %(target)s gemaakt met %(count)d apparaten."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d apparaat kon niet worden toegevoegd; de reden staat in de kolom 'Resultaat'."
msgstr[1] "%(count)d apparaten konden niet worden toegevoegd; de reden staat in de kolom 'Resultaat'."

