msgstr[0] "Controle: %(count)d byte wijkt af"
msgstr[1] "Controle: %(count)d bytes wijken af"

msgid "Import Snapshot…"
msgstr "Momentopname importeren…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "%(count)d apparaat geïmporteerd uit %(file)s."
msgstr[1] "%(count)d apparaten geïmporteerd uit %(file)s."

