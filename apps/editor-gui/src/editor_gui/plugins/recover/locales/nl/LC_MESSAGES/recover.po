msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d groepsadres(sen) hebben geen of meerdere zenders."

msgid "%d parameters could not be recovered"
msgstr "%d parameters konden niet worden hersteld"

msgid "Add to Open Project"
msgstr "Aan geopend project toevoegen"

msgid "Add to Open Project as Read"
msgstr "Aan geopend project toevoegen (gelezen)"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "%(count)d apparaat/apparaten aan het geopende project toegevoegd (%(target)s)."

msgid "Address"
msgstr "Adres"

msgid "Create New Project"
msgstr "Nieuw project maken"

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Nieuw project %(target)s gemaakt met %(count)d apparaat/apparaten."

msgid "Export Snapshot"
msgstr "Momentopname exporteren"

msgid "From Address"
msgstr "Van adres"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Ontbrekende producten worden uit de onlinecatalogus geladen: %(what)s"

msgid "Mask"
msgstr "Masker"

msgid "Not connected to a KNX bus."
msgstr "Niet verbonden met een KNX-bus."

msgid "Open or create a project to add recovered devices."
msgstr "Open of maak een project om herstelde apparaten toe te voegen."

msgid "Product/Application"
msgstr "Product/applicatie"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "%(address)s lezen  (%(done)d/%(total)d)  -  %(stage)s"

msgid "Reading devices…"
msgstr "Apparaten lezen…"

msgid "Recover"
msgstr "Herstellen"

msgid "Recover Project from Bus"
msgstr "Project van de bus herstellen"

msgid "Recover Selected"
msgstr "Geselecteerde herstellen"

msgid "Recover from Bus…"
msgstr "Van de bus herstellen…"

msgid "Recovered"
msgstr "Hersteld"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "%(devices)d apparaat/apparaten hersteld: %(group_addresses)d groepsadressen, %(links)d koppelingen, %(unknown)d parameter(s) niet herstelbaar."

msgid "Scan"
msgstr "Zoeken"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "%(address)s doorzoeken  (%(done)d/%(total)d, %(found)d gevonden)"

msgid "Scanning the bus…"
msgstr "Bus wordt doorzocht…"

msgid "Set an address range and scan the bus."
msgstr "Stel een adresbereik in en doorzoek de bus."

msgid "Status"
msgstr "Status"

msgid "Stop"
msgstr "Stoppen"

msgid "To Address"
msgstr "Tot adres"

msgid "Verify (Read-Only)"
msgstr "Verifiëren (alleen lezen)"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verifiëren (opnieuw lezen en vergelijken)…"

msgid "already in project - skipped"
msgstr "al in project - overgeslagen"

msgid "confirm product/version, then tick"
msgstr "product/versie bevestigen, dan aanvinken"

msgid "error"
msgstr "fout"

msgid "group communication tables"
msgstr "groepscommunicatietabellen"

msgid "matched"
msgstr "overeenkomend"

msgid "not in catalog - import via Catalog"
msgstr "niet in catalogus - importeren via Catalogus"

msgid "parameter memory"
msgstr "parametergeheugen"

msgid "recovered"
msgstr "hersteld"

msgid "unprogrammed"
msgstr "niet geprogrammeerd"

msgid "%(count)d device(s) could not be added; the reason is in the Recovered column."
msgstr "%(count)d apparaat/apparaten kon(den) niet worden toegevoegd; de reden staat in de kolom 'Hersteld'."

msgid "recovered (incomplete)"
msgstr "hersteld (onvolledig)"

msgid "Search Effort"
msgstr "Zoekinspanning"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer."
msgstr "Hoeveel waarden worden geprobeerd voor de instellingen waarvan het apparaat geen kopie bewaart. Meer inspanning vindt instellingen in apparaten met veel kanalen, maar duurt langer."

msgid "Fast"
msgstr "Snel"

msgid "Medium"
msgstr "Gemiddeld"

msgid "Maximum"
msgstr "Maximaal"

msgid "Search Again"
msgstr "Opnieuw zoeken"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Zoekt de instellingen van de geselecteerde onvolledige apparaten opnieuw in wat ervan is gelezen, met de gekozen zoekinspanning. Heeft geen bus nodig. Een apparaat dat al aan het project is toegevoegd, wordt vervangen (één ongedaan-maakstap)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "%(address)s opnieuw zoeken  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d byte(s) en %(objects)d groepsobject(en) wijken af van het apparaat"

msgid "more search effort may help"
msgstr "meer zoekinspanning kan helpen"
