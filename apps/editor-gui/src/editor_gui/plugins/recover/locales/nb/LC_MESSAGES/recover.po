msgstr[1] "%(count)d parametere kan ikke gjenopprettes"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parameter ikke funnet ennå"
msgstr[1] "%(count)d parametere ikke funnet ennå"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "La til %(count)d enhet i det åpne prosjektet (%(target)s)."
msgstr[1] "La til %(count)d enheter i det åpne prosjektet (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Opprettet nytt prosjekt %(target)s med %(count)d enhet."
msgstr[1] "Opprettet nytt prosjekt %(target)s med %(count)d enheter."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d enhet kunne ikke legges til; årsaken står i kolonnen «Resultat»."
msgstr[1] "%(count)d enheter kunne ikke legges til; årsaken står i kolonnen «Resultat»."

msgid "Differs from the device: %(what)s"
msgstr "Avviker fra enheten: %(what)s"

