msgid "Recover Project from Bus"
msgstr "Gjenopprett prosjekt fra bussen"

msgid "From Address"
msgstr "Fra adresse"

msgid "To Address"
msgstr "Til adresse"

msgid "Scan"
msgstr "Skann"

msgid "Stop"
msgstr "Stopp"

msgid "Add to Open Project as Read"
msgstr "Legg til i åpent prosjekt som lest"

msgid "Recover Selected"
msgstr "Gjenopprett valgte"

msgid "Create New Project"
msgstr "Opprett nytt prosjekt"

msgid "Add to Open Project"
msgstr "Legg til i åpent prosjekt"

msgid "Verify (Read-Only)"
msgstr "Verifiser (skrivebeskyttet)"

msgid "Export Snapshot"
msgstr "Eksporter øyeblikksbilde"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verifiserer (leser på nytt og sammenligner)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d gruppeadresse(r) har ingen eller flere avsendere."

msgid "Address"
msgstr "Adresse"

msgid "Mask"
msgstr "Maske"

msgid "Product/Application"
msgstr "Produkt/applikasjon"

msgid "Status"
msgstr "Status"

msgid "Set an address range and scan the bus."
msgstr "Angi et adresseområde og skann bussen."

msgid "Scanning the bus…"
msgstr "Skanner bussen…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Skanner %(address)s  (%(done)d/%(total)d, %(found)d funnet)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Laster manglende produkter fra nettkatalogen: %(what)s"

msgid "Reading devices…"
msgstr "Leser enheter…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Leser %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "gruppekommunikasjonstabeller"

msgid "parameter memory"
msgstr "parameterminne"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Gjenopprettet %(devices)d enhet(er): %(group_addresses)d gruppeadresser, %(links)d koblinger, %(unknown)d parameter(e) kunne ikke gjenopprettes."

msgid "Recovered"
msgstr "Gjenopprettet"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "La til %(count)d enhet(er) i det åpne prosjektet (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Opprettet nytt prosjekt %(target)s med %(count)d enhet(er)."

msgid "Not connected to a KNX bus."
msgstr "Ikke koblet til en KNX-buss."

msgid "Open or create a project to add recovered devices."
msgstr "Åpne eller opprett et prosjekt for å legge til gjenopprettede enheter."

msgid "Product found"
msgstr "Produkt funnet"

msgid "Check the product and version, then select it"
msgstr "Kontroller produkt og versjon, og velg det deretter"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Ikke i katalogen: importer produktet i Katalog"

msgid "Not programmed"
msgstr "Ikke programmert"


msgid "Already in the project, skipped"
msgstr "Allerede i prosjektet, hoppet over"

msgid "Error"
msgstr "Feil"

msgid "%d parameters could not be recovered"
msgstr "%d parametre kunne ikke gjenopprettes"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "%(count)d enhet(er) kunne ikke legges til; årsaken står i kolonnen «Resultat»."

msgid "Recovered (incomplete)"
msgstr "Gjenopprettet (ufullstendig)"

msgid "Search Effort"
msgstr "Søkeinnsats"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Hvor mange verdier som prøves for innstillingene enheten ikke lagrer en kopi av. Mer innsats finner innstillinger i enheter med mange kanaler, men tar lengre tid. Ubegrenset fortsetter til ingen verdi passer bedre; Stopp avslutter søket."

msgid "Fast"
msgstr "Rask"

msgid "Medium"
msgstr "Middels"

msgid "Maximum"
msgstr "Maksimal"

msgid "Search Again"
msgstr "Søk Igjen"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Søker på nytt etter innstillingene til de valgte ufullstendige enhetene i det som ble lest fra dem, med valgt søkeinnsats. Trenger ingen buss. En enhet som allerede er lagt til i prosjektet, erstattes (ett angretrinn)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Søker på nytt i %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d byte og %(objects)d gruppeobjekt(er) avviker fra enheten"

msgid "more search effort may help"
msgstr "mer søkeinnsats kan hjelpe"

msgid "Unlimited"
msgstr "Ubegrenset"

msgid "Result"
msgstr "Resultat"

msgid "Not read yet"
msgstr "Ikke lest ennå"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d gruppeadresser, %(links)d koblinger, %(parameters)d parametere"

msgid "%(count)d unknown"
msgstr "%(count)d ukjente"

msgid "Verified"
msgstr "Kontrollert"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Kontroll: %(bytes)d byte avviker"
