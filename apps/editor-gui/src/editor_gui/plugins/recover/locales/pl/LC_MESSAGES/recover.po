msgstr "Weryfikacja (ponowny odczyt i porównanie)…"

msgid "Address"
msgstr "Adres"

msgid "Mask"
msgstr "Maska"

msgid "Product/Application"
msgstr "Produkt/aplikacja"

msgid "Status"
msgstr "Status"

msgid "Set an address range and scan the bus."
msgstr "Należy ustawić zakres adresów i przeskanować magistralę."

msgid "Scanning the bus…"
msgstr "Skanowanie magistrali…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Skanowanie %(address)s  (%(done)d/%(total)d, znalezione: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Ładowanie brakujących produktów z katalogu online: %(what)s"

msgid "Reading devices…"
msgstr "Odczyt urządzeń…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Odczyt %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tablice komunikacji grupowej"

msgid "parameter memory"
msgstr "pamięć parametrów"

msgid "Recovered"
msgstr "Odzyskane"

msgid "Not connected to a KNX bus."
msgstr "Brak połączenia z magistralą KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Aby dodać odzyskane urządzenia, należy otworzyć lub utworzyć projekt."

msgid "Product found"
msgstr "Znaleziono produkt"

msgid "Check the product and version, then select it"
msgstr "Sprawdź produkt i wersję, a następnie go zaznacz"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Brak w katalogu: zaimportuj jego produkt w Katalogu"

msgid "Not programmed"
msgstr "Nie zaprogramowane"

msgid "Already in the project, skipped"
msgstr "Już w projekcie, pominięte"

msgid "Error"
msgstr "Błąd"

msgid "Recovered (incomplete)"
msgstr "Odzyskane (niekompletne)"

msgid "Search Effort"
msgstr "Nakład Wyszukiwania"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Ile wartości jest sprawdzanych dla ustawień, których kopii urządzenie nie przechowuje. Większy nakład znajduje ustawienia w urządzeniach z wieloma kanałami, ale trwa dłużej. Bez ograniczeń szuka, dopóki żadna wartość nie pasuje lepiej; Zatrzymaj kończy wyszukiwanie."

msgid "Fast"
msgstr "Szybki"

msgid "Medium"
msgstr "Średni"

msgid "Maximum"
msgstr "Maksymalny"

msgid "Search Again"
msgstr "Szukaj Ponownie"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Ponownie wyszukuje ustawienia wybranych niekompletnych urządzeń w danych z nich odczytanych, z wybranym nakładem wyszukiwania. Nie wymaga magistrali. Urządzenie już dodane do projektu zostaje zastąpione (jeden krok cofania)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Ponowne wyszukiwanie dla %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "większy nakład wyszukiwania może pomóc"

msgid "Unlimited"
msgstr "Bez ograniczeń"

msgid "Result"
msgstr "Wynik"

msgid "Not read yet"
msgstr "Jeszcze nie odczytane"

msgid "Verified"
msgstr "Sprawdzone"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d adres grupowy nie ma nadawcy lub ma wielu nadawców."
msgstr[1] "%(count)d adresy grupowe nie mają nadawcy lub mają wielu nadawców."
msgstr[2] "%(count)d adresów grupowych nie ma nadawcy lub ma wielu nadawców."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "Odzyskano %(count)d urządzenie"
msgstr[1] "Odzyskano %(count)d urządzenia"
msgstr[2] "Odzyskano %(count)d urządzeń"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d adres grupowy"
msgstr[1] "%(count)d adresy grupowe"
msgstr[2] "%(count)d adresów grupowych"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d powiązanie"
msgstr[1] "%(count)d powiązania"
msgstr[2] "%(count)d powiązań"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d parametr"
msgstr[1] "%(count)d parametry"
msgstr[2] "%(count)d parametrów"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parametru nie można odzyskać"
msgstr[1] "%(count)d parametrów nie można odzyskać"
msgstr[2] "%(count)d parametrów nie można odzyskać"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parametr jeszcze nieznaleziony"
msgstr[1] "%(count)d parametry jeszcze nieznalezione"
msgstr[2] "%(count)d parametrów jeszcze nieznalezionych"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "Dodano %(count)d urządzenie do otwartego projektu (%(target)s)."
msgstr[1] "Dodano %(count)d urządzenia do otwartego projektu (%(target)s)."
msgstr[2] "Dodano %(count)d urządzeń do otwartego projektu (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Utworzono nowy projekt %(target)s z %(count)d urządzeniem."
msgstr[1] "Utworzono nowy projekt %(target)s z %(count)d urządzeniami."
msgstr[2] "Utworzono nowy projekt %(target)s z %(count)d urządzeniami."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Nie udało się dodać %(count)d urządzenia; przyczyna jest w kolumnie „Wynik”."
msgstr[1] "Nie udało się dodać %(count)d urządzeń; przyczyna jest w kolumnie „Wynik”."
msgstr[2] "Nie udało się dodać %(count)d urządzeń; przyczyna jest w kolumnie „Wynik”."

msgid "Differs from the device: %(what)s"
msgstr "Różni się od urządzenia: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d bajt"
msgstr[1] "%(count)d bajty"
msgstr[2] "%(count)d bajtów"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d obiekt grupy"
msgstr[1] "%(count)d obiekty grupy"
msgstr[2] "%(count)d obiektów grupy"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Sprawdzenie: różni się %(count)d bajt"
msgstr[1] "Sprawdzenie: różnią się %(count)d bajty"
msgstr[2] "Sprawdzenie: różni się %(count)d bajtów"

msgid "Import Snapshot…"
msgstr "Importuj migawkę…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "Zaimportowano %(count)d urządzenie z %(file)s."
msgstr[1] "Zaimportowano %(count)d urządzenia z %(file)s."
msgstr[2] "Zaimportowano %(count)d urządzeń z %(file)s."

msgid "%(file)s is no recovery snapshot: %(error)s"
msgstr "%(file)s nie jest migawką odzyskiwania: %(error)s"

msgid "Recovery Snapshot (*.json)"
msgstr "Migawka odzyskiwania (*.json)"

msgid "All Files"
msgstr "Wszystkie pliki"

msgid "Device mask: %(device)s; product mask: %(product)s"
msgstr "Maska urządzenia: %(device)s; maska produktu: %(product)s"

msgid "Mask compatibility data unavailable; only exact masks checked"
msgstr "Brak danych o zgodności masek; sprawdzono tylko identyczne maski"

msgid "The application version missing from the local catalog was found in the alternative catalog. A login is required to download it. Enter your username and password in Settings > Catalog."
msgstr "Wersja aplikacji brakująca w lokalnym katalogu została znaleziona w alternatywnym katalogu. Jej pobranie wymaga zalogowania. Wprowadź nazwę użytkownika i hasło w Ustawienia > Katalog."
