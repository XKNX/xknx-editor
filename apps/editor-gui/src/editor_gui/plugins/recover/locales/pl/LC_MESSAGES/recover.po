msgid "Recover Project from Bus"
msgstr "Odzyskaj projekt z magistrali"

msgid "From Address"
msgstr "Od adresu"

msgid "To Address"
msgstr "Do adresu"

msgid "Scan"
msgstr "Skanuj"

msgid "Stop"
msgstr "Zatrzymaj"

msgid "Add to Open Project When Read"
msgstr "Dodaj do otwartego projektu po odczytaniu"

msgid "Recover Selected"
msgstr "Odzyskaj wybrane"

