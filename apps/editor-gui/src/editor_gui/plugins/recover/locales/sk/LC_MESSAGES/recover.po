msgstr "nie je v katalógu – importujte cez Katalóg"

msgid "unprogrammed"
msgstr "nenaprogramované"

msgid "recovered"
msgstr "obnovené"

msgid "error"
msgstr "chyba"

msgid "%d parameters could not be recovered"
msgstr "Parametre, ktoré sa nepodarilo obnoviť: %d"

