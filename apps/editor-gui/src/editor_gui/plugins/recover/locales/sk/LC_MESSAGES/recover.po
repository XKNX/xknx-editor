msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "Do otvoreného projektu (%(target)s) bolo pridané %(count)d zariadenie."
msgstr[1] "Do otvoreného projektu (%(target)s) boli pridané %(count)d zariadenia."
msgstr[2] "Do otvoreného projektu (%(target)s) bolo pridaných %(count)d zariadení."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Vytvorený nový projekt %(target)s s %(count)d zariadením."
msgstr[1] "Vytvorený nový projekt %(target)s s %(count)d zariadeniami."
msgstr[2] "Vytvorený nový projekt %(target)s s %(count)d zariadeniami."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Nepodarilo sa pridať %(count)d zariadenie; dôvod je v stĺpci „Výsledok“."
msgstr[1] "Nepodarilo sa pridať %(count)d zariadenia; dôvod je v stĺpci „Výsledok“."
msgstr[2] "Nepodarilo sa pridať %(count)d zariadení; dôvod je v stĺpci „Výsledok“."

msgid "Differs from the device: %(what)s"
msgstr "Líši sa od zariadenia: %(what)s"

