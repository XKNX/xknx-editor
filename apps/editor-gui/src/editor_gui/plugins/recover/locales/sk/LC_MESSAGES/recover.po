msgid "Recover"
msgstr "Obnoviť"

msgid "Recover from Bus…"
msgstr "Obnoviť zo zbernice…"

msgid "Recover Project from Bus"
msgstr "Obnoviť projekt zo zbernice"

msgid "From Address"
msgstr "Od adresy"

msgid "To Address"
msgstr "Po adresu"

msgid "Scan"
msgstr "Hľadať"

msgid "Stop"
msgstr "Zastaviť"

msgid "Add to Open Project When Read"
msgstr "Pridať do otvoreného projektu po načítaní"

msgid "Recover Selected"
msgstr "Obnoviť vybrané"

msgid "Create New Project"
msgstr "Vytvoriť nový projekt"

msgid "Add to Open Project"
msgstr "Pridať do otvoreného projektu"

msgid "Verify (Read-Only)"
msgstr "Overiť (len čítanie)"

msgid "Export Snapshot"
msgstr "Exportovať snímku"

msgid "Verifying (re-reading and comparing)…"
msgstr "Overuje sa (opakované čítanie a porovnanie)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "Skupinové adresy bez vysielača alebo s viacerými vysielačmi: %(count)d."

msgid "Address"
msgstr "Adresa"

msgid "Mask"
msgstr "Maska"

msgid "Product/Application"
msgstr "Produkt/aplikácia"

msgid "Status"
msgstr "Stav"

msgid "Set an address range and scan the bus."
msgstr "Nastavte rozsah adries a prehľadajte zbernicu."

msgid "Scanning the bus…"
msgstr "Prehľadáva sa zbernica…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Hľadá sa %(address)s  (%(done)d/%(total)d, nájdené: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Načítavajú sa chýbajúce produkty z online katalógu: %(what)s"

msgid "Reading devices…"
msgstr "Čítajú sa zariadenia…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Číta sa %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabuľky skupinovej komunikácie"

msgid "parameter memory"
msgstr "pamäť parametrov"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Obnovené zariadenia: %(devices)d – skupinové adresy: %(group_addresses)d, prepojenia: %(links)d, neobnoviteľné parametre: %(unknown)d."

msgid "Recovered"
msgstr "Obnovené"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Zariadenia pridané do otvoreného projektu (%(target)s): %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Vytvorený nový projekt %(target)s, počet zariadení: %(count)d."

msgid "Not connected to a KNX bus."
msgstr "Nepripojené k zbernici KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Na pridanie obnovených zariadení otvorte alebo vytvorte projekt."

msgid "Product found"
msgstr "Produkt nájdený"

msgid "Check the product and version, then select it"
msgstr "Skontrolujte produkt a verziu a potom ho vyberte"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Nie je v katalógu: importujte jeho produkt v Katalógu"

msgid "Not programmed"
msgstr "Nenaprogramované"


msgid "Error"
msgstr "Chyba"

msgid "%d parameters could not be recovered"
msgstr "Parametre, ktoré sa nepodarilo obnoviť: %d"

msgid "Already in the project, skipped"
msgstr "Už v projekte, preskočené"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "Zariadenia, ktoré sa nepodarilo pridať: %(count)d; dôvod je v stĺpci „Výsledok“."

msgid "Recovered (incomplete)"
msgstr "Obnovené (neúplné)"

msgid "Search Effort"
msgstr "Rozsah Hľadania"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Koľko hodnôt sa skúša pre nastavenia, ktorých kópiu zariadenie neuchováva. Väčší rozsah nájde nastavenia v zariadeniach s mnohými kanálmi, ale trvá dlhšie. Neobmedzený hľadá, kým žiadna hodnota nesedí lepšie; Zastaviť hľadanie ukončí."

msgid "Fast"
msgstr "Rýchly"

msgid "Medium"
msgstr "Stredný"

msgid "Maximum"
msgstr "Maximálny"

msgid "Search Again"
msgstr "Hľadať Znova"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Znova vyhľadá nastavenia vybraných neúplných zariadení v údajoch z nich prečítaných, so zvoleným rozsahom hľadania. Nepotrebuje zbernicu. Zariadenie už pridané do projektu sa nahradí (jeden krok späť)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Nové hľadanie pre %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d bajt(ov) a %(objects)d skupinový(ch) objekt(ov) sa líši od zariadenia"

msgid "more search effort may help"
msgstr "väčší rozsah hľadania môže pomôcť"

msgid "Unlimited"
msgstr "Neobmedzený"

msgid "Result"
msgstr "Výsledok"

msgid "Not read yet"
msgstr "Zatiaľ neprečítané"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "Skupinové adresy: %(group_addresses)d, prepojenia: %(links)d, parametre: %(parameters)d"

msgid "%(count)d unknown"
msgstr "Neznáme: %(count)d"

msgid "Verified"
msgstr "Overené"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Overenie: líši sa bajtov: %(bytes)d"
