msgid "Recover Project from Bus"
msgstr "Projeyi Bus'tan Kurtar"

msgid "From Address"
msgstr "Başlangıç Adresi"

msgid "To Address"
msgstr "Bitiş Adresi"

msgid "Scan"
msgstr "Tara"

msgid "Stop"
msgstr "Durdur"

msgid "Add to Open Project as Read"
msgstr "Açık Projeye Okunmuş Olarak Ekle"

msgid "Recover Selected"
msgstr "Seçilenleri Kurtar"

msgid "Create New Project"
msgstr "Yeni Proje Oluştur"

msgid "Add to Open Project"
msgstr "Açık Projeye Ekle"

msgid "Verify (Read-Only)"
msgstr "Doğrula (Salt Okunur)"

msgid "Export Snapshot"
msgstr "Anlık Görüntüyü Dışa Aktar"

msgid "Verifying (re-reading and comparing)…"
msgstr "Doğrulanıyor (yeniden okunuyor ve karşılaştırılıyor)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d grup adresinin göndericisi yok veya birden fazla göndericisi var."

msgid "Address"
msgstr "Adres"

msgid "Mask"
msgstr "Maske"

msgid "Product/Application"
msgstr "Ürün/Uygulama"

msgid "Status"
msgstr "Durum"

msgid "Set an address range and scan the bus."
msgstr "Bir adres aralığı belirleyin ve bus'ı tarayın."

msgid "Scanning the bus…"
msgstr "Bus taranıyor…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Taranıyor: %(address)s  (%(done)d/%(total)d, %(found)d bulundu)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Eksik ürünler çevrimiçi katalogdan yükleniyor: %(what)s"

msgid "Reading devices…"
msgstr "Cihazlar okunuyor…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Okunuyor: %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "grup iletişimi tabloları"

msgid "parameter memory"
msgstr "parametre belleği"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "%(devices)d cihaz kurtarıldı: %(group_addresses)d grup adresi, %(links)d bağlantı, kurtarılamayan %(unknown)d parametre."

msgid "Recovered"
msgstr "Kurtarıldı"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Açık projeye %(count)d cihaz eklendi (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "%(count)d cihazla yeni proje oluşturuldu: %(target)s."

msgid "Not connected to a KNX bus."
msgstr "Bir KNX bus'ına bağlı değil."

msgid "Open or create a project to add recovered devices."
msgstr "Kurtarılan cihazları eklemek için bir proje açın veya oluşturun."

msgid "Product found"
msgstr "Ürün bulundu"

msgid "Check the product and version, then select it"
msgstr "Ürünü ve sürümü kontrol edin, ardından seçin"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Katalogda değil: ürününü Katalog'da içe aktarın"

msgid "Not programmed"
msgstr "Programlanmamış"


msgid "Already in the project, skipped"
msgstr "Zaten projede, atlandı"

msgid "Error"
msgstr "Hata"

msgid "%d parameters could not be recovered"
msgstr "%d parametre kurtarılamadı"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "%(count)d cihaz eklenemedi; nedeni \"Sonuç\" sütununda."

msgid "Recovered (incomplete)"
msgstr "Kurtarıldı (eksik)"

msgid "Search Effort"
msgstr "Arama Kapsamı"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Cihazın kopyasını tutmadığı ayarlar için kaç değerin deneneceği. Daha geniş kapsam çok kanallı cihazlardaki ayarları bulur, ancak daha uzun sürer. Sınırsız, hiçbir değer daha iyi uymayana kadar devam eder; Durdur aramayı bitirir."

msgid "Fast"
msgstr "Hızlı"

msgid "Medium"
msgstr "Orta"

msgid "Maximum"
msgstr "En Yüksek"

msgid "Search Again"
msgstr "Yeniden Ara"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Seçili eksik cihazların ayarlarını, onlardan okunan veride seçilen arama kapsamıyla yeniden arar. Hat bağlantısı gerekmez. Projeye zaten eklenmiş bir cihaz değiştirilir (tek geri alma adımı)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "%(address)s yeniden aranıyor  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d bayt ve %(objects)d grup nesnesi cihazdan farklı"

msgid "more search effort may help"
msgstr "daha geniş arama kapsamı yardımcı olabilir"

msgid "Unlimited"
msgstr "Sınırsız"

msgid "Result"
msgstr "Sonuç"

msgid "Not read yet"
msgstr "Henüz okunmadı"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d grup adresi, %(links)d bağlantı, %(parameters)d parametre"

msgid "%(count)d unknown"
msgstr "%(count)d bilinmeyen"

msgid "Verified"
msgstr "Doğrulandı"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Doğrulama: %(bytes)d bayt farklı"
