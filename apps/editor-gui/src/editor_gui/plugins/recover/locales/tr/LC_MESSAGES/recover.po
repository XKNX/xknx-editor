msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parametre henüz bulunamadı"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "Açık projeye %(count)d cihaz eklendi (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "%(count)d cihazla yeni proje oluşturuldu: %(target)s."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d cihaz eklenemedi; nedeni \"Sonuç\" sütununda."

msgid "Differs from the device: %(what)s"
msgstr "Cihazdan farklı: %(what)s"

