msgid "Recover"
msgstr "Recuperare"

msgid "Recover from Bus…"
msgstr "Recuperare de pe magistrală…"

msgid "Recover Project from Bus"
msgstr "Recuperare proiect de pe magistrală"

msgid "From Address"
msgstr "De la adresa"

msgid "To Address"
msgstr "Până la adresa"

msgid "Scan"
msgstr "Scanare"

msgid "Stop"
msgstr "Oprire"

msgid "Add to Open Project When Read"
msgstr "Adăugare la proiectul deschis la citire"

msgid "Recover Selected"
msgstr "Recuperare selecție"

msgid "Create New Project"
msgstr "Creare proiect nou"

msgid "Add to Open Project"
msgstr "Adăugare la proiectul deschis"

msgid "Verify (Read-Only)"
msgstr "Verificare (doar citire)"

msgid "Export Snapshot"
msgstr "Export instantaneu"

msgid "Verifying (re-reading and comparing)…"
msgstr "Se verifică (recitire și comparare)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "Adrese de grup fără emițător sau cu mai mulți emițători: %(count)d."

msgid "Address"
msgstr "Adresă"

msgid "Mask"
msgstr "Mască"

msgid "Product/Application"
msgstr "Produs/aplicație"

msgid "Status"
msgstr "Stare"

msgid "Set an address range and scan the bus."
msgstr "Setați un interval de adrese și scanați magistrala."

msgid "Scanning the bus…"
msgstr "Se scanează magistrala…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Se scanează %(address)s  (%(done)d/%(total)d, găsite: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Se încarcă produsele lipsă din catalogul online: %(what)s"

msgid "Reading devices…"
msgstr "Se citesc dispozitivele…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Se citește %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabelele de comunicare de grup"

msgid "parameter memory"
msgstr "memoria de parametri"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Dispozitive recuperate: %(devices)d; adrese de grup: %(group_addresses)d, legături: %(links)d, parametri nerecuperabili: %(unknown)d."

msgid "Recovered"
msgstr "Recuperat"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Dispozitive adăugate la proiectul deschis (%(target)s): %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Proiect nou creat: %(target)s (dispozitive: %(count)d)."

msgid "Not connected to a KNX bus."
msgstr "Neconectat la o magistrală KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Deschideți sau creați un proiect pentru a adăuga dispozitivele recuperate."

msgid "Product found"
msgstr "Produs găsit"

msgid "Check the product and version, then select it"
msgstr "Verificați produsul și versiunea, apoi selectați-l"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Nu este în catalog: importați produsul său în Catalog"

msgid "Not programmed"
msgstr "Neprogramat"


msgid "Error"
msgstr "Eroare"

msgid "%d parameters could not be recovered"
msgstr "Parametri care nu au putut fi recuperați: %d"

msgid "Already in the project, skipped"
msgstr "Deja în proiect, omis"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "Dispozitive care nu au putut fi adăugate: %(count)d; motivul este în coloana „Rezultat”."

msgid "Recovered (incomplete)"
msgstr "Recuperat (incomplet)"

msgid "Search Effort"
msgstr "Efort de Căutare"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Câte valori sunt încercate pentru setările din care dispozitivul nu păstrează o copie. Mai mult efort găsește setări în dispozitivele cu multe canale, dar durează mai mult. Nelimitat continuă până când nicio valoare nu se potrivește mai bine; Oprire încheie căutarea."

msgid "Fast"
msgstr "Rapid"

msgid "Medium"
msgstr "Mediu"

msgid "Maximum"
msgstr "Maxim"

msgid "Search Again"
msgstr "Caută din Nou"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Caută din nou setările dispozitivelor incomplete selectate în ce s-a citit din ele, cu efortul de căutare ales. Nu are nevoie de magistrală. Un dispozitiv deja adăugat în proiect este înlocuit (un pas de anulare)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Se caută din nou %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d octet(i) și %(objects)d obiect(e) de comunicare diferă de dispozitiv"

msgid "more search effort may help"
msgstr "mai mult efort de căutare poate ajuta"

msgid "Unlimited"
msgstr "Nelimitat"

msgid "Result"
msgstr "Rezultat"

msgid "Not read yet"
msgstr "Încă necitit"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d adrese de grup, %(links)d legături, %(parameters)d parametri"

msgid "%(count)d unknown"
msgstr "%(count)d necunoscute"

msgid "Verified"
msgstr "Verificat"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Verificare: %(bytes)d octet(i) diferă"
