msgstr[2] "%(count)d parametrů zatím nenalezeno"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "Do otevřeného projektu (%(target)s) přidáno %(count)d zařízení."
msgstr[1] "Do otevřeného projektu (%(target)s) přidána %(count)d zařízení."
msgstr[2] "Do otevřeného projektu (%(target)s) přidáno %(count)d zařízení."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Vytvořen nový projekt %(target)s s %(count)d zařízením."
msgstr[1] "Vytvořen nový projekt %(target)s s %(count)d zařízeními."
msgstr[2] "Vytvořen nový projekt %(target)s s %(count)d zařízeními."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Nebylo možné přidat %(count)d zařízení; důvod je ve sloupci „Výsledek“."
msgstr[1] "Nebylo možné přidat %(count)d zařízení; důvod je ve sloupci „Výsledek“."
msgstr[2] "Nebylo možné přidat %(count)d zařízení; důvod je ve sloupci „Výsledek“."

msgid "Differs from the device: %(what)s"
msgstr "Liší se od zařízení: %(what)s"

