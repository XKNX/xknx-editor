msgid "Recover Project from Bus"
msgstr "Obnovit projekt ze sběrnice"

msgid "From Address"
msgstr "Od adresy"

msgid "To Address"
msgstr "Do adresy"

msgid "Scan"
msgstr "Hledat"

msgid "Stop"
msgstr "Zastavit"

msgid "Add to Open Project as Read"
msgstr "Přidat do otevřeného projektu jako načtené"

msgid "Recover Selected"
msgstr "Obnovit vybrané"

msgid "Create New Project"
msgstr "Vytvořit nový projekt"

msgid "Add to Open Project"
msgstr "Přidat do otevřeného projektu"

msgid "Verify (Read-Only)"
msgstr "Ověřit (jen čtení)"

msgid "Export Snapshot"
msgstr "Exportovat snímek"

msgid "Verifying (re-reading and comparing)…"
msgstr "Ověřování (opakované čtení a porovnání)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "Skupinové adresy bez vysílače nebo s více vysílači: %(count)d."

msgid "Address"
msgstr "Adresa"

msgid "Mask"
msgstr "Maska"

msgid "Product/Application"
msgstr "Produkt/aplikace"

msgid "Status"
msgstr "Stav"

msgid "Set an address range and scan the bus."
msgstr "Nastavte rozsah adres a prohledejte sběrnici."

msgid "Scanning the bus…"
msgstr "Prohledávání sběrnice…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Hledání %(address)s  (%(done)d/%(total)d, nalezeno %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Načítání chybějících produktů z online katalogu: %(what)s"

msgid "Reading devices…"
msgstr "Čtení zařízení…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Čtení %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabulky skupinové komunikace"

msgid "parameter memory"
msgstr "paměť parametrů"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Obnovená zařízení: %(devices)d – skupinové adresy: %(group_addresses)d, propojení: %(links)d, neobnovitelné parametry: %(unknown)d."

msgid "Recovered"
msgstr "Obnoveno"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Zařízení přidaná do otevřeného projektu (%(target)s): %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Vytvořen nový projekt %(target)s, počet zařízení: %(count)d."

msgid "Not connected to a KNX bus."
msgstr "Nepřipojeno ke sběrnici KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Pro přidání obnovených zařízení otevřete nebo vytvořte projekt."

msgid "Product found"
msgstr "Produkt nalezen"

msgid "Check the product and version, then select it"
msgstr "Zkontrolujte produkt a verzi a pak jej vyberte"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Není v katalogu: importujte jeho produkt v Katalogu"

msgid "Not programmed"
msgstr "Nenaprogramováno"


msgid "Already in the project, skipped"
msgstr "Již v projektu, přeskočeno"

msgid "Error"
msgstr "Chyba"

msgid "%d parameters could not be recovered"
msgstr "Parametry, které nebylo možné obnovit: %d"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "Zařízení, která nebylo možné přidat: %(count)d; důvod je ve sloupci „Výsledek“."

msgid "Recovered (incomplete)"
msgstr "Obnoveno (neúplné)"

msgid "Search Effort"
msgstr "Rozsah Hledání"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Kolik hodnot se zkouší pro nastavení, jejichž kopii zařízení neuchovává. Větší rozsah najde nastavení v zařízeních s mnoha kanály, ale trvá déle. Neomezený hledá, dokud žádná hodnota nesedí lépe; Zastavit hledání ukončí."

msgid "Fast"
msgstr "Rychlý"

msgid "Medium"
msgstr "Střední"

msgid "Maximum"
msgstr "Maximální"

msgid "Search Again"
msgstr "Hledat Znovu"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Znovu vyhledá nastavení vybraných neúplných zařízení v datech z nich přečtených, se zvoleným rozsahem hledání. Nepotřebuje sběrnici. Zařízení již přidané do projektu se nahradí (jeden krok zpět)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Nové hledání pro %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d bajt(ů) a %(objects)d skupinový(ch) objekt(ů) se liší od zařízení"

msgid "more search effort may help"
msgstr "větší rozsah hledání může pomoci"

msgid "Unlimited"
msgstr "Neomezený"

msgid "Result"
msgstr "Výsledek"

msgid "Not read yet"
msgstr "Zatím nepřečteno"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "Skupinové adresy: %(group_addresses)d, propojení: %(links)d, parametry: %(parameters)d"

msgid "%(count)d unknown"
msgstr "Neznámé: %(count)d"

msgid "Verified"
msgstr "Ověřeno"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Ověření: liší se bajtů: %(bytes)d"
