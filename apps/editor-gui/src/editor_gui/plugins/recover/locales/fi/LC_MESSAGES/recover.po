msgstr "Luetaan laitteita…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Luetaan %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "ryhmäkommunikoinnin taulukot"

msgid "parameter memory"
msgstr "parametrimuisti"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Palautettuja laitteita %(devices)d: ryhmäosoitteita %(group_addresses)d, linkkejä %(links)d, palautuskelvottomia parametreja %(unknown)d."

