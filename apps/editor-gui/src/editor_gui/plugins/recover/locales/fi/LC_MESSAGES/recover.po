msgid "Recover Project from Bus"
msgstr "Palauta projekti väylältä"

msgid "From Address"
msgstr "Osoitteesta"

msgid "To Address"
msgstr "Osoitteeseen"

msgid "Scan"
msgstr "Scannaa"

msgid "Stop"
msgstr "Pysäytä"

msgid "Add to Open Project as Read"
msgstr "Lisää avoimeen projektiin luettuna"

msgid "Recover Selected"
msgstr "Palauta valitut"

msgid "Create New Project"
msgstr "Luo uusi projekti"

msgid "Add to Open Project"
msgstr "Lisää avoimeen projektiin"

msgid "Verify (Read-Only)"
msgstr "Varmista (vain luku)"

msgid "Export Snapshot"
msgstr "Vie tilannevedos"

msgid "Verifying (re-reading and comparing)…"
msgstr "Varmistetaan (luetaan uudelleen ja verrataan)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "Ryhmäosoitteita, joilla ei ole lähettäjää tai on useita lähettäjiä: %(count)d."

msgid "Address"
msgstr "Osoite"

msgid "Mask"
msgstr "Maski"

msgid "Product/Application"
msgstr "Tuote/sovellus"

msgid "Status"
msgstr "Tila"

msgid "Set an address range and scan the bus."
msgstr "Aseta osoitealue ja scannaa väylä."

msgid "Scanning the bus…"
msgstr "Etsitään väylältä…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Scannataan %(address)s  (%(done)d/%(total)d, löytyi %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Ladataan puuttuvia tuotteita verkkoluettelosta: %(what)s"

msgid "Reading devices…"
msgstr "Luetaan laitteita…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Luetaan %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "ryhmäkommunikoinnin taulukot"

msgid "parameter memory"
msgstr "parametrimuisti"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Palautettuja laitteita %(devices)d: ryhmäosoitteita %(group_addresses)d, linkkejä %(links)d, palautuskelvottomia parametreja %(unknown)d."

msgid "Recovered"
msgstr "Palautettu"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Avoimeen projektiin (%(target)s) lisättiin laitteita: %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Luotiin uusi projekti %(target)s, laitteita: %(count)d."

msgid "Not connected to a KNX bus."
msgstr "Ei yhteyttä KNX-väylään."

msgid "Open or create a project to add recovered devices."
msgstr "Avaa tai luo projekti, jotta voit lisätä palautetut laitteet."

msgid "matched"
msgstr "vastaa"

msgid "confirm product/version, then tick"
msgstr "vahvista tuote/versio ja merkitse sitten"

msgid "not in catalog - import via Catalog"
msgstr "ei luettelossa — tuo Luettelo-toiminnolla"

msgid "unprogrammed"
msgstr "ohjelmoimaton"

msgid "recovered"
msgstr "palautettu"

msgid "already in project - skipped"
msgstr "jo projektissa - ohitettu"

msgid "error"
msgstr "virhe"

msgid "%d parameters could not be recovered"
msgstr "Parametreja, joita ei voitu palauttaa: %d"

msgid "%(count)d device(s) could not be added; the reason is in the Recovered column."
msgstr "Laitteita ei voitu lisätä: %(count)d; syy näkyy sarakkeessa ”Palautettu”."

msgid "recovered (incomplete)"
msgstr "palautettu (keskeneräinen)"

msgid "Search Effort"
msgstr "Haun Laajuus"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer."
msgstr "Kuinka monta arvoa kokeillaan asetuksille, joista laite ei säilytä kopiota. Laajempi haku löytää asetuksia laitteista, joissa on monta kanavaa, mutta kestää pidempään."

msgid "Fast"
msgstr "Nopea"

msgid "Medium"
msgstr "Keskitaso"

msgid "Maximum"
msgstr "Suurin"

msgid "Search Again"
msgstr "Hae Uudelleen"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Hakee valittujen keskeneräisten laitteiden asetukset uudelleen niistä luetusta, valitulla haun laajuudella. Ei tarvitse väylää. Projektiin jo lisätty laite korvataan (yksi kumoamisvaihe)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Haetaan uudelleen: %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d tavua ja %(objects)d ryhmäobjektia poikkeaa laitteesta"

msgid "more search effort may help"
msgstr "laajempi haku voi auttaa"
