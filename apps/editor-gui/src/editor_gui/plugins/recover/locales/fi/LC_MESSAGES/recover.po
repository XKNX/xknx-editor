msgid "Recover Project from Bus"
msgstr "Palauta projekti väylältä"

msgid "From Address"
msgstr "Osoitteesta"

msgid "To Address"
msgstr "Osoitteeseen"

msgid "Scan"
msgstr "Scannaa"

msgid "Stop"
msgstr "Pysäytä"

msgid "Add to Open Project When Read"
msgstr "Lisää avoimeen projektiin luettaessa"

msgid "Recover Selected"
msgstr "Palauta valitut"

msgid "Create New Project…"
msgstr "Luo uusi projekti…"

msgid "Add to Open Project"
msgstr "Lisää avoimeen projektiin"

msgid "Verify (Read-Only)"
msgstr "Varmista (vain luku)"

msgid "Export Snapshot…"
msgstr "Vie tilannevedos…"

msgid "Verifying (re-reading and comparing)…"
msgstr "Varmistetaan (luetaan uudelleen ja verrataan)…"

msgid "Address"
msgstr "Osoite"

msgid "Mask"
msgstr "Maski"

msgid "Product/Application"
msgstr "Tuote/sovellus"

msgid "Status"
msgstr "Tila"

msgid "Set an address range and scan the bus."
msgstr "Aseta osoitealue ja scannaa väylä."

msgid "Scanning the bus…"
msgstr "Etsitään väylältä…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Scannataan %(address)s  (%(done)d/%(total)d, löytyi %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Ladataan puuttuvia tuotteita verkkoluettelosta: %(what)s"

msgid "Reading devices…"
msgstr "Luetaan laitteita…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Luetaan %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "ryhmäkommunikoinnin taulukot"

msgid "parameter memory"
msgstr "parametrimuisti"

msgid "Recovered"
msgstr "Palautettu"

msgid "Not connected to a KNX bus."
msgstr "Ei yhteyttä KNX-väylään."

msgid "Open or create a project to add recovered devices."
msgstr "Avaa tai luo projekti, jotta voit lisätä palautetut laitteet."

msgid "Product found"
msgstr "Tuote löytyi"

msgid "Check the product and version, then select it"
msgstr "Tarkista tuote ja versio ja valitse se sitten"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Ei luettelossa: tuo sen tuote Luettelossa"

msgid "Not programmed"
msgstr "Ei ohjelmoitu"

msgid "Already in the project, skipped"
msgstr "Jo projektissa, ohitettu"

msgid "Error"
msgstr "Virhe"

msgid "Recovered (incomplete)"
msgstr "Palautettu (keskeneräinen)"

msgid "Search Effort"
msgstr "Haun Laajuus"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Kuinka monta arvoa kokeillaan asetuksille, joista laite ei säilytä kopiota. Laajempi haku löytää asetuksia laitteista, joissa on monta kanavaa, mutta kestää pidempään. Rajoittamaton jatkaa, kunnes mikään arvo ei sovi paremmin; Pysäytä lopettaa haun."

msgid "Fast"
msgstr "Nopea"

msgid "Medium"
msgstr "Keskitaso"

msgid "Maximum"
msgstr "Suurin"

msgid "Search Again"
msgstr "Hae Uudelleen"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Hakee valittujen keskeneräisten laitteiden asetukset uudelleen niistä luetusta, valitulla haun laajuudella. Ei tarvitse väylää. Projektiin jo lisätty laite korvataan (yksi kumoamisvaihe)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Haetaan uudelleen: %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "laajempi haku voi auttaa"

msgid "Unlimited"
msgstr "Rajoittamaton"

msgid "Result"
msgstr "Tulos"

msgid "Not read yet"
msgstr "Ei vielä luettu"

msgid "Verified"
msgstr "Tarkistettu"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d ryhmäosoitteella ei ole lähettäjää tai sillä on useita lähettäjiä."
msgstr[1] "%(count)d ryhmäosoitteella ei ole lähettäjää tai niillä on useita lähettäjiä."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "Palautettiin %(count)d laite"
msgstr[1] "Palautettiin %(count)d laitetta"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d ryhmäosoite"
msgstr[1] "%(count)d ryhmäosoitetta"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d linkki"
msgstr[1] "%(count)d linkkiä"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d parametri"
msgstr[1] "%(count)d parametria"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parametria ei voi palauttaa"
msgstr[1] "%(count)d parametria ei voi palauttaa"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parametria ei ole vielä löytynyt"
msgstr[1] "%(count)d parametria ei ole vielä löytynyt"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "Avoimeen projektiin (%(target)s) lisättiin %(count)d laite."
msgstr[1] "Avoimeen projektiin (%(target)s) lisättiin %(count)d laitetta."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Luotiin uusi projekti %(target)s, jossa on %(count)d laite."
msgstr[1] "Luotiin uusi projekti %(target)s, jossa on %(count)d laitetta."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d laitetta ei voitu lisätä; syy näkyy sarakkeessa ”Tulos”."
msgstr[1] "%(count)d laitetta ei voitu lisätä; syy näkyy sarakkeessa ”Tulos”."

msgid "Differs from the device: %(what)s"
msgstr "Poikkeaa laitteesta: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d tavu"
msgstr[1] "%(count)d tavua"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d ryhmäobjekti"
msgstr[1] "%(count)d ryhmäobjektia"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Tarkistus: %(count)d tavu poikkeaa"
msgstr[1] "Tarkistus: %(count)d tavua poikkeaa"

msgid "Import Snapshot…"
msgstr "Tuo tilannevedos…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "Tuotiin %(count)d laite tiedostosta %(file)s."
msgstr[1] "Tuotiin %(count)d laitetta tiedostosta %(file)s."

msgid "%(file)s is no recovery snapshot: %(error)s"
msgstr "%(file)s ei ole palautuksen tilannevedos: %(error)s"

msgid "Recovery Snapshot (*.json)"
msgstr "Palautuksen tilannevedos (*.json)"

msgid "All Files"
msgstr "Kaikki tiedostot"

msgid "Device mask: %(device)s; product mask: %(product)s"
msgstr "Laitteen maski: %(device)s; tuotteen maski: %(product)s"

msgid "Mask compatibility data unavailable; only exact masks checked"
msgstr "Maskien yhteensopivuustietoja ei ole; vain samat maskit tarkistettu"

msgid "The application version missing from the local catalog was found in the alternative catalog. A login is required to download it. Enter your username and password in Settings > Catalog."
msgstr "Paikallisesta luettelosta puuttuva sovellusversio löytyi vaihtoehtoisesta luettelosta. Sen lataaminen edellyttää kirjautumista. Anna käyttäjänimi ja salasana kohdassa Asetukset > Luettelo."
