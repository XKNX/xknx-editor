msgid "Recover Project from Bus"
msgstr "Recupera progetto dal bus"

msgid "From Address"
msgstr "Da indirizzo"

msgid "To Address"
msgstr "A indirizzo"

msgid "Scan"
msgstr "Scansiona"

msgid "Stop"
msgstr "Stop"

msgid "Add to Open Project When Read"
msgstr "Aggiungi al progetto aperto alla lettura"

msgid "Recover Selected"
msgstr "Recupera selezionati"

msgid "Create New Project"
msgstr "Crea nuovo progetto"

msgid "Add to Open Project"
msgstr "Aggiungi al progetto aperto"

msgid "Verify (Read-Only)"
msgstr "Verifica (sola lettura)"

msgid "Export Snapshot"
msgstr "Esporta snapshot"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verifica (rilettura e confronto)…"

msgid "Address"
msgstr "Indirizzo"

msgid "Mask"
msgstr "Maschera"

msgid "Product/Application"
msgstr "Prodotto/applicazione"

msgid "Status"
msgstr "Stato"

msgid "Set an address range and scan the bus."
msgstr "Impostare un intervallo di indirizzi e scansionare il bus."

msgid "Scanning the bus…"
msgstr "Scansione del bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Scansione di %(address)s  (%(done)d/%(total)d, %(found)d trovati)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Caricamento dei prodotti mancanti dal catalogo online: %(what)s"

msgid "Reading devices…"
msgstr "Lettura dei dispositivi…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Lettura di %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabelle di comunicazione di gruppo"

msgid "parameter memory"
msgstr "memoria parametri"

msgid "Recovered"
msgstr "Recuperato"

msgid "Not connected to a KNX bus."
msgstr "Non connesso a un bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Aprire o creare un progetto per aggiungere i dispositivi recuperati."

msgid "Product found"
msgstr "Prodotto trovato"

msgid "Check the product and version, then select it"
msgstr "Verificare prodotto e versione, quindi selezionarlo"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Non nel catalogo: importare il suo prodotto nel Catalogo"

msgid "Not programmed"
msgstr "Non programmato"

msgid "Already in the project, skipped"
msgstr "Già nel progetto, saltato"

msgid "Error"
msgstr "Errore"

msgid "Recovered (incomplete)"
msgstr "Recuperato (incompleto)"

msgid "Search Effort"
msgstr "Impegno di Ricerca"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Quanti valori vengono provati per le impostazioni di cui il dispositivo non conserva una copia. Un impegno maggiore trova le impostazioni nei dispositivi con molti canali, ma richiede più tempo. Illimitato prosegue finché nessun valore si adatta meglio; Stop termina la ricerca."

msgid "Fast"
msgstr "Veloce"

msgid "Medium"
msgstr "Medio"

msgid "Maximum"
msgstr "Massimo"

msgid "Search Again"
msgstr "Cerca di Nuovo"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Cerca di nuovo le impostazioni dei dispositivi incompleti selezionati in ciò che è stato letto da essi, con l'impegno di ricerca scelto. Non serve il bus. Un dispositivo già aggiunto al progetto viene sostituito (un passo di annullamento)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Nuova ricerca per %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "un impegno di ricerca maggiore può aiutare"

msgid "Unlimited"
msgstr "Illimitato"

msgid "Result"
msgstr "Risultato"

msgid "Not read yet"
msgstr "Non ancora letto"

msgid "Verified"
msgstr "Verificato"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d indirizzo di gruppo non ha alcun trasmettitore o ne ha più di uno."
msgstr[1] "%(count)d indirizzi di gruppo non hanno alcun trasmettitore o ne hanno più di uno."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d dispositivo recuperato"
msgstr[1] "%(count)d dispositivi recuperati"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d indirizzo di gruppo"
msgstr[1] "%(count)d indirizzi di gruppo"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d collegamento"
msgstr[1] "%(count)d collegamenti"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d parametro"
msgstr[1] "%(count)d parametri"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parametro non recuperabile"
msgstr[1] "%(count)d parametri non recuperabili"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parametro non ancora trovato"
msgstr[1] "%(count)d parametri non ancora trovati"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d dispositivo aggiunto al progetto aperto (%(target)s)."
msgstr[1] "%(count)d dispositivi aggiunti al progetto aperto (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Creato il nuovo progetto %(target)s con %(count)d dispositivo."
msgstr[1] "Creato il nuovo progetto %(target)s con %(count)d dispositivi."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Non è stato possibile aggiungere %(count)d dispositivo; il motivo è nella colonna «Risultato»."
msgstr[1] "Non è stato possibile aggiungere %(count)d dispositivi; il motivo è nella colonna «Risultato»."

msgid "Differs from the device: %(what)s"
msgstr "Differisce dal dispositivo: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d byte"
msgstr[1] "%(count)d byte"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d oggetto di comunicazione"
msgstr[1] "%(count)d oggetti di comunicazione"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Verifica: %(count)d byte diverso"
msgstr[1] "Verifica: %(count)d byte diversi"
