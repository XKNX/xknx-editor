msgid "Recover"
msgstr "Visszaállítás"

msgid "Recover from Bus…"
msgstr "Visszaállítás a buszról…"

msgid "Recover Project from Bus"
msgstr "Projekt visszaállítása a buszról"

msgid "From Address"
msgstr "Kezdőcím"

msgid "To Address"
msgstr "Zárócím"

msgid "Scan"
msgstr "Keresés"

msgid "Stop"
msgstr "Leállítás"

msgid "Add to Open Project as Read"
msgstr "Hozzáadás a megnyitott projekthez beolvasott állapotban"

msgid "Recover Selected"
msgstr "Kijelöltek visszaállítása"

msgid "Create New Project"
msgstr "Új projekt létrehozása"

msgid "Add to Open Project"
msgstr "Hozzáadás a megnyitott projekthez"

msgid "Verify (Read-Only)"
msgstr "Ellenőrzés (csak olvasás)"

msgid "Export Snapshot"
msgstr "Pillanatkép exportálása"

msgid "Verifying (re-reading and comparing)…"
msgstr "Ellenőrzés (újraolvasás és összehasonlítás)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "Küldő nélküli vagy több küldővel rendelkező csoportcímek: %(count)d."

msgid "Address"
msgstr "Cím"

msgid "Mask"
msgstr "Maszk"

msgid "Product/Application"
msgstr "Termék/alkalmazás"

msgid "Status"
msgstr "Állapot"

msgid "Set an address range and scan the bus."
msgstr "Adjon meg egy címtartományt, és vizsgálja át a buszt."

msgid "Scanning the bus…"
msgstr "A busz átvizsgálása…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Keresés: %(address)s  (%(done)d/%(total)d, talált: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Hiányzó termékek betöltése az online katalógusból: %(what)s"

msgid "Reading devices…"
msgstr "Készülékek beolvasása…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Olvasás: %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "csoportkommunikációs táblák"

msgid "parameter memory"
msgstr "paramétermemória"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Visszaállított készülékek: %(devices)d; csoportcímek: %(group_addresses)d, összekapcsolások: %(links)d, vissza nem állítható paraméterek: %(unknown)d."

msgid "Recovered"
msgstr "Visszaállítva"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "A megnyitott projekthez (%(target)s) hozzáadott készülékek: %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Új projekt létrehozva: %(target)s, készülékek: %(count)d."

msgid "Not connected to a KNX bus."
msgstr "Nincs kapcsolat KNX-busszal."

msgid "Open or create a project to add recovered devices."
msgstr "A visszaállított készülékek hozzáadásához nyisson meg vagy hozzon létre egy projektet."

msgid "matched"
msgstr "egyezik"

msgid "confirm product/version, then tick"
msgstr "erősítse meg a terméket/verziót, majd jelölje be"

msgid "not in catalog - import via Catalog"
msgstr "nincs a katalógusban – importálja a Katalógusból"

msgid "unprogrammed"
msgstr "programozatlan"

msgid "recovered"
msgstr "visszaállítva"

msgid "error"
msgstr "hiba"

msgid "%d parameters could not be recovered"
msgstr "Vissza nem állítható paraméterek: %d"

msgid "already in project - skipped"
msgstr "már a projektben van – kihagyva"

msgid "%(count)d device(s) could not be added; the reason is in the Recovered column."
msgstr "Nem sikerült hozzáadni készülékeket: %(count)d; az ok a „Visszaállítva” oszlopban látható."

msgid "recovered (incomplete)"
msgstr "visszaállítva (hiányos)"

msgid "Search Effort"
msgstr "Keresési Ráfordítás"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer."
msgstr "Hány értéket próbál ki a beállításokhoz, amelyekről az eszköz nem tárol másolatot. Nagyobb ráfordítás sok csatornás eszközökben is megtalálja a beállításokat, de tovább tart."

msgid "Fast"
msgstr "Gyors"

msgid "Medium"
msgstr "Közepes"

msgid "Maximum"
msgstr "Maximális"

msgid "Search Again"
msgstr "Keresés Újra"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "A kiválasztott hiányos eszközök beállításait újra megkeresi a belőlük beolvasott adatokban, a választott keresési ráfordítással. Nem kell hozzá busz. A projekthez már hozzáadott eszköz lecserélődik (egy visszavonási lépés)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "%(address)s újbóli keresése  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d bájt és %(objects)d kommunikációs objektum eltér az eszköztől"

msgid "more search effort may help"
msgstr "nagyobb keresési ráfordítás segíthet"
