msgstr "Készülékek beolvasása…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Olvasás: %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "csoportkommunikációs táblák"

msgid "parameter memory"
msgstr "paramétermemória"

msgid "Recovered"
msgstr "Visszaállítva"

msgid "Not connected to a KNX bus."
msgstr "Nincs kapcsolat KNX-busszal."

msgid "Open or create a project to add recovered devices."
msgstr "A visszaállított készülékek hozzáadásához nyisson meg vagy hozzon létre egy projektet."

msgid "Product found"
msgstr "Termék megtalálva"

msgid "Check the product and version, then select it"
msgstr "Ellenőrizze a terméket és a verziót, majd jelölje ki"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Nincs a katalógusban: importálja a termékét a Katalógusban"

msgid "Not programmed"
msgstr "Nincs programozva"

msgid "Error"
msgstr "Hiba"

msgid "Already in the project, skipped"
msgstr "Már a projektben van, kihagyva"

msgid "Recovered (incomplete)"
msgstr "Visszaállítva (hiányos)"

msgid "Search Effort"
msgstr "Keresési Ráfordítás"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Hány értéket próbál ki a beállításokhoz, amelyekről az eszköz nem tárol másolatot. Nagyobb ráfordítás sok csatornás eszközökben is megtalálja a beállításokat, de tovább tart. A korlátlan addig keres, amíg egyik érték sem illik jobban; a Leállítás befejezi a keresést."

msgid "Fast"
msgstr "Gyors"

msgid "Medium"
msgstr "Közepes"

msgid "Maximum"
msgstr "Maximális"

msgid "Search Again"
msgstr "Keresés Újra"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "A kiválasztott hiányos eszközök beállításait újra megkeresi a belőlük beolvasott adatokban, a választott keresési ráfordítással. Nem kell hozzá busz. A projekthez már hozzáadott eszköz lecserélődik (egy visszavonási lépés)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "%(address)s újbóli keresése  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "nagyobb keresési ráfordítás segíthet"

msgid "Unlimited"
msgstr "Korlátlan"

msgid "Result"
msgstr "Eredmény"

msgid "Not read yet"
msgstr "Még nincs beolvasva"

msgid "Verified"
msgstr "Ellenőrizve"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d csoportcímnek nincs küldője, vagy több küldője van."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d készülék visszaállítva"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d csoportcím"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d összekapcsolás"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d paraméter"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d paraméter nem állítható vissza"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d paraméter még nem található"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d készülék hozzáadva a megnyitott projekthez (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Új projekt létrehozva: %(target)s, %(count)d készülékkel."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d készüléket nem sikerült hozzáadni; az ok az „Eredmény” oszlopban látható."

msgid "Differs from the device: %(what)s"
msgstr "Eltér a készüléktől: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d bájt"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d kommunikációs objektum"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Ellenőrzés: %(count)d bájt eltér"

msgid "Import Snapshot…"
msgstr "Pillanatkép importálása…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "%(count)d eszköz importálva innen: %(file)s."

msgid "%(file)s is no recovery snapshot: %(error)s"
msgstr "A(z) %(file)s nem helyreállítási pillanatkép: %(error)s"

