msgid "Recover Project from Bus"
msgstr "Récupérer le projet depuis le bus"

msgid "From Address"
msgstr "Adresse de début"

msgid "To Address"
msgstr "Adresse de fin"

msgid "Scan"
msgstr "Scanner"

msgid "Stop"
msgstr "Arrêter"

msgid "Add to Open Project as Read"
msgstr "Ajouter au projet ouvert comme lu"

msgid "Recover Selected"
msgstr "Récupérer la sélection"

msgid "Create New Project"
msgstr "Créer un nouveau projet"

msgid "Add to Open Project"
msgstr "Ajouter au projet ouvert"

msgid "Verify (Read-Only)"
msgstr "Vérifier (lecture seule)"

msgid "Export Snapshot"
msgstr "Exporter l'instantané"

msgid "Verifying (re-reading and comparing)…"
msgstr "Vérification (relecture et comparaison)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d adresse(s) de groupe n'ont aucun émetteur ou en ont plusieurs."

msgid "Address"
msgstr "Adresse"

msgid "Mask"
msgstr "Masque"

msgid "Product/Application"
msgstr "Produit/application"

msgid "Status"
msgstr "Statut"

msgid "Set an address range and scan the bus."
msgstr "Définissez une plage d'adresses et scannez le bus."

msgid "Scanning the bus…"
msgstr "Recherche sur le bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Recherche %(address)s  (%(done)d/%(total)d, %(found)d trouvé(s))"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Chargement des produits manquants depuis le catalogue en ligne : %(what)s"

msgid "Reading devices…"
msgstr "Lecture des participants…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Lecture %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tables de communication de groupe"

msgid "parameter memory"
msgstr "mémoire des paramètres"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "%(devices)d participant(s) récupéré(s) : %(group_addresses)d adresses de groupe, %(links)d liaisons, %(unknown)d paramètre(s) non récupérable(s)."

msgid "Recovered"
msgstr "Récupéré"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "%(count)d participant(s) ajouté(s) au projet ouvert (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Nouveau projet %(target)s créé avec %(count)d participant(s)."

msgid "Not connected to a KNX bus."
msgstr "Non connecté à un bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Ouvrez ou créez un projet pour ajouter les participants récupérés."

msgid "Product found"
msgstr "Produit trouvé"

msgid "Check the product and version, then select it"
msgstr "Vérifiez le produit et la version, puis sélectionnez-le"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Absent du catalogue : importez son produit dans le Catalogue"

msgid "Not programmed"
msgstr "Non programmé"


msgid "Already in the project, skipped"
msgstr "Déjà dans le projet, ignoré"

msgid "Error"
msgstr "Erreur"

msgid "%d parameters could not be recovered"
msgstr "%d paramètres n'ont pas pu être récupérés"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "Impossible d’ajouter %(count)d participant(s) ; la raison figure dans la colonne « Résultat »."

msgid "Recovered (incomplete)"
msgstr "Récupéré (incomplet)"

msgid "Search Effort"
msgstr "Effort de Recherche"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Combien de valeurs sont essayées pour les réglages dont l'appareil ne garde aucune copie. Plus d'effort trouve les réglages des appareils à nombreux canaux, mais prend plus de temps. Illimité continue jusqu'à ce qu'aucune valeur ne convienne mieux ; Arrêter termine la recherche."

msgid "Fast"
msgstr "Rapide"

msgid "Medium"
msgstr "Moyen"

msgid "Maximum"
msgstr "Maximum"

msgid "Search Again"
msgstr "Rechercher à Nouveau"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Recherche à nouveau les réglages des appareils incomplets sélectionnés dans ce qui a été lu, avec l'effort de recherche choisi. Aucun bus n'est nécessaire. Un appareil déjà ajouté au projet est remplacé (une étape d'annulation)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Nouvelle recherche pour %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d octet(s) et %(objects)d objet(s) de groupe diffèrent de l'appareil"

msgid "more search effort may help"
msgstr "plus d'effort de recherche peut aider"

msgid "Unlimited"
msgstr "Illimité"

msgid "Result"
msgstr "Résultat"

msgid "Not read yet"
msgstr "Pas encore lu"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d adresses de groupe, %(links)d liaisons, %(parameters)d paramètres"

msgid "%(count)d unknown"
msgstr "%(count)d inconnu(s)"

msgid "Verified"
msgstr "Vérifié"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Vérification : %(bytes)d octet(s) diffèrent"
