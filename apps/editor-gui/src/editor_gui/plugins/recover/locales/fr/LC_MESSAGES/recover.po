msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d adresse de groupe n'a aucun émetteur ou en a plusieurs."
msgstr[1] "%(count)d adresses de groupe n'ont aucun émetteur ou en ont plusieurs."

