msgstr[2] "%(count)d групових об'єктів"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Перевірка: відрізняється %(count)d байт"
msgstr[1] "Перевірка: відрізняються %(count)d байти"
msgstr[2] "Перевірка: відрізняються %(count)d байтів"
