msgstr ""
"Project-Id-Version: xknx-editor recover 1.0\n"
"Language: uk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Recover Project from Bus"
msgstr "Відновити проєкт із шини"

msgid "From Address"
msgstr "Від адреси"

msgid "To Address"
msgstr "До адреси"

msgid "Scan"
msgstr "Сканування"

msgid "Stop"
msgstr "Стоп"

msgid "Add to Open Project When Read"
msgstr "Додавати до відкритого проєкту під час читання"

msgid "Recover Selected"
msgstr "Відновити вибрані"

msgid "Create New Project"
msgstr "Створити новий проєкт"

msgid "Add to Open Project"
msgstr "Додати до відкритого проєкту"

msgid "Verify (Read-Only)"
msgstr "Перевірити (лише читання)"

msgid "Export Snapshot"
msgstr "Експортувати знімок"

msgid "Verifying (re-reading and comparing)…"
msgstr "Перевірка (повторне читання та порівняння)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "Групових адрес без відправника або з кількома відправниками: %(count)d."

msgid "Address"
msgstr "Адреса"

msgid "Mask"
msgstr "Маска"

msgid "Product/Application"
msgstr "Продукт/прикладна програма"

msgid "Status"
msgstr "Статус"

msgid "Set an address range and scan the bus."
msgstr "Задайте діапазон адрес і проскануйте шину."

msgid "Scanning the bus…"
msgstr "Сканування шини…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Сканування %(address)s  (%(done)d/%(total)d, знайдено %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Завантаження відсутніх продуктів з онлайн-каталогу: %(what)s"

msgid "Reading devices…"
msgstr "Читання пристроїв…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Читання %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "таблиці групових зв'язків"

msgid "parameter memory"
msgstr "пам'ять параметрів"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Відновлено пристроїв: %(devices)d; групових адрес: %(group_addresses)d, зв'язків: %(links)d, невідновлюваних параметрів: %(unknown)d."

msgid "Recovered"
msgstr "Відновлено"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Додано пристроїв до відкритого проєкту (%(target)s): %(count)d."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Створено новий проєкт %(target)s; пристроїв: %(count)d."

msgid "Not connected to a KNX bus."
msgstr "Немає з'єднання з шиною KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Відкрийте або створіть проєкт, щоб додати відновлені пристрої."

msgid "Product found"
msgstr "Продукт знайдено"

msgid "Check the product and version, then select it"
msgstr "Перевірте продукт і версію, потім виберіть його"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Немає в каталозі: імпортуйте його продукт у «Каталозі»"

msgid "Not programmed"
msgstr "Не запрограмовано"


msgid "Already in the project, skipped"
msgstr "Уже в проєкті, пропущено"

msgid "Error"
msgstr "Помилка"

msgid "%d parameters could not be recovered"
msgstr "Не вдалося відновити параметрів: %d"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "Не вдалося додати пристроїв: %(count)d; причину наведено в стовпці «Результат»."

msgid "Recovered (incomplete)"
msgstr "Відновлено (не повністю)"

msgid "Search Effort"
msgstr "Обсяг Пошуку"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Скільки значень перебирається для параметрів, копію яких пристрій не зберігає. Більший обсяг знаходить параметри в пристроях з багатьма каналами, але триває довше. Без обмежень пошук триває, доки жодне значення не підходить краще; «Стоп» завершує пошук."

msgid "Fast"
msgstr "Швидкий"

msgid "Medium"
msgstr "Середній"

msgid "Maximum"
msgstr "Максимальний"

msgid "Search Again"
msgstr "Шукати Знову"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Повторно шукає параметри вибраних неповних пристроїв у зчитаних із них даних з вибраним обсягом пошуку. Шина не потрібна. Пристрій, уже доданий до проєкту, замінюється (один крок скасування)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Повторний пошук для %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d байт і %(objects)d групових об'єктів відрізняються від пристрою"

msgid "more search effort may help"
msgstr "більший обсяг пошуку може допомогти"

msgid "Unlimited"
msgstr "Без обмежень"

msgid "Result"
msgstr "Результат"

msgid "Not read yet"
msgstr "Ще не зчитано"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "Групових адрес: %(group_addresses)d, зв'язків: %(links)d, параметрів: %(parameters)d"

msgid "%(count)d unknown"
msgstr "Невідомо: %(count)d"

msgid "Verified"
msgstr "Перевірено"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Перевірка: відрізняється байтів: %(bytes)d"
