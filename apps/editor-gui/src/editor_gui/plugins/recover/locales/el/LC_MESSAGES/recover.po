msgid "Recover Project from Bus"
msgstr "Ανάκτηση Έργου από το Bus"

msgid "From Address"
msgstr "Από Διεύθυνση"

msgid "To Address"
msgstr "Έως Διεύθυνση"

msgid "Scan"
msgstr "Σάρωση"

msgid "Stop"
msgstr "Διακοπή"

msgid "Add to Open Project as Read"
msgstr "Προσθήκη στο Ανοιχτό Έργο ως Αναγνωσμένο"

msgid "Recover Selected"
msgstr "Ανάκτηση Επιλεγμένων"

msgid "Create New Project"
msgstr "Δημιουργία Νέου Έργου"

msgid "Add to Open Project"
msgstr "Προσθήκη στο Ανοιχτό Έργο"

msgid "Verify (Read-Only)"
msgstr "Επαλήθευση (Μόνο Ανάγνωση)"

msgid "Export Snapshot"
msgstr "Εξαγωγή Στιγμιότυπου"

msgid "Verifying (re-reading and comparing)…"
msgstr "Επαλήθευση (εκ νέου ανάγνωση και σύγκριση)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d διεύθυνση(-εις) ομάδας δεν έχουν αποστολέα ή έχουν πολλούς αποστολείς."

msgid "Address"
msgstr "Διεύθυνση"

msgid "Mask"
msgstr "Μάσκα"

msgid "Product/Application"
msgstr "Προϊόν/Εφαρμογή"

msgid "Status"
msgstr "Κατάσταση"

msgid "Set an address range and scan the bus."
msgstr "Ορίστε ένα εύρος διευθύνσεων και σαρώστε το bus."

msgid "Scanning the bus…"
msgstr "Σάρωση του bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Σάρωση %(address)s  (%(done)d/%(total)d, βρέθηκαν %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Φόρτωση προϊόντων που λείπουν από τον online κατάλογο: %(what)s"

msgid "Reading devices…"
msgstr "Ανάγνωση συσκευών…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Ανάγνωση %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "πίνακες επικοινωνίας ομάδων"

msgid "parameter memory"
msgstr "μνήμη παραμέτρων"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "Ανακτήθηκαν %(devices)d συσκευή(-ές): %(group_addresses)d διευθύνσεις ομάδων, %(links)d συνδέσεις, %(unknown)d παράμετρος(-οι) δεν ήταν δυνατό να ανακτηθούν."

msgid "Recovered"
msgstr "Ανακτήθηκε"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "Προστέθηκαν %(count)d συσκευή(-ές) στο ανοιχτό έργο (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Δημιουργήθηκε νέο έργο %(target)s με %(count)d συσκευή(-ές)."

msgid "Not connected to a KNX bus."
msgstr "Δεν υπάρχει σύνδεση με bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Ανοίξτε ή δημιουργήστε ένα έργο για να προσθέσετε ανακτημένες συσκευές."

msgid "Product found"
msgstr "Βρέθηκε προϊόν"

msgid "Check the product and version, then select it"
msgstr "Ελέγξτε το προϊόν και την έκδοση και μετά επιλέξτε το"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Δεν υπάρχει στον κατάλογο: εισαγάγετε το προϊόν του στον Κατάλογο"

msgid "Not programmed"
msgstr "Μη προγραμματισμένη"


msgid "Already in the project, skipped"
msgstr "Ήδη στο έργο, παραλείφθηκε"

msgid "Error"
msgstr "Σφάλμα"

msgid "%d parameters could not be recovered"
msgstr "%d παράμετροι δεν ήταν δυνατό να ανακτηθούν"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "Δεν ήταν δυνατή η προσθήκη %(count)d συσκευής(-ών)· η αιτία αναφέρεται στη στήλη «Αποτέλεσμα»."

msgid "Recovered (incomplete)"
msgstr "Ανακτήθηκε (ελλιπές)"

msgid "Search Effort"
msgstr "Έκταση Αναζήτησης"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Πόσες τιμές δοκιμάζονται για τις ρυθμίσεις των οποίων η συσκευή δεν κρατά αντίγραφο. Μεγαλύτερη έκταση βρίσκει ρυθμίσεις σε συσκευές με πολλά κανάλια, αλλά διαρκεί περισσότερο. Η απεριόριστη συνεχίζει μέχρι καμία τιμή να μην ταιριάζει καλύτερα· η Διακοπή τερματίζει την αναζήτηση."

msgid "Fast"
msgstr "Γρήγορη"

msgid "Medium"
msgstr "Μέτρια"

msgid "Maximum"
msgstr "Μέγιστη"

msgid "Search Again"
msgstr "Νέα Αναζήτηση"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Αναζητά ξανά τις ρυθμίσεις των επιλεγμένων ελλιπών συσκευών σε όσα διαβάστηκαν από αυτές, με την επιλεγμένη έκταση αναζήτησης. Δεν χρειάζεται δίαυλο. Μια συσκευή που έχει ήδη προστεθεί στο έργο αντικαθίσταται (ένα βήμα αναίρεσης)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Νέα αναζήτηση για %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d byte και %(objects)d αντικείμενα επικοινωνίας διαφέρουν από τη συσκευή"

msgid "more search effort may help"
msgstr "μεγαλύτερη έκταση αναζήτησης μπορεί να βοηθήσει"

msgid "Unlimited"
msgstr "Απεριόριστη"

msgid "Result"
msgstr "Αποτέλεσμα"

msgid "Not read yet"
msgstr "Δεν έχει διαβαστεί ακόμη"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d διευθύνσεις ομάδας, %(links)d συνδέσεις, %(parameters)d παράμετροι"

msgid "%(count)d unknown"
msgstr "%(count)d άγνωστες"

msgid "Verified"
msgstr "Επαληθεύτηκε"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Επαλήθευση: διαφέρουν %(bytes)d byte"
