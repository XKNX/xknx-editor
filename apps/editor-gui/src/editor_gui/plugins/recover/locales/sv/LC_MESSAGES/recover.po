msgid "Recover Project from Bus"
msgstr "Återskapa projekt från bussen"

msgid "From Address"
msgstr "Från adress"

msgid "To Address"
msgstr "Till adress"

msgid "Scan"
msgstr "Avsök"

msgid "Stop"
msgstr "Stoppa"

msgid "Add to Open Project When Read"
msgstr "Lägg till i öppet projekt vid läsning"

msgid "Recover Selected"
msgstr "Återskapa markerade"

msgid "Create New Project"
msgstr "Skapa nytt projekt"

msgid "Add to Open Project"
msgstr "Lägg till i öppet projekt"

msgid "Verify (Read-Only)"
msgstr "Verifiera (skrivskyddat)"

msgid "Export Snapshot"
msgstr "Exportera ögonblicksbild"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verifierar (läser om och jämför)…"

msgid "Address"
msgstr "Adress"

msgid "Mask"
msgstr "Mask"

msgid "Product/Application"
msgstr "Produkt/applikation"

msgid "Status"
msgstr "Status"

msgid "Set an address range and scan the bus."
msgstr "Ange ett adressintervall och avsök bussen."

msgid "Scanning the bus…"
msgstr "Avsöker bussen…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Avsöker %(address)s  (%(done)d/%(total)d, %(found)d hittade)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Läser in saknade produkter från onlinekatalogen: %(what)s"

msgid "Reading devices…"
msgstr "Läser apparater…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Läser %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "gruppkommunikationstabeller"

msgid "parameter memory"
msgstr "parameterminne"

msgid "Recovered"
msgstr "Återskapad"

msgid "Not connected to a KNX bus."
msgstr "Inte ansluten till en KNX-buss."

msgid "Open or create a project to add recovered devices."
msgstr "Öppna eller skapa ett projekt för att lägga till återskapade apparater."

msgid "Product found"
msgstr "Produkt hittad"

msgid "Check the product and version, then select it"
msgstr "Kontrollera produkt och version och välj den sedan"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Finns inte i katalogen: importera dess produkt i Katalog"

msgid "Not programmed"
msgstr "Inte programmerad"

msgid "Already in the project, skipped"
msgstr "Redan i projektet, hoppades över"

msgid "Error"
msgstr "Fel"

msgid "Recovered (incomplete)"
msgstr "Återskapad (ofullständig)"

msgid "Search Effort"
msgstr "Sökinsats"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Hur många värden som provas för de inställningar som enheten inte sparar någon kopia av. Mer insats hittar inställningar i enheter med många kanaler, men tar längre tid. Obegränsad fortsätter tills inget värde passar bättre; Stoppa avslutar sökningen."

msgid "Fast"
msgstr "Snabb"

msgid "Medium"
msgstr "Medel"

msgid "Maximum"
msgstr "Maximal"

msgid "Search Again"
msgstr "Sök Igen"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Söker igen efter inställningarna för de valda ofullständiga enheterna i det som lästes från dem, med vald sökinsats. Behöver ingen buss. En enhet som redan lagts till i projektet ersätts (ett ångra-steg)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Söker igen i %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "mer sökinsats kan hjälpa"

msgid "Unlimited"
msgstr "Obegränsad"

msgid "Result"
msgstr "Resultat"

msgid "Not read yet"
msgstr "Inte läst än"

msgid "Verified"
msgstr "Kontrollerad"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d gruppadress har ingen eller flera sändare."
msgstr[1] "%(count)d gruppadresser har ingen eller flera sändare."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d apparat återskapad"
msgstr[1] "%(count)d apparater återskapade"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d gruppadress"
msgstr[1] "%(count)d gruppadresser"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d koppling"
msgstr[1] "%(count)d kopplingar"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d parameter"
msgstr[1] "%(count)d parametrar"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parameter kan inte återskapas"
msgstr[1] "%(count)d parametrar kan inte återskapas"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parameter ännu inte hittad"
msgstr[1] "%(count)d parametrar ännu inte hittade"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d apparat tillagd i det öppna projektet (%(target)s)."
msgstr[1] "%(count)d apparater tillagda i det öppna projektet (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Nytt projekt %(target)s skapat med %(count)d apparat."
msgstr[1] "Nytt projekt %(target)s skapat med %(count)d apparater."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d apparat kunde inte läggas till; orsaken står i kolumnen ”Resultat”."
msgstr[1] "%(count)d apparater kunde inte läggas till; orsaken står i kolumnen ”Resultat”."

msgid "Differs from the device: %(what)s"
msgstr "Skiljer sig från apparaten: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d byte"
msgstr[1] "%(count)d byte"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d gruppobjekt"
msgstr[1] "%(count)d gruppobjekt"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Kontroll: %(count)d byte skiljer sig"
msgstr[1] "Kontroll: %(count)d byte skiljer sig"
