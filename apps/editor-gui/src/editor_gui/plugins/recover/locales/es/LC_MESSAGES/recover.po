msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parámetro no recuperable"
msgstr[1] "%(count)d parámetros no recuperables"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parámetro aún no encontrado"
msgstr[1] "%(count)d parámetros aún no encontrados"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d dispositivo añadido al proyecto abierto (%(target)s)."
msgstr[1] "%(count)d dispositivos añadidos al proyecto abierto (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Creado el nuevo proyecto %(target)s con %(count)d dispositivo."
msgstr[1] "Creado el nuevo proyecto %(target)s con %(count)d dispositivos."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "No se ha podido añadir %(count)d dispositivo; el motivo aparece en la columna «Resultado»."
msgstr[1] "No se han podido añadir %(count)d dispositivos; el motivo aparece en la columna «Resultado»."

msgid "Differs from the device: %(what)s"
msgstr "Difiere del dispositivo: %(what)s"

