msgid "Recover Project from Bus"
msgstr "Recuperar Proyecto desde el Bus"

msgid "From Address"
msgstr "Desde Dirección"

msgid "To Address"
msgstr "Hasta Dirección"

msgid "Scan"
msgstr "Buscar"

msgid "Stop"
msgstr "Detener"

msgid "Add to Open Project as Read"
msgstr "Añadir al Proyecto Abierto como Leído"

msgid "Recover Selected"
msgstr "Recuperar Seleccionados"

msgid "Create New Project"
msgstr "Crear Nuevo Proyecto"

msgid "Add to Open Project"
msgstr "Añadir al Proyecto Abierto"

msgid "Verify (Read-Only)"
msgstr "Verificar (Solo Lectura)"

msgid "Export Snapshot"
msgstr "Exportar Instantánea"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verificando (releyendo y comparando)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d dirección(es) de grupo no tienen emisor o tienen varios emisores."

msgid "Address"
msgstr "Dirección"

msgid "Mask"
msgstr "Máscara"

msgid "Product/Application"
msgstr "Producto/Aplicación"

msgid "Status"
msgstr "Estado"

msgid "Set an address range and scan the bus."
msgstr "Establezca un rango de direcciones y escanee el bus."

msgid "Scanning the bus…"
msgstr "Escaneando el bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Escaneando %(address)s  (%(done)d/%(total)d, %(found)d encontrados)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Cargando los productos que faltan desde el catálogo online: %(what)s"

msgid "Reading devices…"
msgstr "Leyendo dispositivos…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Leyendo %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tablas de comunicación de grupo"

msgid "parameter memory"
msgstr "memoria de parámetros"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "%(devices)d dispositivo(s) recuperado(s): %(group_addresses)d direcciones de grupo, %(links)d enlaces, %(unknown)d parámetro(s) no recuperable(s)."

msgid "Recovered"
msgstr "Recuperado"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "%(count)d dispositivo(s) añadido(s) al proyecto abierto (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Creado el nuevo proyecto %(target)s con %(count)d dispositivo(s)."

msgid "Not connected to a KNX bus."
msgstr "Sin conexión con un bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Abra o cree un proyecto para añadir los dispositivos recuperados."

msgid "matched"
msgstr "coincide"

msgid "confirm product/version, then tick"
msgstr "confirme producto/versión y luego marque"

msgid "not in catalog - import via Catalog"
msgstr "no está en el catálogo - importar mediante Catálogo"

msgid "unprogrammed"
msgstr "sin programar"

msgid "recovered"
msgstr "recuperado"

msgid "already in project - skipped"
msgstr "ya está en el proyecto - omitido"

msgid "error"
msgstr "error"

msgid "%d parameters could not be recovered"
msgstr "No se pudieron recuperar %d parámetros"

msgid "%(count)d device(s) could not be added; the reason is in the Recovered column."
msgstr "No se ha podido añadir %(count)d dispositivo(s); el motivo aparece en la columna «Recuperado»."

msgid "recovered (incomplete)"
msgstr "recuperado (incompleto)"

msgid "Search Effort"
msgstr "Esfuerzo de Búsqueda"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer."
msgstr "Cuántos valores se prueban para los ajustes de los que el dispositivo no guarda copia. Más esfuerzo encuentra ajustes en dispositivos con muchos canales, pero tarda más."

msgid "Fast"
msgstr "Rápido"

msgid "Medium"
msgstr "Medio"

msgid "Maximum"
msgstr "Máximo"

msgid "Search Again"
msgstr "Buscar de Nuevo"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Busca de nuevo los ajustes de los dispositivos incompletos seleccionados en lo que se leyó de ellos, con el esfuerzo de búsqueda elegido. No necesita bus. Un dispositivo ya añadido al proyecto se reemplaza (un paso de deshacer)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Buscando de nuevo %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d byte(s) y %(objects)d objeto(s) de grupo difieren del dispositivo"

msgid "more search effort may help"
msgstr "más esfuerzo de búsqueda puede ayudar"
