msgstr "Escaneando el bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Escaneando %(address)s  (%(done)d/%(total)d, %(found)d encontrados)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Cargando los productos que faltan desde el catálogo online: %(what)s"

msgid "Reading devices…"
msgstr "Leyendo dispositivos…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Leyendo %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tablas de comunicación de grupo"

msgid "parameter memory"
msgstr "memoria de parámetros"

msgid "Recovered"
msgstr "Recuperado"

msgid "Not connected to a KNX bus."
msgstr "Sin conexión con un bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Abra o cree un proyecto para añadir los dispositivos recuperados."

msgid "Product found"
msgstr "Producto encontrado"

msgid "Check the product and version, then select it"
msgstr "Compruebe el producto y la versión y selecciónelo"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "No está en el catálogo: importe su producto en el Catálogo"

msgid "Not programmed"
msgstr "No programado"

msgid "Already in the project, skipped"
msgstr "Ya está en el proyecto, omitido"

msgid "Error"
msgstr "Error"

msgid "Recovered (incomplete)"
msgstr "Recuperado (incompleto)"

msgid "Search Effort"
msgstr "Esfuerzo de Búsqueda"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Cuántos valores se prueban para los ajustes de los que el dispositivo no guarda copia. Más esfuerzo encuentra ajustes en dispositivos con muchos canales, pero tarda más. Ilimitado sigue hasta que ningún valor encaje mejor; Detener termina la búsqueda."

msgid "Fast"
msgstr "Rápido"

msgid "Medium"
msgstr "Medio"

msgid "Maximum"
msgstr "Máximo"

msgid "Search Again"
msgstr "Buscar de Nuevo"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Busca de nuevo los ajustes de los dispositivos incompletos seleccionados en lo que se leyó de ellos, con el esfuerzo de búsqueda elegido. No necesita bus. Un dispositivo ya añadido al proyecto se reemplaza (un paso de deshacer)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Buscando de nuevo %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "más esfuerzo de búsqueda puede ayudar"

msgid "Unlimited"
msgstr "Ilimitado"

msgid "Result"
msgstr "Resultado"

msgid "Not read yet"
msgstr "Aún no leído"

msgid "Verified"
msgstr "Verificado"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d dirección de grupo no tiene emisor o tiene varios emisores."
msgstr[1] "%(count)d direcciones de grupo no tienen emisor o tienen varios emisores."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d dispositivo recuperado"
msgstr[1] "%(count)d dispositivos recuperados"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d dirección de grupo"
msgstr[1] "%(count)d direcciones de grupo"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d enlace"
msgstr[1] "%(count)d enlaces"

