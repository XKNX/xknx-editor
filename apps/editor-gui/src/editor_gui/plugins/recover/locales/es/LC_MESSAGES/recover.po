msgstr[0] "Verificación: difiere %(count)d byte"
msgstr[1] "Verificación: difieren %(count)d bytes"

msgid "Import Snapshot…"
msgstr "Importar Instantánea…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "Se importó %(count)d dispositivo de %(file)s."
msgstr[1] "Se importaron %(count)d dispositivos de %(file)s."

