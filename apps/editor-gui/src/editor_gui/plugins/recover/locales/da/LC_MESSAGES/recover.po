msgstr "Opret nyt projekt"

msgid "Add to Open Project"
msgstr "Tilføj til åbent projekt"

msgid "Verify (Read-Only)"
msgstr "Verificer (skrivebeskyttet)"

msgid "Export Snapshot"
msgstr "Eksporter øjebliksbillede"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verificerer (læser igen og sammenligner)…"

msgid "Address"
msgstr "Adresse"

msgid "Mask"
msgstr "Maske"

msgid "Product/Application"
msgstr "Produkt/applikation"

msgid "Status"
msgstr "Status"

msgid "Set an address range and scan the bus."
msgstr "Angiv et adresseområde, og scan bussen."

msgid "Scanning the bus…"
msgstr "Gennemsøger bussen…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Scanner %(address)s  (%(done)d/%(total)d, %(found)d fundet)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Indlæser manglende produkter fra onlinekataloget: %(what)s"

msgid "Reading devices…"
msgstr "Læser enheder…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Læser %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "gruppekommunikationstabeller"

msgid "parameter memory"
msgstr "parameterhukommelse"

msgid "Recovered"
msgstr "Gendannet"

msgid "Not connected to a KNX bus."
msgstr "Ikke forbundet til en KNX-bus."

msgid "Open or create a project to add recovered devices."
msgstr "Åbn eller opret et projekt for at tilføje gendannede enheder."

msgid "Product found"
msgstr "Produkt fundet"

msgid "Check the product and version, then select it"
msgstr "Kontrollér produkt og version, og vælg det derefter"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Ikke i kataloget: importér dets produkt i Kataloger"

msgid "Not programmed"
msgstr "Ikke programmeret"

msgid "Already in the project, skipped"
msgstr "Allerede i projektet, sprunget over"

msgid "Error"
msgstr "Fejl"

msgid "Recovered (incomplete)"
msgstr "Gendannet (ufuldstændig)"

msgid "Search Effort"
msgstr "Søgeindsats"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Hvor mange værdier der prøves for de indstillinger, enheden ikke gemmer en kopi af. Mere indsats finder indstillinger i enheder med mange kanaler, men tager længere tid. Ubegrænset fortsætter, indtil ingen værdi passer bedre; Stop afslutter søgningen."

msgid "Fast"
msgstr "Hurtig"

msgid "Medium"
msgstr "Middel"

msgid "Maximum"
msgstr "Maksimal"

msgid "Search Again"
msgstr "Søg Igen"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Søger igen indstillingerne for de valgte ufuldstændige enheder i det, der blev læst fra dem, med den valgte søgeindsats. Kræver ingen bus. En enhed, der allerede er føjet til projektet, erstattes (ét fortrydelsestrin)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Søger igen i %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "mere søgeindsats kan hjælpe"

msgid "Unlimited"
msgstr "Ubegrænset"

msgid "Result"
msgstr "Resultat"

msgid "Not read yet"
msgstr "Ikke læst endnu"

msgid "Verified"
msgstr "Kontrolleret"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d gruppeadresse har ingen eller flere afsendere."
msgstr[1] "%(count)d gruppeadresser har ingen eller flere afsendere."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d enhed gendannet"
msgstr[1] "%(count)d enheder gendannet"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d gruppeadresse"
msgstr[1] "%(count)d gruppeadresser"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d sammenkædning"
msgstr[1] "%(count)d sammenkædninger"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d parameter"
msgstr[1] "%(count)d parametre"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parameter kan ikke gendannes"
msgstr[1] "%(count)d parametre kan ikke gendannes"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parameter ikke fundet endnu"
msgstr[1] "%(count)d parametre ikke fundet endnu"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d enhed tilføjet til det åbne projekt (%(target)s)."
msgstr[1] "%(count)d enheder tilføjet til det åbne projekt (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Nyt projekt %(target)s oprettet med %(count)d enhed."
msgstr[1] "Nyt projekt %(target)s oprettet med %(count)d enheder."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d enhed kunne ikke tilføjes; årsagen står i kolonnen \"Resultat\"."
msgstr[1] "%(count)d enheder kunne ikke tilføjes; årsagen står i kolonnen \"Resultat\"."

msgid "Differs from the device: %(what)s"
msgstr "Afviger fra enheden: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d byte"
msgstr[1] "%(count)d byte"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d gruppeobjekt"
msgstr[1] "%(count)d gruppeobjekter"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Kontrol: %(count)d byte afviger"
msgstr[1] "Kontrol: %(count)d byte afviger"
