msgstr "A verificar (a reler e comparar)…"

msgid "Address"
msgstr "Endereço"

msgid "Mask"
msgstr "Máscara"

msgid "Product/Application"
msgstr "Produto/Aplicação"

msgid "Status"
msgstr "Estado"

msgid "Set an address range and scan the bus."
msgstr "Defina um intervalo de endereços e pesquise o bus."

msgid "Scanning the bus…"
msgstr "A pesquisar o bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "A pesquisar %(address)s  (%(done)d/%(total)d, %(found)d encontrados)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "A carregar produtos em falta do catálogo online: %(what)s"

msgid "Reading devices…"
msgstr "A ler dispositivos…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "A ler %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabelas de comunicação de grupo"

msgid "parameter memory"
msgstr "memória de parâmetros"

msgid "Recovered"
msgstr "Recuperado"

msgid "Not connected to a KNX bus."
msgstr "Não conectado a um bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Abra ou crie um projeto para adicionar dispositivos recuperados."

msgid "Product found"
msgstr "Produto encontrado"

msgid "Check the product and version, then select it"
msgstr "Verifique o produto e a versão e depois selecione-o"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Fora do catálogo: importe o seu produto no Catálogo"

msgid "Not programmed"
msgstr "Não programado"

msgid "Already in the project, skipped"
msgstr "Já está no projeto, ignorado"

msgid "Error"
msgstr "Erro"

msgid "Recovered (incomplete)"
msgstr "Recuperado (incompleto)"

msgid "Search Effort"
msgstr "Esforço de Pesquisa"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Quantos valores são testados para as definições de que o dispositivo não guarda cópia. Mais esforço encontra definições em dispositivos com muitos canais, mas demora mais. Ilimitado continua até nenhum valor se ajustar melhor; Parar termina a pesquisa."

msgid "Fast"
msgstr "Rápido"

msgid "Medium"
msgstr "Médio"

msgid "Maximum"
msgstr "Máximo"

msgid "Search Again"
msgstr "Pesquisar Novamente"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Pesquisa novamente as definições dos dispositivos incompletos selecionados no que foi lido deles, com o esforço de pesquisa escolhido. Não precisa do bus. Um dispositivo já adicionado ao projeto é substituído (um passo de anulação)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "A pesquisar novamente %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "mais esforço de pesquisa pode ajudar"

msgid "Unlimited"
msgstr "Ilimitado"

msgid "Result"
msgstr "Resultado"

msgid "Not read yet"
msgstr "Ainda não lido"

msgid "Verified"
msgstr "Verificado"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "%(count)d endereço de grupo não tem emissor ou tem vários emissores."
msgstr[1] "%(count)d endereços de grupo não têm emissor ou têm vários emissores."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d dispositivo recuperado"
msgstr[1] "%(count)d dispositivos recuperados"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d endereço de grupo"
msgstr[1] "%(count)d endereços de grupo"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d vinculação"
msgstr[1] "%(count)d vinculações"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d parâmetro"
msgstr[1] "%(count)d parâmetros"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d parâmetro não recuperável"
msgstr[1] "%(count)d parâmetros não recuperáveis"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d parâmetro ainda não encontrado"
msgstr[1] "%(count)d parâmetros ainda não encontrados"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d dispositivo adicionado ao projeto aberto (%(target)s)."
msgstr[1] "%(count)d dispositivos adicionados ao projeto aberto (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Novo projeto %(target)s criado com %(count)d dispositivo."
msgstr[1] "Novo projeto %(target)s criado com %(count)d dispositivos."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Não foi possível adicionar %(count)d dispositivo; o motivo está na coluna \"Resultado\"."
msgstr[1] "Não foi possível adicionar %(count)d dispositivos; o motivo está na coluna \"Resultado\"."

msgid "Differs from the device: %(what)s"
msgstr "Difere do dispositivo: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d byte"
msgstr[1] "%(count)d bytes"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d objeto de grupo"
msgstr[1] "%(count)d objetos de grupo"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Verificação: %(count)d byte difere"
msgstr[1] "Verificação: %(count)d bytes diferem"

msgid "Import Snapshot…"
msgstr "Importar Instantâneo…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "Importado %(count)d dispositivo de %(file)s."
msgstr[1] "Importados %(count)d dispositivos de %(file)s."

msgid "%(file)s is no recovery snapshot: %(error)s"
msgstr "%(file)s não é um instantâneo de recuperação: %(error)s"

