msgid "Recover Project from Bus"
msgstr "Recuperar Projeto do Bus"

msgid "From Address"
msgstr "Do Endereço"

msgid "To Address"
msgstr "Até ao Endereço"

msgid "Scan"
msgstr "Procurar"

msgid "Stop"
msgstr "Parar"

msgid "Add to Open Project as Read"
msgstr "Adicionar ao Projeto Aberto como Lido"

msgid "Recover Selected"
msgstr "Recuperar Selecionados"

msgid "Create New Project"
msgstr "Criar Novo Projeto"

msgid "Add to Open Project"
msgstr "Adicionar ao Projeto Aberto"

msgid "Verify (Read-Only)"
msgstr "Verificar (Só Leitura)"

msgid "Export Snapshot"
msgstr "Exportar Instantâneo"

msgid "Verifying (re-reading and comparing)…"
msgstr "A verificar (a reler e comparar)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d endereço(s) de grupo não têm emissor ou têm vários emissores."

msgid "Address"
msgstr "Endereço"

msgid "Mask"
msgstr "Máscara"

msgid "Product/Application"
msgstr "Produto/Aplicação"

msgid "Status"
msgstr "Estado"

msgid "Set an address range and scan the bus."
msgstr "Defina um intervalo de endereços e pesquise o bus."

msgid "Scanning the bus…"
msgstr "A pesquisar o bus…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "A pesquisar %(address)s  (%(done)d/%(total)d, %(found)d encontrados)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "A carregar produtos em falta do catálogo online: %(what)s"

msgid "Reading devices…"
msgstr "A ler dispositivos…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "A ler %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "tabelas de comunicação de grupo"

msgid "parameter memory"
msgstr "memória de parâmetros"

msgid "Recovered %(devices)d device(s): %(group_addresses)d group addresses, %(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr "%(devices)d dispositivo(s) recuperado(s): %(group_addresses)d endereços de grupo, %(links)d vinculações, %(unknown)d parâmetro(s) não recuperável(eis)."

msgid "Recovered"
msgstr "Recuperado"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "%(count)d dispositivo(s) adicionado(s) ao projeto aberto (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Novo projeto %(target)s criado com %(count)d dispositivo(s)."

msgid "Not connected to a KNX bus."
msgstr "Não conectado a um bus KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Abra ou crie um projeto para adicionar dispositivos recuperados."

msgid "matched"
msgstr "correspondente"

msgid "confirm product/version, then tick"
msgstr "confirmar produto/versão e depois marcar"

msgid "not in catalog - import via Catalog"
msgstr "fora do catálogo - importar através do Catálogo"

msgid "unprogrammed"
msgstr "não programado"

msgid "recovered"
msgstr "recuperado"

msgid "already in project - skipped"
msgstr "já no projeto - ignorado"

msgid "error"
msgstr "erro"

msgid "%d parameters could not be recovered"
msgstr "Não foi possível recuperar %d parâmetros"

msgid "%(count)d device(s) could not be added; the reason is in the Recovered column."
msgstr "Não foi possível adicionar %(count)d dispositivo(s); o motivo está na coluna \"Recuperado\"."

msgid "recovered (incomplete)"
msgstr "recuperado (incompleto)"

msgid "Search Effort"
msgstr "Esforço de Pesquisa"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer."
msgstr "Quantos valores são testados para as definições de que o dispositivo não guarda cópia. Mais esforço encontra definições em dispositivos com muitos canais, mas demora mais."

msgid "Fast"
msgstr "Rápido"

msgid "Medium"
msgstr "Médio"

msgid "Maximum"
msgstr "Máximo"

msgid "Search Again"
msgstr "Pesquisar Novamente"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Pesquisa novamente as definições dos dispositivos incompletos selecionados no que foi lido deles, com o esforço de pesquisa escolhido. Não precisa do bus. Um dispositivo já adicionado ao projeto é substituído (um passo de anulação)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "A pesquisar novamente %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d byte(s) e %(objects)d objeto(s) de grupo diferem do dispositivo"

msgid "more search effort may help"
msgstr "mais esforço de pesquisa pode ajudar"
