msgid "Recover Project from Bus"
msgstr "Восстановить проект с шины"

msgid "From Address"
msgstr "От адреса"

msgid "To Address"
msgstr "До адреса"

msgid "Scan"
msgstr "Сканировать"

msgid "Stop"
msgstr "Стоп"

msgid "Add to Open Project When Read"
msgstr "Добавлять в открытый проект при чтении"

msgid "Recover Selected"
msgstr "Восстановить выбранные"

msgid "Create New Project…"
msgstr "Создать новый проект…"

msgid "Add to Open Project"
msgstr "Добавить в открытый проект"

msgid "Verify (Read-Only)"
msgstr "Проверить (только чтение)"

msgid "Export Snapshot…"
msgstr "Экспорт снимка…"

msgid "Verifying (re-reading and comparing)…"
msgstr "Проверка (повторное чтение и сравнение)…"

msgid "Address"
msgstr "Адрес"

msgid "Mask"
msgstr "Маска"

msgid "Product/Application"
msgstr "Продукт/прикладная программа"

msgid "Status"
msgstr "Статус"

msgid "Set an address range and scan the bus."
msgstr "Задайте диапазон адресов и выполните поиск на шине."

msgid "Scanning the bus…"
msgstr "Поиск на шине…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Поиск %(address)s  (%(done)d/%(total)d, найдено: %(found)d)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Загрузка недостающих продуктов из онлайн-каталога: %(what)s"

msgid "Reading devices…"
msgstr "Чтение устройств…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Чтение %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "таблицы групповой коммуникации"

msgid "parameter memory"
msgstr "память параметров"

msgid "Recovered"
msgstr "Восстановлено"

msgid "Not connected to a KNX bus."
msgstr "Нет подключения к шине KNX."

msgid "Open or create a project to add recovered devices."
msgstr "Откройте или создайте проект, чтобы добавить восстановленные устройства."

msgid "Product found"
msgstr "Продукт найден"

msgid "Check the product and version, then select it"
msgstr "Проверьте продукт и версию, затем выберите его"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Нет в каталоге: импортируйте его продукт в «Каталоге»"

msgid "Not programmed"
msgstr "Не запрограммировано"

msgid "Already in the project, skipped"
msgstr "Уже в проекте, пропущено"

msgid "Error"
msgstr "Ошибка"

msgid "Recovered (incomplete)"
msgstr "Восстановлено (не полностью)"

msgid "Search Effort"
msgstr "Объём Поиска"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Сколько значений перебирается для параметров, копию которых устройство не хранит. Больший объём находит параметры в устройствах с множеством каналов, но занимает больше времени. Без ограничений поиск идёт, пока ни одно значение не подходит лучше; «Стоп» завершает поиск."

msgid "Fast"
msgstr "Быстрый"

msgid "Medium"
msgstr "Средний"

msgid "Maximum"
msgstr "Максимальный"

msgid "Search Again"
msgstr "Искать Снова"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Повторно ищет параметры выбранных неполных устройств в считанных из них данных с выбранным объёмом поиска. Шина не нужна. Устройство, уже добавленное в проект, заменяется (один шаг отмены)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Повторный поиск для %(address)s  (%(done)d/%(total)d)…"

msgid "more search effort may help"
msgstr "больший объём поиска может помочь"

msgid "Unlimited"
msgstr "Без ограничений"

msgid "Result"
msgstr "Результат"

msgid "Not read yet"
msgstr "Ещё не считано"

msgid "Verified"
msgstr "Проверено"

msgid "%(count)d group address has no sender or multiple senders."
msgid_plural "%(count)d group addresses have no sender or multiple senders."
msgstr[0] "У %(count)d группового адреса нет отправителя или несколько отправителей."
msgstr[1] "У %(count)d групповых адресов нет отправителя или несколько отправителей."
msgstr[2] "У %(count)d групповых адресов нет отправителя или несколько отправителей."

msgid "Recovered %(count)d device"
msgid_plural "Recovered %(count)d devices"
msgstr[0] "Восстановлено %(count)d устройство"
msgstr[1] "Восстановлено %(count)d устройства"
msgstr[2] "Восстановлено %(count)d устройств"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d групповой адрес"
msgstr[1] "%(count)d групповых адреса"
msgstr[2] "%(count)d групповых адресов"

msgid "%(count)d link"
msgid_plural "%(count)d links"
msgstr[0] "%(count)d связь"
msgstr[1] "%(count)d связи"
msgstr[2] "%(count)d связей"

msgid "%(count)d parameter"
msgid_plural "%(count)d parameters"
msgstr[0] "%(count)d параметр"
msgstr[1] "%(count)d параметра"
msgstr[2] "%(count)d параметров"

msgid "%(count)d parameter cannot be recovered"
msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d параметр невозможно восстановить"
msgstr[1] "%(count)d параметра невозможно восстановить"
msgstr[2] "%(count)d параметров невозможно восстановить"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d параметр пока не найден"
msgstr[1] "%(count)d параметра пока не найдены"
msgstr[2] "%(count)d параметров пока не найдены"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "В открытый проект (%(target)s) добавлено %(count)d устройство."
msgstr[1] "В открытый проект (%(target)s) добавлено %(count)d устройства."
msgstr[2] "В открытый проект (%(target)s) добавлено %(count)d устройств."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Создан новый проект %(target)s с %(count)d устройством."
msgstr[1] "Создан новый проект %(target)s с %(count)d устройствами."
msgstr[2] "Создан новый проект %(target)s с %(count)d устройствами."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "Не удалось добавить %(count)d устройство; причина указана в столбце «Результат»."
msgstr[1] "Не удалось добавить %(count)d устройства; причина указана в столбце «Результат»."
msgstr[2] "Не удалось добавить %(count)d устройств; причина указана в столбце «Результат»."

msgid "Differs from the device: %(what)s"
msgstr "Отличается от устройства: %(what)s"

msgid "%(count)d byte"
msgid_plural "%(count)d bytes"
msgstr[0] "%(count)d байт"
msgstr[1] "%(count)d байта"
msgstr[2] "%(count)d байт"

msgid "%(count)d group object"
msgid_plural "%(count)d group objects"
msgstr[0] "%(count)d групповой объект"
msgstr[1] "%(count)d групповых объекта"
msgstr[2] "%(count)d групповых объектов"

msgid "Verify: %(count)d byte differs"
msgid_plural "Verify: %(count)d bytes differ"
msgstr[0] "Проверка: отличается %(count)d байт"
msgstr[1] "Проверка: отличаются %(count)d байта"
msgstr[2] "Проверка: отличаются %(count)d байт"

msgid "Import Snapshot…"
msgstr "Импорт снимка…"

msgid "Imported %(count)d device from %(file)s."
msgid_plural "Imported %(count)d devices from %(file)s."
msgstr[0] "Импортировано %(count)d устройство из %(file)s."
msgstr[1] "Импортировано %(count)d устройства из %(file)s."
msgstr[2] "Импортировано %(count)d устройств из %(file)s."

msgid "%(file)s is no recovery snapshot: %(error)s"
msgstr "%(file)s не является снимком восстановления: %(error)s"

msgid "Recovery Snapshot (*.json)"
msgstr "Снимок восстановления (*.json)"

msgid "All Files"
msgstr "Все файлы"

msgid "Device mask: %(device)s; product mask: %(product)s"
msgstr "Маска устройства: %(device)s; маска продукта: %(product)s"

msgid "Mask compatibility data unavailable; only exact masks checked"
msgstr "Данные о совместимости масок недоступны; проверены только одинаковые маски"

msgid "The application version missing from the local catalog was found in the alternative catalog. A login is required to download it. Enter your username and password in Settings > Catalog."
msgstr "Версия приложения, отсутствующая в локальном каталоге, найдена в альтернативном каталоге. Для скачивания необходимо войти в учётную запись. Укажите имя пользователя и пароль в разделе Настройки > Каталог."
