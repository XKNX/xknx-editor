msgid_plural "%(count)d parameters cannot be recovered"
msgstr[0] "%(count)d Parameter nicht wiederherstellbar"
msgstr[1] "%(count)d Parameter nicht wiederherstellbar"

msgid "%(count)d parameter not found yet"
msgid_plural "%(count)d parameters not found yet"
msgstr[0] "%(count)d Parameter noch nicht gefunden"
msgstr[1] "%(count)d Parameter noch nicht gefunden"

msgid "Added %(count)d device to the open project (%(target)s)."
msgid_plural "Added %(count)d devices to the open project (%(target)s)."
msgstr[0] "%(count)d Gerät zum geöffneten Projekt hinzugefügt (%(target)s)."
msgstr[1] "%(count)d Geräte zum geöffneten Projekt hinzugefügt (%(target)s)."

msgid "Created new project %(target)s with %(count)d device."
msgid_plural "Created new project %(target)s with %(count)d devices."
msgstr[0] "Neues Projekt %(target)s mit %(count)d Gerät erstellt."
msgstr[1] "Neues Projekt %(target)s mit %(count)d Geräten erstellt."

msgid "%(count)d device could not be added; the reason is in the Result column."
msgid_plural "%(count)d devices could not be added; the reason is in the Result column."
msgstr[0] "%(count)d Gerät konnte nicht hinzugefügt werden; der Grund steht in der Spalte „Ergebnis“."
msgstr[1] "%(count)d Geräte konnten nicht hinzugefügt werden; der Grund steht in der Spalte „Ergebnis“."

msgid "Differs from the device: %(what)s"
msgstr "Weicht vom Gerät ab: %(what)s"

