msgid_plural "Recovered %(count)d devices"
msgstr[0] "%(count)d Gerät wiederhergestellt"
msgstr[1] "%(count)d Geräte wiederhergestellt"

msgid "%(count)d group address"
msgid_plural "%(count)d group addresses"
msgstr[0] "%(count)d Gruppenadresse"
msgstr[1] "%(count)d Gruppenadressen"

