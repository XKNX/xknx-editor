msgid "Recover"
msgstr "Wiederherstellen"

msgid "Recover from Bus…"
msgstr "Vom Bus wiederherstellen…"

msgid "Recover Project from Bus"
msgstr "Projekt vom Bus wiederherstellen"

msgid "From Address"
msgstr "Von Adresse"

msgid "To Address"
msgstr "Bis Adresse"

msgid "Scan"
msgstr "Suchen"

msgid "Stop"
msgstr "Stoppen"

msgid "Add to Open Project When Read"
msgstr "Beim Lesen zum geöffneten Projekt hinzufügen"

msgid "Recover Selected"
msgstr "Ausgewählte wiederherstellen"

msgid "Create New Project"
msgstr "Neues Projekt erstellen"

msgid "Add to Open Project"
msgstr "Zum geöffneten Projekt hinzufügen"

msgid "Verify (Read-Only)"
msgstr "Verifizieren (nur lesen)"

msgid "Export Snapshot"
msgstr "Schnappschuss exportieren"

msgid "Verifying (re-reading and comparing)…"
msgstr "Verifizierung (erneutes Lesen und Vergleichen)…"

msgid "%(count)d group address(es) have no sender or multiple senders."
msgstr "%(count)d Gruppenadresse(n) haben keinen oder mehrere Sender."

msgid "Address"
msgstr "Adresse"

msgid "Mask"
msgstr "Maske"

msgid "Product/Application"
msgstr "Produkt/Applikation"

msgid "Status"
msgstr "Status"

msgid "Set an address range and scan the bus."
msgstr "Adressbereich festlegen und den Bus durchsuchen."

msgid "Scanning the bus…"
msgstr "Bus wird durchsucht…"

msgid "Scanning %(address)s  (%(done)d/%(total)d, %(found)d found)"
msgstr "Suche %(address)s  (%(done)d/%(total)d, %(found)d gefunden)"

msgid "Loading missing products from online catalog: %(what)s"
msgstr "Fehlende Produkte werden aus dem Online-Katalog geladen: %(what)s"

msgid "Reading devices…"
msgstr "Geräte werden gelesen…"

msgid "Reading %(address)s  (%(done)d/%(total)d)  -  %(stage)s"
msgstr "Lese %(address)s  (%(done)d/%(total)d)  -  %(stage)s"

msgid "group communication tables"
msgstr "Gruppenkommunikationstabellen"

msgid "parameter memory"
msgstr "Parameterspeicher"

msgid ""
"Recovered %(devices)d device(s): %(group_addresses)d group addresses, "
"%(links)d links, %(unknown)d parameter(s) not recoverable."
msgstr ""
"%(devices)d Gerät(e) wiederhergestellt: %(group_addresses)d Gruppenadressen,"
" %(links)d Verbindungen, %(unknown)d Parameter nicht wiederherstellbar."

msgid "Recovered"
msgstr "Wiederhergestellt"

msgid "Added %(count)d device(s) to the open project (%(target)s)."
msgstr "%(count)d Gerät(e) zum geöffneten Projekt hinzugefügt (%(target)s)."

msgid "Created new project %(target)s with %(count)d device(s)."
msgstr "Neues Projekt %(target)s mit %(count)d Gerät(e) erstellt."

msgid "Not connected to a KNX bus."
msgstr "Nicht mit einem KNX-Bus verbunden."

msgid "Open or create a project to add recovered devices."
msgstr ""
"Öffnen oder erstellen Sie ein Projekt, um wiederhergestellte Geräte "
"hinzuzufügen."

msgid "Product found"
msgstr "Produkt gefunden"

msgid "Check the product and version, then select it"
msgstr "Prüfen Sie Produkt und Version und wählen Sie es dann aus"

msgid "Not in the catalog: import its product in the Catalog"
msgstr "Nicht im Katalog: Importieren Sie sein Produkt im Katalog"

msgid "Not programmed"
msgstr "Nicht programmiert"


msgid "Error"
msgstr "Fehler"

msgid "%d parameters could not be recovered"
msgstr "%d Parameter konnten nicht wiederhergestellt werden"

msgid "Already in the project, skipped"
msgstr "Bereits im Projekt, übersprungen"

msgid "%(count)d device(s) could not be added; the reason is in the Result column."
msgstr "%(count)d Gerät(e) konnten nicht hinzugefügt werden; der Grund steht in der Spalte „Ergebnis“."

msgid "Recovered (incomplete)"
msgstr "Wiederhergestellt (unvollständig)"

msgid "Search Effort"
msgstr "Suchaufwand"

msgid "How many values are tried for the settings a device keeps no copy of. More effort finds settings in devices with many channels, but takes longer. Unlimited goes on until no value fits better; Stop ends the search."
msgstr "Wie viele Werte für die Einstellungen probiert werden, von denen das Gerät keine Kopie speichert. Mehr Aufwand findet Einstellungen in Geräten mit vielen Kanälen, dauert aber länger. Unbegrenzt sucht weiter, bis kein Wert mehr besser passt; Stoppen beendet die Suche."

msgid "Fast"
msgstr "Schnell"

msgid "Medium"
msgstr "Mittel"

msgid "Maximum"
msgstr "Maximal"

msgid "Search Again"
msgstr "Erneut suchen"

msgid "Searches the settings of the selected incomplete devices again in what was read from them, with the chosen search effort. Needs no bus. A device already added to the project is replaced (one undo step)."
msgstr "Sucht die Einstellungen der ausgewählten unvollständigen Geräte erneut in den von ihnen gelesenen Daten, mit dem gewählten Suchaufwand. Benötigt keinen Bus. Ein bereits zum Projekt hinzugefügtes Gerät wird ersetzt (ein Rückgängig-Schritt)."

msgid "Searching %(address)s again  (%(done)d/%(total)d)…"
msgstr "Erneute Suche für %(address)s  (%(done)d/%(total)d)…"

msgid "%(bytes)d byte(s) and %(objects)d group object(s) differ from the device"
msgstr "%(bytes)d Byte(s) und %(objects)d Kommunikationsobjekt(e) weichen vom Gerät ab"

msgid "more search effort may help"
msgstr "mehr Suchaufwand kann helfen"

msgid "Unlimited"
msgstr "Unbegrenzt"

msgid "Result"
msgstr "Ergebnis"

msgid "Not read yet"
msgstr "Noch nicht gelesen"

msgid "%(group_addresses)d group addresses, %(links)d links, %(parameters)d parameters"
msgstr "%(group_addresses)d Gruppenadressen, %(links)d Verknüpfungen, %(parameters)d Parameter"

msgid "%(count)d unknown"
msgstr "%(count)d unbekannt"

msgid "Verified"
msgstr "Geprüft"

msgid "Verify: %(bytes)d byte(s) differ"
msgstr "Prüfen: %(bytes)d Byte(s) weichen ab"
