msgid "Home Assistant"
msgstr "Home Assistant"

msgid "Use Project in Home Assistant"
msgstr "Použít projekt v Home Assistantu"

msgid "Update Home Assistant Now"
msgstr "Aktualizovat Home Assistant nyní"

msgid "Update Home Assistant Automatically"
msgstr "Aktualizovat Home Assistant automaticky"

msgid "After each change, the project is sent to Home Assistant's KNX integration again."
msgstr "Po každé změně se projekt znovu odešle do integrace KNX v Home Assistantu."

msgid "Home Assistant: up to date"
msgstr "Home Assistant: aktuální"

msgid "Home Assistant: changes not sent"
msgstr "Home Assistant: změny neodeslány"

msgid "Home Assistant: updating…"
msgstr "Home Assistant: probíhá aktualizace…"

msgid "Home Assistant: other project"
msgstr "Home Assistant: jiný projekt"

msgid "Home Assistant: KNX integration not set up"
msgstr "Home Assistant: integrace KNX není nastavena"

msgid "Home Assistant: update failed"
msgstr "Home Assistant: aktualizace selhala"

msgid "Home Assistant: not connected"
msgstr "Home Assistant: nepřipojeno"

msgid "Home Assistant's KNX integration uses this project: its group monitor, project view and address pickers know its group addresses, devices and buildings."
msgstr "Integrace KNX v Home Assistantu používá tento projekt: její skupinový monitor, zobrazení projektu a výběr adres znají jeho skupinové adresy, zařízení a budovy."

msgid "The changes are sent to Home Assistant in a moment."
msgstr "Změny budou za okamžik odeslány do Home Assistantu."

msgid "Automatic updates are off: Update Home Assistant Now in the Home Assistant menu sends the changes."
msgstr "Automatické aktualizace jsou vypnuté: změny odešle „Aktualizovat Home Assistant nyní“ v nabídce Home Assistant."

msgid "Home Assistant's KNX integration holds no project."
msgstr "Integrace KNX v Home Assistantu nemá žádný projekt."

msgid "Home Assistant's KNX integration holds the project \"{name}\" ({tool}, {date})."
msgstr "Integrace KNX v Home Assistantu má projekt „{name}“ ({tool}, {date})."

msgid "Set up the KNX integration in Home Assistant to use this project there (Settings > Devices & Services)."
msgstr "Nastavte integraci KNX v Home Assistantu, abyste tam mohli tento projekt používat (Nastavení > Zařízení a služby)."

msgid "Home Assistant did not take the project: {error}"
msgstr "Home Assistant projekt nepřevzal: {error}"

msgid "The XKNX Editor integration is not connected. Update the integration in Home Assistant if this stays."
msgstr "Integrace XKNX Editor není připojena. Pokud tento stav trvá, aktualizujte integraci v Home Assistantu."

msgid "Home Assistant's KNX integration holds no project yet. Use \"{name}\" as its project?"
msgstr "Integrace KNX v Home Assistantu zatím nemá žádný projekt. Použít „{name}“ jako její projekt?"

msgid "Home Assistant's KNX integration holds the project \"{other}\" ({tool}, {date}). Replace it with \"{name}\"?"
msgstr "Integrace KNX v Home Assistantu má projekt „{other}“ ({tool}, {date}). Nahradit ho projektem „{name}“?"

msgid "Its group monitor, project view, address pickers and entity suggestions then know this project's group addresses, devices and buildings. Entities, automations and the KNX integration's other settings stay as they are."
msgstr "Její skupinový monitor, zobrazení projektu, výběr adres a návrhy entit pak znají skupinové adresy, zařízení a budovy tohoto projektu. Entity, automatizace a ostatní nastavení integrace KNX zůstanou beze změny."

msgid "Your changes reach Home Assistant a moment after you make them."
msgstr "Vaše změny dorazí do Home Assistantu chvíli poté, co je provedete."

msgid "Automatic updates are off: Update Home Assistant Now in the Home Assistant menu sends your changes."
msgstr "Automatické aktualizace jsou vypnuté: vaše změny odešle „Aktualizovat Home Assistant nyní“ v nabídce Home Assistant."

msgid "Use in Home Assistant"
msgstr "Použít v Home Assistantu"

msgid "Replace"
msgstr "Nahradit"

msgid "Not Now"
msgstr "Teď ne"

msgid "date unknown"
msgstr "datum neznámé"
