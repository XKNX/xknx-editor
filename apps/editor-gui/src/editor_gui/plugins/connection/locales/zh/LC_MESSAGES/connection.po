msgid "Gateway"
msgstr "网关"

msgid "Connect"
msgstr "连接"

msgid "Disconnect"
msgstr "断开"

msgid "Use Serial Number for Downloads"
msgstr "下载时使用系列号"

msgid "Discovered Gateways"
msgstr "已发现的网关"

msgid "Diagnostics"
msgstr "诊断"

