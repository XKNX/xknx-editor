msgid "Gateway"
msgstr "Brána"

msgid "Connect"
msgstr "Pripojiť"

msgid "Disconnect"
msgstr "Odpojiť"

msgid "Discovered Gateways"
msgstr "Nájdené brány"

msgid "Check for Devices in Programming Mode"
msgstr "Vyhľadať zariadenia v programovacom režime"

msgid "No gateways found"
msgstr "Nenašli sa žiadne brány"

msgid "Manual Connection"
msgstr "Ručné pripojenie"

msgid "Connected: {ip}"
msgstr "Pripojené: {ip}"

msgid "Connected to {ip}"
msgstr "Pripojené k {ip}"

msgid "Disconnected"
msgstr "Odpojené"

msgid "Connecting…"
msgstr "Pripája sa…"

msgid "Connection failed"
msgstr "Pripojenie zlyhalo"

msgid "Scan"
msgstr "Hľadať"

msgid "Settings"
msgstr "Nastavenia"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Použiť multicastové smerovanie (namiesto tunelovania)"

msgid "Gateway IP"
msgstr "IP brány"

msgid "Multicast Group"
msgstr "Skupina multicast"

msgid "Apply"
msgstr "Použiť"

msgid "Connect at Startup"
msgstr "Pripojiť pri spustení"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Pri spustení editor vyhľadá rozhrania KNX a pripojí sa k naposledy použitému. Ak je vypnuté, pripojí sa len vtedy, keď to zvolíte."

msgid "Use Serial Number for Downloads"
msgstr "Použiť sériové číslo pri nahrávaní"

msgid "Bus monitor: {ip}"
msgstr "Monitor zbernice: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Brána je pripojená v režime monitora zbernice. Kým sa monitor zbernice nezastaví, nedá sa nič odosielať ani nahrávať."

msgid "Stop Bus Monitor"
msgstr "Zastaviť monitor zbernice"

msgid "Not possible while the bus monitor is running"
msgstr "Nie je možné, kým beží monitor zbernice"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Na vyhľadávanie odpovedalo, ale čítanie podrobností zlyhalo: {error}"

msgid "Application"
msgstr "Aplikácia"

msgid "Application Version"
msgstr "Verzia aplikácie"

msgid "Devices in Programming Mode"
msgstr "Zariadenia v programovacom režime"

msgid "Hardware Type"
msgstr "Typ hardvéru"

msgid "In this project: {name}"
msgstr "V tomto projekte: {name}"

msgid "Manufacturer"
msgstr "Výrobca"

msgid "Mask Version"
msgstr "Verzia masky"

msgid "No device is in programming mode."
msgstr "Žiadne zariadenie nie je v programovacom režime."

msgid "No fault"
msgstr "Bez chyby"

msgid "Not in this project"
msgstr "Nie je v tomto projekte"

msgid "Order Number"
msgstr "Objednávacie číslo"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Stlačte programovacie tlačidlo na zariadení, aby ste ho prepli do programovacieho režimu, a potom hľadajte znova."

msgid "Product (Catalog)"
msgstr "Produkt (katalóg)"

msgid "Programming mode active"
msgstr "Programovací režim aktívny"

msgid "Rescan"
msgstr "Hľadať znova"

msgid "Searching the bus…"
msgstr "Prehľadáva sa zbernica…"

msgid "Select in Project"
msgstr "Vybrať v projekte"

msgid "Serial Number"
msgstr "Sériové číslo"

msgid "Status"
msgstr "Stav"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Rozhranie nepotvrdilo požiadavku na vyhľadávanie (zbernica obsadená alebo rozhranie preťažené). Skúste to znova."

msgid "The scan could not be completed: {error}"
msgstr "Vyhľadávanie sa nepodarilo dokončiť: {error}"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Nenaprogramované zariadenie (výrobná adresa 15.15.255)"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Rozhranie vyžaduje KNX IP Secure, ale jeho heslá neobsahuje projekt ani načítaný zväzok kľúčov."

msgid "Error: {error}"
msgstr "Chyba: {error}"

msgid "Unknown error"
msgstr "Neznáma chyba"

msgid "Name: {name}"
msgstr "Názov: {name}"

msgid "KNX Address: {address}"
msgstr "Adresa KNX: {address}"

msgid "Core Version: {version}"
msgstr "Verzia jadra: {version}"

msgid "Services: {services}"
msgstr "Služby: {services}"

msgid "Retry"
msgstr "Skúsiť znova"

msgid "Select Connection"
msgstr "Výber pripojenia"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor nedokázal určiť dostupné pripojenie."

msgid "The connection {name} is not available."
msgstr "Pripojenie {name} nie je dostupné."

msgid "You may use any of the connections listed below, instead."
msgstr "Namiesto toho môžete použiť ktorékoľvek z pripojení uvedených nižšie."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Zrušiť"

msgid "This kind of connection is not supported."
msgstr "Tento druh pripojenia nie je podporovaný."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Zariadenie so známym sériovým číslom dostane individuálnu adresu bez stlačenia programovacieho tlačidla."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Rozhrania USB"

msgid "No USB interfaces found"
msgstr "Nenašli sa žiadne rozhrania USB"

msgid "Not connected to the bus"
msgstr "Nepripojené k zbernici"

msgid "Serial Number: {serial}"
msgstr "Sériové číslo: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} zariadenie v programovacom režime"
msgstr[1] "{count} zariadenia v programovacom režime"
msgstr[2] "{count} zariadení v programovacom režime"

msgid "USB Interface Settings…"
msgstr "Nastavenia USB Rozhrania…"

msgid "USB Interface Settings"
msgstr "Nastavenia USB Rozhrania"

msgid "Close"
msgstr "Zavrieť"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maximálna Dĺžka Telegramu (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Typ EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Podporované typy EMI: {types}"

msgid "Mask Version: {mask}"
msgstr "Verzia masky: {mask}"

msgid "Individual Address"
msgstr "Individuálna adresa"

msgid "Address Free?"
msgstr "Adresa Voľná?"

msgid "The individual address {address} is not used by another device."
msgstr "Individuálnu adresu {address} nepoužíva žiadne iné zariadenie."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Individuálnu adresu {address} už používa iné zariadenie na zbernici."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} nie je individuálna adresa (oblasť.linka.zariadenie)."

msgid "The individual address of the interface is being set or checked."
msgstr "Individuálna adresa rozhrania sa práve nastavuje alebo kontroluje."

msgid "Not connected through a USB interface."
msgstr "Nie je pripojené cez rozhranie USB."

msgid "The individual address could not be set: {error}"
msgstr "Individuálnu adresu sa nepodarilo nastaviť: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Individuálnu adresu sa nepodarilo skontrolovať: {error}"

msgid "Setting the individual address…"
msgstr "Nastavuje sa individuálna adresa…"

msgid "Checking the individual address on the bus…"
msgstr "Kontroluje sa individuálna adresa na zbernici…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Zmenená adresa sa nastaví v rozhraní (Enter), ktoré si ju ponechá."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Zmenená adresa sa nastaví v rozhraní (Enter). Toto rozhranie ju po odpojení zabudne, preto sa nastaví znova pri každom pripojení."
