msgid "Gateway"
msgstr "Átjáró"

msgid "Connect"
msgstr "Csatlakozás"

msgid "Disconnect"
msgstr "Kapcsolat bontása"

msgid "Discovered Gateways"
msgstr "Talált átjárók"

msgid "Check for Devices in Programming Mode"
msgstr "Programozási módban lévő készülékek keresése"

msgid "No gateways found"
msgstr "Nem található átjáró"

msgid "Manual Connection"
msgstr "Kézi kapcsolat"

msgid "Connected: {ip}"
msgstr "Csatlakoztatva: {ip}"

msgid "Connected to {ip}"
msgstr "Csatlakoztatva: {ip}"

msgid "Disconnected"
msgstr "Nincs kapcsolat"

msgid "Connecting…"
msgstr "Csatlakozás…"

msgid "Connection failed"
msgstr "A kapcsolódás nem sikerült"

msgid "Scan"
msgstr "Keresés"

msgid "Settings"
msgstr "Beállítások"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Multicast routing használata (tunneling helyett)"

msgid "Gateway IP"
msgstr "Átjáró IP-címe"

msgid "Multicast Group"
msgstr "Multicast csoport"

msgid "Apply"
msgstr "Alkalmaz"

msgid "Connect at Startup"
msgstr "Csatlakozás indításkor"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Indításkor a szerkesztő KNX interfészeket keres, és a legutóbb használthoz csatlakozik. Kikapcsolva csak akkor csatlakozik, amikor Ön kéri."

msgid "Use Serial Number for Downloads"
msgstr "Sorozatszám használata programozáshoz"

msgid "Bus monitor: {ip}"
msgstr "Buszmonitor: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Az átjáró buszmonitor módban csatlakozik. Amíg a buszmonitor le nem áll, semmi sem küldhető és semmi sem programozható."

msgid "Stop Bus Monitor"
msgstr "Buszmonitor leállítása"

msgid "Not possible while the bus monitor is running"
msgstr "Nem lehetséges, amíg a buszmonitor fut"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Válaszolt a keresésre, de a részletei nem olvashatók ki: {error}"

msgid "Application"
msgstr "Alkalmazás"

msgid "Application Version"
msgstr "Alkalmazás verziója"

msgid "Devices in Programming Mode"
msgstr "Programozási módban lévő készülékek"

msgid "Hardware Type"
msgstr "Hardvertípus"

msgid "In this project: {name}"
msgstr "Ebben a projektben: {name}"

msgid "Manufacturer"
msgstr "Gyártó"

msgid "Mask Version"
msgstr "Maszkverzió"

msgid "No device is in programming mode."
msgstr "Egy készülék sincs programozási módban."

msgid "No fault"
msgstr "Nincs hiba"

msgid "Not in this project"
msgstr "Nincs ebben a projektben"

msgid "Order Number"
msgstr "Rendelési szám"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Nyomja meg egy készülék programozó gombját, hogy programozási módba kapcsoljon, majd keressen újra."

msgid "Product (Catalog)"
msgstr "Termék (katalógus)"

msgid "Programming mode active"
msgstr "Programozási mód aktív"

msgid "Rescan"
msgstr "Újrakeresés"

msgid "Searching the bus…"
msgstr "A busz átkutatása…"

msgid "Select in Project"
msgstr "Kijelölés a projektben"

msgid "Serial Number"
msgstr "Sorozatszám"

msgid "Status"
msgstr "Állapot"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Az interfész nem nyugtázta a keresési kérést (a busz foglalt vagy az interfész túlterhelt). Próbálja újra."

msgid "The scan could not be completed: {error}"
msgstr "A keresés nem fejeződhetett be: {error}"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Programozatlan készülék (gyári alapértelmezett cím: 15.15.255)"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Az interfész KNX IP Secure-t igényel, de sem a projekt, sem egy betöltött kulcskarika nem tartalmazza a jelszavait."

msgid "Error: {error}"
msgstr "Hiba: {error}"

msgid "Unknown error"
msgstr "Ismeretlen hiba"

msgid "Name: {name}"
msgstr "Név: {name}"

msgid "KNX Address: {address}"
msgstr "KNX-cím: {address}"

msgid "Core Version: {version}"
msgstr "Core verzió: {version}"

msgid "Services: {services}"
msgstr "Szolgáltatások: {services}"

msgid "Retry"
msgstr "Újra"

msgid "Select Connection"
msgstr "Kapcsolat kiválasztása"

msgid "XKNX Editor could not determine an available connection."
msgstr "Az XKNX Editor nem talált elérhető kapcsolatot."

msgid "The connection {name} is not available."
msgstr "A kapcsolat nem érhető el: {name}"

msgid "You may use any of the connections listed below, instead."
msgstr "Helyette használhatja az alább felsorolt kapcsolatok bármelyikét."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Mégse"

msgid "This kind of connection is not supported."
msgstr "Ez a kapcsolattípus nem támogatott."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Az ismert sorozatszámú eszköz a programozógombja megnyomása nélkül kapja meg a fizikai címét."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-interfészek"

msgid "No USB interfaces found"
msgstr "Nem található USB-interfész"

msgid "Not connected to the bus"
msgstr "Nincs csatlakoztatva a buszhoz"

msgid "Serial Number: {serial}"
msgstr "Sorozatszám: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} készülék programozási módban"

msgid "USB Interface…"
msgstr "USB Interfész…"

msgid "USB Interface"
msgstr "USB Interfész"

msgid "Close"
msgstr "Bezárás"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maximális Távirathossz (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "EMI-típus: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Támogatott EMI-típusok: {types}"

msgid "Mask Version: {mask}"
msgstr "Maszkverzió: {mask}"

msgid "Individual Address"
msgstr "Fizikai cím"

msgid "Address Free?"
msgstr "Szabad a Cím?"

msgid "The individual address {address} is not used by another device."
msgstr "A(z) {address} fizikai címet nem használja más eszköz."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "A(z) {address} fizikai címet már használja egy másik eszköz a buszon."

msgid "{address} is not an individual address (area.line.device)."
msgstr "A(z) {address} nem fizikai cím (terület.vonal.eszköz)."

msgid "The individual address of the interface is being set or checked."
msgstr "Az interfész fizikai címének beállítása vagy ellenőrzése folyamatban van."

msgid "Not connected through a USB interface."
msgstr "Nincs kapcsolat USB interfészen keresztül."

msgid "The individual address could not be set: {error}"
msgstr "A fizikai cím nem állítható be: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "A fizikai cím nem ellenőrizhető: {error}"

msgid "Setting the individual address…"
msgstr "A fizikai cím beállítása…"

msgid "Checking the individual address on the bus…"
msgstr "A fizikai cím ellenőrzése a buszon…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Ez az interfész kihúzáskor elfelejti a fizikai címét, ezért minden csatlakozáskor újra beállításra kerül."