msgstr "Manuell tilkobling"

msgid "Connected: {ip}"
msgstr "Tilkoblet: {ip}"

msgid "Connected to {ip}"
msgstr "Koblet til {ip}"

msgid "Disconnected"
msgstr "Frakoblet"

msgid "Connecting…"
msgstr "Kobler til…"

msgid "Connection failed"
msgstr "Tilkoblingen mislyktes"

