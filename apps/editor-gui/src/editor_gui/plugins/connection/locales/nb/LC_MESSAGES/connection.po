msgstr "Serienummer"

msgid "Order Number"
msgstr "Artikkelnummer"

msgid "Hardware Type"
msgstr "Hardvaretype"

msgid "Status"
msgstr "Status"

msgid "No fault"
msgstr "Ingen feil"

msgid "Programming mode active"
msgstr "Programmeringsmodus aktiv"

msgid "No gateways found"
msgstr "Ingen gatewayer funnet"

