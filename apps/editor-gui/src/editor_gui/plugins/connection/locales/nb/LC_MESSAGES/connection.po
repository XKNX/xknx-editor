msgid "Gateway"
msgstr "Gateway"

msgid "Connect"
msgstr "Koble til"

msgid "Disconnect"
msgstr "Koble fra"

msgid "Connect at Startup"
msgstr "Koble til ved oppstart"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Ved oppstart søker editoren etter KNX-grensesnitt og kobler til det som sist ble brukt. Slått av kobler den bare til når du velger det."

msgid "Use Serial Number for Downloads"
msgstr "Bruk serienummer ved nedlasting"

msgid "Discovered Gateways"
msgstr "Funne gatewayer"

msgid "Check for Devices in Programming Mode"
msgstr "Søk etter enheter i programmeringsmodus"

msgid "Devices in Programming Mode"
msgstr "Enheter i programmeringsmodus"

msgid "Rescan"
msgstr "Søk på nytt"

msgid "Searching the bus…"
msgstr "Søker på bussen…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Trykk på programmeringsknappen på en enhet for å sette den i programmeringsmodus, og søk deretter på nytt."

msgid "No device is in programming mode."
msgstr "Ingen enhet er i programmeringsmodus."

msgid "The scan could not be completed: {error}"
msgstr "Søket kunne ikke fullføres: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Grensesnittet bekreftet ikke søkeforespørselen (bussen er opptatt eller grensesnittet er overbelastet). Prøv igjen."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Svarte på søket, men lesing av detaljene mislyktes: {error}"

msgid "In this project: {name}"
msgstr "I dette prosjektet: {name}"

msgid "Not in this project"
msgstr "Ikke i dette prosjektet"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Uprogrammert enhet (fabrikkadresse 15.15.255)"

msgid "Select in Project"
msgstr "Velg i prosjektet"

msgid "Manufacturer"
msgstr "Produsent"

msgid "Product (Catalog)"
msgstr "Produkt (katalog)"

msgid "Application"
msgstr "Applikasjon"

msgid "Application Version"
msgstr "Applikasjonsversjon"

msgid "Mask Version"
msgstr "Maskeversjon"

msgid "Serial Number"
msgstr "Serienummer"

msgid "Order Number"
msgstr "Artikkelnummer"

msgid "Hardware Type"
msgstr "Hardvaretype"

msgid "Status"
msgstr "Status"

msgid "No fault"
msgstr "Ingen feil"

msgid "Programming mode active"
msgstr "Programmeringsmodus aktiv"

msgid "No gateways found"
msgstr "Ingen gatewayer funnet"

msgid "Manual Connection"
msgstr "Manuell tilkobling"

msgid "Connected: {ip}"
msgstr "Tilkoblet: {ip}"

msgid "Connected to {ip}"
msgstr "Koblet til {ip}"

msgid "Disconnected"
msgstr "Frakoblet"

msgid "Connecting…"
msgstr "Kobler til…"

msgid "Connection failed"
msgstr "Tilkoblingen mislyktes"

msgid "Scan"
msgstr "Skann"

msgid "Settings"
msgstr "Innstillinger"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Bruk multicast-ruting (i stedet for tunneling)"

msgid "Gateway IP"
msgstr "Gateway-IP"

msgid "Multicast Group"
msgstr "Multicast-gruppe"

msgid "Apply"
msgstr "Bruk"

msgid "Bus monitor: {ip}"
msgstr "Busmonitor: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Gatewayen er tilkoblet i busmonitormodus. Ingenting kan sendes eller lastes ned før busmonitoren er stoppet."

msgid "Not possible while the bus monitor is running"
msgstr "Ikke mulig mens busmonitoren kjører"

msgid "Stop Bus Monitor"
msgstr "Stopp busmonitor"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Grensesnittet krever KNX IP Secure, men verken prosjektet eller en lastet nøkkelring har passordene."

msgid "Error: {error}"
msgstr "Feil: {error}"

msgid "Unknown error"
msgstr "Ukjent feil"

msgid "Name: {name}"
msgstr "Navn: {name}"

msgid "KNX Address: {address}"
msgstr "KNX-adresse: {address}"

msgid "Core Version: {version}"
msgstr "Core-versjon: {version}"

msgid "Services: {services}"
msgstr "Tjenester: {services}"

msgid "Retry"
msgstr "Prøv på nytt"

msgid "Select Connection"
msgstr "Velg tilkobling"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor kunne ikke fastsette en tilgjengelig tilkobling."

msgid "The connection {name} is not available."
msgstr "Tilkoblingen {name} er ikke tilgjengelig."

msgid "You may use any of the connections listed below, instead."
msgstr "Du kan heller bruke noen av tilkoblingene angitt nedenfor."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Avbryt"

msgid "This kind of connection is not supported."
msgstr "Denne typen tilkobling støttes ikke."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "En enhet med kjent serienummer får sin individuelle adresse uten at programmeringsknappen trykkes."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-grensesnitt"

msgid "No USB interfaces found"
msgstr "Ingen USB-grensesnitt funnet"

msgid "Not connected to the bus"
msgstr "Ikke koblet til bussen"

msgid "Serial Number: {serial}"
msgstr "Serienummer: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} enhet i programmeringsmodus"
msgstr[1] "{count} enheter i programmeringsmodus"

msgid "USB Interface Settings…"
msgstr "Innstillinger for USB-grensesnitt…"

msgid "USB Interface Settings"
msgstr "Innstillinger for USB-grensesnitt"

msgid "Close"
msgstr "Lukk"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maksimal telegramlengde (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "EMI-type: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Støttede EMI-typer: {types}"

msgid "Mask Version: {mask}"
msgstr "Maskeversjon: {mask}"

msgid "Individual Address"
msgstr "Individuell adresse"

msgid "Address Free?"
msgstr "Adresse ledig?"

msgid "The individual address {address} is not used by another device."
msgstr "Den individuelle adressen {address} brukes ikke av en annen enhet."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Den individuelle adressen {address} brukes allerede av en annen enhet på bussen."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} er ikke en individuell adresse (område.linje.enhet)."

msgid "The individual address of the interface is being set or checked."
msgstr "Grensesnittets individuelle adresse blir satt eller kontrollert."

msgid "Not connected through a USB interface."
msgstr "Ikke tilkoblet via et USB-grensesnitt."

msgid "The individual address could not be set: {error}"
msgstr "Den individuelle adressen kunne ikke settes: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Den individuelle adressen kunne ikke kontrolleres: {error}"

msgid "Setting the individual address…"
msgstr "Setter den individuelle adressen…"

msgid "Checking the individual address on the bus…"
msgstr "Kontrollerer den individuelle adressen på bussen…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "En endret adresse settes i grensesnittet (Enter), som beholder den."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "En endret adresse settes i grensesnittet (Enter). Dette grensesnittet glemmer den når det kobles fra, så den settes på nytt ved hver tilkobling."
