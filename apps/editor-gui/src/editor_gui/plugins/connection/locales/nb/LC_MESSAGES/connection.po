msgstr "Tøm"

msgid "Time"
msgstr "Tid"

msgid "Direction"
msgstr "Retning"

msgid "Protocol"
msgstr "Protokoll"

msgid "Service"
msgstr "Tjeneste"

msgid "Data"
msgstr "Data"

