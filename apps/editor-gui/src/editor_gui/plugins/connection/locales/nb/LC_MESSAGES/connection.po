msgid "Gateway"
msgstr "Gateway"

msgid "Connect"
msgstr "Koble til"

msgid "Disconnect"
msgstr "Koble fra"

msgid "Use Serial Number for Downloads"
msgstr "Bruk serienummer ved nedlasting"

msgid "Discovered Gateways"
msgstr "Funne gatewayer"

msgid "Diagnostics"
msgstr "Diagnostikk"

msgid "Check for Devices in Programming Mode"
msgstr "Søk etter enheter i programmeringsmodus"

msgid "Devices in Programming Mode"
msgstr "Enheter i programmeringsmodus"

msgid "Rescan"
msgstr "Søk på nytt"

msgid "Searching the bus…"
msgstr "Søker på bussen…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Trykk på programmeringsknappen på en enhet for å sette den i programmeringsmodus, og søk deretter på nytt."

msgid "No device is in programming mode."
msgstr "Ingen enhet er i programmeringsmodus."

msgid "The scan could not be completed: {error}"
msgstr "Søket kunne ikke fullføres: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Grensesnittet bekreftet ikke søkeforespørselen (bussen er opptatt eller grensesnittet er overbelastet). Prøv igjen."

msgid "{count} device(s) in programming mode"
msgstr "{count} enhet(er) i programmeringsmodus"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Svarte på søket, men lesing av detaljene mislyktes: {error}"

msgid "In this project: {name}"
msgstr "I dette prosjektet: {name}"

msgid "Not in this project"
msgstr "Ikke i dette prosjektet"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Uprogrammert enhet (fabrikkadresse 15.15.255)"

msgid "Select in Project"
msgstr "Velg i prosjektet"

msgid "Manufacturer"
msgstr "Produsent"

msgid "Product (Catalog)"
msgstr "Produkt (katalog)"

