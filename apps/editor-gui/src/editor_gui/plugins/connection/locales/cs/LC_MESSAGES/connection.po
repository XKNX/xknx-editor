msgid "Gateway"
msgstr "Brána"

msgid "Connect"
msgstr "Připojit"

msgid "Disconnect"
msgstr "Odpojit"

msgid "Connect at Startup"
msgstr "Připojit při spuštění"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Při spuštění editor vyhledá rozhraní KNX a připojí se k naposledy použitému. Je-li vypnuto, připojí se jen tehdy, když to zvolíte."

msgid "Use Serial Number for Downloads"
msgstr "Použít sériové číslo pro nahrávání"

msgid "Discovered Gateways"
msgstr "Nalezené brány"

msgid "Check for Devices in Programming Mode"
msgstr "Vyhledat zařízení v programovacím režimu"

msgid "Devices in Programming Mode"
msgstr "Zařízení v programovacím režimu"

msgid "Rescan"
msgstr "Hledat znovu"

msgid "Searching the bus…"
msgstr "Prohledávání sběrnice…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Stiskněte programovací tlačítko na zařízení, abyste ho přepnuli do programovacího režimu, a poté hledejte znovu."

msgid "No device is in programming mode."
msgstr "Žádné zařízení není v programovacím režimu."

msgid "The scan could not be completed: {error}"
msgstr "Vyhledávání nelze dokončit: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Rozhraní nepotvrdilo požadavek na vyhledávání (sběrnice obsazená nebo rozhraní přetížené). Zkuste to prosím znovu."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Na vyhledávání odpovědělo, ale čtení podrobností selhalo: {error}"

msgid "In this project: {name}"
msgstr "V tomto projektu: {name}"

msgid "Not in this project"
msgstr "Není v tomto projektu"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Nenaprogramované zařízení (výchozí adresa z výroby 15.15.255)"

msgid "Select in Project"
msgstr "Vybrat v projektu"

msgid "Manufacturer"
msgstr "Výrobce"

msgid "Product (Catalog)"
msgstr "Produkt (katalog)"

msgid "Application"
msgstr "Aplikace"

msgid "Application Version"
msgstr "Verze aplikace"

msgid "Mask Version"
msgstr "Verze masky"

msgid "Serial Number"
msgstr "Sériové číslo"

msgid "Order Number"
msgstr "Objednací číslo"

msgid "Hardware Type"
msgstr "Typ hardwaru"

msgid "Status"
msgstr "Stav"

msgid "No fault"
msgstr "Bez chyby"

msgid "Programming mode active"
msgstr "Programovací režim aktivní"

msgid "No gateways found"
msgstr "Nenalezeny žádné brány"

msgid "Manual Connection"
msgstr "Ruční připojení"

msgid "Connected: {ip}"
msgstr "Připojeno: {ip}"

msgid "Connected to {ip}"
msgstr "Připojeno k {ip}"

msgid "Disconnected"
msgstr "Odpojeno"

msgid "Connecting…"
msgstr "Připojování…"

msgid "Connection failed"
msgstr "Připojení selhalo"

msgid "Scan"
msgstr "Hledat"

msgid "Settings"
msgstr "Nastavení"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Použít multicastové směrování (místo tunelování)"

msgid "Gateway IP"
msgstr "IP brány"

msgid "Multicast Group"
msgstr "Skupina multicast"

msgid "Apply"
msgstr "Použít"

msgid "Bus monitor: {ip}"
msgstr "Sběrnicový monitor: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Brána je připojena v režimu sběrnicového monitoru. Dokud nebude sběrnicový monitor zastaven, nelze nic odesílat ani nahrávat."

msgid "Not possible while the bus monitor is running"
msgstr "Není možné, dokud běží sběrnicový monitor"

msgid "Stop Bus Monitor"
msgstr "Zastavit sběrnicový monitor"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Rozhraní vyžaduje KNX IP Secure, ale jeho hesla neobsahuje projekt ani načtený svazek klíčů."

msgid "Error: {error}"
msgstr "Chyba: {error}"

msgid "Unknown error"
msgstr "Neznámá chyba"

msgid "Name: {name}"
msgstr "Název: {name}"

msgid "KNX Address: {address}"
msgstr "Adresa KNX: {address}"

msgid "Core Version: {version}"
msgstr "Verze jádra: {version}"

msgid "Services: {services}"
msgstr "Služby: {services}"

msgid "Retry"
msgstr "Zkusit znovu"

msgid "Select Connection"
msgstr "Vybrat připojení"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor se nepodařilo určit dostupné připojení."

msgid "The connection {name} is not available."
msgstr "Připojení {name} není dostupné."

msgid "You may use any of the connections listed below, instead."
msgstr "Namísto toho můžete použít kterékoli z níže uvedených připojení."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Zrušit"

msgid "This kind of connection is not supported."
msgstr "Tento druh připojení není podporován."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Zařízení se známým sériovým číslem dostane individuální adresu bez stisknutí programovacího tlačítka."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Rozhraní USB"

msgid "No USB interfaces found"
msgstr "Nenalezena žádná rozhraní USB"

msgid "Not connected to the bus"
msgstr "Nepřipojeno ke sběrnici"

msgid "Serial Number: {serial}"
msgstr "Sériové číslo: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} zařízení v programovacím režimu"
msgstr[1] "{count} zařízení v programovacím režimu"
msgstr[2] "{count} zařízení v programovacím režimu"

msgid "USB Interface Settings…"
msgstr "Nastavení USB Rozhraní…"

msgid "USB Interface Settings"
msgstr "Nastavení USB Rozhraní"

msgid "Close"
msgstr "Zavřít"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maximální Délka Telegramu (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Typ EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Podporované typy EMI: {types}"

msgid "Mask Version: {mask}"
msgstr "Verze masky: {mask}"

msgid "Individual Address"
msgstr "Individuální adresa"

msgid "Address Free?"
msgstr "Adresa Volná?"

msgid "The individual address {address} is not used by another device."
msgstr "Individuální adresu {address} nepoužívá žádné jiné zařízení."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Individuální adresu {address} již používá jiné zařízení na sběrnici."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} není individuální adresa (oblast.linie.zařízení)."

msgid "The individual address of the interface is being set or checked."
msgstr "Individuální adresa rozhraní se právě nastavuje nebo kontroluje."

msgid "Not connected through a USB interface."
msgstr "Není připojeno přes rozhraní USB."

msgid "The individual address could not be set: {error}"
msgstr "Individuální adresu se nepodařilo nastavit: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Individuální adresu se nepodařilo zkontrolovat: {error}"

msgid "Setting the individual address…"
msgstr "Nastavuje se individuální adresa…"

msgid "Checking the individual address on the bus…"
msgstr "Kontroluje se individuální adresa na sběrnici…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Změněná adresa se nastaví v rozhraní (Enter), které si ji ponechá."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Změněná adresa se nastaví v rozhraní (Enter). Toto rozhraní ji po odpojení zapomene, proto se nastaví znovu při každém připojení."
