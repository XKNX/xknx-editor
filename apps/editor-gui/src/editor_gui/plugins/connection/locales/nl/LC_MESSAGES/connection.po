msgstr "Geen apparaat in programmeermodus."

msgid "No fault"
msgstr "Geen fout"

msgid "No gateways found"
msgstr "Geen gateways gevonden"

msgid "Not in this project"
msgstr "Niet in dit project"

msgid "Order Number"
msgstr "Bestelnummer"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Druk op de programmeerknop van een apparaat om het in programmeermodus te zetten en zoek daarna opnieuw."

msgid "Product (Catalog)"
msgstr "Product (catalogus)"

msgid "Programming mode active"
msgstr "Programmeermodus actief"

msgid "Rescan"
msgstr "Opnieuw zoeken"

msgid "Scan"
msgstr "Zoeken"

msgid "Searching the bus…"
msgstr "Bus wordt doorzocht…"

msgid "Select in Project"
msgstr "In project selecteren"

msgid "Serial Number"
msgstr "Serienummer"

msgid "Settings"
msgstr "Instellingen"

msgid "Status"
msgstr "Status"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "De interface heeft de zoekopdracht niet bevestigd (bus bezet of interface overbelast). Probeer het opnieuw."

msgid "The scan could not be completed: {error}"
msgstr "De zoekopdracht kon niet worden voltooid: {error}"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Niet-geprogrammeerd apparaat (fabrieksadres 15.15.255)"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Multicast-routing gebruiken (in plaats van tunneling)"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "De interface vereist KNX IP Secure, maar noch het project noch een geladen keyring bevat de wachtwoorden."

msgid "Error: {error}"
msgstr "Fout: {error}"

msgid "Unknown error"
msgstr "Onbekende fout"

msgid "Name: {name}"
msgstr "Naam: {name}"

msgid "KNX Address: {address}"
msgstr "KNX-adres: {address}"

msgid "Core Version: {version}"
msgstr "Core-versie: {version}"

msgid "Services: {services}"
msgstr "Diensten: {services}"

msgid "Retry"
msgstr "Opnieuw proberen"

msgid "Select Connection"
msgstr "Selecteer verbinding"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor kon geen beschikbare verbinding bepalen."

msgid "The connection {name} is not available."
msgstr "De verbinding {name} is niet beschikbaar."

msgid "You may use any of the connections listed below, instead."
msgstr "U kunt in plaats daarvan een van de onderstaande verbindingen gebruiken."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Annuleren"

msgid "This kind of connection is not supported."
msgstr "Dit soort verbinding wordt niet ondersteund."

msgid "UDP tunneling"
msgstr "UDP-tunneling"

msgid "TCP tunneling"
msgstr "TCP-tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Een apparaat met bekend serienummer krijgt zijn individueel adres zonder dat de programmeerknop wordt ingedrukt."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-interfaces"

msgid "No USB interfaces found"
msgstr "Geen USB-interfaces gevonden"

msgid "Not connected to the bus"
msgstr "Niet met de bus verbonden"

msgid "Serial Number: {serial}"
msgstr "Serienummer: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} apparaat in programmeermodus"
msgstr[1] "{count} apparaten in programmeermodus"

msgid "USB Interface…"
msgstr "USB-interface…"

msgid "USB Interface"
msgstr "USB-interface"

msgid "Close"
msgstr "Sluiten"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maximale telegramlengte (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "EMI-type: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Ondersteunde EMI-types: {types}"

msgid "Mask Version: {mask}"
msgstr "Maskerversie: {mask}"

msgid "Individual Address"
msgstr "Individueel Adres"

msgid "Address Free?"
msgstr "Adres vrij?"

msgid "The individual address {address} is not used by another device."
msgstr "Het individuele adres {address} wordt niet door een ander apparaat gebruikt."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Het individuele adres {address} wordt al door een ander apparaat op de bus gebruikt."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} is geen individueel adres (bereik.lijn.apparaat)."

msgid "The individual address of the interface is being set or checked."
msgstr "Het individuele adres van de interface wordt ingesteld of gecontroleerd."

msgid "Not connected through a USB interface."
msgstr "Niet verbonden via een USB-interface."

msgid "The individual address could not be set: {error}"
msgstr "Het individuele adres kon niet worden ingesteld: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Het individuele adres kon niet worden gecontroleerd: {error}"

msgid "Setting the individual address…"
msgstr "Individueel adres wordt ingesteld…"

msgid "Checking the individual address on the bus…"
msgstr "Individueel adres wordt op de bus gecontroleerd…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Een gewijzigd adres wordt in de interface ingesteld (Enter), die het onthoudt."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Een gewijzigd adres wordt in de interface ingesteld (Enter). Deze interface vergeet het bij het loskoppelen, daarom wordt het bij elke verbinding opnieuw ingesteld."
