# Dutch translations for connection plugin
msgid ""
msgstr ""
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Connection"
msgstr "Verbinding"

msgid "Connect"
msgstr "Verbinden"

msgid "Disconnect"
msgstr "Verbreken"

msgid "Connected: {ip}"
msgstr "Verbonden: {ip}"

msgid "Connected to {ip}"
msgstr "Verbonden met {ip}"

msgid "Disconnected"
msgstr "Niet verbonden"

msgid "Connect at Startup"
msgstr "Verbinden bij opstarten"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Bij het starten zoekt de editor naar KNX-interfaces en verbindt met de laatst gebruikte. Uitgeschakeld verbindt hij alleen wanneer u dat kiest."

msgid "Use Serial Number for Downloads"
msgstr "Serienummer gebruiken voor downloads"

msgid "Bus monitor: {ip}"
msgstr "Busmonitor: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "De interface is in busmonitormodus verbonden. Totdat de busmonitor is gestopt, kan niets worden verzonden of geprogrammeerd."

msgid "Stop Bus Monitor"
msgstr "Busmonitor stoppen"

msgid "Not possible while the bus monitor is running"
msgstr "Niet mogelijk zolang de busmonitor loopt"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Heeft op de zoekopdracht geantwoord, maar het lezen van de details is mislukt: {error}"

msgid "Application"
msgstr "Applicatie"

msgid "Application Version"
msgstr "Applicatieversie"

msgid "Apply"
msgstr "Toepassen"

msgid "Check for Devices in Programming Mode"
msgstr "Apparaten in programmeermodus zoeken"

msgid "Connecting…"
msgstr "Verbinden…"

msgid "Connection failed"
msgstr "Verbinding mislukt"

msgid "Devices in Programming Mode"
msgstr "Apparaten in programmeermodus"

msgid "Discovered Gateways"
msgstr "Gevonden gateways"

