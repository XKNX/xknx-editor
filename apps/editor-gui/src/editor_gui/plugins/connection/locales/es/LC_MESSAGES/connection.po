msgstr "Conectado: {ip}"

msgid "Connected to {ip}"
msgstr "Conectado a {ip}"

msgid "Disconnected"
msgstr "Desconectado"

msgid "Connecting…"
msgstr "Conectando…"

msgid "Connection failed"
msgstr "Error de conexión"

msgid "Scan"
msgstr "Buscar"

msgid "Settings"
msgstr "Configuración"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Usar enrutamiento multicast (en lugar de tunnelling)"

msgid "Gateway IP"
msgstr "IP de la Pasarela"

msgid "An open connection to the gateway connects to the new address once it is entered."
msgstr "Una conexión abierta con la pasarela se conecta a la nueva dirección en cuanto se introduce."

msgid "Use the Project's Bus Connection"
msgstr "Usar la Conexión Bus del Proyecto"

msgid "While a project is open whose backbone line has a Bus Connection (Topology), the connection goes through it instead of the gateway set here."
msgstr "Mientras esté abierto un proyecto cuya línea troncal tenga una Conexión Bus (Topología), la conexión pasa por ella en lugar de por la pasarela configurada aquí."

msgid "Multicast Group"
msgstr "Grupo Multicast"

msgid "Apply"
msgstr "Aplicar"

msgid "Bus monitor: {ip}"
msgstr "Monitor del bus: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "La pasarela está conectada en modo monitor del bus. No se puede enviar ni programar nada hasta que se detenga el monitor del bus."

msgid "Not possible while the bus monitor is running"
msgstr "No es posible mientras el monitor del bus está en marcha"

msgid "Stop Bus Monitor"
msgstr "Detener Monitor del Bus"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "La interfaz requiere KNX IP Secure, pero ni el proyecto ni un keyring cargado contienen sus contraseñas."

msgid "Error: {error}"
msgstr "Error: {error}"

msgid "Unknown error"
msgstr "Error desconocido"

msgid "Name: {name}"
msgstr "Nombre: {name}"

msgid "KNX Address: {address}"
msgstr "Dirección KNX: {address}"

msgid "Core Version: {version}"
msgstr "Versión del núcleo: {version}"

msgid "Services: {services}"
msgstr "Servicios: {services}"

msgid "Retry"
msgstr "Reintentar"

msgid "Select Connection"
msgstr "Seleccione Conexión"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor no pudo determinar una conexión disponible."

msgid "The connection {name} is not available."
msgstr "La conexión {name} no está disponible."

msgid "You may use any of the connections listed below, instead."
msgstr "En su lugar, puedes usar cualquiera de las conexiones listadas a continuación."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Cancelar"

msgid "This kind of connection is not supported."
msgstr "Este tipo de conexión no es compatible."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Un dispositivo cuyo número de serie se conoce recibe su dirección individual sin pulsar su botón de programación."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfaces USB"

msgid "No USB interfaces found"
msgstr "No se encontraron interfaces USB"

msgid "Not connected to the bus"
msgstr "No conectada al bus"

msgid "Serial Number: {serial}"
msgstr "Número de Serie: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} dispositivo en modo programación"
msgstr[1] "{count} dispositivos en modo programación"

msgid "USB Interface…"
msgstr "Interfaz USB…"

msgid "USB Interface"
msgstr "Interfaz USB"

msgid "Close"
msgstr "Cerrar"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Longitud Máxima de Telegrama (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Tipo de EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Tipos de EMI admitidos: {types}"

msgid "Mask Version: {mask}"
msgstr "Versión de máscara: {mask}"

msgid "Individual Address"
msgstr "Dirección Individual"

msgid "Address Free?"
msgstr "¿Dirección Libre?"

msgid "The individual address {address} is not used by another device."
msgstr "La dirección individual {address} no la usa ningún otro dispositivo."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "La dirección individual {address} ya la usa otro dispositivo del bus."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} no es una dirección individual (área.línea.dispositivo)."

msgid "The individual address of the interface is being set or checked."
msgstr "La dirección individual de la interfaz se está estableciendo o comprobando."

msgid "Not connected through a USB interface."
msgstr "No conectado a través de una interfaz USB."

msgid "The individual address could not be set: {error}"
msgstr "No se pudo establecer la dirección individual: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "No se pudo comprobar la dirección individual: {error}"

msgid "Setting the individual address…"
msgstr "Estableciendo la dirección individual…"

msgid "Checking the individual address on the bus…"
msgstr "Comprobando la dirección individual en el bus…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Esta interfaz olvida su dirección individual al desconectarla, por lo que se vuelve a establecer en cada conexión."

msgid "Protected Group Addresses"
msgstr "Direcciones de Grupo Protegidas"

msgid "Nothing is ever sent to these group addresses, not even reads, e.g. the ones of gates or an alarm system: addresses like 1/2/3, or groups ending with a slash like 7/0/, separated by spaces. MCP clients can add to the list but not take anything out."
msgstr "Nunca se envía nada a estas direcciones de grupo, ni siquiera lecturas, p. ej. las de portones o un sistema de alarma: direcciones como 1/2/3 o grupos que terminan en barra como 7/0/, separados por espacios. Los clientes MCP pueden añadir a la lista pero no quitar nada."

msgid "Not a group address or group: {entries}"
msgstr "No es una dirección de grupo ni un grupo: {entries}"

msgid "Confirmation Timeout (Seconds)"
msgstr "Tiempo de espera de confirmación (segundos)"

msgid "How long to wait for the interface to confirm each frame it sends. A slow connection, such as a remote tunnel or a VPN, needs longer."
msgstr "Cuánto se espera a que la interfaz confirme cada trama que envía. Una conexión lenta, como un túnel remoto o una VPN, necesita más tiempo."

msgid "Acknowledgement Timeout (Seconds)"
msgstr "Tiempo de espera de acuse (segundos)"

msgid "How long to wait for a device to acknowledge a frame of a download before sending it again (up to three times). A device closes the connection after 6 seconds without a frame, so a longer wait only helps where the answers are late, not lost."
msgstr "Cuánto se espera a que un dispositivo acuse recibo de una trama de una programación antes de enviarla de nuevo (hasta tres veces). Un dispositivo cierra la conexión tras 6 segundos sin trama, así que esperar más solo ayuda si las respuestas llegan tarde, no si se pierden."

msgid "Response Timeout (Seconds)"
msgstr "Tiempo de espera de respuesta (segundos)"

msgid "How long to wait for a device's answer, e.g. to a memory or property read."
msgstr "Cuánto se espera la respuesta de un dispositivo, p. ej. a una lectura de memoria o de una propiedad."

msgid "Medium: {medium}"
msgstr "Medio: {medium}"

msgid "Domain Address"
msgstr "Dirección de Dominio"

msgid "From Line"
msgstr "Desde Línea"

msgid "The interface sends with this domain address and receives only the telegrams of devices with it."
msgstr "La interfaz envía con esta dirección de dominio y solo recibe los telegramas de los dispositivos que la tienen."

msgid "{address} is not an RF domain address (4 and 8 hexadecimal digits, e.g. 0001:23456789)."
msgstr "{address} no es una dirección de dominio RF (4 y 8 dígitos hexadecimales, p. ej. 0001:23456789)."

msgid "The domain address of the interface is being set."
msgstr "Se está estableciendo la dirección de dominio de la interfaz."

msgid "The connected USB interface is not a KNX RF interface."
msgstr "La interfaz USB conectada no es una interfaz KNX RF."

msgid "The domain address could not be set: {error}"
msgstr "No se pudo establecer la dirección de dominio: {error}"

msgid "Setting the domain address…"
msgstr "Estableciendo la dirección de dominio…"

msgid "Local Device Access"
msgstr "Acceso al Dispositivo Local"

msgid "Connects to the KNX device the USB interface is part of (e.g. an actuator with a USB port of its own) instead of the bus. Only this device can then be reached, for downloads and readouts; group telegrams, broadcasts and the bus monitor are not available. Needs a cEMI interface."
msgstr "Se conecta al dispositivo KNX del que forma parte la interfaz USB (p. ej. un actuador con su propio puerto USB) en lugar de al bus. Entonces solo se puede acceder a este dispositivo, para descargas y lecturas; los telegramas de grupo, los broadcasts y el monitor del bus no están disponibles. Requiere una interfaz cEMI."

msgid "Connect to the interface's own device (local device access)"
msgstr "Conectar al propio dispositivo de la interfaz (acceso al dispositivo local)"

msgid "{target}, local device access to {address}"
msgstr "{target}, acceso al dispositivo local {address}"

msgid "(address unknown)"
msgstr "(dirección desconocida)"

msgid "Local device access: only this device is reached"
msgstr "Acceso al dispositivo local: solo se accede a este dispositivo"

msgid "Switching the connection…"
msgstr "Cambiando la conexión…"

msgid "The connection could not be switched: {error}"
msgstr "No se pudo cambiar la conexión: {error}"

msgid "The connection of the interface is being switched."
msgstr "Se está cambiando la conexión de la interfaz."

msgid "Through local device access only the USB interface's own device {local} can be reached, not {address}."
msgstr "Mediante el acceso al dispositivo local solo se puede acceder al propio dispositivo {local} de la interfaz USB, no a {address}."

msgid "Through local device access only the USB interface's own device {local} can be reached: group telegrams can't be sent."
msgstr "Mediante el acceso al dispositivo local solo se puede acceder al propio dispositivo {local} de la interfaz USB: no se pueden enviar telegramas de grupo."

msgid "Through local device access only the USB interface's own device {local} can be reached: broadcasts can't be sent."
msgstr "Mediante el acceso al dispositivo local solo se puede acceder al propio dispositivo {local} de la interfaz USB: no se pueden enviar broadcasts."

msgid "Through local device access only the USB interface's own device {local} can be reached: the bus monitor can't run."
msgstr "Mediante el acceso al dispositivo local solo se puede acceder al propio dispositivo {local} de la interfaz USB: el monitor del bus no puede funcionar."

msgid "Through local device access only the USB interface's own device {local} can be reached: scan from {local} to {local}."
msgstr "Mediante el acceso al dispositivo local solo se puede acceder al propio dispositivo {local} de la interfaz USB: escanee de {local} a {local}."

msgid "Protocol"
msgstr "Protocolo"

msgid "KNXnet/IP Server"
msgstr "Servidor KNXnet/IP"

msgid "Run a KNXnet/IP server for other tools (USB to IP bridge)"
msgstr "Ejecutar un servidor KNXnet/IP para otras herramientas (puente de USB a IP)"

msgid "Other tools (another editor, Home Assistant, a commissioning tool) connect to it over the network and use this USB interface as a KNXnet/IP interface. Each tunnel gets one of the tunnel addresses, which have to be free addresses of the interface's line. It runs while the editor is connected to the bus through the interface, and opens a network port: turn it on only where that is wanted."
msgstr "Otras herramientas (otro editor, Home Assistant, una herramienta de puesta en marcha) se conectan a él por la red y usan esta interfaz USB como interfaz KNXnet/IP. Cada túnel recibe una de las direcciones de túnel, que tienen que ser direcciones libres de la línea de la interfaz. Funciona mientras el editor está conectado al bus a través de la interfaz y abre un puerto de red: actívelo solo donde se desee."

msgid "Port"
msgstr "Puerto"

msgid "Listen On"
msgstr "Escuchar en"

msgid "All network interfaces"
msgstr "Todas las interfaces de red"

msgid "This computer only"
msgstr "Solo este equipo"

msgid "Answer searches (discovery)"
msgstr "Responder a búsquedas (discovery)"

msgid "Offer TCP"
msgstr "Ofrecer TCP"

msgid "Tunnel Addresses"
msgstr "Direcciones de Túnel"

msgid "Suggest"
msgstr "Sugerir"

msgid "Name"
msgstr "Nombre"

msgid "KNXnet/IP server on port {port}, {count} tunnel"
msgid_plural "KNXnet/IP server on port {port}, {count} tunnels"
msgstr[0] "Servidor KNXnet/IP en el puerto {port}, {count} túnel"
msgstr[1] "Servidor KNXnet/IP en el puerto {port}, {count} túneles"

msgid "The KNXnet/IP server is not running."
msgstr "El servidor KNXnet/IP no está en ejecución."

msgid "No tunnels open"
msgstr "No hay túneles abiertos"

msgid "Channel"
msgstr "Canal"

msgid "Client"
msgstr "Cliente"

msgid "Address"
msgstr "Dirección"

msgid "At least one tunnel address is needed."
msgstr "Se necesita al menos una dirección de túnel."

msgid "The tunnel address {address} is given twice."
msgstr "La dirección de túnel {address} se ha indicado dos veces."

msgid "{address} is the individual address of the interface itself."
msgstr "{address} es la dirección individual de la propia interfaz."

msgid "{address} is not on the line of the interface ({line})."
msgstr "{address} no está en la línea de la interfaz ({line})."

msgid "{address} is the individual address of the device {name}."
msgstr "{address} es la dirección individual del dispositivo {name}."

msgid "{port} is not a port (1 to 65535)."
msgstr "{port} no es un puerto (1 a 65535)."

msgid "The KNXnet/IP server runs only while the editor is connected through a KNX USB interface."
msgstr "El servidor KNXnet/IP solo funciona mientras el editor está conectado a través de una interfaz KNX USB."

msgid "The KNXnet/IP server doesn't run with local device access: the connection reaches only the interface's own device."
msgstr "El servidor KNXnet/IP no funciona con el acceso al dispositivo local: la conexión solo llega al propio dispositivo de la interfaz."

msgid "The KNXnet/IP server is being started or stopped."
msgstr "El servidor KNXnet/IP se está iniciando o deteniendo."

msgid "The KNXnet/IP server could not start: {error}"
msgstr "No se pudo iniciar el servidor KNXnet/IP: {error}"
