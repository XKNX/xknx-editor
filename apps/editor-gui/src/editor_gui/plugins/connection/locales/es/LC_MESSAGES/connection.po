msgid "Gateway"
msgstr "Pasarela"

msgid "Connect"
msgstr "Conectar"

msgid "Disconnect"
msgstr "Desconectar"

msgid "Connect at Startup"
msgstr "Conectar al Iniciar"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Al iniciar, el editor busca interfaces KNX y se conecta a la última utilizada. Si se desactiva, solo se conecta cuando usted lo elija."

msgid "Use Serial Number for Downloads"
msgstr "Usar Número de Serie para Programar"

msgid "Discovered Gateways"
msgstr "Pasarelas Detectadas"

msgid "Check for Devices in Programming Mode"
msgstr "Buscar Dispositivos en Modo Programación"

msgid "Devices in Programming Mode"
msgstr "Dispositivos en Modo Programación"

msgid "Rescan"
msgstr "Volver a Buscar"

msgid "Searching the bus…"
msgstr "Buscando en el bus…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Pulse el botón de programación de un dispositivo para ponerlo en modo programación y vuelva a buscar."

msgid "No device is in programming mode."
msgstr "Ningún dispositivo está en modo programación."

msgid "The scan could not be completed: {error}"
msgstr "No se pudo completar la búsqueda: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "La interfaz no confirmó la solicitud de búsqueda (bus ocupado o interfaz sobrecargada). Inténtelo de nuevo."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Ha respondido a la búsqueda, pero no se pudieron leer sus detalles: {error}"

msgid "In this project: {name}"
msgstr "En este proyecto: {name}"

msgid "Not in this project"
msgstr "No está en este proyecto"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Dispositivo sin programar (dirección de fábrica 15.15.255)"

msgid "Select in Project"
msgstr "Seleccionar en el Proyecto"

msgid "Manufacturer"
msgstr "Fabricante"

msgid "Product (Catalog)"
msgstr "Producto (Catálogo)"

msgid "Application"
msgstr "Aplicación"

msgid "Application Version"
msgstr "Versión de la Aplicación"

msgid "Mask Version"
msgstr "Versión de Máscara"

msgid "Serial Number"
msgstr "Número de Serie"

msgid "Order Number"
msgstr "Número de Pedido"

msgid "Hardware Type"
msgstr "Tipo de Hardware"

msgid "Status"
msgstr "Estado"

msgid "No fault"
msgstr "Sin errores"

msgid "Programming mode active"
msgstr "Modo programación activo"

msgid "No gateways found"
msgstr "No se encontraron pasarelas"

msgid "Manual Connection"
msgstr "Conexión Manual"

msgid "Connected: {ip}"
msgstr "Conectado: {ip}"

msgid "Connected to {ip}"
msgstr "Conectado a {ip}"

msgid "Disconnected"
msgstr "Desconectado"

msgid "Connecting…"
msgstr "Conectando…"

msgid "Connection failed"
msgstr "Error de conexión"

msgid "Scan"
msgstr "Buscar"

msgid "Settings"
msgstr "Configuración"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Usar enrutamiento multicast (en lugar de tunnelling)"

msgid "Gateway IP"
msgstr "IP de la Pasarela"

msgid "Multicast Group"
msgstr "Grupo Multicast"

msgid "Apply"
msgstr "Aplicar"

msgid "Bus monitor: {ip}"
msgstr "Monitor del bus: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "La pasarela está conectada en modo monitor del bus. No se puede enviar ni programar nada hasta que se detenga el monitor del bus."

msgid "Not possible while the bus monitor is running"
msgstr "No es posible mientras el monitor del bus está en marcha"

msgid "Stop Bus Monitor"
msgstr "Detener Monitor del Bus"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "La interfaz requiere KNX IP Secure, pero ni el proyecto ni un keyring cargado contienen sus contraseñas."

msgid "Error: {error}"
msgstr "Error: {error}"

msgid "Unknown error"
msgstr "Error desconocido"

msgid "Name: {name}"
msgstr "Nombre: {name}"

msgid "KNX Address: {address}"
msgstr "Dirección KNX: {address}"

msgid "Core Version: {version}"
msgstr "Versión del núcleo: {version}"

msgid "Services: {services}"
msgstr "Servicios: {services}"

msgid "Retry"
msgstr "Reintentar"

msgid "Select Connection"
msgstr "Seleccione Conexión"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor no pudo determinar una conexión disponible."

msgid "The connection {name} is not available."
msgstr "La conexión {name} no está disponible."

msgid "You may use any of the connections listed below, instead."
msgstr "En su lugar, puedes usar cualquiera de las conexiones listadas a continuación."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Cancelar"

msgid "This kind of connection is not supported."
msgstr "Este tipo de conexión no es compatible."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Un dispositivo cuyo número de serie se conoce recibe su dirección individual sin pulsar su botón de programación."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfaces USB"

msgid "No USB interfaces found"
msgstr "No se encontraron interfaces USB"

msgid "Not connected to the bus"
msgstr "No conectada al bus"

msgid "Serial Number: {serial}"
msgstr "Número de Serie: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} dispositivo en modo programación"
msgstr[1] "{count} dispositivos en modo programación"

msgid "USB Interface…"
msgstr "Interfaz USB…"

msgid "USB Interface"
msgstr "Interfaz USB"

msgid "Close"
msgstr "Cerrar"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Longitud Máxima de Telegrama (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Tipo de EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Tipos de EMI admitidos: {types}"

msgid "Mask Version: {mask}"
msgstr "Versión de máscara: {mask}"

msgid "Individual Address"
msgstr "Dirección Individual"

msgid "Address Free?"
msgstr "¿Dirección Libre?"

msgid "The individual address {address} is not used by another device."
msgstr "La dirección individual {address} no la usa ningún otro dispositivo."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "La dirección individual {address} ya la usa otro dispositivo del bus."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} no es una dirección individual (área.línea.dispositivo)."

msgid "The individual address of the interface is being set or checked."
msgstr "La dirección individual de la interfaz se está estableciendo o comprobando."

msgid "Not connected through a USB interface."
msgstr "No conectado a través de una interfaz USB."

msgid "The individual address could not be set: {error}"
msgstr "No se pudo establecer la dirección individual: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "No se pudo comprobar la dirección individual: {error}"

msgid "Setting the individual address…"
msgstr "Estableciendo la dirección individual…"

msgid "Checking the individual address on the bus…"
msgstr "Comprobando la dirección individual en el bus…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Esta interfaz olvida su dirección individual al desconectarla, por lo que se vuelve a establecer en cada conexión."