msgid "The KNXnet/IP server runs only while the editor is connected through a KNX USB interface."
msgstr "Serveri KNXnet/IP funksionon vetëm ndërsa redaktori është i lidhur përmes një ndërfaqeje KNX USB."

msgid "The KNXnet/IP server doesn't run with local device access: the connection reaches only the interface's own device."
msgstr "Serveri KNXnet/IP nuk funksionon me qasje në pajisjen lokale: lidhja arrin vetëm pajisjen e vetë ndërfaqes."

msgid "The KNXnet/IP server is being started or stopped."
msgstr "Serveri KNXnet/IP po niset ose po ndalet."

msgid "The KNXnet/IP server could not start: {error}"
msgstr "Serveri KNXnet/IP nuk mund të nisej: {error}"

msgid "Enter the data to send (e.g. 44 AE 0C)."
msgstr "Shkruani të dhënat për t'u dërguar (p.sh. 44 AE 0C)."
