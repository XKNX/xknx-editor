msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} pajisje në modalitetin e programimit"
msgstr[1] "{count} pajisje në modalitetin e programimit"

msgid "USB Interface…"
msgstr "Ndërfaqja USB…"

msgid "USB Interface"
msgstr "Ndërfaqja USB"

msgid "Close"
msgstr "Mbyll"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Gjatësia maksimale e telegramit (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Lloji EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Llojet EMI të mbështetura: {types}"

msgid "Mask Version: {mask}"
msgstr "Versioni i maskës: {mask}"

msgid "Individual Address"
msgstr "Adresa individuale"

msgid "Address Free?"
msgstr "A është e lirë?"

msgid "The individual address {address} is not used by another device."
msgstr "Adresa individuale {address} nuk përdoret nga asnjë pajisje tjetër."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Adresa individuale {address} përdoret tashmë nga një pajisje tjetër në bus."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} nuk është adresë individuale (zona.linja.pajisja)."

msgid "The individual address of the interface is being set or checked."
msgstr "Adresa individuale e ndërfaqes po vendoset ose po kontrollohet."

msgid "Not connected through a USB interface."
msgstr "Nuk ka lidhje përmes një ndërfaqeje USB."

msgid "The individual address could not be set: {error}"
msgstr "Vendosja e adresës individuale dështoi: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Kontrolli i adresës individuale dështoi: {error}"

msgid "Setting the individual address…"
msgstr "Po vendoset adresa individuale…"

msgid "Checking the individual address on the bus…"
msgstr "Po kontrollohet adresa individuale në bus…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Kjo ndërfaqe nuk e ruan adresën e saj individuale pas shkëputjes, prandaj adresa vendoset sërish në çdo lidhje."

msgid "Protected Group Addresses"
msgstr "Adresa grupi të mbrojtura"

msgid "Nothing is ever sent to these group addresses, not even reads, e.g. the ones of gates or an alarm system: addresses like 1/2/3, or groups ending with a slash like 7/0/, separated by spaces. MCP clients can add to the list but not take anything out."
msgstr "Asgjë nuk dërgohet kurrë në këto adresa grupi, madje as kërkesa leximi. Këtu mund të vendosen, për shembull, adresat e portave ose të një sistemi alarmi: adresa si 1/2/3 ose grupe që mbarojnë me vijë të pjerrët, si 7/0/. Ndajini me hapësira. Klientët MCP mund të shtojnë adresa në listë, por nuk mund të heqin asnjë."

msgid "Not a group address or group: {entries}"
msgstr "Këto hyrje nuk janë as adresa grupi, as grupe: {entries}"

msgid "Confirmation Timeout (Seconds)"
msgstr "Afati i konfirmimit (sekonda)"

msgid "How long to wait for the interface to confirm each frame it sends. A slow connection, such as a remote tunnel or a VPN, needs longer."
msgstr "Sa gjatë pritet që ndërfaqja të konfirmojë çdo kornizë që dërgon. Një lidhje e ngadaltë, si një tunel në distancë ose një VPN, ka nevojë për më shumë kohë."

msgid "Acknowledgement Timeout (Seconds)"
msgstr "Afati i pranimit (sekonda)"

msgid "How long to wait for a device to acknowledge a frame of a download before sending it again (up to three times). A device closes the connection after 6 seconds without a frame, so a longer wait only helps where the answers are late, not lost."
msgstr "Sa gjatë pritet që një pajisje të pranojë një kornizë të programimit para se të dërgohet përsëri (deri në tri herë). Një pajisje e mbyll lidhjen pas 6 sekondash pa kornizë, prandaj një pritje më e gjatë ndihmon vetëm kur përgjigjet vijnë vonë, jo kur humbasin."

msgid "Response Timeout (Seconds)"
msgstr "Afati i përgjigjes (sekonda)"

msgid "How long to wait for a device's answer, e.g. to a memory or property read."
msgstr "Sa gjatë pritet përgjigjja e një pajisjeje, p.sh. për një lexim të memories ose të një vetie."

msgid "Medium: {medium}"
msgstr "Mediumi: {medium}"

msgid "Domain Address"
msgstr "Adresa e domenit"

msgid "From Line"
msgstr "Nga Linja"

msgid "The interface sends with this domain address and receives only the telegrams of devices with it."
msgstr "Ndërfaqja dërgon me këtë adresë domeni dhe merr vetëm telegramet e pajisjeve që e kanë atë."

msgid "{address} is not an RF domain address (4 and 8 hexadecimal digits, e.g. 0001:23456789)."
msgstr "{address} nuk është adresë domeni RF (4 dhe 8 shifra heksadecimale, p.sh. 0001:23456789)."

msgid "The domain address of the interface is being set."
msgstr "Adresa e domenit të ndërfaqes po vendoset."

msgid "The connected USB interface is not a KNX RF interface."
msgstr "Ndërfaqja USB e lidhur nuk është ndërfaqe KNX RF."

msgid "The domain address could not be set: {error}"
msgstr "Adresa e domenit nuk mund të vendosej: {error}"

msgid "Setting the domain address…"
msgstr "Po vendoset adresa e domenit…"
