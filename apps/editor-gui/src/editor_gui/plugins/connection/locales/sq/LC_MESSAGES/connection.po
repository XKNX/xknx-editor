msgid "Gateway"
msgstr "Gateway"

msgid "Connect"
msgstr "Lidhu"

msgid "Disconnect"
msgstr "Shkëputu"

msgid "Connect at Startup"
msgstr "Lidhu në nisje"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Në nisje, editori kërkon ndërfaqe KNX dhe lidhet me atë që është përdorur së fundi. Kur ky opsion është i çaktivizuar, editori lidhet vetëm kur zgjidhni një ndërfaqe."

msgid "Use Serial Number for Downloads"
msgstr "Përdor numrin serial për programim"

msgid "Discovered Gateways"
msgstr "Gateway të gjetur"

msgid "Check for Devices in Programming Mode"
msgstr "Kërko pajisje në modalitetin e programimit"

msgid "Devices in Programming Mode"
msgstr "Pajisje në modalitetin e programimit"

msgid "Rescan"
msgstr "Kërko përsëri"

msgid "Searching the bus…"
msgstr "Po kërkohet në bus…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Shtypni butonin e programimit në një pajisje për ta kaluar në modalitetin e programimit, pastaj kërkoni përsëri."

msgid "No device is in programming mode."
msgstr "Asnjë pajisje në modalitetin e programimit."

msgid "The scan could not be completed: {error}"
msgstr "Kërkimi nuk u përfundua: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Ndërfaqja nuk e konfirmoi kërkesën për kërkim (bus i zënë ose ndërfaqe e mbingarkuar). Ju lutemi provoni përsëri."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "U përgjigj në kërkim, por leximi i detajeve dështoi: {error}"

msgid "In this project: {name}"
msgstr "Në këtë projekt: {name}"

msgid "Not in this project"
msgstr "Nuk është në këtë projekt"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Pajisje e paprogramuar (adresa e fabrikës 15.15.255)"

msgid "Select in Project"
msgstr "Zgjidhe në projekt"

msgid "Manufacturer"
msgstr "Prodhuesi"

msgid "Product (Catalog)"
msgstr "Produkti (katalogu)"

msgid "Application"
msgstr "Programi aplikativ"

msgid "Application Version"
msgstr "Versioni i programit aplikativ"

msgid "Mask Version"
msgstr "Versioni i maskës"

msgid "Serial Number"
msgstr "Numri serial"

msgid "Order Number"
msgstr "Numri i porosisë"

msgid "Hardware Type"
msgstr "Lloji i harduerit"

msgid "Status"
msgstr "Gjendja"

msgid "No fault"
msgstr "Pa defekt"

msgid "Programming mode active"
msgstr "Modaliteti i programimit aktiv"

msgid "No gateways found"
msgstr "Nuk u gjet asnjë gateway"

msgid "Manual Connection"
msgstr "Lidhje manuale"

msgid "Connected: {ip}"
msgstr "I lidhur: {ip}"

msgid "Connected to {ip}"
msgstr "I lidhur me {ip}"

msgid "Disconnected"
msgstr "I shkëputur"

msgid "Connecting…"
msgstr "Po lidhet…"

msgid "Connection failed"
msgstr "Lidhja dështoi"

msgid "Scan"
msgstr "Kërko"

msgid "Settings"
msgstr "Cilësimet"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Përdor routing multicast (në vend të tunneling)"

msgid "Gateway IP"
msgstr "IP e gateway-t"

msgid "Multicast Group"
msgstr "Grupi multicast"

msgid "Apply"
msgstr "Zbato"

msgid "Bus monitor: {ip}"
msgstr "Monitori i busit: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Gateway-i është i lidhur në modalitetin e monitorit të busit. Asgjë nuk mund të dërgohet ose programohet derisa të ndalohet monitori i busit."

msgid "Not possible while the bus monitor is running"
msgstr "Nuk është e mundur ndërkohë që monitori i busit është në punë"

msgid "Stop Bus Monitor"
msgstr "Ndalo monitorin e busit"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Ndërfaqja kërkon KNX IP Secure, por as projekti as ndonjë keyring i ngarkuar nuk i ka fjalëkalimet e saj."

msgid "Error: {error}"
msgstr "Gabim: {error}"

msgid "Unknown error"
msgstr "Gabim i panjohur"

msgid "Name: {name}"
msgstr "Emri: {name}"

msgid "KNX Address: {address}"
msgstr "Adresa KNX: {address}"

msgid "Core Version: {version}"
msgstr "Versioni i bërthamës: {version}"

msgid "Services: {services}"
msgstr "Shërbimet: {services}"

msgid "Retry"
msgstr "Provo përsëri"

msgid "Select Connection"
msgstr "Zgjidh lidhjen"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor nuk gjeti dot një lidhje të disponueshme."

msgid "The connection {name} is not available."
msgstr "Lidhja {name} nuk është e disponueshme."

msgid "You may use any of the connections listed below, instead."
msgstr "Në vend të saj, mund të përdorni cilëndo nga lidhjet më poshtë."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Anulo"

msgid "This kind of connection is not supported."
msgstr "Ky lloj lidhjeje nuk mbështetet."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Një pajisje me numër serial të njohur merr adresën individuale pa shtypur butonin e programimit."

msgid "Connection Type"
msgstr "Lloji i lidhjes"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Zbatohet në lidhjen e radhës, njësoj si zgjedhja në menynë Gateway."

msgid "USB Interfaces"
msgstr "Ndërfaqet USB"

msgid "No USB interfaces found"
msgstr "Nuk u gjet asnjë ndërfaqe USB"

msgid "Not connected to the bus"
msgstr "Nuk ka lidhje me bus-in"

msgid "Serial Number: {serial}"
msgstr "Numri serial: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} pajisje në modalitetin e programimit"
msgstr[1] "{count} pajisje në modalitetin e programimit"

msgid "USB Interface…"
msgstr "Ndërfaqja USB…"

msgid "USB Interface"
msgstr "Ndërfaqja USB"

msgid "Close"
msgstr "Mbyll"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Gjatësia Maksimale e Telegramit (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Lloji EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Llojet EMI të mbështetura: {types}"

msgid "Mask Version: {mask}"
msgstr "Versioni i maskës: {mask}"

msgid "Individual Address"
msgstr "Adresa individuale"

msgid "Address Free?"
msgstr "Adresa e Lirë?"

msgid "The individual address {address} is not used by another device."
msgstr "Adresa individuale {address} nuk përdoret nga asnjë pajisje tjetër."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Adresa individuale {address} përdoret tashmë nga një pajisje tjetër në bus."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} nuk është adresë individuale (zona.linja.pajisja)."

msgid "The individual address of the interface is being set or checked."
msgstr "Adresa individuale e ndërfaqes po vendoset ose po kontrollohet."

msgid "Not connected through a USB interface."
msgstr "Nuk ka lidhje përmes një ndërfaqeje USB."

msgid "The individual address could not be set: {error}"
msgstr "Adresa individuale nuk mund të vendosej: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Adresa individuale nuk mund të kontrollohej: {error}"

msgid "Setting the individual address…"
msgstr "Po vendoset adresa individuale…"

msgid "Checking the individual address on the bus…"
msgstr "Po kontrollohet adresa individuale në bus…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Një adresë e ndryshuar vendoset në ndërfaqe (Enter), e cila e ruan."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Një adresë e ndryshuar vendoset në ndërfaqe (Enter). Kjo ndërfaqe e harron kur shkëputet, prandaj vendoset sërish në çdo lidhje."
