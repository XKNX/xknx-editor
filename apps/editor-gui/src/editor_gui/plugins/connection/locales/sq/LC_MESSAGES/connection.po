msgstr "Serveri KNXnet/IP nuk po funksionon."

msgid "No tunnels open"
msgstr "Asnjë tunel i hapur"

msgid "Channel"
msgstr "Kanali"

msgid "Client"
msgstr "Klienti"

msgid "Address"
msgstr "Adresa"

msgid "At least one tunnel address is needed."
msgstr "Nevojitet të paktën një adresë tuneli."

msgid "The tunnel address {address} is given twice."
msgstr "Adresa e tunelit {address} është dhënë dy herë."

msgid "{address} is the individual address of the interface itself."
msgstr "{address} është adresa individuale e vetë ndërfaqes."

msgid "{address} is not on the line of the interface ({line})."
msgstr "{address} nuk është në linjën e ndërfaqes ({line})."

