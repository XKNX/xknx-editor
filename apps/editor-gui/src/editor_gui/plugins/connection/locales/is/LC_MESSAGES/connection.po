msgstr "Kjarnaútgáfa: {version}"

msgid "Services: {services}"
msgstr "Þjónustur: {services}"

msgid "Retry"
msgstr "Reyna aftur"

msgid "Select Connection"
msgstr "Velja tengingu"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor fann enga tiltæka tengingu."

msgid "The connection {name} is not available."
msgstr "Tengingin {name} er ekki tiltæk."

msgid "You may use any of the connections listed below, instead."
msgstr "Þú getur notað einhverja af tengingunum hér fyrir neðan í staðinn."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Hætta við"

msgid "This kind of connection is not supported."
msgstr "Þessi gerð tengingar er ekki studd."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Tæki með þekkt raðnúmer fær einstaklingsvistfang sitt án þess að ýtt sé á forritunarhnapp þess."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-skil"

msgid "No USB interfaces found"
msgstr "Engin USB-skil fundust"

msgid "Not connected to the bus"
msgstr "Ekki tengt við tengibrautina"

msgid "Serial Number: {serial}"
msgstr "Raðnúmer: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} tæki í forritunarham"
msgstr[1] "{count} tæki í forritunarham"

msgid "USB Interface…"
msgstr "USB-tengi…"

msgid "USB Interface"
msgstr "USB-tengi"

msgid "Close"
msgstr "Loka"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Hámarkslengd skeytis (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "EMI-gerð: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Studdar EMI-gerðir: {types}"

msgid "Mask Version: {mask}"
msgstr "Grímuútgáfa: {mask}"

msgid "Individual Address"
msgstr "Einstaklingsvistfang"

msgid "Address Free?"
msgstr "Vistfang laust?"

msgid "The individual address {address} is not used by another device."
msgstr "Ekkert annað tæki notar einstaklingsvistfangið {address}."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Annað tæki á tengibrautinni notar þegar einstaklingsvistfangið {address}."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} er ekki einstaklingsvistfang (svæði.lína.tæki)."

msgid "The individual address of the interface is being set or checked."
msgstr "Verið er að stilla eða athuga einstaklingsvistfang tengisins."

msgid "Not connected through a USB interface."
msgstr "Ekki tengt um USB-tengi."

msgid "The individual address could not be set: {error}"
msgstr "Ekki tókst að stilla einstaklingsvistfangið: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Ekki tókst að athuga einstaklingsvistfangið: {error}"

msgid "Setting the individual address…"
msgstr "Stilli einstaklingsvistfangið…"

msgid "Checking the individual address on the bus…"
msgstr "Athuga einstaklingsvistfangið á tengibrautinni…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Breytt vistfang er stillt í tenginu (Enter), sem heldur því."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Breytt vistfang er stillt í tenginu (Enter). Þetta tengi gleymir því þegar það er tekið úr sambandi, svo það er stillt aftur við hverja tengingu."
