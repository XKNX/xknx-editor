msgstr "Zastosuj"

msgid "Bus monitor: {ip}"
msgstr "Monitor magistrali: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Bramka jest połączona w trybie monitora magistrali. Do czasu zatrzymania monitora magistrali nie można niczego wysyłać ani programować."

msgid "Not possible while the bus monitor is running"
msgstr "Niemożliwe, gdy działa monitor magistrali"

msgid "Stop Bus Monitor"
msgstr "Zatrzymaj monitor magistrali"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Interfejs wymaga KNX IP Secure, ale ani projekt, ani załadowany plik kluczy nie zawiera jego haseł."

msgid "Error: {error}"
msgstr "Błąd: {error}"

msgid "Unknown error"
msgstr "Nieznany błąd"

msgid "Name: {name}"
msgstr "Nazwa: {name}"

msgid "KNX Address: {address}"
msgstr "Adres KNX: {address}"

msgid "Core Version: {version}"
msgstr "Wersja rdzenia: {version}"

msgid "Services: {services}"
msgstr "Usługi: {services}"

msgid "Retry"
msgstr "Ponów"

msgid "Select Connection"
msgstr "Wybierz połączenie"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor nie mógł określić dostępnego połączenia."

msgid "The connection {name} is not available."
msgstr "Połączenie {name} jest niedostępne."

msgid "You may use any of the connections listed below, instead."
msgstr "Zamiast tego możesz użyć któregoś z poniższych połączeń."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Anuluj"

msgid "This kind of connection is not supported."
msgstr "Ten rodzaj połączenia nie jest obsługiwany."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Urządzenie o znanym numerze seryjnym otrzymuje adres indywidualny bez naciskania przycisku programowania."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfejsy USB"

msgid "No USB interfaces found"
msgstr "Nie znaleziono interfejsów USB"

msgid "Not connected to the bus"
msgstr "Brak połączenia z magistralą"

msgid "Serial Number: {serial}"
msgstr "Numer seryjny: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} urządzenie w trybie programowania"
msgstr[1] "{count} urządzenia w trybie programowania"
msgstr[2] "{count} urządzeń w trybie programowania"

msgid "USB Interface…"
msgstr "Interfejs USB…"

msgid "USB Interface"
msgstr "Interfejs USB"

msgid "Close"
msgstr "Zamknij"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maksymalna Długość Telegramu (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Typ EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Obsługiwane typy EMI: {types}"

msgid "Mask Version: {mask}"
msgstr "Wersja maski: {mask}"

msgid "Individual Address"
msgstr "Adres indywidualny"

msgid "Address Free?"
msgstr "Adres Wolny?"

msgid "The individual address {address} is not used by another device."
msgstr "Adres indywidualny {address} nie jest używany przez inne urządzenie."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Adres indywidualny {address} jest już używany przez inne urządzenie na magistrali."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} nie jest adresem indywidualnym (obszar.linia.urządzenie)."

msgid "The individual address of the interface is being set or checked."
msgstr "Adres indywidualny interfejsu jest właśnie ustawiany lub sprawdzany."

msgid "Not connected through a USB interface."
msgstr "Brak połączenia przez interfejs USB."

msgid "The individual address could not be set: {error}"
msgstr "Nie udało się ustawić adresu indywidualnego: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Nie udało się sprawdzić adresu indywidualnego: {error}"

msgid "Setting the individual address…"
msgstr "Ustawianie adresu indywidualnego…"

msgid "Checking the individual address on the bus…"
msgstr "Sprawdzanie adresu indywidualnego na magistrali…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Ten interfejs zapomina swój adres indywidualny po odłączeniu, dlatego jest on ustawiany ponownie przy każdym połączeniu."

msgid "Protected Group Addresses"
msgstr "Chronione Adresy Grupowe"

msgid "Nothing is ever sent to these group addresses, not even reads, e.g. the ones of gates or an alarm system: addresses like 1/2/3, or groups ending with a slash like 7/0/, separated by spaces. MCP clients can add to the list but not take anything out."
msgstr "Na te adresy grupowe nigdy nic nie jest wysyłane, nawet odczyty, np. adresy bram lub systemu alarmowego: adresy takie jak 1/2/3 lub grupy kończące się ukośnikiem, jak 7/0/, oddzielone spacjami. Klienci MCP mogą dodawać do listy, ale nie mogą niczego z niej usuwać."

msgid "Not a group address or group: {entries}"
msgstr "To nie jest adres grupowy ani grupa: {entries}"

msgid "Confirmation Timeout (Seconds)"
msgstr "Limit czasu potwierdzenia (sekundy)"

msgid "How long to wait for the interface to confirm each frame it sends. A slow connection, such as a remote tunnel or a VPN, needs longer."
msgstr "Jak długo czekać, aż interfejs potwierdzi każdą wysłaną ramkę. Wolne połączenie, np. zdalny tunel lub VPN, potrzebuje więcej czasu."

msgid "Acknowledgement Timeout (Seconds)"
msgstr "Limit czasu potwierdzenia odbioru (sekundy)"

msgid "How long to wait for a device to acknowledge a frame of a download before sending it again (up to three times). A device closes the connection after 6 seconds without a frame, so a longer wait only helps where the answers are late, not lost."
msgstr "Jak długo czekać, aż urządzenie potwierdzi ramkę programowania, zanim zostanie wysłana ponownie (do trzech razy). Urządzenie zamyka połączenie po 6 sekundach bez ramki, więc dłuższe czekanie pomaga tylko wtedy, gdy odpowiedzi przychodzą z opóźnieniem, a nie gdy giną."

msgid "Response Timeout (Seconds)"
msgstr "Limit czasu odpowiedzi (sekundy)"

msgid "How long to wait for a device's answer, e.g. to a memory or property read."
msgstr "Jak długo czekać na odpowiedź urządzenia, np. na odczyt pamięci lub właściwości."

msgid "Medium: {medium}"
msgstr "Medium: {medium}"

msgid "Domain Address"
msgstr "Adres domeny"

msgid "From Line"
msgstr "Z linii"

msgid "The interface sends with this domain address and receives only the telegrams of devices with it."
msgstr "Interfejs nadaje z tym adresem domeny i odbiera tylko telegramy urządzeń, które go mają."

msgid "{address} is not an RF domain address (4 and 8 hexadecimal digits, e.g. 0001:23456789)."
msgstr "{address} nie jest adresem domeny RF (4 i 8 cyfr szesnastkowych, np. 0001:23456789)."

msgid "The domain address of the interface is being set."
msgstr "Adres domeny interfejsu jest właśnie ustawiany."

msgid "The connected USB interface is not a KNX RF interface."
msgstr "Podłączony interfejs USB nie jest interfejsem KNX RF."

msgid "The domain address could not be set: {error}"
msgstr "Nie udało się ustawić adresu domeny: {error}"

msgid "Setting the domain address…"
msgstr "Ustawianie adresu domeny…"

msgid "Local Device Access"
msgstr "Dostęp do urządzenia lokalnego"

msgid "Connects to the KNX device the USB interface is part of (e.g. an actuator with a USB port of its own) instead of the bus. Only this device can then be reached, for downloads and readouts; group telegrams, broadcasts and the bus monitor are not available. Needs a cEMI interface."
msgstr "Łączy z urządzeniem KNX, którego częścią jest interfejs USB (np. z aktorem z własnym portem USB), zamiast z magistralą. Osiągalne jest wtedy tylko to urządzenie, do programowania i odczytów; telegramy grupowe, rozgłoszenia i monitor magistrali nie są dostępne. Wymaga interfejsu cEMI."

msgid "Connect to the interface's own device (local device access)"
msgstr "Połącz z własnym urządzeniem interfejsu (dostęp do urządzenia lokalnego)"

msgid "{target}, local device access to {address}"
msgstr "{target}, dostęp do urządzenia lokalnego {address}"

msgid "(address unknown)"
msgstr "(adres nieznany)"

msgid "Local device access: only this device is reached"
msgstr "Dostęp do urządzenia lokalnego: osiągane jest tylko to urządzenie"

msgid "Switching the connection…"
msgstr "Przełączanie połączenia…"

msgid "The connection could not be switched: {error}"
msgstr "Nie udało się przełączyć połączenia: {error}"

msgid "The connection of the interface is being switched."
msgstr "Połączenie interfejsu jest właśnie przełączane."

msgid "Through local device access only the USB interface's own device {local} can be reached, not {address}."
msgstr "Przez dostęp do urządzenia lokalnego osiągalne jest tylko własne urządzenie {local} interfejsu USB, a nie {address}."

msgid "Through local device access only the USB interface's own device {local} can be reached: group telegrams can't be sent."
msgstr "Przez dostęp do urządzenia lokalnego osiągalne jest tylko własne urządzenie {local} interfejsu USB: nie można wysyłać telegramów grupowych."

msgid "Through local device access only the USB interface's own device {local} can be reached: broadcasts can't be sent."
msgstr "Przez dostęp do urządzenia lokalnego osiągalne jest tylko własne urządzenie {local} interfejsu USB: nie można wysyłać rozgłoszeń."

msgid "Through local device access only the USB interface's own device {local} can be reached: the bus monitor can't run."
msgstr "Przez dostęp do urządzenia lokalnego osiągalne jest tylko własne urządzenie {local} interfejsu USB: monitor magistrali nie może działać."

msgid "Through local device access only the USB interface's own device {local} can be reached: scan from {local} to {local}."
msgstr "Przez dostęp do urządzenia lokalnego osiągalne jest tylko własne urządzenie {local} interfejsu USB: skanuj od {local} do {local}."

msgid "Protocol"
msgstr "Protokół"

msgid "KNXnet/IP Server"
msgstr "Serwer KNXnet/IP"

msgid "Run a KNXnet/IP server for other tools (USB to IP bridge)"
msgstr "Uruchom serwer KNXnet/IP dla innych narzędzi (most USB–IP)"

msgid "Other tools (another editor, Home Assistant, a commissioning tool) connect to it over the network and use this USB interface as a KNXnet/IP interface. Each tunnel gets one of the tunnel addresses, which have to be free addresses of the interface's line. It runs while the editor is connected to the bus through the interface, and opens a network port: turn it on only where that is wanted."
msgstr "Inne narzędzia (inny edytor, Home Assistant, narzędzie do uruchamiania instalacji) łączą się z nim przez sieć i używają tego interfejsu USB jako interfejsu KNXnet/IP. Każdy tunel otrzymuje jeden z adresów tuneli, które muszą być wolnymi adresami linii interfejsu. Działa, dopóki edytor jest połączony z magistralą przez interfejs, i otwiera port sieciowy: włączaj go tylko tam, gdzie jest to pożądane."

msgid "Port"
msgstr "Port"

msgid "Listen On"
msgstr "Nasłuchuj na"

msgid "All network interfaces"
msgstr "Wszystkie interfejsy sieciowe"

msgid "This computer only"
msgstr "Tylko ten komputer"

msgid "Answer searches (discovery)"
msgstr "Odpowiadaj na wyszukiwania (discovery)"

msgid "Offer TCP"
msgstr "Oferuj TCP"

msgid "Tunnel Addresses"
msgstr "Adresy tuneli"

msgid "Suggest"
msgstr "Zaproponuj"

msgid "Name"
msgstr "Nazwa"

msgid "KNXnet/IP server on port {port}, {count} tunnel"
msgid_plural "KNXnet/IP server on port {port}, {count} tunnels"
msgstr[0] "Serwer KNXnet/IP na porcie {port}, {count} tunel"
msgstr[1] "Serwer KNXnet/IP na porcie {port}, {count} tunele"
msgstr[2] "Serwer KNXnet/IP na porcie {port}, {count} tuneli"

msgid "The KNXnet/IP server is not running."
msgstr "Serwer KNXnet/IP nie działa."

msgid "No tunnels open"
msgstr "Brak otwartych tuneli"

msgid "Channel"
msgstr "Kanał"

msgid "Client"
msgstr "Klient"

msgid "Address"
msgstr "Adres"

msgid "At least one tunnel address is needed."
msgstr "Potrzebny jest co najmniej jeden adres tunelu."

msgid "The tunnel address {address} is given twice."
msgstr "Adres tunelu {address} podano dwa razy."

msgid "{address} is the individual address of the interface itself."
msgstr "{address} to adres indywidualny samego interfejsu."

msgid "{address} is not on the line of the interface ({line})."
msgstr "{address} nie leży na linii interfejsu ({line})."

msgid "{address} is the individual address of the device {name}."
msgstr "{address} to adres indywidualny urządzenia {name}."

msgid "{port} is not a port (1 to 65535)."
msgstr "{port} nie jest portem (1 do 65535)."

msgid "The KNXnet/IP server runs only while the editor is connected through a KNX USB interface."
msgstr "Serwer KNXnet/IP działa tylko wtedy, gdy edytor jest połączony przez interfejs KNX USB."

msgid "The KNXnet/IP server doesn't run with local device access: the connection reaches only the interface's own device."
msgstr "Serwer KNXnet/IP nie działa przy dostępie do urządzenia lokalnego: połączenie dociera tylko do własnego urządzenia interfejsu."

msgid "The KNXnet/IP server is being started or stopped."
msgstr "Serwer KNXnet/IP jest właśnie uruchamiany lub zatrzymywany."

msgid "The KNXnet/IP server could not start: {error}"
msgstr "Nie udało się uruchomić serwera KNXnet/IP: {error}"
