msgid ""
msgstr ""
"Project-Id-Version: xknx-editor connection 1.0\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Gateway"
msgstr "Bramka"

msgid "Connect"
msgstr "Połącz"

msgid "Disconnect"
msgstr "Rozłącz"

msgid "Connect at Startup"
msgstr "Połącz przy uruchomieniu"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Przy uruchomieniu edytor wyszukuje interfejsy KNX i łączy się z ostatnio używanym. Po wyłączeniu łączy się tylko wtedy, gdy to wybierzesz."

msgid "Use Serial Number for Downloads"
msgstr "Programuj z użyciem numeru seryjnego"

msgid "Discovered Gateways"
msgstr "Wykryte bramki"

msgid "Check for Devices in Programming Mode"
msgstr "Szukaj urządzeń w trybie programowania"

msgid "Devices in Programming Mode"
msgstr "Urządzenia w trybie programowania"

msgid "Rescan"
msgstr "Szukaj ponownie"

msgid "Searching the bus…"
msgstr "Przeszukiwanie magistrali…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Aby przełączyć urządzenie w tryb programowania, należy nacisnąć jego przycisk programowania, a następnie wyszukać ponownie."

msgid "No device is in programming mode."
msgstr "Żadne urządzenie nie jest w trybie programowania."

msgid "The scan could not be completed: {error}"
msgstr "Nie można ukończyć wyszukiwania: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Interfejs nie potwierdził żądania wyszukiwania (magistrala zajęta lub interfejs przeciążony). Należy spróbować ponownie."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Odpowiedziało na wyszukiwanie, ale odczyt szczegółów nie powiódł się: {error}"

msgid "In this project: {name}"
msgstr "W tym projekcie: {name}"

msgid "Not in this project"
msgstr "Brak w tym projekcie"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Niezaprogramowane urządzenie (fabryczny adres domyślny 15.15.255)"

msgid "Select in Project"
msgstr "Wybierz w projekcie"

msgid "Manufacturer"
msgstr "Producent"

msgid "Product (Catalog)"
msgstr "Produkt (katalog)"

msgid "Application"
msgstr "Aplikacja"

msgid "Application Version"
msgstr "Wersja aplikacji"

msgid "Mask Version"
msgstr "Wersja maski"

msgid "Serial Number"
msgstr "Numer seryjny"

msgid "Order Number"
msgstr "Numer zamówienia"

msgid "Hardware Type"
msgstr "Typ sprzętu"

msgid "Status"
msgstr "Status"

msgid "No fault"
msgstr "Brak błędów"

msgid "Programming mode active"
msgstr "Tryb programowania aktywny"

msgid "No gateways found"
msgstr "Nie znaleziono bramek"

msgid "Manual Connection"
msgstr "Połączenie ręczne"

msgid "Connected: {ip}"
msgstr "Połączono: {ip}"

msgid "Connected to {ip}"
msgstr "Połączono z {ip}"

msgid "Disconnected"
msgstr "Nie połączono"

msgid "Connecting…"
msgstr "Łączenie…"

msgid "Connection failed"
msgstr "Połączenie nie powiodło się"

msgid "Scan"
msgstr "Skanuj"

msgid "Settings"
msgstr "Ustawienia"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Użyj routingu multicast (zamiast tunelowania)"

msgid "Gateway IP"
msgstr "IP bramki"

msgid "Multicast Group"
msgstr "Grupa multicast"

msgid "Apply"
msgstr "Zastosuj"

msgid "Bus monitor: {ip}"
msgstr "Monitor magistrali: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Bramka jest połączona w trybie monitora magistrali. Do czasu zatrzymania monitora magistrali nie można niczego wysyłać ani programować."

msgid "Not possible while the bus monitor is running"
msgstr "Niemożliwe, gdy działa monitor magistrali"

msgid "Stop Bus Monitor"
msgstr "Zatrzymaj monitor magistrali"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Interfejs wymaga KNX IP Secure, ale ani projekt, ani załadowany plik kluczy nie zawiera jego haseł."

msgid "Error: {error}"
msgstr "Błąd: {error}"

msgid "Unknown error"
msgstr "Nieznany błąd"

msgid "Name: {name}"
msgstr "Nazwa: {name}"

msgid "KNX Address: {address}"
msgstr "Adres KNX: {address}"

msgid "Core Version: {version}"
msgstr "Wersja rdzenia: {version}"

msgid "Services: {services}"
msgstr "Usługi: {services}"

msgid "Retry"
msgstr "Ponów"

msgid "Select Connection"
msgstr "Wybierz połączenie"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor nie mógł określić dostępnego połączenia."

msgid "The connection {name} is not available."
msgstr "Połączenie {name} jest niedostępne."

msgid "You may use any of the connections listed below, instead."
msgstr "Zamiast tego możesz użyć któregoś z poniższych połączeń."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Anuluj"

msgid "This kind of connection is not supported."
msgstr "Ten rodzaj połączenia nie jest obsługiwany."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Urządzenie o znanym numerze seryjnym otrzymuje adres indywidualny bez naciskania przycisku programowania."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfejsy USB"

msgid "No USB interfaces found"
msgstr "Nie znaleziono interfejsów USB"

msgid "Not connected to the bus"
msgstr "Brak połączenia z magistralą"

msgid "Serial Number: {serial}"
msgstr "Numer seryjny: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} urządzenie w trybie programowania"
msgstr[1] "{count} urządzenia w trybie programowania"
msgstr[2] "{count} urządzeń w trybie programowania"

msgid "USB Interface Settings…"
msgstr "Ustawienia Interfejsu USB…"

msgid "USB Interface Settings"
msgstr "Ustawienia Interfejsu USB"

msgid "Close"
msgstr "Zamknij"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maksymalna Długość Telegramu (APDU): {length}"

msgid "Individual Address"
msgstr "Adres indywidualny"

msgid "Address Free?"
msgstr "Adres Wolny?"

msgid "The individual address {address} is not used by another device."
msgstr "Adres indywidualny {address} nie jest używany przez inne urządzenie."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Adres indywidualny {address} jest już używany przez inne urządzenie na magistrali."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} nie jest adresem indywidualnym (obszar.linia.urządzenie)."

msgid "The individual address of the interface is being set or checked."
msgstr "Adres indywidualny interfejsu jest właśnie ustawiany lub sprawdzany."

msgid "Not connected through a USB interface."
msgstr "Brak połączenia przez interfejs USB."

msgid "The individual address could not be set: {error}"
msgstr "Nie udało się ustawić adresu indywidualnego: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Nie udało się sprawdzić adresu indywidualnego: {error}"

msgid "Setting the individual address…"
msgstr "Ustawianie adresu indywidualnego…"

msgid "Checking the individual address on the bus…"
msgstr "Sprawdzanie adresu indywidualnego na magistrali…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Zmieniony adres jest ustawiany w interfejsie (Enter), który go zachowuje."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Zmieniony adres jest ustawiany w interfejsie (Enter). Ten interfejs zapomina go po odłączeniu, dlatego jest on ustawiany ponownie przy każdym połączeniu."
