msgid "Gateway"
msgstr "Шлюз"

msgid "Connect"
msgstr "Під'єднатися"

msgid "Disconnect"
msgstr "Від'єднати"

msgid "Connect at Startup"
msgstr "Підключатися під час запуску"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Під час запуску редактор шукає інтерфейси KNX і підключається до останнього використаного. Якщо вимкнено, підключається лише за вашим вибором."

msgid "Use Serial Number for Downloads"
msgstr "Використовувати серійний номер для завантажень"

msgid "Discovered Gateways"
msgstr "Виявлені шлюзи"

msgid "Check for Devices in Programming Mode"
msgstr "Шукати пристрої в режимі програмування"

msgid "Devices in Programming Mode"
msgstr "Пристрої в режимі програмування"

msgid "Rescan"
msgstr "Шукати знову"

msgid "Searching the bus…"
msgstr "Пошук на шині…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Натисніть кнопку програмування на пристрої, щоб увімкнути режим програмування, а потім повторіть пошук."

msgid "No device is in programming mode."
msgstr "Жоден пристрій не перебуває в режимі програмування."

msgid "The scan could not be completed: {error}"
msgstr "Не вдалося завершити пошук: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Інтерфейс не підтвердив запит на пошук (шина зайнята або інтерфейс перевантажений). Спробуйте ще раз."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Відповів на пошук, але не вдалося прочитати відомості: {error}"

msgid "In this project: {name}"
msgstr "У цьому проєкті: {name}"

msgid "Not in this project"
msgstr "Не в цьому проєкті"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Непрограмований пристрій (заводська адреса 15.15.255)"

msgid "Select in Project"
msgstr "Вибрати в проєкті"

msgid "Manufacturer"
msgstr "Виробник"

msgid "Product (Catalog)"
msgstr "Продукт (каталог)"

msgid "Application"
msgstr "Додаток"

msgid "Application Version"
msgstr "Версія прикладної програми"

msgid "Mask Version"
msgstr "Версія маски"

msgid "Serial Number"
msgstr "Серійний номер"

msgid "Order Number"
msgstr "Номер для замовлення"

msgid "Hardware Type"
msgstr "Тип Hardware"

msgid "Status"
msgstr "Статус"

msgid "No fault"
msgstr "Немає помилок"

msgid "Programming mode active"
msgstr "Режим програмування активний"

msgid "No gateways found"
msgstr "Шлюзів не знайдено"

msgid "Manual Connection"
msgstr "Ручне з'єднання"

msgid "Connected: {ip}"
msgstr "З'єднано: {ip}"

msgid "Connected to {ip}"
msgstr "З'єднано з {ip}"

msgid "Disconnected"
msgstr "Не з'єднано"

msgid "Connecting…"
msgstr "З'єднання…"

msgid "Connection failed"
msgstr "Помилка з'єднання"

msgid "Scan"
msgstr "Пошук"

msgid "Settings"
msgstr "Налаштування"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Використовувати multicast-роутинг (замість тунелінгу)"

msgid "Gateway IP"
msgstr "IP шлюзу"

msgid "Multicast Group"
msgstr "Multicast-група"

msgid "Apply"
msgstr "Застосувати"

msgid "Bus monitor: {ip}"
msgstr "Монітор шини: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Шлюз під'єднано в режимі монітора шини. Нічого не можна надіслати чи завантажити, доки монітор шини не зупинено."

msgid "Not possible while the bus monitor is running"
msgstr "Неможливо, поки працює монітор шини"

msgid "Stop Bus Monitor"
msgstr "Зупинити монітор шини"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Інтерфейс вимагає KNX IP Secure, але ні проєкт, ні завантажена в'язка ключів не містять його паролів."

msgid "Error: {error}"
msgstr "Помилка: {error}"

msgid "Unknown error"
msgstr "Невідома помилка"

msgid "Name: {name}"
msgstr "Ім'я: {name}"

msgid "KNX Address: {address}"
msgstr "Адреса KNX: {address}"

msgid "Core Version: {version}"
msgstr "Версія ядра: {version}"

msgid "Services: {services}"
msgstr "Служби: {services}"

msgid "Retry"
msgstr "Повторити спробу"

msgid "Select Connection"
msgstr "Виберіть з'єднання"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor не може визначити доступне підключення."

msgid "The connection {name} is not available."
msgstr "Підключення {name} не доступне."

msgid "You may use any of the connections listed below, instead."
msgstr "Замість ви можете використовувати будь-які перераховані нижче з'єднання."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Скасувати"

msgid "This kind of connection is not supported."
msgstr "Цей тип з'єднання не підтримується."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Пристрій із відомим серійним номером отримує індивідуальну адресу без натискання кнопки програмування."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-інтерфейси"

msgid "No USB interfaces found"
msgstr "USB-інтерфейси не знайдено"

msgid "Not connected to the bus"
msgstr "Немає з'єднання з шиною"

msgid "Serial Number: {serial}"
msgstr "Серійний номер: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} пристрій у режимі програмування"
msgstr[1] "{count} пристрої у режимі програмування"
msgstr[2] "{count} пристроїв у режимі програмування"

msgid "USB Interface Settings…"
msgstr "Налаштування USB-інтерфейсу…"

msgid "USB Interface Settings"
msgstr "Налаштування USB-інтерфейсу"

msgid "Close"
msgstr "Закрити"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Максимальна довжина телеграми (APDU): {length}"

msgid "Individual Address"
msgstr "Індивідуальна адреса"

msgid "Address Free?"
msgstr "Адреса вільна?"

msgid "The individual address {address} is not used by another device."
msgstr "Індивідуальна адреса {address} не використовується іншим пристроєм."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Індивідуальна адреса {address} вже використовується іншим пристроєм на шині."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} не є індивідуальною адресою (область.лінія.пристрій)."

msgid "The individual address of the interface is being set or checked."
msgstr "Індивідуальна адреса інтерфейсу встановлюється або перевіряється."

msgid "Not connected through a USB interface."
msgstr "Немає підключення через USB-інтерфейс."

msgid "The individual address could not be set: {error}"
msgstr "Не вдалося встановити індивідуальну адресу: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Не вдалося перевірити індивідуальну адресу: {error}"

msgid "Setting the individual address…"
msgstr "Встановлення індивідуальної адреси…"

msgid "Checking the individual address on the bus…"
msgstr "Перевірка індивідуальної адреси на шині…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Змінена адреса встановлюється в інтерфейсі (Enter), який її зберігає."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Змінена адреса встановлюється в інтерфейсі (Enter). Цей інтерфейс забуває її після від'єднання, тому вона встановлюється знову під час кожного підключення."
