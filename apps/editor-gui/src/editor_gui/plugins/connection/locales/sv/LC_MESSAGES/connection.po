msgid "Gateway"
msgstr "Gateway"

msgid "Connect"
msgstr "Anslut"

msgid "Disconnect"
msgstr "Koppla ifrån"

msgid "Connect at Startup"
msgstr "Anslut vid start"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Vid start söker redigeraren efter KNX-gränssnitt och ansluter till det senast använda. Avstängt ansluter den bara när du väljer det."

msgid "Use Serial Number for Downloads"
msgstr "Använd serienummer vid programmering"

msgid "Discovered Gateways"
msgstr "Hittade gateways"

msgid "Check for Devices in Programming Mode"
msgstr "Sök efter apparater i programmeringsläge"

msgid "Devices in Programming Mode"
msgstr "Apparater i programmeringsläge"

msgid "Rescan"
msgstr "Sök igen"

msgid "Searching the bus…"
msgstr "Söker igenom bussen…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Tryck på programmeringsknappen på en apparat för att sätta den i programmeringsläge och sök sedan igen."

msgid "No device is in programming mode."
msgstr "Ingen apparat är i programmeringsläge."

msgid "The scan could not be completed: {error}"
msgstr "Sökningen kunde inte slutföras: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Gränssnittet bekräftade inte sökbegäran (bussen upptagen eller gränssnittet överbelastat). Försök igen."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Svarade på sökningen, men det gick inte att läsa detaljerna: {error}"

msgid "In this project: {name}"
msgstr "I det här projektet: {name}"

msgid "Not in this project"
msgstr "Inte i det här projektet"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Oprogrammerad apparat (fabriksadress 15.15.255)"

msgid "Select in Project"
msgstr "Markera i projektet"

msgid "Manufacturer"
msgstr "Tillverkare"

msgid "Product (Catalog)"
msgstr "Produkt (katalog)"

msgid "Application"
msgstr "Applikation"

msgid "Application Version"
msgstr "Applikationsversion"

msgid "Mask Version"
msgstr "Maskversion"

msgid "Serial Number"
msgstr "Serienummer"

msgid "Order Number"
msgstr "Beställningsnummer"

msgid "Hardware Type"
msgstr "Hårdvarutyp"

msgid "Status"
msgstr "Status"

msgid "No fault"
msgstr "Inget fel"

msgid "Programming mode active"
msgstr "Programmeringsläge aktivt"

msgid "No gateways found"
msgstr "Inga gateways hittades"

msgid "Manual Connection"
msgstr "Manuell anslutning"

msgid "Connected: {ip}"
msgstr "Ansluten: {ip}"

msgid "Connected to {ip}"
msgstr "Ansluten till {ip}"

msgid "Disconnected"
msgstr "Ej ansluten"

msgid "Connecting…"
msgstr "Ansluter…"

msgid "Connection failed"
msgstr "Anslutningen misslyckades"

msgid "Scan"
msgstr "Avsök"

msgid "Settings"
msgstr "Inställningar"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Använd multicast-routing (i stället för tunneling)"

msgid "Gateway IP"
msgstr "Gateway-IP"

msgid "Multicast Group"
msgstr "Multicastgrupp"

msgid "Apply"
msgstr "Tillämpa"

msgid "Bus monitor: {ip}"
msgstr "Bussövervakare: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Gatewayen är ansluten i bussövervakarläge. Inget kan skickas eller programmeras förrän bussövervakaren har stoppats."

msgid "Not possible while the bus monitor is running"
msgstr "Inte möjligt medan bussövervakaren körs"

msgid "Stop Bus Monitor"
msgstr "Stoppa bussövervakare"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Gränssnittet kräver KNX IP Secure, men varken projektet eller en inläst nyckelring innehåller dess lösenord."

msgid "Error: {error}"
msgstr "Fel: {error}"

msgid "Unknown error"
msgstr "Okänt fel"

msgid "Name: {name}"
msgstr "Namn: {name}"

msgid "KNX Address: {address}"
msgstr "KNX-adress: {address}"

msgid "Core Version: {version}"
msgstr "Core-version: {version}"

msgid "Services: {services}"
msgstr "Tjänster: {services}"

msgid "Retry"
msgstr "Försök igen"

msgid "Select Connection"
msgstr "Välj anslutning"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor kunde inte hitta en tillgänglig anslutning."

msgid "The connection {name} is not available."
msgstr "Anslutningen {name} är inte tillgänglig."

msgid "You may use any of the connections listed below, instead."
msgstr "Du kan använda någon av de anslutningar som anges nedan, istället."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Avbryt"

msgid "This kind of connection is not supported."
msgstr "Den här typen av anslutning stöds inte."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "En enhet med känt serienummer får sin individuella adress utan att programmeringsknappen trycks."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-gränssnitt"

msgid "No USB interfaces found"
msgstr "Inga USB-gränssnitt hittades"

msgid "Not connected to the bus"
msgstr "Inte ansluten till bussen"

msgid "Serial Number: {serial}"
msgstr "Serienummer: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} apparat i programmeringsläge"
msgstr[1] "{count} apparater i programmeringsläge"

msgid "USB Interface…"
msgstr "USB-gränssnitt…"

msgid "USB Interface"
msgstr "USB-gränssnitt"

msgid "Close"
msgstr "Stäng"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maximal telegramlängd (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "EMI-typ: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "EMI-typer som stöds: {types}"

msgid "Mask Version: {mask}"
msgstr "Maskversion: {mask}"

msgid "Individual Address"
msgstr "Individuell adress"

msgid "Address Free?"
msgstr "Adress ledig?"

msgid "The individual address {address} is not used by another device."
msgstr "Den individuella adressen {address} används inte av någon annan enhet."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Den individuella adressen {address} används redan av en annan enhet på bussen."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} är ingen individuell adress (område.linje.enhet)."

msgid "The individual address of the interface is being set or checked."
msgstr "Gränssnittets individuella adress håller på att ställas in eller kontrolleras."

msgid "Not connected through a USB interface."
msgstr "Inte ansluten via ett USB-gränssnitt."

msgid "The individual address could not be set: {error}"
msgstr "Den individuella adressen kunde inte ställas in: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Den individuella adressen kunde inte kontrolleras: {error}"

msgid "Setting the individual address…"
msgstr "Ställer in den individuella adressen…"

msgid "Checking the individual address on the bus…"
msgstr "Kontrollerar den individuella adressen på bussen…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Detta gränssnitt glömmer sin individuella adress när det kopplas ur, så den ställs in igen vid varje anslutning."