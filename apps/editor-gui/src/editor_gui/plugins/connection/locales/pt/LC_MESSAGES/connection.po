msgstr "Utilizar routing multicast (em vez de tunneling)"

msgid "Gateway IP"
msgstr "IP do Gateway"

msgid "Multicast Group"
msgstr "Grupo Multicast"

msgid "Apply"
msgstr "Aplicar"

msgid "Bus monitor: {ip}"
msgstr "Monitor de bus: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "O gateway está conectado em modo de monitor de bus. Não é possível enviar nem baixar nada até o monitor de bus ser parado."

msgid "Not possible while the bus monitor is running"
msgstr "Não é possível enquanto o monitor de bus estiver em execução"

msgid "Stop Bus Monitor"
msgstr "Parar Monitor de Bus"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "A interface requer KNX IP Secure, mas nem o projeto nem um keyring carregado contêm as respetivas senhas."

msgid "Error: {error}"
msgstr "Erro: {error}"

