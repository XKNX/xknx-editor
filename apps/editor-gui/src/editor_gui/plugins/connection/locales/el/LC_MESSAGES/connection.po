msgstr "Διεύθυνση"

msgid "At least one tunnel address is needed."
msgstr "Απαιτείται τουλάχιστον μία διεύθυνση σήραγγας."

msgid "The tunnel address {address} is given twice."
msgstr "Η διεύθυνση σήραγγας {address} δίνεται δύο φορές."

msgid "{address} is the individual address of the interface itself."
msgstr "Η {address} είναι η ατομική διεύθυνση της ίδιας της διεπαφής."

msgid "{address} is not on the line of the interface ({line})."
msgstr "Η {address} δεν βρίσκεται στη γραμμή της διεπαφής ({line})."

msgid "{address} is the individual address of the device {name}."
msgstr "Η {address} είναι η ατομική διεύθυνση της συσκευής {name}."

msgid "{port} is not a port (1 to 65535)."
msgstr "Η {port} δεν είναι θύρα (1 έως 65535)."

msgid "The KNXnet/IP server runs only while the editor is connected through a KNX USB interface."
msgstr "Ο διακομιστής KNXnet/IP εκτελείται μόνο όσο ο επεξεργαστής είναι συνδεδεμένος μέσω διεπαφής KNX USB."

msgid "The KNXnet/IP server doesn't run with local device access: the connection reaches only the interface's own device."
msgstr "Ο διακομιστής KNXnet/IP δεν εκτελείται με τοπική πρόσβαση συσκευής: η σύνδεση φτάνει μόνο στη δική συσκευή της διεπαφής."

msgid "The KNXnet/IP server is being started or stopped."
msgstr "Ο διακομιστής KNXnet/IP εκκινείται ή σταματά αυτή τη στιγμή."

msgid "The KNXnet/IP server could not start: {error}"
msgstr "Δεν ήταν δυνατή η εκκίνηση του διακομιστή KNXnet/IP: {error}"

