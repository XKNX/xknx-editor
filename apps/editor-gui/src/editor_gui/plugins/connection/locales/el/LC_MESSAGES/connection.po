msgstr "Έκδοση μάσκας: {mask}"

msgid "Individual Address"
msgstr "Ατομική Διεύθυνση"

msgid "Address Free?"
msgstr "Ελεύθερη Διεύθυνση;"

msgid "The individual address {address} is not used by another device."
msgstr "Η ατομική διεύθυνση {address} δεν χρησιμοποιείται από άλλη συσκευή."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Η ατομική διεύθυνση {address} χρησιμοποιείται ήδη από άλλη συσκευή στον δίαυλο."

msgid "{address} is not an individual address (area.line.device)."
msgstr "Η {address} δεν είναι ατομική διεύθυνση (περιοχή.γραμμή.συσκευή)."

msgid "The individual address of the interface is being set or checked."
msgstr "Η ατομική διεύθυνση της διεπαφής ορίζεται ή ελέγχεται."

msgid "Not connected through a USB interface."
msgstr "Δεν υπάρχει σύνδεση μέσω διεπαφής USB."

msgid "The individual address could not be set: {error}"
msgstr "Δεν ήταν δυνατός ο ορισμός της ατομικής διεύθυνσης: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Δεν ήταν δυνατός ο έλεγχος της ατομικής διεύθυνσης: {error}"

msgid "Setting the individual address…"
msgstr "Ορισμός της ατομικής διεύθυνσης…"

msgid "Checking the individual address on the bus…"
msgstr "Έλεγχος της ατομικής διεύθυνσης στον δίαυλο…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Αυτή η διεπαφή ξεχνά την ατομική της διεύθυνση όταν αποσυνδέεται, γι' αυτό ορίζεται ξανά σε κάθε σύνδεση."

msgid "Protected Group Addresses"
msgstr "Προστατευμένες Διευθύνσεις Ομάδας"

msgid "Nothing is ever sent to these group addresses, not even reads, e.g. the ones of gates or an alarm system: addresses like 1/2/3, or groups ending with a slash like 7/0/, separated by spaces. MCP clients can add to the list but not take anything out."
msgstr "Δεν στέλνεται ποτέ τίποτα σε αυτές τις διευθύνσεις ομάδας, ούτε αναγνώσεις, π.χ. αυτές για πύλες ή σύστημα συναγερμού: διευθύνσεις όπως 1/2/3 ή ομάδες που τελειώνουν σε κάθετο όπως 7/0/, χωρισμένες με κενά. Οι πελάτες MCP μπορούν να προσθέσουν στη λίστα αλλά όχι να αφαιρέσουν κάτι."

msgid "Not a group address or group: {entries}"
msgstr "Δεν είναι διεύθυνση ομάδας ή ομάδα: {entries}"

msgid "Confirmation Timeout (Seconds)"
msgstr "Χρονικό όριο επιβεβαίωσης (δευτερόλεπτα)"

msgid "How long to wait for the interface to confirm each frame it sends. A slow connection, such as a remote tunnel or a VPN, needs longer."
msgstr "Πόσο να περιμένει για την επιβεβαίωση κάθε πλαισίου που στέλνει η διεπαφή. Μια αργή σύνδεση, όπως ένα απομακρυσμένο τούνελ ή ένα VPN, χρειάζεται περισσότερο."

msgid "Acknowledgement Timeout (Seconds)"
msgstr "Χρονικό όριο αναγνώρισης (δευτερόλεπτα)"

msgid "How long to wait for a device to acknowledge a frame of a download before sending it again (up to three times). A device closes the connection after 6 seconds without a frame, so a longer wait only helps where the answers are late, not lost."
msgstr "Πόσο να περιμένει μια συσκευή να αναγνωρίσει ένα πλαίσιο μιας φόρτωσης πριν σταλεί ξανά (έως τρεις φορές). Μια συσκευή κλείνει τη σύνδεση μετά από 6 δευτερόλεπτα χωρίς πλαίσιο, οπότε μεγαλύτερη αναμονή βοηθά μόνο όταν οι απαντήσεις αργούν, όχι όταν χάνονται."

msgid "Response Timeout (Seconds)"
msgstr "Χρονικό όριο απάντησης (δευτερόλεπτα)"

msgid "How long to wait for a device's answer, e.g. to a memory or property read."
msgstr "Πόσο να περιμένει την απάντηση μιας συσκευής, π.χ. σε ανάγνωση μνήμης ή ιδιότητας."

msgid "Medium: {medium}"
msgstr "Μέσο: {medium}"

msgid "Domain Address"
msgstr "Διεύθυνση Τομέα"

msgid "From Line"
msgstr "Από Γραμμή"

msgid "The interface sends with this domain address and receives only the telegrams of devices with it."
msgstr "Η διεπαφή στέλνει με αυτή τη διεύθυνση τομέα και λαμβάνει μόνο τα τηλεγραφήματα συσκευών που την έχουν."

msgid "{address} is not an RF domain address (4 and 8 hexadecimal digits, e.g. 0001:23456789)."
msgstr "Η {address} δεν είναι διεύθυνση τομέα RF (4 και 8 δεκαεξαδικά ψηφία, π.χ. 0001:23456789)."

msgid "The domain address of the interface is being set."
msgstr "Η διεύθυνση τομέα της διεπαφής ορίζεται αυτή τη στιγμή."

msgid "The connected USB interface is not a KNX RF interface."
msgstr "Η συνδεδεμένη διεπαφή USB δεν είναι διεπαφή KNX RF."

msgid "The domain address could not be set: {error}"
msgstr "Δεν ήταν δυνατό να οριστεί η διεύθυνση τομέα: {error}"

msgid "Setting the domain address…"
msgstr "Ορισμός της διεύθυνσης τομέα…"

msgid "Local Device Access"
msgstr "Τοπική Πρόσβαση Συσκευής"

msgid "Connects to the KNX device the USB interface is part of (e.g. an actuator with a USB port of its own) instead of the bus. Only this device can then be reached, for downloads and readouts; group telegrams, broadcasts and the bus monitor are not available. Needs a cEMI interface."
msgstr "Συνδέεται με τη συσκευή KNX της οποίας μέρος είναι η διεπαφή USB (π.χ. έναν ενεργοποιητή με δική του θύρα USB) αντί για το bus. Τότε μόνο αυτή η συσκευή είναι προσβάσιμη, για λήψεις και αναγνώσεις· τα τηλεγραφήματα ομάδας, τα broadcast και η παρακολούθηση bus δεν είναι διαθέσιμα. Απαιτεί διεπαφή cEMI."

msgid "Connect to the interface's own device (local device access)"
msgstr "Σύνδεση με τη δική συσκευή της διεπαφής (τοπική πρόσβαση συσκευής)"

msgid "{target}, local device access to {address}"
msgstr "{target}, τοπική πρόσβαση συσκευής στη {address}"

msgid "(address unknown)"
msgstr "(άγνωστη διεύθυνση)"

msgid "Local device access: only this device is reached"
msgstr "Τοπική πρόσβαση συσκευής: μόνο αυτή η συσκευή είναι προσβάσιμη"

msgid "Switching the connection…"
msgstr "Εναλλαγή της σύνδεσης…"

msgid "The connection could not be switched: {error}"
msgstr "Δεν ήταν δυνατή η εναλλαγή της σύνδεσης: {error}"

msgid "The connection of the interface is being switched."
msgstr "Η σύνδεση της διεπαφής εναλλάσσεται αυτή τη στιγμή."

msgid "Through local device access only the USB interface's own device {local} can be reached, not {address}."
msgstr "Μέσω τοπικής πρόσβασης συσκευής είναι προσβάσιμη μόνο η δική συσκευή {local} της διεπαφής USB, όχι η {address}."

msgid "Through local device access only the USB interface's own device {local} can be reached: group telegrams can't be sent."
msgstr "Μέσω τοπικής πρόσβασης συσκευής είναι προσβάσιμη μόνο η δική συσκευή {local} της διεπαφής USB: δεν είναι δυνατή η αποστολή τηλεγραφημάτων ομάδας."

msgid "Through local device access only the USB interface's own device {local} can be reached: broadcasts can't be sent."
msgstr "Μέσω τοπικής πρόσβασης συσκευής είναι προσβάσιμη μόνο η δική συσκευή {local} της διεπαφής USB: δεν είναι δυνατή η αποστολή broadcast."

msgid "Through local device access only the USB interface's own device {local} can be reached: the bus monitor can't run."
msgstr "Μέσω τοπικής πρόσβασης συσκευής είναι προσβάσιμη μόνο η δική συσκευή {local} της διεπαφής USB: η παρακολούθηση bus δεν μπορεί να εκτελεστεί."

msgid "Through local device access only the USB interface's own device {local} can be reached: scan from {local} to {local}."
msgstr "Μέσω τοπικής πρόσβασης συσκευής είναι προσβάσιμη μόνο η δική συσκευή {local} της διεπαφής USB: σαρώστε από {local} έως {local}."

msgid "Protocol"
msgstr "Πρωτόκολλο"

msgid "KNXnet/IP Server"
msgstr "Διακομιστής KNXnet/IP"

msgid "Run a KNXnet/IP server for other tools (USB to IP bridge)"
msgstr "Εκτέλεση διακομιστή KNXnet/IP για άλλα εργαλεία (γέφυρα USB σε IP)"

msgid "Other tools (another editor, Home Assistant, a commissioning tool) connect to it over the network and use this USB interface as a KNXnet/IP interface. Each tunnel gets one of the tunnel addresses, which have to be free addresses of the interface's line. It runs while the editor is connected to the bus through the interface, and opens a network port: turn it on only where that is wanted."
msgstr "Άλλα εργαλεία (άλλος επεξεργαστής, Home Assistant, εργαλείο θέσης σε λειτουργία) συνδέονται σε αυτόν μέσω δικτύου και χρησιμοποιούν αυτή τη διεπαφή USB ως διεπαφή KNXnet/IP. Κάθε σήραγγα λαμβάνει μία από τις διευθύνσεις σηράγγων, οι οποίες πρέπει να είναι ελεύθερες διευθύνσεις της γραμμής της διεπαφής. Εκτελείται όσο ο επεξεργαστής είναι συνδεδεμένος στο bus μέσω της διεπαφής και ανοίγει μια θύρα δικτύου: ενεργοποιήστε τον μόνο όπου αυτό είναι επιθυμητό."

msgid "Port"
msgstr "Θύρα"

msgid "Listen On"
msgstr "Ακρόαση Σε"

msgid "All network interfaces"
msgstr "Όλες οι διεπαφές δικτύου"

