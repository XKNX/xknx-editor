msgid "Gateway"
msgstr "Gateway"

msgid "Connect"
msgstr "Σύνδεση"

msgid "Disconnect"
msgstr "Αποσύνδεση"

msgid "Connect at Startup"
msgstr "Σύνδεση κατά την Εκκίνηση"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Κατά την εκκίνηση, ο επεξεργαστής αναζητά διεπαφές KNX και συνδέεται με αυτή που χρησιμοποιήθηκε τελευταία. Αν απενεργοποιηθεί, συνδέεται μόνο όταν το επιλέξετε."

msgid "Use Serial Number for Downloads"
msgstr "Χρήση Σειριακού Αριθμού για Φορτίσεις"

msgid "Discovered Gateways"
msgstr "Εντοπισμένα Gateway"

msgid "Check for Devices in Programming Mode"
msgstr "Έλεγχος για Συσκευές σε Κατάσταση Προγραμματισμού"

msgid "Devices in Programming Mode"
msgstr "Συσκευές σε Κατάσταση Προγραμματισμού"

msgid "Rescan"
msgstr "Νέα Σάρωση"

msgid "Searching the bus…"
msgstr "Αναζήτηση στο bus…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Πατήστε το πλήκτρο προγραμματισμού μιας συσκευής για να τη θέσετε σε κατάσταση προγραμματισμού και, στη συνέχεια, σαρώστε ξανά."

msgid "No device is in programming mode."
msgstr "Καμία συσκευή δεν είναι σε κατάσταση προγραμματισμού."

msgid "The scan could not be completed: {error}"
msgstr "Η σάρωση δεν ολοκληρώθηκε: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Η θύρα επικοινωνίας δεν επιβεβαίωσε το αίτημα σάρωσης (bus απασχολημένο ή θύρα υπερφορτωμένη). Δοκιμάστε ξανά."

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Απάντησε στη σάρωση, αλλά η ανάγνωση των λεπτομερειών απέτυχε: {error}"

msgid "In this project: {name}"
msgstr "Σε αυτό το έργο: {name}"

msgid "Not in this project"
msgstr "Δεν υπάρχει σε αυτό το έργο"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Μη προγραμματισμένη συσκευή (εργοστασιακή διεύθυνση 15.15.255)"

msgid "Select in Project"
msgstr "Επιλογή στο Έργο"

msgid "Manufacturer"
msgstr "Κατασκευαστής"

msgid "Product (Catalog)"
msgstr "Προϊόν (Κατάλογος)"

msgid "Application"
msgstr "Εφαρμογή"

msgid "Application Version"
msgstr "Έκδοση Εφαρμογής"

msgid "Mask Version"
msgstr "Έκδοση Μάσκας"

msgid "Serial Number"
msgstr "Σειριακός Αριθμός"

msgid "Order Number"
msgstr "Αριθμός Παραγγελίας"

msgid "Hardware Type"
msgstr "Τύπος Υλικού"

msgid "Status"
msgstr "Κατάσταση"

msgid "No fault"
msgstr "Κανένα σφάλμα"

msgid "Programming mode active"
msgstr "Κατάσταση προγραμματισμού ενεργή"

msgid "No gateways found"
msgstr "Δεν βρέθηκαν gateway"

msgid "Manual Connection"
msgstr "Χειροκίνητη Σύνδεση"

msgid "Connected: {ip}"
msgstr "Συνδέθηκε: {ip}"

msgid "Connected to {ip}"
msgstr "Συνδέθηκε με {ip}"

msgid "Disconnected"
msgstr "Αποσυνδέθηκε"

msgid "Connecting…"
msgstr "Σύνδεση…"

msgid "Connection failed"
msgstr "Η σύνδεση απέτυχε"

msgid "Scan"
msgstr "Σάρωση"

msgid "Settings"
msgstr "Ρυθμίσεις"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Χρήση δρομολόγησης multicast (αντί για tunnelling)"

msgid "Gateway IP"
msgstr "IP Gateway"

msgid "Multicast Group"
msgstr "Ομάδα Multicast"

msgid "Apply"
msgstr "Εφαρμογή"

msgid "Bus monitor: {ip}"
msgstr "Παρακολούθηση bus: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Το gateway είναι συνδεδεμένο σε λειτουργία παρακολούθησης bus. Δεν είναι δυνατή η αποστολή ή η φόρτιση μέχρι να σταματήσει η παρακολούθηση bus."

msgid "Not possible while the bus monitor is running"
msgstr "Δεν είναι δυνατό όσο εκτελείται η παρακολούθηση bus"

msgid "Stop Bus Monitor"
msgstr "Διακοπή Παρακολούθησης Bus"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Η θύρα επικοινωνίας απαιτεί KNX IP Secure, αλλά ούτε το έργο ούτε κάποιο φορτωμένο keyring περιέχει τους κωδικούς της."

msgid "Error: {error}"
msgstr "Σφάλμα: {error}"

msgid "Unknown error"
msgstr "Άγνωστο σφάλμα"

msgid "Name: {name}"
msgstr "Όνομα: {name}"

msgid "KNX Address: {address}"
msgstr "Διεύθυνση KNX: {address}"

msgid "Core Version: {version}"
msgstr "Έκδοση Core: {version}"

msgid "Services: {services}"
msgstr "Υπηρεσίες: {services}"

msgid "Retry"
msgstr "Επανάληψη"

msgid "Select Connection"
msgstr "Επιλέξτε σύνδεση"

msgid "XKNX Editor could not determine an available connection."
msgstr "Το XKNX Editor δεν μπόρεσε να καθορίσει μια διαθέσιμη σύνδεση."

msgid "The connection {name} is not available."
msgstr "Η σύνδεση {name} δεν είναι διαθέσιμη."

msgid "You may use any of the connections listed below, instead."
msgstr "Αντ' αυτού, μπορείτε να χρησιμοποιήσετε οποιαδήποτε από τις συνδέσεις που αναφέρονται παρακάτω."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "This kind of connection is not supported."
msgstr "Αυτός ο τύπος σύνδεσης δεν υποστηρίζεται."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Μια συσκευή με γνωστό σειριακό αριθμό λαμβάνει την ατομική της διεύθυνση χωρίς να πατηθεί το κουμπί προγραμματισμού της."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Θύρες επικοινωνίας USB"

msgid "No USB interfaces found"
msgstr "Δεν βρέθηκαν θύρες επικοινωνίας USB"

msgid "Not connected to the bus"
msgstr "Δεν υπάρχει σύνδεση με το bus"

msgid "Serial Number: {serial}"
msgstr "Σειριακός Αριθμός: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} συσκευή σε κατάσταση προγραμματισμού"
msgstr[1] "{count} συσκευές σε κατάσταση προγραμματισμού"

msgid "USB Interface…"
msgstr "Διεπαφή USB…"

msgid "USB Interface"
msgstr "Διεπαφή USB"

msgid "Close"
msgstr "Κλείσιμο"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Μέγιστο Μήκος Τηλεγραφήματος (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Τύπος EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Υποστηριζόμενοι τύποι EMI: {types}"

msgid "Mask Version: {mask}"
msgstr "Έκδοση μάσκας: {mask}"

msgid "Individual Address"
msgstr "Ατομική Διεύθυνση"

msgid "Address Free?"
msgstr "Ελεύθερη Διεύθυνση;"

msgid "The individual address {address} is not used by another device."
msgstr "Η ατομική διεύθυνση {address} δεν χρησιμοποιείται από άλλη συσκευή."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Η ατομική διεύθυνση {address} χρησιμοποιείται ήδη από άλλη συσκευή στον δίαυλο."

msgid "{address} is not an individual address (area.line.device)."
msgstr "Η {address} δεν είναι ατομική διεύθυνση (περιοχή.γραμμή.συσκευή)."

msgid "The individual address of the interface is being set or checked."
msgstr "Η ατομική διεύθυνση της διεπαφής ορίζεται ή ελέγχεται."

msgid "Not connected through a USB interface."
msgstr "Δεν υπάρχει σύνδεση μέσω διεπαφής USB."

msgid "The individual address could not be set: {error}"
msgstr "Δεν ήταν δυνατός ο ορισμός της ατομικής διεύθυνσης: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Δεν ήταν δυνατός ο έλεγχος της ατομικής διεύθυνσης: {error}"

msgid "Setting the individual address…"
msgstr "Ορισμός της ατομικής διεύθυνσης…"

msgid "Checking the individual address on the bus…"
msgstr "Έλεγχος της ατομικής διεύθυνσης στον δίαυλο…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "Μια αλλαγμένη διεύθυνση ορίζεται στη διεπαφή (Enter), η οποία τη διατηρεί."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "Μια αλλαγμένη διεύθυνση ορίζεται στη διεπαφή (Enter). Αυτή η διεπαφή την ξεχνά όταν αποσυνδέεται, γι' αυτό ορίζεται ξανά σε κάθε σύνδεση."
