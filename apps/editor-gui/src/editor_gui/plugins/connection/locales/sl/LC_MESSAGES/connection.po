msgid "Gateway"
msgstr "Prehod"

msgid "Connect"
msgstr "Poveži"

msgid "Disconnect"
msgstr "Prekini povezavo"

msgid "Discovered Gateways"
msgstr "Najdeni prehodi"

msgid "Check for Devices in Programming Mode"
msgstr "Poišči naprave v načinu programiranja"

msgid "No gateways found"
msgstr "Ni najdenih prehodov"

msgid "Manual Connection"
msgstr "Ročna povezava"

msgid "Connected: {ip}"
msgstr "Povezano: {ip}"

msgid "Connected to {ip}"
msgstr "Povezano z {ip}"

msgid "Disconnected"
msgstr "Ni povezave"

msgid "Connecting…"
msgstr "Povezovanje…"

msgid "Connection failed"
msgstr "Povezava ni uspela"

msgid "Scan"
msgstr "Išči"

msgid "Settings"
msgstr "Nastavitve"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Uporabi usmerjanje multicast (namesto tuneliranja)"

msgid "Gateway IP"
msgstr "IP prehoda"

msgid "Multicast Group"
msgstr "Skupina multicast"

msgid "Apply"
msgstr "Uporabi"

msgid "Connect at Startup"
msgstr "Poveži ob zagonu"

msgid "At start, the editor looks for KNX interfaces and connects to the one used last. Turned off, it connects only when you choose."
msgstr "Ob zagonu urejevalnik poišče vmesnike KNX in se poveže z nazadnje uporabljenim. Če je izklopljeno, se poveže le, ko to izberete."

msgid "Use Serial Number for Downloads"
msgstr "Pri programiranju uporabi serijsko številko"

msgid "Bus monitor: {ip}"
msgstr "Monitor vodila: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Prehod je povezan v načinu monitorja vodila. Dokler monitorja vodila ne ustavite, ni mogoče ničesar poslati ali programirati."

msgid "Stop Bus Monitor"
msgstr "Ustavi monitor vodila"

msgid "Not possible while the bus monitor is running"
msgstr "Ni mogoče, dokler deluje monitor vodila"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Naprava se je odzvala na iskanje, vendar branje njenih podrobnosti ni uspelo: {error}"

msgid "Application"
msgstr "Aplikacija"

msgid "Application Version"
msgstr "Različica aplikacije"

msgid "Devices in Programming Mode"
msgstr "Naprave v načinu programiranja"

msgid "Hardware Type"
msgstr "Vrsta strojne opreme"

msgid "In this project: {name}"
msgstr "V tem projektu: {name}"

msgid "Manufacturer"
msgstr "Proizvajalec"

msgid "Mask Version"
msgstr "Različica maske"

msgid "No device is in programming mode."
msgstr "Nobena naprava ni v načinu programiranja."

msgid "No fault"
msgstr "Brez napake"

msgid "Not in this project"
msgstr "Ni v tem projektu"

msgid "Order Number"
msgstr "Naročilna številka"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Pritisnite tipko za programiranje na napravi, da jo preklopite v način programiranja, nato znova iščite."

msgid "Product (Catalog)"
msgstr "Izdelek (katalog)"

msgid "Programming mode active"
msgstr "Način programiranja je vklopljen"

msgid "Rescan"
msgstr "Išči znova"

msgid "Searching the bus…"
msgstr "Iskanje po vodilu…"

msgid "Select in Project"
msgstr "Izberi v projektu"

msgid "Serial Number"
msgstr "Serijska številka"

msgid "Status"
msgstr "Stanje"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Vmesnik ni potrdil zahteve za iskanje (vodilo je zasedeno ali vmesnik preobremenjen). Poskusite znova."

msgid "The scan could not be completed: {error}"
msgstr "Iskanja ni bilo mogoče dokončati: {error}"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Neprogramirana naprava (tovarniški naslov 15.15.255)"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Vmesnik zahteva KNX IP Secure, vendar njegovih gesel nima niti projekt niti naložena zbirka ključev."

msgid "Error: {error}"
msgstr "Napaka: {error}"

msgid "Unknown error"
msgstr "Neznana napaka"

msgid "Name: {name}"
msgstr "Ime: {name}"

msgid "KNX Address: {address}"
msgstr "Naslov KNX: {address}"

msgid "Core Version: {version}"
msgstr "Različica jedra: {version}"

msgid "Services: {services}"
msgstr "Storitve: {services}"

msgid "Retry"
msgstr "Poskusi znova"

msgid "Select Connection"
msgstr "Izbira povezave"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor ni mogel najti razpoložljive povezave."

msgid "The connection {name} is not available."
msgstr "Povezava {name} ni na voljo."

msgid "You may use any of the connections listed below, instead."
msgstr "Namesto nje lahko uporabite katero koli od spodaj navedenih povezav."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Prekliči"

msgid "This kind of connection is not supported."
msgstr "Ta vrsta povezave ni podprta."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Naprava z znano serijsko številko dobi fizični naslov brez pritiska na programirni gumb."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Vmesniki USB"

msgid "No USB interfaces found"
msgstr "Ni najdenih vmesnikov USB"

msgid "Not connected to the bus"
msgstr "Ni povezave z vodilom"

msgid "Serial Number: {serial}"
msgstr "Serijska številka: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} naprava v načinu programiranja"
msgstr[1] "{count} napravi v načinu programiranja"
msgstr[2] "{count} naprave v načinu programiranja"
msgstr[3] "{count} naprav v načinu programiranja"

msgid "USB Interface…"
msgstr "Vmesnik USB…"

msgid "USB Interface"
msgstr "Vmesnik USB"

msgid "Close"
msgstr "Zapri"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Največja Dolžina Telegrama (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Vrsta EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Podprte vrste EMI: {types}"

msgid "Mask Version: {mask}"
msgstr "Različica maske: {mask}"

msgid "Individual Address"
msgstr "Fizični naslov"

msgid "Address Free?"
msgstr "Naslov Prost?"

msgid "The individual address {address} is not used by another device."
msgstr "Fizičnega naslova {address} ne uporablja nobena druga naprava."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Fizični naslov {address} že uporablja druga naprava na vodilu."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} ni fizični naslov (področje.linija.naprava)."

msgid "The individual address of the interface is being set or checked."
msgstr "Fizični naslov vmesnika se nastavlja ali preverja."

msgid "Not connected through a USB interface."
msgstr "Ni povezave prek vmesnika USB."

msgid "The individual address could not be set: {error}"
msgstr "Fizičnega naslova ni bilo mogoče nastaviti: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Fizičnega naslova ni bilo mogoče preveriti: {error}"

msgid "Setting the individual address…"
msgstr "Nastavljanje fizičnega naslova…"

msgid "Checking the individual address on the bus…"
msgstr "Preverjanje fizičnega naslova na vodilu…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Ta vmesnik ob odklopu pozabi svoj fizični naslov, zato se nastavi znova ob vsaki povezavi."