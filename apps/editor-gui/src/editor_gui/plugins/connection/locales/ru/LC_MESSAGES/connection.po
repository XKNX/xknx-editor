msgstr "Нужен хотя бы один адрес туннеля."

msgid "The tunnel address {address} is given twice."
msgstr "Адрес туннеля {address} указан дважды."

msgid "{address} is the individual address of the interface itself."
msgstr "{address} — индивидуальный адрес самого интерфейса."

msgid "{address} is not on the line of the interface ({line})."
msgstr "{address} не находится на линии интерфейса ({line})."

msgid "{address} is the individual address of the device {name}."
msgstr "{address} — индивидуальный адрес устройства {name}."

msgid "{port} is not a port (1 to 65535)."
msgstr "{port} не является портом (от 1 до 65535)."

msgid "The KNXnet/IP server runs only while the editor is connected through a KNX USB interface."
msgstr "Сервер KNXnet/IP работает, только пока редактор подключён через интерфейс KNX USB."

msgid "The KNXnet/IP server doesn't run with local device access: the connection reaches only the interface's own device."
msgstr "Сервер KNXnet/IP не работает при доступе к локальному устройству: подключение достигает только собственного устройства интерфейса."

msgid "The KNXnet/IP server is being started or stopped."
msgstr "Сервер KNXnet/IP сейчас запускается или останавливается."

msgid "The KNXnet/IP server could not start: {error}"
msgstr "Не удалось запустить сервер KNXnet/IP: {error}"

