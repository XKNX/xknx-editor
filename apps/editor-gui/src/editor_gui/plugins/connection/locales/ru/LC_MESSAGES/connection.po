msgstr[0] "Сервер KNXnet/IP на порту {port}, {count} туннель"
msgstr[1] "Сервер KNXnet/IP на порту {port}, {count} туннеля"
msgstr[2] "Сервер KNXnet/IP на порту {port}, {count} туннелей"

