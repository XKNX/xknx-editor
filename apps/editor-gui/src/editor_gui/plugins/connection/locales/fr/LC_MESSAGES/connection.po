msgstr "Application"

msgid "Application Version"
msgstr "Version de l'Application"

msgid "Mask Version"
msgstr "Version de masque"

msgid "Serial Number"
msgstr "Numéro de Série"

msgid "Order Number"
msgstr "Numéro de commande"

msgid "Hardware Type"
msgstr "Type matériel"

msgid "Status"
msgstr "Statut"

msgid "No fault"
msgstr "Aucun défaut"

msgid "Programming mode active"
msgstr "Mode programmation actif"

msgid "No gateways found"
msgstr "Aucune passerelle trouvée"

msgid "Manual Connection"
msgstr "Connexion manuelle"

msgid "Connected: {ip}"
msgstr "Connecté : {ip}"

msgid "Connected to {ip}"
msgstr "Connecté à {ip}"

msgid "Disconnected"
msgstr "Déconnecté"

msgid "Connecting…"
msgstr "Connexion…"

msgid "Connection failed"
msgstr "Échec de la connexion"

msgid "Scan"
msgstr "Scanner"

msgid "Settings"
msgstr "Réglages"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Utiliser le routage multicast (au lieu du tunnel)"

msgid "Gateway IP"
msgstr "IP de la passerelle"

msgid "Multicast Group"
msgstr "Groupe multicast"

msgid "Apply"
msgstr "Appliquer"

msgid "Bus monitor: {ip}"
msgstr "Moniteur de bus : {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "La passerelle est connectée en mode moniteur de bus. Rien ne peut être envoyé ni téléchargé tant que le moniteur de bus n'est pas arrêté."

msgid "Not possible while the bus monitor is running"
msgstr "Impossible tant que le moniteur de bus est actif"

msgid "Stop Bus Monitor"
msgstr "Arrêter le moniteur de bus"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "L'interface exige KNX IP Secure, mais ni le projet ni un trousseau de clés chargé ne contient ses mots de passe."

msgid "Error: {error}"
msgstr "Erreur : {error}"

msgid "Unknown error"
msgstr "Erreur inconnue"

msgid "Name: {name}"
msgstr "Nom : {name}"

msgid "KNX Address: {address}"
msgstr "Adresse KNX : {address}"

msgid "Core Version: {version}"
msgstr "Version du noyau : {version}"

msgid "Services: {services}"
msgstr "Services : {services}"

msgid "Retry"
msgstr "Réessayer"

msgid "Select Connection"
msgstr "Sélectionner la connexion"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor n'a pas pu déterminer de connexion disponible."

msgid "The connection {name} is not available."
msgstr "La connexion {name} n'est pas disponible."

msgid "You may use any of the connections listed below, instead."
msgstr "Vous pouvez utiliser n'importe quelle connexion listée ci-dessous."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Annuler"

msgid "This kind of connection is not supported."
msgstr "Ce type de connexion n'est pas pris en charge."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Un appareil dont le numéro de série est connu reçoit son adresse individuelle sans appuyer sur son bouton de programmation."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfaces USB"

msgid "No USB interfaces found"
msgstr "Aucune interface USB trouvée"

msgid "Not connected to the bus"
msgstr "Non connectée au bus"

msgid "Serial Number: {serial}"
msgstr "Numéro de Série : {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} participant en mode programmation"
msgstr[1] "{count} participants en mode programmation"

msgid "USB Interface…"
msgstr "Interface USB…"

msgid "USB Interface"
msgstr "Interface USB"

msgid "Close"
msgstr "Fermer"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Longueur Maximale des Télégrammes (APDU) : {length}"

msgid "EMI Type: {emi}"
msgstr "Type d'EMI : {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Types d'EMI pris en charge : {types}"

msgid "Mask Version: {mask}"
msgstr "Version du masque : {mask}"

msgid "Individual Address"
msgstr "Adresse Individuelle"

msgid "Address Free?"
msgstr "Adresse Libre ?"

msgid "The individual address {address} is not used by another device."
msgstr "L'adresse individuelle {address} n'est utilisée par aucun autre appareil."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "L'adresse individuelle {address} est déjà utilisée par un autre appareil sur le bus."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} n'est pas une adresse individuelle (zone.ligne.appareil)."

msgid "The individual address of the interface is being set or checked."
msgstr "L'adresse individuelle de l'interface est en cours de définition ou de vérification."

msgid "Not connected through a USB interface."
msgstr "Pas de connexion via une interface USB."

msgid "The individual address could not be set: {error}"
msgstr "Impossible de définir l'adresse individuelle : {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Impossible de vérifier l'adresse individuelle : {error}"

msgid "Setting the individual address…"
msgstr "Définition de l'adresse individuelle…"

msgid "Checking the individual address on the bus…"
msgstr "Vérification de l'adresse individuelle sur le bus…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Cette interface oublie son adresse individuelle lorsqu'elle est débranchée, elle est donc redéfinie à chaque connexion."