msgstr "Rechercher à nouveau"

msgid "Searching the bus…"
msgstr "Recherche sur le bus…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Appuyez sur le bouton de programmation d'un participant pour le mettre en mode programmation, puis relancez la recherche."

msgid "No device is in programming mode."
msgstr "Aucun participant n'est en mode programmation."

msgid "The scan could not be completed: {error}"
msgstr "La recherche n'a pas pu aboutir : {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "L'interface n'a pas confirmé la demande de recherche (bus occupé ou interface surchargée). Veuillez réessayer."

msgid "{count} device(s) in programming mode"
msgstr "{count} participant(s) en mode programmation"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "A répondu à la recherche, mais la lecture de ses détails a échoué : {error}"

