msgstr "Tip hardware"

msgid "In this project: {name}"
msgstr "În acest proiect: {name}"

msgid "Manufacturer"
msgstr "Producător"

msgid "Mask Version"
msgstr "Versiune mască"

msgid "No device is in programming mode."
msgstr "Niciun dispozitiv nu este în modul de programare."

msgid "No fault"
msgstr "Nicio eroare"

msgid "Not in this project"
msgstr "Nu este în acest proiect"

msgid "Order Number"
msgstr "Cod de comandă"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Apăsați butonul de programare al unui dispozitiv pentru a-l trece în modul de programare, apoi scanați din nou."

msgid "Product (Catalog)"
msgstr "Produs (catalog)"

msgid "Programming mode active"
msgstr "Mod de programare activ"

msgid "Rescan"
msgstr "Rescanare"

msgid "Searching the bus…"
msgstr "Se scanează magistrala…"

msgid "Select in Project"
msgstr "Selectare în proiect"

msgid "Serial Number"
msgstr "Număr de serie"

msgid "Status"
msgstr "Stare"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Interfața nu a confirmat cererea de scanare (magistrală ocupată sau interfață supraîncărcată). Încercați din nou."

msgid "The scan could not be completed: {error}"
msgstr "Scanarea nu a putut fi finalizată: {error}"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Dispozitiv neprogramat (adresa implicită din fabrică 15.15.255)"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Interfața necesită KNX IP Secure, dar nici proiectul, nici un keyring încărcat nu conține parolele ei."

msgid "Error: {error}"
msgstr "Eroare: {error}"

msgid "Unknown error"
msgstr "Eroare necunoscută"

msgid "Name: {name}"
msgstr "Nume: {name}"

msgid "KNX Address: {address}"
msgstr "Adresă KNX: {address}"

msgid "Core Version: {version}"
msgstr "Versiune core: {version}"

msgid "Services: {services}"
msgstr "Servicii: {services}"

msgid "Retry"
msgstr "Reîncercare"

msgid "Select Connection"
msgstr "Selectare conexiune"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor nu a putut determina o conexiune disponibilă."

msgid "The connection {name} is not available."
msgstr "Conexiunea {name} nu este disponibilă."

msgid "You may use any of the connections listed below, instead."
msgstr "Puteți folosi în schimb oricare dintre conexiunile de mai jos."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Revocare"

msgid "This kind of connection is not supported."
msgstr "Acest tip de conexiune nu este acceptat."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Un dispozitiv al cărui număr de serie este cunoscut primește adresa fizică fără apăsarea butonului de programare."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfețe USB"

msgid "No USB interfaces found"
msgstr "Nu s-a găsit nicio interfață USB"

msgid "Not connected to the bus"
msgstr "Neconectată la magistrală"

msgid "Serial Number: {serial}"
msgstr "Număr de serie: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} dispozitiv în modul de programare"
msgstr[1] "{count} dispozitive în modul de programare"
msgstr[2] "{count} de dispozitive în modul de programare"

msgid "USB Interface Settings…"
msgstr "Setări Interfață USB…"

msgid "USB Interface Settings"
msgstr "Setări Interfață USB"

msgid "Close"
msgstr "Închidere"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Lungime Maximă a Telegramei (APDU): {length}"

msgid "Individual Address"
msgstr "Adresă fizică"

msgid "Address Free?"
msgstr "Adresă Liberă?"

msgid "The individual address {address} is not used by another device."
msgstr "Adresa fizică {address} nu este folosită de alt dispozitiv."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Adresa fizică {address} este deja folosită de alt dispozitiv de pe magistrală."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} nu este o adresă fizică (zonă.linie.dispozitiv)."

msgid "The individual address of the interface is being set or checked."
msgstr "Adresa fizică a interfeței este în curs de setare sau verificare."

msgid "Not connected through a USB interface."
msgstr "Nu există conexiune printr-o interfață USB."

msgid "The individual address could not be set: {error}"
msgstr "Adresa fizică nu a putut fi setată: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Adresa fizică nu a putut fi verificată: {error}"

msgid "Setting the individual address…"
msgstr "Se setează adresa fizică…"

msgid "Checking the individual address on the bus…"
msgstr "Se verifică adresa fizică pe magistrală…"

msgid "A changed address is set on the interface (Enter), which keeps it."
msgstr "O adresă modificată este setată în interfață (Enter), care o păstrează."

msgid "A changed address is set on the interface (Enter). This interface forgets it when unplugged, so it is set again on every connect."
msgstr "O adresă modificată este setată în interfață (Enter). Această interfață o uită când este deconectată, așa că este setată din nou la fiecare conectare."
