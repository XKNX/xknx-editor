msgstr "Serienummer"

msgid "Order Number"
msgstr "Ordrenummer"

msgid "Hardware Type"
msgstr "Hardwaretype"

msgid "Status"
msgstr "Status"

msgid "No fault"
msgstr "Ingen fejl"

msgid "Programming mode active"
msgstr "Programmeringstilstand aktiv"

msgid "No gateways found"
msgstr "Ingen gateways fundet"

msgid "Manual Connection"
msgstr "Manuel forbindelse"

msgid "Connected: {ip}"
msgstr "Forbundet: {ip}"

msgid "Connected to {ip}"
msgstr "Forbundet til {ip}"

msgid "Disconnected"
msgstr "Ikke forbundet"

msgid "Connecting…"
msgstr "Opretter forbindelse…"

msgid "Connection failed"
msgstr "Forbindelsen mislykkedes"

msgid "Scan"
msgstr "Scan"

msgid "Settings"
msgstr "Indstillinger"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Brug multicast-routing (i stedet for tunneling)"

msgid "Gateway IP"
msgstr "Gateway-IP"

msgid "An open connection to the gateway connects to the new address once it is entered."
msgstr "En åben forbindelse til gatewayen forbinder til den nye adresse, når den er indtastet."

msgid "Use the Project's Bus Connection"
msgstr "Brug projektets busforbindelse"

msgid "While a project is open whose backbone line has a Bus Connection (Topology), the connection goes through it instead of the gateway set here."
msgstr "Mens et projekt er åbent, hvis backbone-linje har en busforbindelse (Topologi), går forbindelsen gennem den i stedet for gatewayen, der er angivet her."

msgid "Multicast Group"
msgstr "Multicast-gruppe"

msgid "Apply"
msgstr "Anvend"

msgid "Bus monitor: {ip}"
msgstr "Busovervågning: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Gatewayen er forbundet i busovervågningstilstand. Intet kan sendes eller downloades, før busovervågningen er stoppet."

msgid "Not possible while the bus monitor is running"
msgstr "Ikke muligt, mens busovervågningen kører"

msgid "Stop Bus Monitor"
msgstr "Stop busovervågning"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Interfacet kræver KNX IP Secure, men hverken projektet eller en indlæst nøglering indeholder dets adgangskoder."

msgid "Error: {error}"
msgstr "Fejl: {error}"

msgid "Unknown error"
msgstr "Ukendt fejl"

msgid "Name: {name}"
msgstr "Navn: {name}"

msgid "KNX Address: {address}"
msgstr "KNX-adresse: {address}"

msgid "Core Version: {version}"
msgstr "Core-version: {version}"

msgid "Services: {services}"
msgstr "Tjenester: {services}"

msgid "Retry"
msgstr "Prøv igen"

msgid "Select Connection"
msgstr "Vælg forbindelse"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor kunne ikke bestemme en tilgængelig forbindelse."

msgid "The connection {name} is not available."
msgstr "Forbindelsen {name} er ikke tilgængelig."

msgid "You may use any of the connections listed below, instead."
msgstr "Du kan i stedet bruge nogen af de forbindelser, der er anført nedenfor."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Annuller"

msgid "This kind of connection is not supported."
msgstr "Denne type forbindelse understøttes ikke."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "En enhed, hvis serienummer er kendt, får sin individuelle adresse uden at trykke på dens programmeringsknap."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "USB-interfaces"

msgid "No USB interfaces found"
msgstr "Ingen USB-interfaces fundet"

msgid "Not connected to the bus"
msgstr "Ikke forbundet til bussen"

msgid "Serial Number: {serial}"
msgstr "Serienummer: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} enhed i programmeringstilstand"
msgstr[1] "{count} enheder i programmeringstilstand"

msgid "USB Interface…"
msgstr "USB-interface…"

msgid "USB Interface"
msgstr "USB-interface"

msgid "Close"
msgstr "Luk"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Maksimal telegramlængde (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "EMI-type: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Understøttede EMI-typer: {types}"

msgid "Mask Version: {mask}"
msgstr "Maskeversion: {mask}"

msgid "Individual Address"
msgstr "Individuel adresse"

msgid "Address Free?"
msgstr "Adresse ledig?"

msgid "The individual address {address} is not used by another device."
msgstr "Den individuelle adresse {address} bruges ikke af en anden enhed."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "Den individuelle adresse {address} bruges allerede af en anden enhed på bussen."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} er ikke en individuel adresse (område.linje.enhed)."

msgid "The individual address of the interface is being set or checked."
msgstr "Interfacets individuelle adresse bliver indstillet eller kontrolleret."

msgid "Not connected through a USB interface."
msgstr "Ikke forbundet via et USB-interface."

msgid "The individual address could not be set: {error}"
msgstr "Den individuelle adresse kunne ikke indstilles: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Den individuelle adresse kunne ikke kontrolleres: {error}"

msgid "Setting the individual address…"
msgstr "Indstiller den individuelle adresse…"

msgid "Checking the individual address on the bus…"
msgstr "Kontrollerer den individuelle adresse på bussen…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Dette interface glemmer sin individuelle adresse, når det tages ud, så den indstilles igen ved hver forbindelse."

msgid "Protected Group Addresses"
msgstr "Beskyttede Gruppeadresser"

msgid "Nothing is ever sent to these group addresses, not even reads, e.g. the ones of gates or an alarm system: addresses like 1/2/3, or groups ending with a slash like 7/0/, separated by spaces. MCP clients can add to the list but not take anything out."
msgstr "Der sendes aldrig noget til disse gruppeadresser, heller ikke læsninger, f.eks. dem til porte eller et alarmsystem: adresser som 1/2/3 eller grupper, der slutter med en skråstreg, som 7/0/, adskilt af mellemrum. MCP-klienter kan tilføje til listen, men ikke fjerne noget."

msgid "Not a group address or group: {entries}"
msgstr "Ikke en gruppeadresse eller gruppe: {entries}"

msgid "Confirmation Timeout (Seconds)"
msgstr "Timeout for bekræftelse (sekunder)"

msgid "How long to wait for the interface to confirm each frame it sends. A slow connection, such as a remote tunnel or a VPN, needs longer."
msgstr "Hvor længe der ventes på, at interfacet bekræfter hver ramme, det sender. En langsom forbindelse, f.eks. en fjerntunnel eller et VPN, kræver længere tid."

msgid "Acknowledgement Timeout (Seconds)"
msgstr "Timeout for kvittering (sekunder)"

msgid "How long to wait for a device to acknowledge a frame of a download before sending it again (up to three times). A device closes the connection after 6 seconds without a frame, so a longer wait only helps where the answers are late, not lost."
msgstr "Hvor længe der ventes på, at en enhed kvitterer for en ramme i en download, før den sendes igen (op til tre gange). En enhed lukker forbindelsen efter 6 sekunder uden ramme, så længere ventetid hjælper kun, når svarene kommer sent, ikke når de går tabt."

msgid "Response Timeout (Seconds)"
msgstr "Timeout for svar (sekunder)"

msgid "How long to wait for a device's answer, e.g. to a memory or property read."
msgstr "Hvor længe der ventes på en enheds svar, f.eks. på en læsning af hukommelse eller en egenskab."

msgid "Medium: {medium}"
msgstr "Medie: {medium}"

msgid "Domain Address"
msgstr "Domæneadresse"

msgid "From Line"
msgstr "Fra linje"

msgid "The interface sends with this domain address and receives only the telegrams of devices with it."
msgstr "Interfacet sender med denne domæneadresse og modtager kun telegrammer fra enheder, der har den."

msgid "{address} is not an RF domain address (4 and 8 hexadecimal digits, e.g. 0001:23456789)."
msgstr "{address} er ikke en RF-domæneadresse (4 og 8 hexadecimale cifre, f.eks. 0001:23456789)."

msgid "The domain address of the interface is being set."
msgstr "Interfacets domæneadresse er ved at blive indstillet."

msgid "The connected USB interface is not a KNX RF interface."
msgstr "Det tilsluttede USB-interface er ikke et KNX RF-interface."

msgid "The domain address could not be set: {error}"
msgstr "Domæneadressen kunne ikke indstilles: {error}"

msgid "Setting the domain address…"
msgstr "Indstiller domæneadressen…"

msgid "Local Device Access"
msgstr "Lokal enhedsadgang"

msgid "Connects to the KNX device the USB interface is part of (e.g. an actuator with a USB port of its own) instead of the bus. Only this device can then be reached, for downloads and readouts; group telegrams, broadcasts and the bus monitor are not available. Needs a cEMI interface."
msgstr "Forbinder til den KNX-enhed, som USB-interfacet er en del af (f.eks. en aktuator med sin egen USB-port), i stedet for til bussen. Kun denne enhed kan så nås, til downloads og udlæsninger; gruppetelegrammer, broadcasts og busovervågningen er ikke tilgængelige. Kræver et cEMI-interface."

msgid "Connect to the interface's own device (local device access)"
msgstr "Forbind til interfacets egen enhed (lokal enhedsadgang)"

msgid "{target}, local device access to {address}"
msgstr "{target}, lokal enhedsadgang til {address}"

msgid "(address unknown)"
msgstr "(adresse ukendt)"

msgid "Local device access: only this device is reached"
msgstr "Lokal enhedsadgang: kun denne enhed nås"

msgid "Switching the connection…"
msgstr "Skifter forbindelsen…"

msgid "The connection could not be switched: {error}"
msgstr "Forbindelsen kunne ikke skiftes: {error}"

msgid "The connection of the interface is being switched."
msgstr "Interfacets forbindelse er ved at blive skiftet."

msgid "Through local device access only the USB interface's own device {local} can be reached, not {address}."
msgstr "Via lokal enhedsadgang kan kun USB-interfacets egen enhed {local} nås, ikke {address}."

msgid "Through local device access only the USB interface's own device {local} can be reached: group telegrams can't be sent."
msgstr "Via lokal enhedsadgang kan kun USB-interfacets egen enhed {local} nås: gruppetelegrammer kan ikke sendes."

msgid "Through local device access only the USB interface's own device {local} can be reached: broadcasts can't be sent."
msgstr "Via lokal enhedsadgang kan kun USB-interfacets egen enhed {local} nås: broadcasts kan ikke sendes."

msgid "Through local device access only the USB interface's own device {local} can be reached: the bus monitor can't run."
msgstr "Via lokal enhedsadgang kan kun USB-interfacets egen enhed {local} nås: busovervågningen kan ikke køre."

msgid "Through local device access only the USB interface's own device {local} can be reached: scan from {local} to {local}."
msgstr "Via lokal enhedsadgang kan kun USB-interfacets egen enhed {local} nås: scan fra {local} til {local}."

msgid "Protocol"
msgstr "Protokol"

msgid "KNXnet/IP Server"
msgstr "KNXnet/IP-server"

msgid "Run a KNXnet/IP server for other tools (USB to IP bridge)"
msgstr "Kør en KNXnet/IP-server for andre værktøjer (USB-til-IP-bro)"

msgid "Other tools (another editor, Home Assistant, a commissioning tool) connect to it over the network and use this USB interface as a KNXnet/IP interface. Each tunnel gets one of the tunnel addresses, which have to be free addresses of the interface's line. It runs while the editor is connected to the bus through the interface, and opens a network port: turn it on only where that is wanted."
msgstr "Andre værktøjer (en anden editor, Home Assistant, et idriftsættelsesværktøj) forbinder til den over netværket og bruger dette USB-interface som et KNXnet/IP-interface. Hver tunnel får en af tunneladresserne, som skal være ledige adresser på interfacets linje. Den kører, mens editoren er forbundet til bussen via interfacet, og åbner en netværksport: slå den kun til, hvor det ønskes."

msgid "Port"
msgstr "Port"

msgid "Listen On"
msgstr "Lyt på"

msgid "All network interfaces"
msgstr "Alle netværksinterfaces"

msgid "This computer only"
msgstr "Kun denne computer"

msgid "Answer searches (discovery)"
msgstr "Besvar søgninger (discovery)"

msgid "Offer TCP"
msgstr "Tilbyd TCP"

msgid "Tunnel Addresses"
msgstr "Tunneladresser"

msgid "Suggest"
msgstr "Foreslå"

msgid "Name"
msgstr "Navn"

msgid "KNXnet/IP server on port {port}, {count} tunnel"
msgid_plural "KNXnet/IP server on port {port}, {count} tunnels"
msgstr[0] "KNXnet/IP-server på port {port}, {count} tunnel"
msgstr[1] "KNXnet/IP-server på port {port}, {count} tunneler"

msgid "The KNXnet/IP server is not running."
msgstr "KNXnet/IP-serveren kører ikke."

msgid "No tunnels open"
msgstr "Ingen åbne tunneler"

msgid "Channel"
msgstr "Kanal"

msgid "Client"
msgstr "Klient"

msgid "Address"
msgstr "Adresse"

msgid "At least one tunnel address is needed."
msgstr "Der kræves mindst én tunneladresse."

msgid "The tunnel address {address} is given twice."
msgstr "Tunneladressen {address} er angivet to gange."

msgid "{address} is the individual address of the interface itself."
msgstr "{address} er selve interfacets individuelle adresse."

msgid "{address} is not on the line of the interface ({line})."
msgstr "{address} er ikke på interfacets linje ({line})."

msgid "{address} is the individual address of the device {name}."
msgstr "{address} er den individuelle adresse for enheden {name}."

msgid "{port} is not a port (1 to 65535)."
msgstr "{port} er ikke en port (1 til 65535)."

msgid "The KNXnet/IP server runs only while the editor is connected through a KNX USB interface."
msgstr "KNXnet/IP-serveren kører kun, mens editoren er forbundet via et KNX USB-interface."

msgid "The KNXnet/IP server doesn't run with local device access: the connection reaches only the interface's own device."
msgstr "KNXnet/IP-serveren kører ikke med lokal enhedsadgang: forbindelsen når kun interfacets egen enhed."

msgid "The KNXnet/IP server is being started or stopped."
msgstr "KNXnet/IP-serveren er ved at blive startet eller stoppet."

msgid "The KNXnet/IP server could not start: {error}"
msgstr "KNXnet/IP-serveren kunne ikke starte: {error}"
