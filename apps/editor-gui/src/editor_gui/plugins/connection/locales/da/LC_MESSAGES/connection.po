msgid "Gateway"
msgstr "Gateway"

msgid "Connect"
msgstr "Opret forbindelse"

msgid "Disconnect"
msgstr "Afbryd forbindelse"

msgid "Use Serial Number for Downloads"
msgstr "Brug serienummer til downloads"

msgid "Discovered Gateways"
msgstr "Fundne gateways"

msgid "Diagnostics"
msgstr "Diagnosticering"

msgid "Check for Devices in Programming Mode"
msgstr "Søg efter enheder i programmeringstilstand"

msgid "Devices in Programming Mode"
msgstr "Enheder i programmeringstilstand"

msgid "Rescan"
msgstr "Søg igen"

msgid "Searching the bus…"
msgstr "Gennemsøger bussen…"

msgid "Press the programming button on a device to put it into programming mode, then rescan."
msgstr "Tryk på programmeringsknappen på en enhed for at sætte den i programmeringstilstand, og søg derefter igen."

msgid "No device is in programming mode."
msgstr "Ingen enhed er i programmeringstilstand."

msgid "The scan could not be completed: {error}"
msgstr "Søgningen kunne ikke gennemføres: {error}"

msgid "The interface did not confirm the scan request (bus busy or interface overloaded). Please try again."
msgstr "Interfacet bekræftede ikke søgeanmodningen (bussen optaget eller interfacet overbelastet). Prøv igen."

msgid "{count} device(s) in programming mode"
msgstr "{count} enhed(er) i programmeringstilstand"

msgid "Answered the scan, but reading its details failed: {error}"
msgstr "Svarede på søgningen, men læsning af detaljerne mislykkedes: {error}"

msgid "In this project: {name}"
msgstr "I dette projekt: {name}"

msgid "Not in this project"
msgstr "Ikke i dette projekt"

msgid "Unprogrammed device (factory default address 15.15.255)"
msgstr "Uprogrammeret enhed (fabriksadresse 15.15.255)"

msgid "Select in Project"
msgstr "Vælg i projekt"

msgid "Manufacturer"
msgstr "Producent"

msgid "Product (Catalog)"
msgstr "Produkt (katalog)"

msgid "Application"
msgstr "Applikation"

msgid "Application Version"
msgstr "Applikationsversion"

msgid "Mask Version"
msgstr "Maskeversion"

msgid "Serial Number"
msgstr "Serienummer"

msgid "Order Number"
msgstr "Ordrenummer"

msgid "Hardware Type"
msgstr "Hardwaretype"

msgid "Status"
msgstr "Status"

msgid "No fault"
msgstr "Ingen fejl"

msgid "Programming mode active"
msgstr "Programmeringstilstand aktiv"

msgid "No gateways found"
msgstr "Ingen gateways fundet"

msgid "Manual Connection"
msgstr "Manuel forbindelse"

msgid "Connected: {ip}"
msgstr "Forbundet: {ip}"

msgid "Connected to {ip}"
msgstr "Forbundet til {ip}"

msgid "Disconnected"
msgstr "Ikke forbundet"

msgid "Connecting…"
msgstr "Opretter forbindelse…"

msgid "Connection failed"
msgstr "Forbindelsen mislykkedes"

msgid "Scan"
msgstr "Scan"

msgid "Settings"
msgstr "Indstillinger"

msgid "Use multicast routing (instead of tunneling)"
msgstr "Brug multicast-routing (i stedet for tunneling)"

msgid "Gateway IP"
msgstr "Gateway-IP"

msgid "Multicast Group"
msgstr "Multicast-gruppe"

msgid "Apply"
msgstr "Anvend"

msgid "Bus monitor: {ip}"
msgstr "Busovervågning: {ip}"

msgid "The gateway is connected in bus monitor mode. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Gatewayen er forbundet i busovervågningstilstand. Intet kan sendes eller downloades, før busovervågningen er stoppet."

msgid "Not possible while the bus monitor is running"
msgstr "Ikke muligt, mens busovervågningen kører"

msgid "Stop Bus Monitor"
msgstr "Stop busovervågning"

msgid "The interface requires KNX IP Secure, but neither the project nor a loaded keyring has its passwords."
msgstr "Interfacet kræver KNX IP Secure, men hverken projektet eller en indlæst nøglering indeholder dets adgangskoder."

msgid "Error: {error}"
msgstr "Fejl: {error}"

msgid "Unknown error"
msgstr "Ukendt fejl"

msgid "Name: {name}"
msgstr "Navn: {name}"

msgid "KNX Address: {address}"
msgstr "KNX-adresse: {address}"

msgid "Core Version: {version}"
msgstr "Core-version: {version}"

msgid "Services: {services}"
msgstr "Tjenester: {services}"

msgid "Retry"
msgstr "Prøv igen"

msgid "Select Connection"
msgstr "Vælg forbindelse"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor kunne ikke bestemme en tilgængelig forbindelse."

msgid "The connection {name} is not available."
msgstr "Forbindelsen {name} er ikke tilgængelig."

msgid "You may use any of the connections listed below, instead."
msgstr "Du kan i stedet bruge nogen af de forbindelser, der er anført nedenfor."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Annuller"

msgid "This kind of connection is not supported."
msgstr "Denne type forbindelse understøttes ikke."
