msgstr "Servizi: {services}"

msgid "Retry"
msgstr "Riprova"

msgid "Select Connection"
msgstr "Seleziona connessione"

msgid "XKNX Editor could not determine an available connection."
msgstr "XKNX Editor non può determinare una connessione disponibile."

msgid "The connection {name} is not available."
msgstr "La connessione {name} non è disponibile."

msgid "You may use any of the connections listed below, instead."
msgstr "È possibile utilizzare invece una qualsiasi delle connessioni elencate di seguito."

msgid "{name}: {error}"
msgstr "{name}: {error}"

msgid "Cancel"
msgstr "Annulla"

msgid "This kind of connection is not supported."
msgstr "Questo tipo di connessione non è supportato."

msgid "UDP tunneling"
msgstr "UDP tunneling"

msgid "TCP tunneling"
msgstr "TCP tunneling"

msgid "Routing"
msgstr "Routing"

msgid "USB"
msgstr "USB"

msgid "A device whose serial number is known gets its individual address without pressing its programming button."
msgstr "Un dispositivo con numero di serie noto riceve il proprio indirizzo individuale senza premere il suo tasto di programmazione."

msgid "Connection Type"
msgstr "Connection Type"

msgid "Applies on the next connect, like the Gateway menu's choice."
msgstr "Applies on the next connect, like the Gateway menu's choice."

msgid "USB Interfaces"
msgstr "Interfacce USB"

msgid "No USB interfaces found"
msgstr "Nessuna interfaccia USB trovata"

msgid "Not connected to the bus"
msgstr "Non collegata al bus"

msgid "Serial Number: {serial}"
msgstr "Numero Seriale: {serial}"

msgid "{count} device in programming mode"
msgid_plural "{count} devices in programming mode"
msgstr[0] "{count} dispositivo in modalità di programmazione"
msgstr[1] "{count} dispositivi in modalità di programmazione"

msgid "USB Interface…"
msgstr "Interfaccia USB…"

msgid "USB Interface"
msgstr "Interfaccia USB"

msgid "Close"
msgstr "Chiudi"

msgid "Maximum Telegram Length (APDU): {length}"
msgstr "Lunghezza massima del telegramma (APDU): {length}"

msgid "EMI Type: {emi}"
msgstr "Tipo EMI: {emi}"

msgid "Supported EMI Types: {types}"
msgstr "Tipi EMI supportati: {types}"

msgid "Mask Version: {mask}"
msgstr "Versione maschera: {mask}"

msgid "Individual Address"
msgstr "Indirizzo individuale"

msgid "Address Free?"
msgstr "Indirizzo libero?"

msgid "The individual address {address} is not used by another device."
msgstr "L'indirizzo individuale {address} non è usato da nessun altro dispositivo."

msgid "The individual address {address} is already in use by another device on the bus."
msgstr "L'indirizzo individuale {address} è già usato da un altro dispositivo sul bus."

msgid "{address} is not an individual address (area.line.device)."
msgstr "{address} non è un indirizzo individuale (area.linea.dispositivo)."

msgid "The individual address of the interface is being set or checked."
msgstr "L'indirizzo individuale dell'interfaccia è in fase di impostazione o verifica."

msgid "Not connected through a USB interface."
msgstr "Non connesso tramite un'interfaccia USB."

msgid "The individual address could not be set: {error}"
msgstr "Impossibile impostare l'indirizzo individuale: {error}"

msgid "The individual address could not be checked: {error}"
msgstr "Impossibile verificare l'indirizzo individuale: {error}"

msgid "Setting the individual address…"
msgstr "Impostazione dell'indirizzo individuale…"

msgid "Checking the individual address on the bus…"
msgstr "Verifica dell'indirizzo individuale sul bus…"

msgid "This interface forgets its individual address when unplugged, so it is set again on every connect."
msgstr "Questa interfaccia dimentica il proprio indirizzo individuale quando viene scollegata, quindi viene reimpostato a ogni connessione."