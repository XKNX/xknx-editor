msgstr "{rate} т/с"

msgid "Group Address:"
msgstr "Групповой адрес:"

msgid "e.g. 1/2/3"
msgstr "напр. 1/2/3"

msgid "Enter a group address of the project to send to it."
msgstr "Введите групповой адрес проекта, чтобы отправить на него."

msgid "Start"
msgstr "Старт"

msgid "Stop"
msgstr "Стоп"

msgid "Import"
msgstr "Импорт"

msgid "Export"
msgstr "Экспорт"

msgid "Print"
msgstr "Печать"

msgid "Replay Telegrams"
msgstr "Воспроизвести телеграммы"

msgid "Stop Replay"
msgstr "Остановить воспроизведение"

msgid "Start recording the group telegrams"
msgstr "Начать запись групповых телеграмм"

msgid "Start recording the connection's communication other than group telegrams, including every frame this app sends"
msgstr "Начать запись обмена данными соединения, кроме групповых телеграмм, включая все кадры, отправляемые этим приложением"

msgid "Connect the interface in bus monitor mode and record every frame"
msgstr "Подключить интерфейс в режиме мониторинга шин и записывать каждый кадр"

msgid "Stop recording"
msgstr "Остановить запись"

msgid "Close the bus monitor connection and restore the normal connection"
msgstr "Закрыть соединение мониторинга шин и восстановить обычное соединение"

msgid "Remove all telegrams"
msgstr "Удалить все телеграммы"

msgid "Load a recording"
msgstr "Загрузить запись"

msgid "Save the telegrams to a file"
msgstr "Сохранить телеграммы в файл"

msgid "Print the telegrams as a PDF document"
msgstr "Напечатать телеграммы как документ PDF"

msgid "Send the selected group telegrams (all if none is selected) again with their original timing"
msgstr "Снова отправить выбранные групповые телеграммы (все, если ничего не выбрано) с исходными интервалами"

msgid "Cancel the replay"
msgstr "Отменить воспроизведение"

msgid "Copy"
msgstr "Копировать"

msgid "Copy the selected telegrams (all shown if none is selected) to the clipboard ({shortcut}). Double-click a telegram to select its source device."
msgstr "Копировать выбранные телеграммы (все показанные, если ничего не выбрано) в буфер обмена ({shortcut}). Двойной щелчок по телеграмме выбирает её устройство-источник."

msgid "Rec."
msgstr "Зап."

msgid "Stopped"
msgstr "Остановлено"

msgid "Replaying {done}/{total}"
msgstr "Воспроизведение {done}/{total}"

msgid "Connecting in bus monitor mode…"
msgstr "Подключение в режиме мониторинга шин…"

msgid "Closing the bus monitor connection…"
msgstr "Закрытие соединения мониторинга шин…"

msgid "Bus monitor mode: the normal connection is closed. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Режим мониторинга шин: обычное соединение закрыто. Пока мониторинг шин не остановлен, ничего нельзя отправить или загрузить."

msgid "Start Bus Monitor"
msgstr "Запустить мониторинг шин"

msgid "The bus monitor connects the interface in bus monitor mode. The normal connection is closed while the bus monitor runs: nothing can be sent or downloaded in that time. Stopping the bus monitor restores the normal connection.\n\nStart the bus monitor?"
msgstr "Мониторинг шин подключает интерфейс в режиме мониторинга шин. Пока он работает, обычное соединение закрыто: в это время ничего нельзя отправить или загрузить. После остановки мониторинга шин обычное соединение восстанавливается.\n\nЗапустить мониторинг шин?"

msgid "The bus monitor is not supported for this connection type. It needs a tunnelling connection."
msgstr "Мониторинг шин не поддерживается для этого типа подключения. Для него требуется туннельное подключение."

msgid "The interface does not support bus monitor mode."
msgstr "Интерфейс не поддерживает режим мониторинга шин."

msgid "The interface rejected bus monitor mode: another client holds a connection to it."
msgstr "Интерфейс отклонил режим мониторинга шин: к нему подключён другой клиент."

msgid "The bus monitor connection could not be established."
msgstr "Не удалось установить соединение мониторинга шин."

msgid "The normal connection is restored."
msgstr "Обычное соединение восстановлено."

msgid "Unsaved Telegrams"
msgstr "Несохранённые телеграммы"

msgid "The telegrams have not been exported. Clear them anyway?"
msgstr "Телеграммы не экспортированы. Всё равно очистить?"

msgid "The telegrams have not been exported. Loading a recording replaces them and stops the recording. Continue?"
msgstr "Телеграммы не экспортированы. Загрузка записи заменит их и остановит запись. Продолжить?"

msgid "Loading a recording replaces the telegrams and stops the recording. Continue?"
msgstr "Загрузка записи заменит телеграммы и остановит запись. Продолжить?"

