msgstr "esim. 1/2/3"

msgid "Enter a group address of the project to send to it."
msgstr "Anna projektin ryhmäosoite, johon lähetetään."

msgid "Start"
msgstr "Käynnistä"

msgid "Stop"
msgstr "Pysäytä"

msgid "Import"
msgstr "Tuo"

