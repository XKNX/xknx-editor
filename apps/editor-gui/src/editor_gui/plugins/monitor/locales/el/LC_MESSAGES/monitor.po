msgstr "Έναρξη"

msgid "Stop"
msgstr "Διακοπή"

msgid "Import"
msgstr "Εισαγωγή"

msgid "Export"
msgstr "Εξαγωγή"

msgid "Print"
msgstr "Εκτύπωση"

msgid "Replay Telegrams"
msgstr "Αναπαραγωγή Τηλεγραφημάτων"

msgid "Stop Replay"
msgstr "Διακοπή Αναπαραγωγής"

msgid "Start recording the group telegrams"
msgstr "Έναρξη καταγραφής των τηλεγραφημάτων ομάδας"

msgid "Start recording the connection's communication other than group telegrams, including every frame this app sends"
msgstr "Έναρξη καταγραφής της επικοινωνίας της σύνδεσης εκτός των τηλεγραφημάτων ομάδας, συμπεριλαμβανομένου κάθε πλαισίου που στέλνει αυτή η εφαρμογή"

msgid "Connect the interface in bus monitor mode and record every frame"
msgstr "Σύνδεση της θύρας επικοινωνίας σε λειτουργία παρακολούθησης bus και καταγραφή κάθε πλαισίου"

msgid "Stop recording"
msgstr "Διακοπή καταγραφής"

msgid "Close the bus monitor connection and restore the normal connection"
msgstr "Κλείσιμο της σύνδεσης παρακολούθησης bus και επαναφορά της κανονικής σύνδεσης"

msgid "Remove all telegrams"
msgstr "Αφαίρεση όλων των τηλεγραφημάτων"

msgid "Load a recording"
msgstr "Φόρτωση καταγραφής"

msgid "Save the telegrams to a file"
msgstr "Αποθήκευση των τηλεγραφημάτων σε αρχείο"

msgid "Print the telegrams as a PDF document"
msgstr "Εκτύπωση των τηλεγραφημάτων ως έγγραφο PDF"

msgid "Send the selected group telegrams (all if none is selected) again with their original timing"
msgstr "Επαναποστολή των επιλεγμένων τηλεγραφημάτων ομάδας (όλων, αν δεν έχει επιλεγεί κανένα) με τον αρχικό τους χρονισμό"

msgid "Cancel the replay"
msgstr "Ακύρωση της αναπαραγωγής"

msgid "Copy"
msgstr "Αντιγραφή"

msgid "Copy the selected telegrams (all shown if none is selected) to the clipboard ({shortcut}). Double-click a telegram to select its source device."
msgstr "Αντιγραφή των επιλεγμένων τηλεγραφημάτων (όλων των εμφανιζόμενων, αν δεν έχει επιλεγεί κανένα) στο πρόχειρο ({shortcut}). Με διπλό κλικ σε ένα τηλεγράφημα επιλέγεται η συσκευή προέλευσής του."

msgid "Rec."
msgstr "Καταγρ."

msgid "Stopped"
msgstr "Σταματημένο"

msgid "Replaying {done}/{total}"
msgstr "Αναπαραγωγή {done}/{total}"

msgid "Connecting in bus monitor mode…"
msgstr "Σύνδεση σε λειτουργία παρακολούθησης bus…"

msgid "Closing the bus monitor connection…"
msgstr "Κλείσιμο της σύνδεσης παρακολούθησης bus…"

msgid "Bus monitor mode: the normal connection is closed. Nothing can be sent or downloaded until the bus monitor is stopped."
msgstr "Λειτουργία παρακολούθησης bus: η κανονική σύνδεση είναι κλειστή. Δεν είναι δυνατή η αποστολή ή η φόρτιση μέχρι να σταματήσει η παρακολούθηση bus."

msgid "Start Bus Monitor"
msgstr "Έναρξη Παρακολούθησης Bus"

msgid "The bus monitor connects the interface in bus monitor mode. The normal connection is closed while the bus monitor runs: nothing can be sent or downloaded in that time. Stopping the bus monitor restores the normal connection.\n\nStart the bus monitor?"
msgstr "Η παρακολούθηση bus συνδέει τη θύρα επικοινωνίας σε λειτουργία παρακολούθησης bus. Η κανονική σύνδεση κλείνει όσο εκτελείται η παρακολούθηση bus: σε αυτό το διάστημα δεν είναι δυνατή η αποστολή ή η φόρτιση. Με τη διακοπή της παρακολούθησης bus αποκαθίσταται η κανονική σύνδεση.\n\nΈναρξη παρακολούθησης bus;"

msgid "The bus monitor is not supported for this connection type. It needs a tunnelling connection."
msgstr "Η παρακολούθηση bus δεν υποστηρίζεται για αυτόν τον τύπο σύνδεσης. Απαιτεί σύνδεση tunnelling."

msgid "The interface does not support bus monitor mode."
msgstr "Η θύρα επικοινωνίας δεν υποστηρίζει τη λειτουργία παρακολούθησης bus."

msgid "The interface rejected bus monitor mode: another client holds a connection to it."
msgstr "Η θύρα επικοινωνίας απέρριψε τη λειτουργία παρακολούθησης bus: άλλος client διατηρεί σύνδεση με αυτήν."

msgid "The bus monitor connection could not be established."
msgstr "Δεν ήταν δυνατή η δημιουργία της σύνδεσης παρακολούθησης bus."

msgid "The normal connection is restored."
msgstr "Η κανονική σύνδεση αποκαταστάθηκε."

msgid "Unsaved Telegrams"
msgstr "Μη Αποθηκευμένα Τηλεγραφήματα"

msgid "The telegrams have not been exported. Clear them anyway?"
msgstr "Τα τηλεγραφήματα δεν έχουν εξαχθεί. Να διαγραφούν παρ' όλα αυτά;"

msgid "The telegrams have not been exported. Loading a recording replaces them and stops the recording. Continue?"
msgstr "Τα τηλεγραφήματα δεν έχουν εξαχθεί. Η φόρτωση μιας καταγραφής τα αντικαθιστά και διακόπτει την καταγραφή. Συνέχεια;"

msgid "Loading a recording replaces the telegrams and stops the recording. Continue?"
msgstr "Η φόρτωση μιας καταγραφής αντικαθιστά τα τηλεγραφήματα και διακόπτει την καταγραφή. Συνέχεια;"

