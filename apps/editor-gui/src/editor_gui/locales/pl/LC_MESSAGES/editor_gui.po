msgid "Port {port} is already in use by another program, so the MCP server cannot start. Choose another port, or end the other program."
msgstr "Port {port} jest już używany przez inny program, więc nie można uruchomić serwera MCP. Należy wybrać inny port lub zamknąć drugi program."

msgid "The MCP server could not start: {error}"
msgstr "Nie można uruchomić serwera MCP: {error}"

msgid "Start Server"
msgstr "Uruchom serwer"

msgid "Stop Server"
msgstr "Zatrzymaj serwer"

msgid "AI MCP"
msgstr "AI MCP"

msgid "This editor is controllable by an AI assistant (Claude, Codex, …) through the built-in MCP server: it exposes the catalog and project as tools over Streamable HTTP. Start the server below, then register its endpoint in your AI tool."
msgstr "Tym edytorem może sterować asystent AI (Claude, Codex, …) przez wbudowany serwer MCP: udostępnia on katalog i projekt jako narzędzia przez Streamable HTTP. Należy uruchomić serwer poniżej, a następnie zarejestrować jego punkt końcowy w narzędziu AI."

msgid "MCP Endpoint"
msgstr "Punkt końcowy MCP"

msgid "Example: register the MCP server in your AI tool (adjust host/port):"
msgstr "Przykład: rejestracja serwera MCP w narzędziu AI (dostosować host/port):"

msgid "Use host 0.0.0.0 to make the server reachable from other devices on the network; 127.0.0.1/localhost only allows this machine."
msgstr "Host 0.0.0.0 udostępnia serwer innym urządzeniom w sieci; 127.0.0.1/localhost ogranicza dostęp do tego komputera."

msgid "claude mcp add --transport http xknx-editor {url}"
msgstr "claude mcp add --transport http xknx-editor {url}"

