msgstr "1/3 - Ім'я групової адреси/Головна - Середня - Підгрупа"

msgid "1/1 - Name/Address"
msgstr "1/1 - Ім'я/Адреса"

msgid "3/3 - Main - Middle - Sub group name/Main - Middle - Sub group address"
msgstr "3/3 - Головна - Середня - Ім'я підгрупи/Головна - Середня - Адреса підгрупи"

msgid "Export with Header Line"
msgstr "Експорт з рядком назв"

