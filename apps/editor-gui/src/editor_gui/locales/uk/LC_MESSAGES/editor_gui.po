msgstr "Вибрати все"

msgid "Long-press in the field below and choose Paste."
msgstr "Натисніть і утримуйте поле нижче та виберіть «Вставити»."

msgid "Too many wrong passwords. Please try again in a few minutes."
msgstr "Забагато неправильних паролів. Спробуйте ще раз за кілька хвилин."

msgid "Port {port} is already in use by another program, so the browser UI cannot start there. Start it with another port (e.g. --web={example}) or without a port to take a free one."
msgstr "Порт {port} уже використовується іншою програмою, тому інтерфейс браузера не може там запуститися. Запустіть його з іншим портом (напр. --web={example}) або без порту, щоб використати вільний."

msgid "Open in Browser"
msgstr "Відкрити в браузері"

msgid "Stop XKNX Editor"
msgstr "Зупинити XKNX Editor"

msgid "XKNX Editor Already Running"
msgstr "XKNX Editor уже запущено"

