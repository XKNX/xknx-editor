msgid "Version {version}"
msgstr "Версія {version}"

msgid "A desktop editor for building-automation installation projects, built on the open-source xknx library and based on xknxtoolkit by kewde. Not affiliated with or endorsed by the KNX Association."
msgstr "Настільний редактор проєктів інсталяцій автоматизації будівель, створений на основі бібліотеки з відкритим кодом xknx та xknxtoolkit від kewde. Не пов'язаний з KNX Association і не схвалений нею."

msgid "Network Location"
msgstr "Мережеве розташування"

msgid "This location is on a network drive:\n{home}\n\nKNX project files use a database that cannot run reliably on network shares. The editor can work on a local copy instead and write it back to the network location when you close the project."
msgstr "Це розташування знаходиться на мережевому диску:\n{home}\n\nФайли проєктів KNX використовують базу даних, яка не може надійно працювати в мережевих папках. Натомість редактор може працювати з локальною копією та записати її назад у мережеве розташування, коли ви закриєте проєкт."

msgid "Use a Local Copy"
msgstr "Використати локальну копію"

msgid "Working on a local copy; written back to {home} when you close the project."
msgstr "Робота з локальною копією; її буде записано назад у {home}, коли ви закриєте проєкт."

