msgid "Your project opened fine and everything you need to work with is here. A few extra details from the original file are shown a bit more simply:"
msgstr "Το έργο σας άνοιξε κανονικά και ό,τι χρειάζεστε για να εργαστείτε είναι εδώ. Μερικές επιπλέον λεπτομέρειες από το αρχικό αρχείο εμφανίζονται λίγο πιο απλά:"

msgid "This project came from a file with a few extra details this editor does not use. The export leaves these out:"
msgstr "Αυτό το έργο προέρχεται από ένα αρχείο με μερικές επιπλέον λεπτομέρειες που αυτός ο επεξεργαστής δεν χρησιμοποιεί. Η εξαγωγή τις παραλείπει:"

msgid "The original file had {count} installations. They were combined into one."
msgstr "Το αρχικό αρχείο είχε {count} εγκαταστάσεις. Συνδυάστηκαν σε μία."

msgid "{count} device(s) aren't assigned to a line. They're kept in the project and included on export, but can't be edited here yet."
msgstr "{count} συσκευή(-ές) δεν είναι αντιστοιχισμένες σε γραμμή. Διατηρούνται στο έργο και περιλαμβάνονται στην εξαγωγή, αλλά δεν μπορούν ακόμη να επεξεργαστούν εδώ."

msgid "{count} group object(s) had an extra description in the original file. The custom name and function are kept; only that description is not shown here."
msgstr "{count} αντικείμενο(-α) επικοινωνίας είχαν μια επιπλέον περιγραφή στο αρχικό αρχείο. Το προσαρμοσμένο όνομα και η λειτουργία διατηρούνται· μόνο αυτή η περιγραφή δεν εμφανίζεται εδώ."

msgid "For example: {examples}"
msgstr "Για παράδειγμα: {examples}"

msgid "{count} IP or function setting(s) from the original file are not used here."
msgstr "{count} ρύθμιση(-εις) IP ή λειτουργίας από το αρχικό αρχείο δεν χρησιμοποιούνται εδώ."

msgid "{count} line(s) use several segments. In a schema 14/20 export they are shown at line level only."
msgstr "{count} γραμμή(-ές) χρησιμοποιούν πολλά τμήματα. Σε εξαγωγή με σχήμα 14/20 εμφανίζονται μόνο σε επίπεδο γραμμής."

msgid "{count} line(s) had the same address in different installations. One of each was kept when combining."
msgstr "{count} γραμμή(-ές) είχαν την ίδια διεύθυνση σε διαφορετικές εγκαταστάσεις. Κατά τον συνδυασμό διατηρήθηκε μία από την καθεμία."

msgid "Exporting {name} — this can take a while for large projects."
msgstr "Εξαγωγή του {name} — αυτό μπορεί να διαρκέσει λίγο σε μεγάλα έργα."

msgid "Collecting the manufacturer data…"
msgstr "Συλλογή των δεδομένων κατασκευαστή…"

msgid "Writing the archive…"
msgstr "Εγγραφή του αρχείου…"

msgid "Getting the certificate from MyKNX…"
msgstr "Λήψη του πιστοποιητικού από το MyKNX…"

msgid "Cancelling…"
msgstr "Ακύρωση…"

msgid "Export cancelled, no file was written"
msgstr "Η εξαγωγή ακυρώθηκε, δεν γράφτηκε κανένα αρχείο"

msgid "Export Failed"
msgstr "Η Εξαγωγή Απέτυχε"

msgid "The project could not be exported to {name}."
msgstr "Δεν ήταν δυνατή η εξαγωγή του έργου στο {name}."

msgid "MyKNX did not issue the certificate for the project:"
msgstr "Το MyKNX δεν εξέδωσε το πιστοποιητικό για το έργο:"

msgid "To export without it, choose 'Export Without Certificate' or the 'License with a Dongle' tab in the Sign Export window."
msgstr "Για εξαγωγή χωρίς αυτό, επιλέξτε «Εξαγωγή Χωρίς Πιστοποιητικό» ή την καρτέλα «Άδεια με Dongle» στο παράθυρο «Υπογραφή Εξαγωγής»."

msgid "{name} cannot be imported."
msgstr "Δεν είναι δυνατή η εισαγωγή του {name}."

msgid "The file was written, but it refers to product data that is not in the catalog: {references}. Add these products to the catalog and export again."
msgstr "Το αρχείο γράφτηκε, αλλά αναφέρεται σε δεδομένα προϊόντων που δεν υπάρχουν στον κατάλογο: {references}. Προσθέστε αυτά τα προϊόντα στον κατάλογο και κάντε ξανά εξαγωγή."

msgid "Sign Export"
msgstr "Υπογραφή Εξαγωγής"

msgid "ETS 6: needs a licensed .knxproj through a MyKNX login or a dongle.\nETS 5: just use 'Export Without Certificate'."
msgstr "ETS 6: απαιτεί αδειοδοτημένο .knxproj μέσω σύνδεσης MyKNX ή dongle.\nETS 5: απλώς χρησιμοποιήστε την «Εξαγωγή Χωρίς Πιστοποιητικό»."

msgid "Sign with MyKNX Login"
msgstr "Υπογραφή με Σύνδεση MyKNX"

msgid "License with a Dongle"
msgstr "Άδεια με Dongle"

msgid "ETS must not be running on any computer with this MyKNX account while you log in and export here."
msgstr "Το ETS δεν πρέπει να εκτελείται σε κανέναν υπολογιστή με αυτόν τον λογαριασμό MyKNX όσο συνδέεστε και κάνετε εξαγωγή εδώ."

msgid "MyKNX Username"
msgstr "Όνομα Χρήστη MyKNX"

msgid "MyKNX Password"
msgstr "Κωδικός MyKNX"

msgid "Log in"
msgstr "Σύνδεση"

msgid "Complete sign-in in your browser. Code: {code}"
msgstr "Ολοκληρώστε τη σύνδεση στο πρόγραμμα περιήγησής σας. Κωδικός: {code}"

msgid "Login failed (HTTP 401). Either the password is wrong, or this account uses two-factor authentication - the server does not say which."
msgstr "Η σύνδεση απέτυχε (HTTP 401). Είτε ο κωδικός είναι λάθος είτε αυτός ο λογαριασμός χρησιμοποιεί έλεγχο ταυτότητας δύο παραγόντων - ο διακομιστής δεν αναφέρει ποιο από τα δύο."

msgid "Re-enter Credentials"
msgstr "Επανεισαγωγή Διαπιστευτηρίων"

msgid "Start 2FA Sign-In"
msgstr "Έναρξη Σύνδεσης 2FA"

msgid "MyKNX OAuth Credentials (2FA)"
msgstr "Διαπιστευτήρια OAuth MyKNX (2FA)"

msgid "Needed only for accounts with two-factor authentication. The 2FA sign-in opens in your browser automatically when a normal login is rejected. Enter the OAuth client id/secret, or extract them from your installed ETS: pick 'Knx.Ets.MyKnx.dll' from the ETS program folder (e.g. C:\\Program Files (x86)\\ETS6\\Knx.Ets.MyKnx.dll).\n\nAlternatively, if you have any licensed ETS installed, skip online signing entirely and use the local project store instead - see the 'License with a Dongle' tab."
msgstr "Απαιτούνται μόνο για λογαριασμούς με έλεγχο ταυτότητας δύο παραγόντων. Η σύνδεση 2FA ανοίγει αυτόματα στο πρόγραμμα περιήγησης όταν απορρίπτεται μια κανονική σύνδεση. Εισαγάγετε το OAuth client id/secret ή εξαγάγετέ τα από το εγκατεστημένο ETS σας: επιλέξτε το 'Knx.Ets.MyKnx.dll' από τον φάκελο προγράμματος του ETS (π.χ. C:\\Program Files (x86)\\ETS6\\Knx.Ets.MyKnx.dll).\n\nΕναλλακτικά, αν έχετε εγκατεστημένο οποιοδήποτε αδειοδοτημένο ETS, παραλείψτε εντελώς την online υπογραφή και χρησιμοποιήστε αντί αυτού το τοπικό project store - δείτε την καρτέλα «Άδεια με Dongle»."

msgid "Client ID"
msgstr "Client ID"

msgid "Client Secret"
msgstr "Client Secret"

msgid "Extract from ETS…"
msgstr "Εξαγωγή από ETS…"

msgid "Extracting…"
msgstr "Εξαγωγή…"

msgid "Save"
msgstr "Αποθήκευση"

msgid "All files"
msgstr "Όλα τα αρχεία"

msgid "Logging in…"
msgstr "Σύνδεση…"

msgid "License"
msgstr "Άδεια"

msgid "No licenses found on this account"
msgstr "Δεν βρέθηκαν άδειες σε αυτόν τον λογαριασμό"

msgid "no online certificate"
msgstr "χωρίς online πιστοποιητικό"

msgid "expired"
msgstr "έληξε"

msgid "None of these licenses can sign online. Only ETS6 (or a cloud-enabled ETS app) licenses produce a certificate; ETS5/older licenses cannot. Use 'License with a dongle' instead."
msgstr "Καμία από αυτές τις άδειες δεν μπορεί να υπογράψει online. Μόνο άδειες ETS6 (ή εφαρμογής ETS με δυνατότητα cloud) παράγουν πιστοποιητικό· οι άδειες ETS5/παλαιότερες όχι. Χρησιμοποιήστε αντί αυτού την «Άδεια με Dongle»."

msgid "Login failed: {error}"
msgstr "Η σύνδεση απέτυχε: {error}"

msgid "Format Version"
msgstr "Έκδοση Μορφής"

msgid "Remove device(s) & re-export"
msgstr "Αφαίρεση συσκευής(-ών) & νέα εξαγωγή"

msgid "Removed {count} incompatible device(s); re-exporting"
msgstr "Αφαιρέθηκαν {count} μη συμβατή(-ές) συσκευή(-ές)· νέα εξαγωγή"

msgid "This file will NOT import into the chosen ETS version: the product data of these manufacturers only exists for a newer ETS (e.g. an ETS 6 product in an ETS 5 export), so ETS rejects the whole project. Remove the affected device(s) or export for the newer ETS."
msgstr "Αυτό το αρχείο ΔΕΝ θα εισαχθεί στην επιλεγμένη έκδοση ETS: τα δεδομένα προϊόντων αυτών των κατασκευαστών υπάρχουν μόνο για νεότερο ETS (π.χ. ένα προϊόν ETS 6 σε εξαγωγή ETS 5), οπότε το ETS απορρίπτει ολόκληρο το έργο. Αφαιρέστε τις επηρεαζόμενες συσκευές ή κάντε εξαγωγή για το νεότερο ETS."

msgid "ETS 6 (schema 23)"
msgstr "ETS 6 (σχήμα 23)"

msgid "ETS 5 (schema 20)"
msgstr "ETS 5 (σχήμα 20)"

msgid "Signing Key…"
msgstr "Κλειδί Υπογραφής…"

msgid "Signing Key"
msgstr "Κλειδί Υπογραφής"

msgid "Folder signature uses a placeholder key. Enter a valid signature under 'Signing Key…' or use the 'License with a Dongle' way."
msgstr "Η υπογραφή φακέλου χρησιμοποιεί κλειδί κράτησης θέσης. Εισαγάγετε έγκυρη υπογραφή στο «Κλειδί Υπογραφής…» ή χρησιμοποιήστε τον τρόπο «Άδεια με Dongle»."

msgid "Export to ProjectStore"
msgstr "Εξαγωγή σε ProjectStore"

msgid "Select the {ets} ProjectStore folder"
msgstr "Επιλέξτε τον φάκελο ProjectStore του {ets}"

msgid "Select the ETS installer.guid file"
msgstr "Επιλέξτε το αρχείο installer.guid του ETS"

msgid "ETS installer id"
