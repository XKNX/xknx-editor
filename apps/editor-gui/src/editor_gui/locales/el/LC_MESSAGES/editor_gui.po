msgid "Run the MCP server so an LLM can drive the editor over Streamable HTTP. It shares this app's catalog database."
msgstr "Εκκινήστε τον διακομιστή MCP ώστε ένα LLM να μπορεί να χειρίζεται τον επεξεργαστή μέσω Streamable HTTP. Χρησιμοποιεί τη βάση δεδομένων καταλόγου αυτής της εφαρμογής."

msgid "MCP Host"
msgstr "Host MCP"

msgid "MCP Port"
msgstr "Θύρα MCP"

msgid "Bearer Token (Optional)"
msgstr "Bearer Token (Προαιρετικό)"

msgid "Server: Running"
msgstr "Διακομιστής: Σε λειτουργία"

msgid "Server: Stopped"
msgstr "Διακομιστής: Σταματημένος"

msgid "Port {port} is already in use by another program, so the MCP server cannot start. Choose another port, or end the other program."
msgstr "Η θύρα {port} χρησιμοποιείται ήδη από άλλο πρόγραμμα, οπότε ο διακομιστής MCP δεν μπορεί να ξεκινήσει. Επιλέξτε άλλη θύρα ή τερματίστε το άλλο πρόγραμμα."

msgid "The MCP server could not start: {error}"
msgstr "Ο διακομιστής MCP δεν μπόρεσε να ξεκινήσει: {error}"

msgid "Start Server"
msgstr "Εκκίνηση Διακομιστή"

msgid "Stop Server"
msgstr "Διακοπή Διακομιστή"

msgid "AI MCP"
msgstr "AI MCP"

msgid "This editor is controllable by an AI assistant (Claude, Codex, …) through the built-in MCP server: it exposes the catalog and project as tools over Streamable HTTP. Start the server below, then register its endpoint in your AI tool."
msgstr "Αυτός ο επεξεργαστής μπορεί να ελέγχεται από έναν βοηθό τεχνητής νοημοσύνης (Claude, Codex, …) μέσω του ενσωματωμένου διακομιστή MCP: παρέχει τον κατάλογο και το έργο ως εργαλεία μέσω Streamable HTTP. Εκκινήστε τον διακομιστή παρακάτω και, στη συνέχεια, καταχωρίστε το endpoint του στο εργαλείο AI σας."

msgid "MCP Endpoint"
msgstr "Endpoint MCP"

msgid "Example: register the MCP server in your AI tool (adjust host/port):"
msgstr "Παράδειγμα: καταχώριση του διακομιστή MCP στο εργαλείο AI σας (προσαρμόστε host/θύρα):"

msgid "Use host 0.0.0.0 to make the server reachable from other devices on the network; 127.0.0.1/localhost only allows this machine."
msgstr "Χρησιμοποιήστε τον host 0.0.0.0 ώστε ο διακομιστής να είναι προσβάσιμος από άλλες συσκευές στο δίκτυο· το 127.0.0.1/localhost επιτρέπει μόνο αυτόν τον υπολογιστή."

msgid "claude mcp add --transport http xknx-editor {url}"
msgstr "claude mcp add --transport http xknx-editor {url}"

msgid "claude mcp add --transport http xknx-editor {url} --header \"Authorization: Bearer {token}\""
msgstr "claude mcp add --transport http xknx-editor {url} --header \"Authorization: Bearer {token}\""

msgid "codex mcp add xknx-editor --url {url}"
msgstr "codex mcp add xknx-editor --url {url}"

msgid "export XKNX_MCP_TOKEN='{token}'\ncodex mcp add xknx-editor --url {url} --bearer-token-env-var XKNX_MCP_TOKEN"
msgstr "export XKNX_MCP_TOKEN='{token}'\ncodex mcp add xknx-editor --url {url} --bearer-token-env-var XKNX_MCP_TOKEN"

