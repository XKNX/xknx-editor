msgstr "Eksempel: registrer MCP-serveren i dit AI-værktøj (tilpas vært/port):"

msgid "Use host 0.0.0.0 to make the server reachable from other devices on the network; 127.0.0.1/localhost only allows this machine."
msgstr "Brug vært 0.0.0.0 for at gøre serveren tilgængelig fra andre enheder på netværket; 127.0.0.1/localhost tillader kun denne computer."

