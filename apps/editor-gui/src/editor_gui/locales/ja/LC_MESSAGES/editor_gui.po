msgid "AI MCP"
msgstr "AI MCP"

msgid "This editor is controllable by an AI assistant (Claude, Codex, …) through the built-in MCP server: it exposes the catalog and project as tools over Streamable HTTP. Start the server below, then register its endpoint in your AI tool."
msgstr "このエディターは、内蔵のMCPサーバーを通じてAIアシスタント（Claude、Codex、…）から操作できます。サーバーはカタログとプロジェクトをStreamable HTTP経由のツールとして公開します。下でサーバーを起動し、そのエンドポイントをAIツールに登録してください。"

msgid "MCP Endpoint"
msgstr "MCPエンドポイント"

msgid "Example: register the MCP server in your AI tool (adjust host/port):"
msgstr "例：AIツールにMCPサーバーを登録します（ホスト／ポートを調整してください）："

msgid "Use host 0.0.0.0 to make the server reachable from other devices on the network; 127.0.0.1/localhost only allows this machine."
msgstr "ネットワーク上の他のデバイスからサーバーにアクセスできるようにするには、ホスト0.0.0.0を使用してください。127.0.0.1/localhostではこのコンピューターからのみアクセスできます。"

msgid "claude mcp add --transport http xknx-editor {url}"
msgstr "claude mcp add --transport http xknx-editor {url}"

msgid "claude mcp add --transport http xknx-editor {url} --header \"Authorization: Bearer {token}\""
msgstr "claude mcp add --transport http xknx-editor {url} --header \"Authorization: Bearer {token}\""

msgid "codex mcp add xknx-editor --url {url}"
msgstr "codex mcp add xknx-editor --url {url}"

msgid "export XKNX_MCP_TOKEN='{token}'\ncodex mcp add xknx-editor --url {url} --bearer-token-env-var XKNX_MCP_TOKEN"
msgstr "export XKNX_MCP_TOKEN='{token}'\ncodex mcp add xknx-editor --url {url} --bearer-token-env-var XKNX_MCP_TOKEN"

