msgid "Help"
msgstr "Справка"

msgid "Feedback"
msgstr "Обратная связь"

msgid "About"
msgstr "О программе"

msgid "Language"
msgstr "Язык"

msgid "No matches"
msgstr "Нет совпадений"

msgid "Version {version}"
msgstr "Версия {version}"

msgid "A desktop editor for building-automation installation projects, built on the open-source xknx library and based on xknxtoolkit by kewde. Not affiliated with or endorsed by the KNX Association."
msgstr "Настольный редактор проектов инсталляций автоматизации зданий, построенный на библиотеке с открытым исходным кодом xknx и основанный на xknxtoolkit от kewde. Не связан с KNX Association и не одобрен ею."

msgid "Network Location"
msgstr "Сетевое расположение"

msgid "This location is on a network drive:\n{home}\n\nKNX project files use a database that cannot run reliably on network shares. The editor can work on a local copy instead and write it back to the network location when you close the project."
msgstr "Это расположение находится на сетевом диске:\n{home}\n\nФайлы проектов KNX используют базу данных, которая не может надёжно работать на сетевых ресурсах. Вместо этого редактор может работать с локальной копией и записать её обратно в сетевое расположение при закрытии проекта."

msgid "Use a Local Copy"
msgstr "Использовать локальную копию"

msgid "Working on a local copy; written back to {home} when you close the project."
msgstr "Работа с локальной копией; она будет записана обратно в {home} при закрытии проекта."

