msgid "Paste an OpenKNX GitHub release URL (the release page works — the .zip asset is found automatically). A direct .knxprod or KNX product XML link also works.\n\nExamples:\n  https://github.com/OpenKNX/OAM-RaumController/releases/tag/v5.4.3\n  https://github.com/OpenKNX/OAM-RaumController/releases/latest"
msgstr "Vložte URL vydání OpenKNX na GitHubu (funguje i stránka vydání — příloha .zip se najde automaticky). Funguje i přímý odkaz na .knxprod nebo produktové XML KNX.\n\nPříklady:\n  https://github.com/OpenKNX/OAM-RaumController/releases/tag/v5.4.3\n  https://github.com/OpenKNX/OAM-RaumController/releases/latest"

msgid "Or choose a local folder with product files (.knxprod, OpenKNX release .zip, or KNX product XML) to import all of them."
msgstr "Nebo vyberte místní složku s produktovými soubory (.knxprod, .zip vydání OpenKNX nebo produktové XML KNX) a importujte je všechny."

msgid "Choose Folder…"
msgstr "Vybrat složku…"

msgid "Or upload product files (.knxprod, OpenKNX release .zip, or KNX product XML) from this computer to import all of them."
msgstr "Nebo nahrajte produktové soubory (.knxprod, .zip vydání OpenKNX nebo produktové XML KNX) z tohoto počítače a importujte je všechny."

msgid "Choose Files…"
msgstr "Vybrat soubory…"

msgid "Load"
msgstr "Načíst"

msgid "Downloading and importing…"
msgstr "Stahování a import…"

msgid "Nothing new imported (already in the catalog)"
