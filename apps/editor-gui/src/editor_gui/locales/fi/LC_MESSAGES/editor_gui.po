msgid "Paste an OpenKNX GitHub release URL (the release page works — the .zip asset is found automatically). A direct .knxprod or KNX product XML link also works.\n\nExamples:\n  https://github.com/OpenKNX/OAM-RaumController/releases/tag/v5.4.3\n  https://github.com/OpenKNX/OAM-RaumController/releases/latest"
msgstr "Liitä OpenKNX:n GitHub-julkaisun URL-osoite (julkaisusivu käy — .zip-tiedosto löydetään automaattisesti). Myös suora .knxprod- tai KNX-tuote-XML-linkki käy.\n\nEsimerkkejä:\n  https://github.com/OpenKNX/OAM-RaumController/releases/tag/v5.4.3\n  https://github.com/OpenKNX/OAM-RaumController/releases/latest"

msgid "Or choose a local folder with product files (.knxprod, OpenKNX release .zip, or KNX product XML) to import all of them."
msgstr "Tai valitse paikallinen kansio, jossa on tuotetiedostoja (.knxprod, OpenKNX-julkaisun .zip tai KNX-tuote-XML), tuodaksesi ne kaikki."

msgid "Choose Folder…"
msgstr "Valitse kansio…"

msgid "Or upload product files (.knxprod, OpenKNX release .zip, or KNX product XML) from this computer to import all of them."
msgstr "Tai lähetä tuotetiedostoja (.knxprod, OpenKNX-julkaisun .zip tai KNX-tuote-XML) tältä tietokoneelta tuodaksesi ne kaikki."

msgid "Choose Files…"
msgstr "Valitse tiedostot…"

