msgstr "Lataa"

msgid "Downloading and importing…"
msgstr "Ladataan ja tuodaan…"

msgid "Nothing new imported (already in the catalog)"
msgstr "Mitään uutta ei tuotu (jo luettelossa)"

msgid "Import from URL failed: {error}"
msgstr "Tuonti URL-osoitteesta epäonnistui: {error}"

msgid "Choose a Folder with KNX Product Files"
msgstr "Valitse kansio, jossa on KNX-tuotetiedostoja"

msgid "Importing from folder…"
