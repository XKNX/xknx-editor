msgstr "Point de terminaison MCP"

msgid "Example: register the MCP server in your AI tool (adjust host/port):"
msgstr "Exemple : enregistrer le serveur MCP dans votre outil d'IA (adaptez l'hôte/le port) :"

msgid "Use host 0.0.0.0 to make the server reachable from other devices on the network; 127.0.0.1/localhost only allows this machine."
msgstr "Utilisez l'hôte 0.0.0.0 pour rendre le serveur accessible depuis d'autres appareils du réseau ; 127.0.0.1/localhost n'autorise que cet ordinateur."

