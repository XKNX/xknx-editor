msgstr "Eksempel: registrer MCP-serveren i KI-verktøyet ditt (tilpass vert/port):"

msgid "Use host 0.0.0.0 to make the server reachable from other devices on the network; 127.0.0.1/localhost only allows this machine."
msgstr "Bruk vert 0.0.0.0 for å gjøre serveren tilgjengelig fra andre enheter i nettverket; 127.0.0.1/localhost tillater bare denne maskinen."

