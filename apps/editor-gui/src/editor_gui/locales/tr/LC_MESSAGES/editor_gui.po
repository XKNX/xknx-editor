msgstr "MyKNX proje için sertifika düzenlemedi:"

msgid "To export without it, choose 'Export Without Certificate' or the 'License with a Dongle' tab in the Sign Export window."
msgstr "Sertifika olmadan dışa aktarmak için \"Dışa Aktarmayı İmzala\" penceresinde \"Sertifikasız Dışa Aktar\" seçeneğini veya \"Dongle ile Lisansla\" sekmesini seçin."

msgid "{name} cannot be imported."
msgstr "{name} içe aktarılamıyor."

msgid "The file was written, but it refers to product data that is not in the catalog: {references}. Add these products to the catalog and export again."
msgstr "Dosya yazıldı, ancak katalogda olmayan ürün verilerine başvuruyor: {references}. Bu ürünleri kataloğa ekleyin ve yeniden dışa aktarın."

msgid "Sign Export"
msgstr "Dışa Aktarmayı İmzala"

msgid "ETS 6: needs a licensed .knxproj through a MyKNX login or a dongle.\nETS 5: just use 'Export Without Certificate'."
msgstr "ETS 6: MyKNX oturumu veya dongle ile lisanslanmış bir .knxproj gerekir.\nETS 5: yalnızca 'Sertifikasız Dışa Aktar' seçeneğini kullanın."

msgid "Sign with MyKNX Login"
msgstr "MyKNX Oturumuyla İmzala"

msgid "License with a Dongle"
msgstr "Dongle ile Lisansla"

msgid "ETS must not be running on any computer with this MyKNX account while you log in and export here."
msgstr "Burada oturum açıp dışa aktarma yaparken bu MyKNX hesabıyla hiçbir bilgisayarda ETS çalışmamalıdır."

msgid "MyKNX Username"
