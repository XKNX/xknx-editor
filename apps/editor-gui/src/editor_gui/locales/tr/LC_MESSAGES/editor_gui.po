msgid "No licenses found on this account"
msgstr "Bu hesapta lisans bulunamadı"

msgid "no online certificate"
msgstr "çevrimiçi sertifika yok"

msgid "expired"
msgstr "süresi dolmuş"

msgid "None of these licenses can sign online. Only ETS6 (or a cloud-enabled ETS app) licenses produce a certificate; ETS5/older licenses cannot. Use 'License with a dongle' instead."
msgstr "Bu lisansların hiçbiri çevrimiçi imzalayamaz. Yalnızca ETS6 (veya bulut özellikli bir ETS uygulaması) lisansları sertifika üretir; ETS5/daha eski lisanslar üretemez. Bunun yerine 'Dongle ile Lisansla' seçeneğini kullanın."

msgid "Login failed: {error}"
msgstr "Oturum açılamadı: {error}"

