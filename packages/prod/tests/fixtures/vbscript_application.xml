            <ParameterCalculations>
              <ParameterCalculation Id="M-00FA_A-0002-01-0000_PC-1" Name="DelayCode" Language="VBScript">
                <LRTransformation><![CDATA[Dim Base, Shift, Mant
Base = 5
Shift = 0
If ms < 300 Then ms = 300
Mant = ms / Base
While Mant > 127 And Shift < 24
  Shift = Shift + 1
  Mant = ms / (Base * 2 ^ Shift)
Wend
raw = Shift * 2 ^ 8 + CInt(Mant)
]]></LRTransformation>
                <RLTransformation><![CDATA[Dim Shift
Shift = Int((raw And &hFF00) / 2 ^ 8)
ms = (raw And &hFF) * (5 * 2 ^ Shift)
]]></RLTransformation>
                <LParameters><ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-1_R-1" AliasName="ms" /></LParameters>
                <RParameters><ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-2_R-2" AliasName="raw" /></RParameters>
              </ParameterCalculation>
              <ParameterCalculation Id="M-00FA_A-0002-01-0000_PC-2" Name="FlagBits" Language="VBScript">
                <LRTransformation><![CDATA[flags = flags And &hFC ' keep the other bits
If lock Then flags = flags Or 1
If invert = 1 Then flags = flags Or 2 End If
]]></LRTransformation>
                <RLTransformation><![CDATA[lock = flags And 1
invert = (flags And 2) \ 2
]]></RLTransformation>
                <LParameters>
                  <ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-3_R-3" AliasName="lock" />
                  <ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-4_R-4" AliasName="invert" />
                </LParameters>
                <RParameters><ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-5_R-5" AliasName="flags" /></RParameters>
              </ParameterCalculation>
              <ParameterCalculation Id="M-00FA_A-0002-01-0000_PC-3" Name="OffsetText" Language="VBScript">
                <LRTransformation><![CDATA[label = "Offset " & (offset / 2) & " K"]]></LRTransformation>
                <RLTransformation></RLTransformation>
                <LParameters><ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-6_R-6" AliasName="offset" /></LParameters>
                <RParameters><ParameterRefRef RefId="M-00FA_A-0002-01-0000_P-7_R-7" AliasName="label" /></RParameters>
              </ParameterCalculation>
              <ParameterCalculation Id="M-00FA_A-0002-01-0000_PC-4" Name="Modes" Language="VBScript">
                <LRTransformation><![CDATA[Select Case mode
Case 0, 1
  result = mode * 10
Case 2
  result = CInt("two")
Case 3
  On Error Resume Next
  result = CInt("three")
  result = 99
Case Else
  result = 255
End Select
]]></LRTransformation>
                <RLTransformation></RLTransformation>
